+#[test]
+fn mac_reap_and_signal_share_one_lock_and_wait_error_never_proves_exit() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    let done = DoneFlag::new();
+    let (entered_tx, entered_rx) = std::sync::mpsc::channel();
+    let (release_tx, release_rx) = std::sync::mpsc::channel();
+    let reaper_done = std::sync::Arc::clone(&done);
+    let reaper = std::thread::spawn(move || {
+        reaper_done.poll_reap(|| {
+            entered_tx.send(()).unwrap();
+            release_rx.recv().unwrap();
+            Ok(true)
+        })
+    });
+    entered_rx.recv().unwrap();
+    let delivered = std::sync::Arc::new(AtomicBool::new(false));
+    let delivered_thread = std::sync::Arc::clone(&delivered);
+    let signal_done = std::sync::Arc::clone(&done);
+    let (attempt_tx, attempt_rx) = std::sync::mpsc::channel();
+    let (finished_tx, finished_rx) = std::sync::mpsc::channel();
+    let signal = std::thread::spawn(move || {
+        attempt_tx.send(()).unwrap();
+        let sent = signal_done.signal_if_live(|| {
+            delivered_thread.store(true, Ordering::SeqCst);
+        });
+        finished_tx.send(sent).unwrap();
+    });
+    attempt_rx.recv().unwrap();
+    assert!(finished_rx.recv_timeout(Duration::from_millis(20)).is_err());
+    release_tx.send(()).unwrap();
+    assert!(reaper.join().unwrap().unwrap());
+    signal.join().unwrap();
+    assert!(!finished_rx.recv().unwrap());
+    assert!(!delivered.load(Ordering::SeqCst));
+
+    let uncertain = DoneFlag::new();
+    assert!(uncertain
+        .poll_reap(|| Err(std::io::Error::other("wait failed")))
+        .is_err());
+    assert!(!uncertain.wait_exit(Duration::ZERO));
+    assert!(!uncertain.signal_if_live(|| panic!("uncertain child must not be signalled")));
+}
