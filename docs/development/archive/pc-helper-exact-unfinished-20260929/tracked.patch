+#[test]
+fn exact_helper_client_rejects_legacy_already_and_mismatched_receipts() {
+    let binding = ExactBinding {
+        run_ref: "run-1".into(),
+        plan_id: "plan-1".into(),
+        plan_digest: "a".repeat(64),
+        artifact_digest: "b".repeat(64),
+        config_sha256: "c".repeat(64),
+        core_sha256: "d".repeat(64),
+    };
+    let receipt = ExactReceipt {
+        binding: binding.clone(),
+        launched_config_sha256: "e".repeat(64),
+        launch_closure_digest: "f".repeat(64),
+        daemon_birth: "daemon-1".into(),
+        pid: 4242,
+        process_birth: "birth-1".into(),
+    };
+    let request = Request::StartExact(ExactStartParams {
+        common: StartParams {
+            cfg: "/tmp/config.json".into(),
+            log: String::new(),
+            fwd: false,
+            parent_pid: None,
+        },
+        binding: binding.clone(),
+    });
+    for wire in ["OK already 4242\n", "OK started 4242\n", "ERR unknown\n"] {
+        let (client, _) = stop_test_client(vec![polaris_helper_client::MockStream::with_response(
+            wire.as_bytes().to_vec(),
+        )]);
+        assert!(
+            start_exact_with_client(&client, request.clone(), &binding).is_err(),
+            "{wire}"
+        );
+    }
+    let mut wrong = receipt.clone();
+    wrong.binding.plan_id = "other-plan".into();
+    let response = Response::Ok(ResponseKind::Exact(ExactResult::Started(wrong))).to_wire_line();
+    let (client, _) = stop_test_client(vec![polaris_helper_client::MockStream::with_response(
+        format!("{response}\n").into_bytes(),
+    )]);
+    assert!(start_exact_with_client(&client, request.clone(), &binding).is_err());
+    let response =
+        Response::Ok(ResponseKind::Exact(ExactResult::Started(receipt.clone()))).to_wire_line();
+    let (client, _) = stop_test_client(vec![polaris_helper_client::MockStream::with_response(
+        format!("{response}\n").into_bytes(),
+    )]);
+    assert_eq!(
+        start_exact_with_client(&client, request, &binding),
+        Ok(receipt.clone())
+    );
+
+    let (client, _) = stop_test_client(vec![polaris_helper_client::MockStream::with_response(
+        b"OK stopped 4242\n".to_vec(),
+    )]);
+    assert!(
+        exact_result_with_client(&client, Request::StopExact(receipt.clone()), &receipt).is_err()
+    );
+    let response = Response::Ok(ResponseKind::Exact(ExactResult::StopRequested(
+        receipt.clone(),
+    )))
+    .to_wire_line();
+    let (client, _) = stop_test_client(vec![polaris_helper_client::MockStream::with_response(
+        format!("{response}\n").into_bytes(),
+    )]);
+    assert_eq!(
+        exact_result_with_client(&client, Request::StopExact(receipt.clone()), &receipt),
+        Ok(ExactResult::StopRequested(receipt))
+    );
+}
