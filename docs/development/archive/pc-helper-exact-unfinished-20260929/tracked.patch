+#[allow(
+    dead_code,
+    reason = "managed exact helper calls are not wired into production Apply yet"
+)]
+fn exact_result_with_client(
+    client: &HelperClient,
+    request: Request,
+    want: &ExactReceipt,
+) -> Result<ExactResult, String> {
+    let is_stop = matches!(request, Request::StopExact(_));
+    let response = client
+        .send_with_timeout(&request, HELPER_STOP_TIMEOUT)
+        .map_err(|error| format!("exact helper outcome unknown: {error}"))?;
+    match response {
+        Response::Ok(ResponseKind::Exact(result)) => {
+            let matching = match &result {
+                ExactResult::Running(receipt) if !is_stop => receipt == want,
+                ExactResult::StopRequested(receipt) if is_stop => receipt == want,
+                ExactResult::Exited(receipt) => receipt == want,
+                ExactResult::Unknown | ExactResult::Mismatch => true,
+                _ => false,
+            };
+            if matching {
+                Ok(result)
+            } else {
+                Err("exact helper returned mismatched instance".into())
+            }
+        }
+        Response::Err(error) => Err(format!("exact helper command failed: {error}")),
+        other => Err(format!(
+            "exact helper returned legacy or malformed response: {other:?}"
+        )),
+    }
+}
