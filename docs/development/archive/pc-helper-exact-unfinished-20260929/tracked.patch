+/// Reap and signal share one lock. A PID cannot be reused until the child is reaped; marking
+/// Exited in the same critical section as `try_wait` closes the wait-to-done signalling gap.
+#[cfg(any(target_os = "macos", test))]
+struct DoneFlag {
+    state: std::sync::Mutex<DoneObservation>,
+    cv: std::sync::Condvar,
+}
+
+#[cfg(any(target_os = "macos", test))]
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum DoneObservation {
+    Live,
+    Exited,
+    Unknown,
+}
+
+#[cfg(any(target_os = "macos", test))]
+impl DoneFlag {
+    fn new() -> std::sync::Arc<Self> {
+        std::sync::Arc::new(Self {
+            state: std::sync::Mutex::new(DoneObservation::Live),
+            cv: std::sync::Condvar::new(),
+        })
+    }
+
+    fn poll_reap(&self, try_wait: impl FnOnce() -> std::io::Result<bool>) -> std::io::Result<bool> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if *state != DoneObservation::Live {
+            return Ok(*state == DoneObservation::Exited);
+        }
+        match try_wait() {
+            Ok(true) => {
+                *state = DoneObservation::Exited;
+                self.cv.notify_all();
+                Ok(true)
+            }
+            Ok(false) => Ok(false),
+            Err(error) => {
+                *state = DoneObservation::Unknown;
+                self.cv.notify_all();
+                Err(error)
+            }
+        }
+    }
+
+    fn wait_exit(&self, timeout: Duration) -> bool {
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let (state, _) = self
+            .cv
+            .wait_timeout_while(state, timeout, |state| *state == DoneObservation::Live)
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        *state == DoneObservation::Exited
+    }
+
+    fn signal_if_live(&self, send: impl FnOnce()) -> bool {
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if *state != DoneObservation::Live {
+            return false;
+        }
+        send();
+        true
+    }
+}
