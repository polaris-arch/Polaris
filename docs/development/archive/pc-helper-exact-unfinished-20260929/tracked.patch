+        Ok(Response::Err(error)) => Err(format!("exact helper start failed: {error}")),
+        Ok(other) => Err(format!(
+            "exact helper start returned unverified receipt: {other:?}"
+        )),
+        Err(error) => Err(format!("exact helper start outcome unknown: {error}")),
+    }
