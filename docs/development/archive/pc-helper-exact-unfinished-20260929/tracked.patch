+
+fn exact_observation<S: CoreSpawner>(
+    state: &HandlerState,
+    spawner: &S,
+    want: &ExactReceipt,
+) -> ExactResult {
+    if want.daemon_birth != crate::exact::daemon_birth() || !want.valid() {
+        return ExactResult::Unknown;
+    }
+    let Some(child) = state.child.as_ref() else {
+        return if crate::exact::linux_instance_exited(want) == Some(true) {
+            ExactResult::Exited(want.clone())
+        } else {
+            ExactResult::Unknown
+        };
+    };
+    let Some(current) = state.exact.as_ref() else {
+        return ExactResult::Mismatch;
+    };
+    if child.pid != current.pid || !crate::exact::matches(want, current) {
+        return ExactResult::Mismatch;
+    }
+    match spawner.process_birth(child.pid) {
+        Some(birth) if birth == current.process_birth => ExactResult::Running(current.clone()),
+        Some(_) => ExactResult::Exited(want.clone()),
+        None => ExactResult::Unknown,
+    }
+}
+
+fn handle_exact_status<P, S, D, SD>(
+    state: &HandlerState,
+    deps: &HandlerDeps<'_, P, S, D, SD>,
+    conn: &mut impl Conn,
+) where
+    P: PeerCredProvider,
+    S: CoreSpawner,
+    D: FreePortDeps,
+    SD: SystemdOps,
+{
+    let result = read_exact_receipt(conn).map_or(ExactResult::Unknown, |want| {
+        exact_observation(state, deps.spawner, &want)
+    });
+    let _ = conn.write_line(&Response::Ok(ResponseKind::Exact(result)).to_wire_line());
+}
+
+fn handle_exact_stop<P, S, D, SD>(
+    state: &mut HandlerState,
+    deps: &HandlerDeps<'_, P, S, D, SD>,
+    conn: &mut impl Conn,
+) where
+    P: PeerCredProvider,
+    S: CoreSpawner,
+    D: FreePortDeps,
+    SD: SystemdOps,
+{
+    let Some(want) = read_exact_receipt(conn) else {
+        let _ = conn.write_line("ERR bad-args");
+        return;
+    };
+    let result = match exact_observation(state, deps.spawner, &want) {
