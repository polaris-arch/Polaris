+		if result.Generation != generation || result.State != tun.RouteAddressSetCommitted {
+			r.inputAccess.Lock()
+			r.inputSet, r.inputInclude, r.inputExclude = previousSet, previousInclude, previousExclude
+			r.inputAccess.Unlock()
+		}
+	}()
+	return updater.UpdateRouteAddressSetSnapshot(generation, slices.Clone(include), slices.Clone(exclude))
 }
