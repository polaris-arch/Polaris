+				// Each complete datagram is far below the retained 4 MiB limit;
+				// table userdata stays within Linux's 256-byte attribute limit.
+				for start := 0; start < item.count; start += 128 {
+					packet := make([]netlink.Message, 0, min(128, item.count-start))
+					for i := start; i < min(start+128, item.count); i++ {
+						name := fmt.Sprintf("foreign-%d", i)
+						var attributes []netlink.Attribute
+						if op == unix.NFT_MSG_GETTABLE {
+							attributes = []netlink.Attribute{{Type: unix.NFTA_TABLE_NAME, Data: []byte(name + "\x00")}, {Type: nftTableHandle, Data: binaryutil.BigEndian.PutUint64(uint64(i + 1000))}}
+							if item.padded {
+								attributes = append(attributes, netlink.Attribute{Type: nftTableUserdata, Data: make([]byte, 256)})
+							}
+						} else {
+							if item.padded {
+								name = strings.Repeat("c", 235) + name
+							}
+							attributes = []netlink.Attribute{{Type: unix.NFTA_CHAIN_TABLE, Data: []byte("foreign-parent\x00")}, {Type: unix.NFTA_CHAIN_NAME, Data: []byte(name + "\x00")}, {Type: unix.NFTA_CHAIN_HANDLE, Data: binaryutil.BigEndian.PutUint64(uint64(i + 1000))}}
+						}
+						encoded, err := netlink.MarshalAttributes(attributes)
+						if err != nil {
+							t.Fatal(err)
+						}
+						data := append(extraHeader(byte(TableFamilyINet), 0), encoded...)
+						object := netlink.Message{Header: netlink.Header{Length: uint32(16 + len(data)), Type: request.Header.Type - 1, Flags: netlink.Multi, Sequence: request.Header.Sequence, PID: request.Header.PID}, Data: data}
+						foreignBytes += 16 + len(data)
+						foreignCount++
+						packet = append(packet, object)
+					}
+					packets = append(packets, packet)
+				}
+				return deliver(append(packets, done))
+			}
+			snapshot, err := c.ReadConsistentTable(&Table{Name: "own", Family: TableFamilyINet})
+			if err != nil || c.owned.tainted || snapshot == nil {
+				t.Fatalf("valid large foreign family poisoned a small own table: %v", err)
+			}
+			if foreignCount != item.count || item.padded && foreignBytes <= 16<<20 || !item.padded && foreignCount <= 65536 {
+				t.Fatal("positive control did not cross the removed aggregate limit")
+			}
+			if snapshot.Generation != 0xfedcba98 || len(snapshot.Tables) != 1 || len(snapshot.Chains) != 1 || snapshot.Tables[0].Name != "own" || snapshot.Chains[0].Name != "own-chain" || snapshot.Chains[0].Table.Name != "own" || len(tr.sent) != 6 {
+				t.Fatal("complete generation/terminal family selection was lost")
+			}
+			if generation, err := c.Generation(); err != nil || generation != 0xfedcba98 {
+				t.Fatal("valid foreign family dump sealed the next read")
+			}
+			c.CreateTable(&Table{Name: "after-valid-observation", Family: TableFamilyINet, Flags: TableFlagOwner})
+			if err := c.Flush(); err != nil || c.LastTransaction().State != TransactionCommitted || len(tr.sent) != 8 {
+				t.Fatalf("valid foreign family dump blocked the next write: %v", err)
+			}
+			t.Logf("complete valid foreign family objects=%d wire-bytes=%d retained own tables=1 chains=1; next read/write succeeded", foreignCount, foreignBytes)
+		})
+	}
+}
