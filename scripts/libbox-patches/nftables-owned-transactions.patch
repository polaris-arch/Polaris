diff --git a/owned.go b/owned.go
new file mode 100644
index 0000000..69f0819
--- /dev/null
+++ b/owned.go
@@ -0,0 +1,758 @@
+package nftables
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"syscall"
+	"time"
+
+	"github.com/mdlayher/netlink"
+	"github.com/sagernet/nftables/binaryutil"
+	"golang.org/x/sys/unix"
+)
+
+// These values are pinned to Linux v6.12's UAPI, including backported kernels.
+const (
+	TableFlagOwner   uint32 = 0x2
+	TableFlagPersist uint32 = 0x4
+	nftTableHandle   uint16 = 4
+	nftTableUserdata uint16 = 6
+	nftTableOwner    uint16 = 7
+	nftSetHandle     uint16 = 16
+	nftChainUserdata uint16 = 12
+	nftGenID         uint16 = 1
+	nfnlBatchGenID   uint16 = 1
+)
+
+var (
+	ErrSealed            = errors.New("nftables connection permanently sealed")
+	ErrUncertain         = errors.New("nftables transaction outcome uncertain")
+	ErrGenerationChanged = errors.New("nftables generation changed; discard observation")
+)
+
+type TransactionState uint8
+
+const (
+	TransactionUnknown TransactionState = iota
+	TransactionNotSent
+	TransactionAborted
+	TransactionCommitted
+)
+
+// MessageIntent is produced only by the library serializer. Bytes, header and
+// object association are copied before the journal is called and before send.
+type MessageIntent struct {
+	Index             int
+	Header            netlink.Header
+	Family            TableFamily
+	Table, Chain, Set string
+	Handle            uint64
+	Bytes             []byte
+}
+
+type TransactionIntent struct {
+	Birth                           string
+	NamespaceDevice, NamespaceInode uint64
+	PortID, Generation              uint32
+	Messages                        []MessageIntent // includes BEGIN and END
+}
+
+type TransactionReceipt struct {
+	Intent  TransactionIntent
+	State   TransactionState
+	Sent    bool
+	Replies []netlink.Message
+	// GenerationNotifications are observations, never ACKs or object ownership.
+	GenerationNotifications []GenerationNotification
+	Err                     error
+}
+
+// TransactionJournal must persist Pending before returning from Prepare.
+// Complete receives an independent copy; the caller cannot change wire bytes.
+type TransactionJournal interface {
+	Prepare(TransactionIntent) error
+	Complete(TransactionReceipt)
+}
+
+type ownedState struct {
+	birth                           string
+	namespaceDevice, namespaceInode uint64
+	journal                         TransactionJournal
+	portID, sequence, generation    uint32
+	raw                             syscall.RawConn
+	transport                       ownedTransport
+	last                            TransactionReceipt
+	timeout                         time.Duration
+	tainted                         bool
+}
+
+// AsOwnedTransactions binds all transactions to one lasting socket and the
+// borrowed original namespace fd. Closing permanently seals every later IO.
+func AsOwnedTransactions(birth string, journal TransactionJournal) ConnOption {
+	return func(cc *Conn) {
+		cc.lasting = true
+		cc.owned = &ownedState{birth: birth, journal: journal, timeout: 5 * time.Second}
+	}
+}
+
+func (cc *Conn) initOwned() error {
+	o := cc.owned
+	if o == nil {
+		return nil
+	}
+	if o.birth == "" || o.journal == nil || cc.NetNS <= 0 {
+		return errors.New("owned nft socket requires birth, journal and pinned namespace fd")
+	}
+	var st unix.Stat_t
+	if err := unix.Fstat(cc.NetNS, &st); err != nil {
+		return err
+	}
+	typ, err := unix.IoctlRetInt(cc.NetNS, unix.NS_GET_NSTYPE)
+	if err != nil || typ != unix.CLONE_NEWNET {
+		return errors.New("owned nft socket fd is not a network namespace")
+	}
+	o.namespaceDevice, o.namespaceInode = uint64(st.Dev), st.Ino
+	o.raw, err = cc.nlconn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	controlErr := o.raw.Control(func(fd uintptr) {
+		sa, e := unix.Getsockname(int(fd))
+		if e != nil {
+			err = e
+			return
+		}
+		nl, ok := sa.(*unix.SockaddrNetlink)
+		if !ok {
+			err = errors.New("owned nft socket is not netlink")
+			return
+		}
+		o.portID = nl.Pid
+	})
+	if controlErr != nil {
+		return controlErr
+	}
+	if err != nil {
+		return err
+	}
+	if o.portID == 0 {
+		return errors.New("owned nft socket has no port id")
+	}
+	if err = o.checkMemberships(); err != nil {
+		return err
+	}
+	var seed [4]byte
+	if _, err = rand.Read(seed[:]); err != nil {
+		return err
+	}
+	o.transport = &ownedNetlinkTransport{conn: cc.nlconn, state: o}
+	o.sequence = binary.NativeEndian.Uint32(seed[:])
+	if o.sequence == 0 {
+		o.sequence = 1
+	}
+	return nil
+}
+
+func cloneIntent(in TransactionIntent) TransactionIntent {
+	out := in
+	out.Messages = append([]MessageIntent(nil), in.Messages...)
+	for i := range out.Messages {
+		out.Messages[i].Bytes = bytes.Clone(in.Messages[i].Bytes)
+	}
+	return out
+}
+func cloneReceipt(in TransactionReceipt) TransactionReceipt {
+	out := in
+	out.Intent = cloneIntent(in.Intent)
+	out.Replies = cloneMessages(in.Replies)
+	out.GenerationNotifications = cloneGenerationNotifications(in.GenerationNotifications)
+	return out
+}
+func cloneMessages(in []netlink.Message) []netlink.Message {
+	out := append([]netlink.Message(nil), in...)
+	for i := range out {
+		out[i].Data = bytes.Clone(in[i].Data)
+	}
+	return out
+}
+
+// LastTransaction is a copy and is never authority to retry an uncertain send.
+func (cc *Conn) LastTransaction() TransactionReceipt {
+	cc.mu.Lock()
+	defer cc.mu.Unlock()
+	if cc.owned == nil {
+		return TransactionReceipt{}
+	}
+	return cloneReceipt(cc.owned.last)
+}
+
+// UseGeneration consumes the complete 32-bit generation from a consistent
+// snapshot. It applies to the next Flush only; aborts are never replayed.
+func (cc *Conn) UseGeneration(generation uint32) error {
+	cc.mu.Lock()
+	defer cc.mu.Unlock()
+	if cc.sealed {
+		return ErrSealed
+	}
+	if cc.owned != nil && cc.owned.tainted {
+		return ErrUncertain
+	}
+	if cc.owned == nil || generation == 0 {
+		return errors.New("conditional nft commit requires owned socket and nonzero generation")
+	}
+	cc.owned.generation = generation
+	return nil
+}
+
+func (cc *Conn) freezeOwned() ([]netlink.Message, TransactionIntent, error) {
+	o := cc.owned
+	messages := batch(cloneMessages(cc.messages))
+	messages[0].Header.Flags |= netlink.Acknowledge
+	messages[len(messages)-1].Header.Flags |= netlink.Acknowledge
+	if o.generation != 0 {
+		attrs, err := netlink.MarshalAttributes([]netlink.Attribute{{Type: nfnlBatchGenID, Data: binaryutil.BigEndian.PutUint32(o.generation)}})
+		if err != nil {
+			return nil, TransactionIntent{}, err
+		}
+		messages[0].Data = append(messages[0].Data, attrs...)
+	}
+	intent := TransactionIntent{Birth: o.birth, NamespaceDevice: o.namespaceDevice, NamespaceInode: o.namespaceInode, PortID: o.portID, Generation: o.generation}
+	for i := range messages {
+		m := &messages[i]
+		// Only supported object creates require echo; set-element batches still have
+		// full intent and ACK association and do not invent durable anonymous IDs.
+		op := int(m.Header.Type) & 0xff
+		if int(m.Header.Type)>>8 == unix.NFNL_SUBSYS_NFTABLES && (op == unix.NFT_MSG_NEWTABLE || op == unix.NFT_MSG_NEWCHAIN || op == unix.NFT_MSG_NEWRULE || op == unix.NFT_MSG_NEWSET) {
+			m.Header.Flags |= unix.NLM_F_ECHO
+		}
+		o.sequence++
+		if o.sequence == 0 {
+			return nil, intent, errors.New("owned nft sequence exhausted")
+		}
+		m.Header.Sequence = o.sequence
+		m.Header.PID = o.portID
+		m.Header.Length = uint32(16 + len(m.Data))
+		mi, err := messageIntent(i, *m)
+		if err != nil {
+			return nil, intent, err
+		}
+		intent.Messages = append(intent.Messages, mi)
+	}
+	return messages, intent, nil
+}
+
+func messageIntent(index int, m netlink.Message) (MessageIntent, error) {
+	mi := MessageIntent{Index: index, Header: m.Header}
+	var err error
+	mi.Bytes, err = m.MarshalBinary()
+	if err != nil {
+		return mi, err
+	}
+	if len(m.Data) < 4 {
+		return mi, errors.New("nft message missing nfgen header")
+	}
+	mi.Family = TableFamily(m.Data[0])
+	if m.Header.Type == unix.NFNL_MSG_BATCH_BEGIN || m.Header.Type == unix.NFNL_MSG_BATCH_END {
+		return mi, nil
+	}
+	if int(m.Header.Type)>>8 != unix.NFNL_SUBSYS_NFTABLES {
+		return mi, errors.New("foreign subsystem in nft transaction")
+	}
+	attrs, err := netlink.UnmarshalAttributes(m.Data[4:])
+	if err != nil {
+		return mi, err
+	}
+	op := int(m.Header.Type) & 0xff
+	var table, chain, set, handle uint16
+	switch op {
+	case unix.NFT_MSG_NEWTABLE, unix.NFT_MSG_DELTABLE:
+		table = unix.NFTA_TABLE_NAME
+		handle = nftTableHandle
+	case unix.NFT_MSG_NEWCHAIN, unix.NFT_MSG_DELCHAIN:
+		table = unix.NFTA_CHAIN_TABLE
+		chain = unix.NFTA_CHAIN_NAME
+		handle = unix.NFTA_CHAIN_HANDLE
+	case unix.NFT_MSG_NEWRULE, unix.NFT_MSG_DELRULE:
+		table = unix.NFTA_RULE_TABLE
+		chain = unix.NFTA_RULE_CHAIN
+		handle = unix.NFTA_RULE_HANDLE
+	case unix.NFT_MSG_NEWSET, unix.NFT_MSG_DELSET:
+		table = unix.NFTA_SET_TABLE
+		set = unix.NFTA_SET_NAME
+		handle = nftSetHandle
+	case unix.NFT_MSG_NEWSETELEM, unix.NFT_MSG_DELSETELEM:
+		table = unix.NFTA_SET_ELEM_LIST_TABLE
+		set = unix.NFTA_SET_ELEM_LIST_SET
+	default:
+		return mi, fmt.Errorf("nft operation %d has no audited transaction intent", op)
+	}
+	for _, a := range attrs {
+		typ := a.Type & 0x3fff
+		switch typ {
+		case table:
+			mi.Table = string(bytes.TrimSuffix(a.Data, []byte{0}))
+		case chain:
+			if chain != 0 {
+				mi.Chain = string(bytes.TrimSuffix(a.Data, []byte{0}))
+			}
+		case set:
+			if set != 0 {
+				mi.Set = string(bytes.TrimSuffix(a.Data, []byte{0}))
+			}
+		case handle:
+			if handle != 0 && len(a.Data) == 8 {
+				mi.Handle = binary.BigEndian.Uint64(a.Data)
+			}
+		}
+	}
+	if mi.Table == "" {
+		return mi, errors.New("nft global mutation has no owned parent intent")
+	}
+	return mi, nil
+}
+
+// flushOwned holds cc.mu. The one SendMessages call has no implicit retry.
+func (cc *Conn) flushOwned() (err error) {
+	o := cc.owned
+	messages, intent, err := cc.freezeOwned()
+	receipt := TransactionReceipt{Intent: intent, State: TransactionNotSent}
+	defer func() {
+		receipt.Err = err
+		if receipt.State == TransactionUnknown {
+			o.tainted = true
+		}
+		o.last = cloneReceipt(receipt)
+		o.generation = 0
+		o.journal.Complete(cloneReceipt(receipt))
+	}()
+	if err != nil {
+		return err
+	}
+	if err = o.journal.Prepare(cloneIntent(intent)); err != nil {
+		return err
+	}
+	var total, largestRequest int
+	for _, m := range intent.Messages {
+		total += len(m.Bytes)
+		largestRequest = max(largestRequest, len(m.Bytes))
+	}
+	// Configure and read back the original socket before delivery. The queue
+	// budget does not substitute for the complete observed ACK/echo receipt.
+	if err = o.transport.Buffers(total, largestRequest, len(messages)); err != nil {
+		return err
+	}
+	if err = o.transport.CheckMemberships(); err != nil {
+		return err
+	}
+	if err = o.transport.Deadline(time.Now().Add(o.timeout)); err != nil {
+		return err
+	}
+	defer o.transport.Deadline(time.Time{})
+	if err = o.transport.Send(messages); err != nil {
+		if !errors.Is(err, unix.EMSGSIZE) {
+			receipt.State = TransactionUnknown
+		}
+		return err
+	}
+
+	receipt.Sent = true
+	receipt.State = TransactionUnknown
+	expected := make(map[uint32]int, len(messages))
+	for i, m := range messages {
+		expected[m.Header.Sequence] = i
+	}
+	acked := make([]bool, len(messages))
+	echoed := make([]bool, len(messages))
+	var first error
+	lastACK := -1
+	// This exchange alone grants the requested echo exception. The intent was
+	// frozen before Send and is never recovered from a previous transaction.
+	receiveContext := ownedMutationReceiveContext(intent)
+	for {
+		packet, recvErr := o.transport.Receive(receiveContext)
+		if first == nil && packet.kernelError != nil {
+			first = packet.kernelError
+		}
+		if recvErr != nil {
+			return errors.Join(first, recvErr, ErrUncertain)
+		}
+		if len(receipt.GenerationNotifications)+len(packet.notifications) > 1 {
+			return errors.Join(first, errors.New("duplicate nft generation notification"), ErrUncertain)
+		}
+		receipt.GenerationNotifications = append(receipt.GenerationNotifications, cloneGenerationNotifications(packet.notifications)...)
+		// Validate the whole packet before selecting even a known abort. A GEN
+		// cannot coexist with a kernel failure in this transaction.
+		generationAbort := false
+		for _, reply := range packet.replies {
+			receipt.Replies = append(receipt.Replies, reply)
+			i, ok := expected[reply.Header.Sequence]
+			if !ok || reply.Header.PID != o.portID || reply.Header.Flags&netlink.DumpInterrupted != 0 {
+				return errors.Join(first, errors.New("nft reply has wrong sequence/PID or interrupted dump"), ErrUncertain)
+			}
+			sent := messages[i]
+			if reply.Header.Type == netlink.Error {
+				errno, ackErr := validateACK(reply, sent)
+				if ackErr != nil || acked[i] || i < lastACK {
+					return errors.Join(first, ackErr, errors.New("nft ACK missing, duplicate or out of order"), ErrUncertain)
+				}
+				acked[i] = true
+				lastACK = i
+				if errno != 0 {
+					if first == nil {
+						first = errno
+					}
+					// A validated begin failure is emitted before any batch handler, or
+					// after commit error's abort. ERESTART specifically proves no commit.
+					if i == 0 && errno == unix.ERESTART {
+						generationAbort = true
+					}
+				}
+			} else {
+				if echoed[i] || sent.Header.Flags&unix.NLM_F_ECHO == 0 {
+					return errors.Join(first, errors.New("unexpected/duplicate nft echo"), ErrUncertain)
+				}
+				if err := validateEcho(intent.Messages[i], reply); err != nil {
+					return errors.Join(first, err, ErrUncertain)
+				}
+				echoed[i] = true
+			}
+		}
+		if first != nil && len(receipt.GenerationNotifications) != 0 {
+			return errors.Join(first, errors.New("nft generation notification contradicts kernel error"), ErrUncertain)
+		}
+		if generationAbort {
+			receipt.State = TransactionAborted
+			return errors.Join(first, ErrGenerationChanged)
+		}
+		// The kernel emits END success only after commit. No individual ACK can
+		// publish ownership while END, an expected member ACK or echo is missing.
+		if acked[len(messages)-1] {
+			if first != nil {
+				return errors.Join(first, ErrUncertain)
+			}
+			for i, m := range messages {
+				if !acked[i] || (m.Header.Flags&unix.NLM_F_ECHO != 0 && !echoed[i]) {
+					return errors.Join(errors.New("incomplete nft batch receipt"), ErrUncertain)
+				}
+			}
+			receipt.State = TransactionCommitted
+			return nil
+		}
+		// Linux delivers member errors after the abort and then does not ACK END.
+		// Drain all requested member ACKs to retain full correlation; receipt is
+		// Aborted only for the pinned complete error list, never a recv errno.
+		if first != nil {
+			all := true
+			for i := 0; i < len(messages)-1; i++ {
+				if !acked[i] {
+					all = false
+					break
+				}
+			}
+			if all {
+				receipt.State = TransactionAborted
+				return first
+			}
+		}
+	}
+}
+
+func validateACK(reply, sent netlink.Message) (syscall.Errno, error) {
+	if len(reply.Data) < 20 {
+		return 0, errors.New("short nft ACK")
+	}
+	code := int32(binary.NativeEndian.Uint32(reply.Data[:4]))
+	h := reply.Data[4:20]
+	if binary.NativeEndian.Uint32(h[:4]) != sent.Header.Length || binary.NativeEndian.Uint16(h[4:6]) != uint16(sent.Header.Type) || binary.NativeEndian.Uint16(h[6:8]) != uint16(sent.Header.Flags) || binary.NativeEndian.Uint32(h[8:12]) != sent.Header.Sequence || binary.NativeEndian.Uint32(h[12:16]) != sent.Header.PID {
+		return 0, errors.New("nft ACK embedded request differs from frozen intent")
+	}
+	if code > 0 {
+		return 0, errors.New("positive nft ACK errno")
+	}
+	return syscall.Errno(-code), nil
+}
+func validateEcho(intent MessageIntent, reply netlink.Message) error {
+	echo, err := messageIntent(intent.Index, reply)
+	if err != nil {
+		return err
+	}
+	if reply.Header.Type != intent.Header.Type || echo.Family != intent.Family || echo.Table != intent.Table || echo.Chain != intent.Chain || echo.Set != intent.Set || intent.Handle != 0 && echo.Handle != intent.Handle {
+		return errors.New("nft echo differs in family, parent or handle")
+	}
+	op := int(reply.Header.Type) & 0xff
+	if (op == unix.NFT_MSG_NEWTABLE || op == unix.NFT_MSG_NEWCHAIN || op == unix.NFT_MSG_NEWRULE || op == unix.NFT_MSG_NEWSET) && echo.Handle == 0 {
+		return errors.New("nft object echo has no durable handle")
+	}
+	return nil
+}
+
+type ownedReceiveContext struct {
+	mutation  *TransactionIntent // nil for queries; immutable current frozen intent
+	requested map[uint32]MessageIntent
+}
+
+func ownedMutationReceiveContext(intent TransactionIntent) ownedReceiveContext {
+	frozen := cloneIntent(intent)
+	context := ownedReceiveContext{mutation: &frozen, requested: make(map[uint32]MessageIntent, len(frozen.Messages))}
+	for _, message := range frozen.Messages {
+		context.requested[message.Header.Sequence] = message
+	}
+	return context
+}
+
+func (o *ownedState) receiveRaw(context ownedReceiveContext) (ownedReceivePacket, error) {
+	var size int
+	var recvErr error
+	err := o.raw.Read(func(fd uintptr) bool {
+		size, _, _, _, recvErr = unix.Recvmsg(int(fd), nil, nil, unix.MSG_PEEK|unix.MSG_TRUNC|unix.MSG_DONTWAIT)
+		return recvErr != unix.EAGAIN && recvErr != unix.EWOULDBLOCK
+	})
+	if err != nil {
+		return ownedReceivePacket{}, err
+	}
+	if recvErr != nil {
+		return ownedReceivePacket{}, recvErr
+	}
+	if size <= 0 || size > 4<<20 {
+		return ownedReceivePacket{}, errors.New("nft datagram exceeds bounded receive budget")
+	}
+	buf := make([]byte, size)
+	var n, flags int
+	var from unix.Sockaddr
+	err = o.raw.Read(func(fd uintptr) bool {
+		n, _, flags, from, recvErr = unix.Recvmsg(int(fd), buf, nil, unix.MSG_DONTWAIT)
+		return recvErr != unix.EAGAIN && recvErr != unix.EWOULDBLOCK
+	})
+	if err != nil {
+		return ownedReceivePacket{}, err
+	}
+	if recvErr != nil {
+		return ownedReceivePacket{}, recvErr
+	}
+	return decodeOwnedReceivePacket(buf[:n], flags, from, context)
+}
+func decodeOwnedDatagram(buf []byte, flags int, from unix.Sockaddr) ([]netlink.Message, error) {
+	return decodeOwnedDatagramContext(buf, flags, from, ownedReceiveContext{})
+}
+func decodeOwnedDatagramContext(buf []byte, flags int, from unix.Sockaddr, context ownedReceiveContext) ([]netlink.Message, error) {
+	packet, err := decodeOwnedReceivePacket(buf, flags, from, context)
+	return packet.replies, err
+}
+
+// Record the rejected receive without changing peer acceptance. Headers are
+// untrusted diagnostic data, never an ACK/echo receipt or authority to retry.
+func rejectedOwnedSender(buf []byte, flags int, from unix.Sockaddr) error {
+	return rejectedOwnedDatagram("nft datagram sender is not the unicast kernel", buf, flags, from)
+}
+
+func rejectedOwnedDatagram(reason string, buf []byte, flags int, from unix.Sockaddr) error {
+	pid, groups := "unavailable", "unavailable"
+	if sender, ok := from.(*unix.SockaddrNetlink); ok && sender != nil {
+		pid, groups = fmt.Sprint(sender.Pid), fmt.Sprint(sender.Groups)
+	}
+	parsed, parseErr := syscall.ParseNetlinkMessage(buf)
+	// Bound only the rejected receive's diagnostic text; the wire receive and
+	// all accepted message validation keep their existing limits and behavior.
+	headers := make([]syscall.NlMsghdr, min(len(parsed), 8))
+	for i := range headers {
+		headers[i] = parsed[i].Header
+	}
+	return fmt.Errorf("%s: from_type=%T from_pid=%s from_groups=%s recvmsg_flags=%#x datagram_bytes=%d datagram_sha256=%x header_count=%d headers=%+v header_parse_error=%v", reason, from, pid, groups, flags, len(buf), sha256.Sum256(buf), len(parsed), headers, parseErr)
+}
+
+// PendingBytes includes framing. It lets complete builders use an actual
+// encoded-byte budget rather than an element-count proxy.
+func (cc *Conn) PendingBytes() (int, error) {
+	cc.mu.Lock()
+	defer cc.mu.Unlock()
+	if cc.sealed {
+		return 0, ErrSealed
+	}
+	if cc.err != nil {
+		return 0, cc.err
+	}
+	size := 40
+	if cc.owned != nil && cc.owned.generation != 0 {
+		size += 8
+	}
+	for _, m := range cc.messages {
+		m.Header.Length = uint32(16 + len(m.Data))
+		b, err := m.MarshalBinary()
+		if err != nil {
+			return 0, err
+		}
+		size += len(b)
+	}
+	return size, nil
+}
+
+// SetElementBytes uses exactly the same serializer as SetAddElements.
+func SetElementBytes(s *Set, values []SetElement) (int, error) {
+	attrs, err := s.makeElemList(values, s.ID)
+	if err != nil {
+		return 0, err
+	}
+	b, err := netlink.MarshalAttributes(attrs)
+	return 20 + len(b), err
+}
+
+// DiscardPending discards an unsent builder queue. It never retries a receipt.
+func (cc *Conn) DiscardPending() {
+	cc.mu.Lock()
+	defer cc.mu.Unlock()
+	cc.messages = nil
+	cc.err = nil
+	if cc.owned != nil {
+		cc.owned.generation = 0
+	}
+}
+
+// This is the actual transport injection seam. Production always installs the
+// sender-aware raw receiver; no exported option accepts caller wire bytes.
+type ownedTransport interface {
+	Send([]netlink.Message) error
+	Receive(ownedReceiveContext) (ownedReceivePacket, error)
+	CheckMemberships() error
+	Buffers(wireBytes, largestRequestBytes, messageCount int) error
+	Deadline(time.Time) error
+}
+type ownedNetlinkTransport struct {
+	conn  *netlink.Conn
+	state *ownedState
+}
+
+func (t *ownedNetlinkTransport) Send(messages []netlink.Message) error {
+	_, err := t.conn.SendMessages(messages)
+	return err
+}
+func (t *ownedNetlinkTransport) Receive(context ownedReceiveContext) (ownedReceivePacket, error) {
+	return t.state.receiveRaw(context)
+}
+func (t *ownedNetlinkTransport) CheckMemberships() error { return t.state.checkMemberships() }
+func (t *ownedNetlinkTransport) Deadline(deadline time.Time) error {
+	return t.conn.SetReadDeadline(deadline)
+}
+
+// The lower bounds below are observable wire requirements, not estimates of
+// skb truesize. A sufficient value never proves receipt completion: ENOBUFS
+// after Send still permanently taints the connection and is never replayed.
+const ownedReceiveBufferTarget = 4 << 20
+
+type ownedBufferSocket interface {
+	ReadBuffer() (int, error)
+	WriteBuffer() (int, error)
+	SetReadBuffer(int) error
+	SetWriteBuffer(int) error
+}
+
+func (t *ownedNetlinkTransport) ReadBuffer() (int, error)  { return t.conn.ReadBuffer() }
+func (t *ownedNetlinkTransport) WriteBuffer() (int, error) { return t.conn.WriteBuffer() }
+func (t *ownedNetlinkTransport) SetReadBuffer(size int) error {
+	return t.setBuffer(unix.SO_RCVBUF, size)
+}
+func (t *ownedNetlinkTransport) SetWriteBuffer(size int) error {
+	return t.setBuffer(unix.SO_SNDBUF, size)
+}
+func (t *ownedNetlinkTransport) setBuffer(option, size int) error {
+	var socketErr error
+	err := t.state.raw.Control(func(fd uintptr) {
+		// The dependency's setters try SO_*BUFFORCE first. Owned transports
+		// use only the normal bounded options on their original socket.
+		socketErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, option, size)
+	})
+	if err != nil {
+		return err
+	}
+	return socketErr
+}
+func (t *ownedNetlinkTransport) Buffers(total, largestRequest, count int) error {
+	return configureOwnedBuffers(t, total, largestRequest, count)
+}
+func configureOwnedBuffers(socket ownedBufferSocket, total, largestRequest, count int) error {
+	maxInt := int(^uint(0) >> 1)
+	if total < 20 || largestRequest < 20 || largestRequest > total || total > maxInt-64 || count < 1 || count > maxInt/36 {
+		return errors.New("invalid nft socket buffer requirements")
+	}
+	readSize, err := socket.ReadBuffer()
+	if err != nil {
+		return err
+	}
+	writeSize, err := socket.WriteBuffer()
+	if err != nil {
+		return err
+	}
+	// An uncapped error ACK includes its complete original request plus the
+	// outer netlink header and errno. Every requested ACK is at least 36 bytes.
+	// Use the largest individual request, not the sum of unrelated payloads.
+	minimumRead := max(largestRequest+20, count*36)
+	beforeRead, beforeWrite := readSize, writeSize
+	if readSize < minimumRead {
+		if err := socket.SetReadBuffer(ownedReceiveBufferTarget); err != nil {
+			return err
+		}
+		readSize, err = socket.ReadBuffer()
+		if err != nil {
+			return err
+		}
+	}
+	if readSize < beforeRead || readSize < minimumRead {
+		return fmt.Errorf("nft actual receive buffer is insufficient: before=%d actual=%d minimum-wire=%d target=%d", beforeRead, readSize, minimumRead, ownedReceiveBufferTarget)
+	}
+	if writeSize < total+32 {
+		if err := socket.SetWriteBuffer(total + 64); err != nil {
+			return err
+		}
+		writeSize, err = socket.WriteBuffer()
+		if err != nil {
+			return err
+		}
+	}
+	if writeSize < beforeWrite || writeSize < total+32 {
+		return fmt.Errorf("nft encoded batch exceeds actual send buffer: wire=%d before=%d actual=%d", total, beforeWrite, writeSize)
+	}
+	return nil
+}
+
+// ConfirmedObjects returns kernel handles only after the full commit receipt.
+func (r TransactionReceipt) ConfirmedObjects() (*ConsistentSnapshot, error) {
+	if r.State != TransactionCommitted {
+		return nil, ErrUncertain
+	}
+	out := &ConsistentSnapshot{}
+	for _, m := range r.Replies {
+		if int(m.Header.Type)>>8 != unix.NFNL_SUBSYS_NFTABLES {
+			continue
+		}
+		switch int(m.Header.Type) & 0xff {
+		case unix.NFT_MSG_NEWTABLE:
+			t, e := tableFromMsg(m)
+			if e != nil {
+				return nil, e
+			}
+			out.Tables = append(out.Tables, t)
+		case unix.NFT_MSG_NEWCHAIN:
+			c, e := chainFromMsg(m)
+			if e != nil {
+				return nil, e
+			}
+			out.Chains = append(out.Chains, c)
+		case unix.NFT_MSG_NEWRULE:
+			r, e := ruleFromMsg(TableFamily(m.Data[0]), m)
+			if e != nil {
+				return nil, e
+			}
+			out.Rules = append(out.Rules, r)
+		case unix.NFT_MSG_NEWSET:
+			s, e := setsFromMsg(m)
+			if e != nil {
+				return nil, e
+			}
+			out.Sets = append(out.Sets, s)
+		}
+	}
+	return out, nil
+}
