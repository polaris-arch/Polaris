+type bufferSocketResult struct {
+	read, write                 int
+	readLimit, writeLimit       int
+	readCalls, writeCalls       int
+	readFailAt, writeFailAt     int
+	readSetErr, writeSetErr     error
+	readRequests, writeRequests []int
+}
+
+func (s *bufferSocketResult) ReadBuffer() (int, error) {
+	s.readCalls++
+	if s.readCalls == s.readFailAt {
+		return 0, unix.EBADF
+	}
+	return s.read, nil
+}
+func (s *bufferSocketResult) WriteBuffer() (int, error) {
+	s.writeCalls++
+	if s.writeCalls == s.writeFailAt {
+		return 0, unix.EBADF
+	}
+	return s.write, nil
+}
+func (s *bufferSocketResult) SetReadBuffer(size int) error {
+	s.readRequests = append(s.readRequests, size)
+	if s.readSetErr != nil {
+		return s.readSetErr
+	}
+	s.read = min(size*2, s.readLimit)
+	return nil
+}
+func (s *bufferSocketResult) SetWriteBuffer(size int) error {
+	s.writeRequests = append(s.writeRequests, size)
+	if s.writeSetErr != nil {
+		return s.writeSetErr
+	}
+	s.write = min(size*2, s.writeLimit)
+	return nil
+}
+func TestOwnedBuffersPreserveDefault(t *testing.T) {
+	for _, size := range []int{212992, 16 << 20} {
+		socket := &bufferSocketResult{read: size, write: size}
+		if err := configureOwnedBuffers(socket, 124, 84, 3); err != nil {
+			t.Fatal(err)
+		}
+		if socket.read != size || socket.write != size || len(socket.readRequests)+len(socket.writeRequests) != 0 {
+			t.Fatal("an adequate original/default buffer was set or reduced")
+		}
+	}
+}
+func TestOwnedBuffersKernelClampMayMeetActualMinimum(t *testing.T) {
+	socket := &bufferSocketResult{read: 64, write: 128, readLimit: 425984, writeLimit: 425984}
+	if err := configureOwnedBuffers(socket, 124, 84, 3); err != nil {
+		t.Fatal(err)
+	}
+	if socket.read >= ownedReceiveBufferTarget || socket.read < 108 || socket.readCalls != 2 || socket.writeCalls != 2 {
+		t.Fatal("clamped actual buffer was rejected or not read back")
+	}
+	if len(socket.readRequests) != 1 || socket.readRequests[0] != ownedReceiveBufferTarget {
+		t.Fatal("receive expansion was not bounded")
+	}
+}
