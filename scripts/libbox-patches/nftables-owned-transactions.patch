+
+func queryReplies(request netlink.Message, generation uint32) []netlink.Message {
+	if int(request.Header.Type)&0xff == unix.NFT_MSG_GETGEN {
+		attrs, _ := netlink.MarshalAttributes([]netlink.Attribute{{Type: nftGenID, Data: binaryutil.BigEndian.PutUint32(generation)}})
+		return []netlink.Message{{Header: netlink.Header{Type: request.Header.Type - 1, Sequence: request.Header.Sequence, PID: request.Header.PID}, Data: append(extraHeader(0, 0), attrs...)}, ack(request, 0)}
+	}
+	return []netlink.Message{{Header: netlink.Header{Type: netlink.Done, Sequence: request.Header.Sequence, PID: request.Header.PID}, Data: make([]byte, 4)}}
+}
+
+func TestOwnedConsistentSnapshotUsesCompleteGeneration(t *testing.T) {
+	for _, change := range []bool{false, true} {
+		t.Run(fmt.Sprint(change), func(t *testing.T) {
+			c, tr, _ := testOwnedConn(t)
+			genReads := 0
+			tr.onSend = func(m []netlink.Message) [][]netlink.Message {
+				generation := uint32(0xfedcba98)
+				if int(m[0].Header.Type)&0xff == unix.NFT_MSG_GETGEN {
+					genReads++
+					if change && genReads == 2 {
+						generation++
+					}
+				}
+				return [][]netlink.Message{queryReplies(m[0], generation)}
+			}
+			snapshot, err := c.ReadConsistentTable(&Table{Name: "own", Family: TableFamilyINet})
+			if change {
+				if snapshot != nil || !errors.Is(err, ErrGenerationChanged) || c.owned.tainted {
+					t.Fatalf("generation mismatch claimed snapshot or corrupted socket: %+v %v", snapshot, err)
+				}
+			} else if err != nil || snapshot.Generation != 0xfedcba98 {
+				t.Fatalf("GENID lost bits: %+v %v", snapshot, err)
+			}
+			if len(tr.sent) != 6 {
+				t.Fatalf("missing before/dumps/after: %d", len(tr.sent))
+			}
+		})
+	}
+}
+
+func TestOwnedCorruptedObservationTaintsSocketWithoutReplay(t *testing.T) {
+	for _, fault := range []string{"genid-short", "genid-duplicate-zero", "wrong-type", "filtered-rule-parent", "filtered-set-parent", "malformed-family-table", "malformed-family-chain", "malformed-family-chain-hook", "dump-interrupted", "dump-missing-end", "dump-enobufs"} {
+		t.Run(fault, func(t *testing.T) {
+			c, tr, _ := testOwnedConn(t)
+			tr.onSend = func(m []netlink.Message) [][]netlink.Message {
+				request := m[0]
+				replies := queryReplies(request, 0xfedcba98)
+				if int(request.Header.Type)&0xff == unix.NFT_MSG_GETGEN {
+					switch fault {
+					case "genid-short":
+						replies[0].Data = []byte{0, 0, 0, 0, 1}
+					case "genid-duplicate-zero":
+						attrs, _ := netlink.MarshalAttributes([]netlink.Attribute{{Type: nftGenID, Data: make([]byte, 4)}, {Type: nftGenID, Data: binaryutil.BigEndian.PutUint32(7)}})
+						replies[0].Data = append(extraHeader(0, 0), attrs...)
+					case "wrong-type":
+						replies[0].Header.Type++
+					}
+				} else {
+					switch fault {
+					case "filtered-rule-parent":
+						if int(request.Header.Type)&0xff == unix.NFT_MSG_GETRULE {
+							replies = append([]netlink.Message{dumpObject(request, "foreign", "chain")}, replies...)
+						}
+					case "filtered-set-parent":
+						if int(request.Header.Type)&0xff == unix.NFT_MSG_GETSET {
+							replies = append([]netlink.Message{dumpObject(request, "foreign", "set")}, replies...)
+						}
+					case "malformed-family-table", "malformed-family-chain":
+						op := unix.NFT_MSG_GETTABLE
+						if fault == "malformed-family-chain" {
+							op = unix.NFT_MSG_GETCHAIN
+						}
+						if int(request.Header.Type)&0xff == op {
+							object := dumpObject(request, "foreign", "foreign-child")
+							object.Data = append(object.Data, 1)
+							replies = append([]netlink.Message{object}, replies...)
+						}
+					case "malformed-family-chain-hook":
+						if int(request.Header.Type)&0xff == unix.NFT_MSG_GETCHAIN {
+							object := dumpObject(request, "foreign", "foreign-child")
+							attrs, _ := netlink.MarshalAttributes([]netlink.Attribute{{Type: unix.NFTA_CHAIN_HOOK | unix.NLA_F_NESTED, Data: []byte{1}}})
+							object.Data = append(object.Data, attrs...)
+							replies = append([]netlink.Message{object}, replies...)
+						}
+					case "dump-interrupted":
+						replies[0].Header.Flags |= netlink.DumpInterrupted
+					case "dump-missing-end":
+						return nil
+					case "dump-enobufs":
+						tr.receiveErr = unix.ENOBUFS
+						return nil
+					}
+				}
+				return [][]netlink.Message{replies}
+			}
+			if snapshot, err := c.ReadConsistentTable(&Table{Name: "own", Family: TableFamilyINet}); snapshot != nil || !errors.Is(err, ErrUncertain) {
+				t.Fatalf("invalid snapshot accepted: %+v %v", snapshot, err)
+			}
+			attempts := len(tr.sent)
+			if _, err := c.Generation(); !errors.Is(err, ErrUncertain) {
+				t.Fatal("uncertain observation did not seal later query")
+			}
+			c.CreateTable(&Table{Name: "own", Family: TableFamilyINet})
+			if err := c.Flush(); !errors.Is(err, ErrUncertain) || len(tr.sent) != attempts {
+				t.Fatal("uncertain query replayed or permitted a later mutation")
+			}
+		})
+	}
+}
+
+func dumpObject(request netlink.Message, table, name string) netlink.Message {
+	attrs := []netlink.Attribute{{Type: 1, Data: []byte(table + "\x00")}}
+	switch int(request.Header.Type) & 0xff {
+	case unix.NFT_MSG_GETTABLE:
+		attrs = append(attrs, netlink.Attribute{Type: nftTableHandle, Data: binaryutil.BigEndian.PutUint64(101)})
+	case unix.NFT_MSG_GETCHAIN:
+		attrs = append(attrs, netlink.Attribute{Type: unix.NFTA_CHAIN_NAME, Data: []byte(name + "\x00")}, netlink.Attribute{Type: unix.NFTA_CHAIN_HANDLE, Data: binaryutil.BigEndian.PutUint64(201)})
+	case unix.NFT_MSG_GETRULE:
+		attrs = append(attrs, netlink.Attribute{Type: unix.NFTA_RULE_CHAIN, Data: []byte(name + "\x00")}, netlink.Attribute{Type: unix.NFTA_RULE_HANDLE, Data: binaryutil.BigEndian.PutUint64(301)})
+	case unix.NFT_MSG_GETSET:
+		attrs = append(attrs, netlink.Attribute{Type: unix.NFTA_SET_NAME, Data: []byte(name + "\x00")}, netlink.Attribute{Type: nftSetHandle, Data: binaryutil.BigEndian.PutUint64(401)})
+	}
+	data, _ := netlink.MarshalAttributes(attrs)
+	return netlink.Message{Header: netlink.Header{Type: request.Header.Type - 1, Flags: netlink.Multi, Sequence: request.Header.Sequence, PID: request.Header.PID}, Data: append(extraHeader(byte(TableFamilyINet), 0), data...)}
+}
+
+func TestOwnedFamilyDumpSelectsTargetAfterValidatingAllObjects(t *testing.T) {
+	for _, target := range []string{"own", ""} {
+		t.Run(target, func(t *testing.T) {
+			c, tr, _ := testOwnedConn(t)
+			tr.onSend = func(messages []netlink.Message) [][]netlink.Message {
+				request := messages[0]
+				replies := queryReplies(request, 0xfedcba98)
+				op := int(request.Header.Type) & 0xff
+				if op == unix.NFT_MSG_GETTABLE || op == unix.NFT_MSG_GETCHAIN {
+					if attrs, err := netlink.UnmarshalAttributes(request.Data[4:]); err != nil || len(attrs) != 0 {
+						t.Fatal("family-wide dump pretended to have a table filter")
+					}
+					replies = append([]netlink.Message{dumpObject(request, "own", "own-chain"), dumpObject(request, "coexisting", "foreign-chain")}, replies...)
+				}
+				return [][]netlink.Message{replies}
+			}
+			snapshot, err := c.readConsistent(TableFamilyINet, target)
+			if err != nil || c.owned.tainted || snapshot.Generation != 0xfedcba98 {
+				t.Fatalf("valid coexisting family dump poisoned transport: %+v %v", snapshot, err)
+			}
+			want := 1
+			if target == "" {
+				want = 2
+			}
+			if len(snapshot.Tables) != want || len(snapshot.Chains) != want || snapshot.Tables[0].Name != "own" || snapshot.Chains[0].Table.Name != "own" {
+				t.Fatalf("incorrect family selection: %+v", snapshot)
+			}
+			if _, err = c.Generation(); err != nil {
+				t.Fatal("valid family dump tainted next query")
+			}
+		})
+	}
+}
