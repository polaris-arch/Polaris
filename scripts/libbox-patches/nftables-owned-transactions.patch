+func TestOwnedKernelT2(t *testing.T) {
+	fd, j := kernelNamespace(t)
+	a := kernelConn(t, fd, "native-a", j)
+	b := kernelConn(t, fd, "native-b", j)
+	var table, shared *Table
+	if !t.Run("owner_create_exclusive_and_foreign_denial", func(t *testing.T) {
+		table = kernelOwnerTable(t, a, "polaris_native_owner_a")
+		b.CreateTable(&Table{Name: table.Name, Family: table.Family, Flags: TableFlagOwner})
+		if err := b.Flush(); err == nil {
+			t.Fatal("exclusive collision succeeded")
+		}
+		if b.LastTransaction().State != TransactionAborted {
+			t.Fatal("EXCL rejection did not produce a complete abort")
+		}
+		b.AddChain(&Chain{Name: "foreign", Table: table})
+		if err := b.Flush(); err == nil {
+			t.Fatal("foreign socket modified owner table")
+		}
+		b.DelTable(table)
+		if err := b.Flush(); err == nil {
+			t.Fatal("foreign socket deleted owner table")
+		}
+	}) {
+		return
+	}
+	if !t.Run("stale_generation_aborts_without_effect", func(t *testing.T) {
+		generation, err := a.Generation()
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = kernelOwnerTable(t, b, "polaris_native_owner_b")
+		a.CreateTable(&Table{Name: "polaris_native_stale_generation", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+		if err = a.UseGeneration(generation); err != nil {
+			t.Fatal(err)
+		}
+		if err = a.Flush(); !errors.Is(err, ErrGenerationChanged) || !errors.Is(err, unix.ERESTART) {
+			t.Fatalf("stale GENID did not abort: %v", err)
+		}
+		snapshot, err := a.ReadConsistent(TableFamilyIPv4)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, it := range snapshot.Tables {
+			if it.Name == "polaris_native_stale_generation" {
+				t.Fatal("GENID-mismatched batch created a table")
+			}
+		}
+	}) {
+		return
+	}
+	if !t.Run("nonrecursive_delete_preserves_foreign_child", func(t *testing.T) {
+		var err error
+		shared = a.CreateTable(&Table{Name: "polaris_native_nonrec", Family: TableFamilyIPv4})
+		if err = a.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		b.AddChain(&Chain{Name: "foreign_child", Table: shared})
+		if err = b.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		observed, err := a.ReadConsistentTable(shared)
+		if err != nil {
+			t.Fatal(err)
+		}
+		a.DelTableNonRecursive(shared)
+		if err = a.UseGeneration(observed.Generation); err != nil {
+			t.Fatal(err)
+		}
+		if err = a.Flush(); !errors.Is(err, unix.EBUSY) {
+			t.Fatalf("NONREC did not preserve foreign child: %v", err)
+		}
+	}) {
+		return
+	}
+	if !t.Run("original_socket_retirement_and_permanent_seal", func(t *testing.T) {
+		var err error
+		if err = a.CloseLasting(); err != nil {
+			t.Fatal(err)
+		}
+		// The observer is bound to the same pinned namespace. Socket retirement may
+		// remove only A's non-PERSIST owner table; B's table and shared parent remain.
+		remaining, err := b.ReadConsistent(TableFamilyIPv4)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var seenB, seenShared bool
+		for _, it := range remaining.Tables {
+			if it.Name == table.Name {
+				t.Fatal("closed owner socket retained its table")
+			}
+			seenB = seenB || it.Name == "polaris_native_owner_b"
+			seenShared = seenShared || it.Name == shared.Name
+		}
+		if !seenB || !seenShared {
+			t.Fatal("A retirement removed another permission domain")
+		}
+		if err = a.Flush(); !errors.Is(err, ErrSealed) {
+			t.Fatal("closed connection reopened")
+		}
+	}) {
+		return
+	}
+}
+
+func TestOwnedKernelT3(t *testing.T) {
+	fd, j := kernelNamespace(t)
+	c := kernelConn(t, fd, "native-t3", j)
+	table := kernelOwnerTable(t, c, "polaris_native_t3")
+	for _, count := range []int{0, 1000, 1001} {
+		if !t.Run(fmt.Sprintf("constant_%d_unbound_fill_then_bound_rejection", count), func(t *testing.T) {
+			set := &Set{Table: table, ID: uint32(200 + count), Name: fmt.Sprintf("constant_%d", count), Constant: true, KeyType: TypeIPAddr}
+			c.AddChain(&Chain{Name: fmt.Sprintf("preceding_%d", count), Table: table})
+			if err := c.AddSet(set, nil); err != nil {
+				t.Fatal(err)
+			}
+			elements := make([]SetElement, count)
+			addr := netip.MustParseAddr("10.17.0.1")
+			for i := range elements {
+				elements[i] = SetElement{Key: addr.AsSlice()}
+				addr = addr.Next()
+			}
+			for start := 0; start < len(elements); start += 1000 {
+				end := min(start+1000, len(elements))
+				if err := c.SetAddElements(set, elements[start:end]); err != nil {
+					t.Fatal(err)
+				}
+				if err := c.Flush(); err != nil {
+					t.Fatalf("unbound constant count=%d chunk=%d: %v", count, start, err)
+				}
+			}
+			if err := c.Flush(); err != nil {
+				t.Fatal(err)
+			}
+			got, _, err := c.ReadConsistentElements(set)
+			if err != nil || len(got) != count {
+				t.Fatalf("count=%d actual=%d err=%v", count, len(got), err)
+			}
+			chain := &Chain{Name: fmt.Sprintf("preceding_%d", count), Table: table}
+			c.AddRule(&Rule{Table: table, Chain: chain, Exprs: []expr.Any{&expr.Meta{Key: expr.MetaKeyMARK, Register: 1}, &expr.Lookup{SourceRegister: 1, SetName: set.Name}, &expr.Verdict{Kind: expr.VerdictReturn}}})
+			if err := c.Flush(); err != nil {
+				t.Fatal(err)
+			}
+			if err := c.SetAddElements(set, []SetElement{{Key: netip.MustParseAddr("10.99.0.1").AsSlice()}}); err != nil {
+				t.Fatal(err)
+			}
+			if err := c.Flush(); err == nil {
+				t.Fatal("bound Constant accepted a late element")
+			}
+		}) {
+			return
+		}
+	}
+	if !t.Run("anonymous_set_and_lookup_same_batch", func(t *testing.T) {
+		chain := c.AddChain(&Chain{Name: "anonymous", Table: table})
+		anonymous := &Set{Table: table, Anonymous: true, Constant: true, KeyType: TypeInetProto}
+		if err := c.AddSet(anonymous, []SetElement{{Key: []byte{unix.IPPROTO_TCP}}, {Key: []byte{unix.IPPROTO_UDP}}}); err != nil {
+			t.Fatal(err)
+		}
+		c.AddRule(&Rule{Table: table, Chain: chain, Exprs: []expr.Any{&expr.Meta{Key: expr.MetaKeyL4PROTO, Register: 1}, &expr.Lookup{SourceRegister: 1, SetID: anonymous.ID, SetName: anonymous.Name}, &expr.Verdict{Kind: expr.VerdictReturn}}})
+		if err := c.Flush(); err != nil {
+			t.Fatalf("anonymous + lookup same batch: %v", err)
+		}
+	}) {
+		return
+	}
+
+	t.Run("interval_pair_complete", func(t *testing.T) {
+		interval := &Set{Table: table, ID: 77, Name: "paired_interval", Constant: true, Interval: true, KeyType: TypeIPAddr}
+		if err := c.AddSet(interval, nil); err != nil {
+			t.Fatal(err)
+		}
+		if err := c.SetAddElements(interval, []SetElement{{Key: netip.MustParseAddr("10.28.0.0").AsSlice()}, {Key: netip.MustParseAddr("10.28.1.0").AsSlice(), IntervalEnd: true}}); err != nil {
+			t.Fatal(err)
+		}
+		if err := c.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		elements, _, err := c.ReadConsistentElements(interval)
+		if err != nil || len(elements) != 2 || !elements[1].IntervalEnd {
+			t.Fatalf("interval pair not complete: %+v %v", elements, err)
+		}
+	})
+}
diff --git a/owned_membership.go b/owned_membership.go
new file mode 100644
index 0000000..72459e7
--- /dev/null
+++ b/owned_membership.go
@@ -0,0 +1,58 @@
+package nftables
+
+import (
+	"errors"
+	"fmt"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+// The probe and full read use the same original fd under one Control call.
+// NETLINK_LIST_MEMBERSHIPS returns native-endian u32 bitmasks, not group IDs.
+func (o *ownedState) checkMemberships() error {
+	var socketErr error
+	err := o.raw.Control(func(fd uintptr) {
+		socketErr = checkOwnedMemberships(func(words []uint32, length *uint32) error {
+			var value unsafe.Pointer
+			if len(words) != 0 {
+				value = unsafe.Pointer(&words[0])
+			}
+			_, _, errno := unix.Syscall6(unix.SYS_GETSOCKOPT, fd, unix.SOL_NETLINK, unix.NETLINK_LIST_MEMBERSHIPS, uintptr(value), uintptr(unsafe.Pointer(length)), 0)
+			if errno != 0 {
+				return errno
+			}
+			return nil
+		})
+	})
+	if err != nil {
+		return err
+	}
+	return socketErr
+}
+
+func checkOwnedMemberships(read func([]uint32, *uint32) error) error {
+	var required uint32
+	if err := read(nil, &required); err != nil {
+		return fmt.Errorf("nft membership size probe: %w", err)
+	}
+	// socklen is passed to a kernel int, and the full byte count must fit int
+	// on this architecture. These are representation checks, not a group cap.
+	if required%4 != 0 || uint64(required) > uint64(^uint(0)>>1) || required > uint32(^uint32(0)>>1) {
+		return errors.New("nft membership size is not a representable u32 mask array")
+	}
+	words := make([]uint32, int(required)/4)
+	actual := required
+	if err := read(words, &actual); err != nil {
+		return fmt.Errorf("nft full membership read: %w", err)
+	}
+	if actual != required {
+		return fmt.Errorf("nft membership read changed length: required=%d actual=%d", required, actual)
+	}
+	for index, mask := range words {
+		if mask != 0 {
+			return fmt.Errorf("owned nft socket has a subscription: word=%d mask=%#x", index, mask)
+		}
+	}
+	return nil
+}
diff --git a/owned_membership_test.go b/owned_membership_test.go
new file mode 100644
index 0000000..0d4d888
--- /dev/null
+++ b/owned_membership_test.go
@@ -0,0 +1,155 @@
+package nftables
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/mdlayher/netlink"
+	"golang.org/x/sys/unix"
+)
+
+type membershipReadResult struct {
+	required, actual  uint32
+	masks             []uint32
+	probeErr, readErr error
+	calls             int
+}
+
+func (r *membershipReadResult) read(words []uint32, length *uint32) error {
+	r.calls++
+	if r.calls == 1 {
+		if len(words) != 0 || *length != 0 {
+			return errors.New("bad membership size probe")
+		}
+		*length = r.required
+		return r.probeErr
+	}
+	if r.calls != 2 || len(words) != int(r.required)/4 || *length != r.required {
+		return errors.New("unexpected membership full read or retry")
+	}
+	copy(words, r.masks)
+	*length = r.actual
+	return r.readErr
+}
+func TestOwnedMembershipFullRead(t *testing.T) {
+	cases := []struct {
+		name string
+		r    membershipReadResult
+		want bool
+	}{
+		{"fresh-zero-length", membershipReadResult{}, true},
+		{"multiple-zero-masks", membershipReadResult{required: 16, actual: 16, masks: make([]uint32, 4)}, true},
+		{"large-zero-array-no-cap", membershipReadResult{required: 4 * (65536 + 1), actual: 4 * (65536 + 1), masks: make([]uint32, 65536+1)}, true},
+		{"low-subscription", membershipReadResult{required: 4, actual: 4, masks: []uint32{64}}, false},
+		{"high-subscription", membershipReadResult{required: 16, actual: 16, masks: []uint32{0, 0, 0, 1 << 31}}, false},
+		{"size-probe-error", membershipReadResult{probeErr: unix.EBADF}, false},
+		{"full-read-error", membershipReadResult{required: 4, actual: 4, readErr: unix.EPERM}, false},
+		{"unaligned-length", membershipReadResult{required: 3}, false},
+		{"kernel-int-overflow", membershipReadResult{required: 0x80000000}, false},
+		{"larger-readback", membershipReadResult{required: 4, actual: 8}, false},
+		{"smaller-readback", membershipReadResult{required: 8, actual: 4}, false},
+		{"nonzero-after-zero-probe", membershipReadResult{actual: 4}, false},
+	}
+	for _, item := range cases {
+		t.Run(item.name, func(t *testing.T) {
+			err := checkOwnedMemberships(item.r.read)
+			if (err == nil) != item.want {
+				t.Fatal("membership completeness predicate wrong", err)
+			}
+			if item.r.calls > 2 || item.want && item.r.calls != 2 {
+				t.Fatal("membership read used retries or omitted full read")
+			}
+			if item.r.probeErr != nil && !errors.Is(err, item.r.probeErr) || item.r.readErr != nil && !errors.Is(err, item.r.readErr) {
+				t.Fatal("original membership errno lost", err)
+			}
+		})
+	}
+}
+func TestOwnedMembershipFailureBeforeMutationAndQuerySend(t *testing.T) {
+	for _, query := range []bool{false, true} {
+		for _, which := range []string{"subscription", "probe", "readback"} {
+			t.Run(fmt.Sprintf("query%v_%s", query, which), func(t *testing.T) {
+				c, tr, j := testOwnedConn(t)
+				c.CreateTable(&Table{Name: "confirmed", Family: TableFamilyIPv4})
+				if err := c.Flush(); err != nil {
+					t.Fatal(err)
+				}
+				before := c.LastTransaction()
+				r := membershipReadResult{required: 16, actual: 16, masks: []uint32{0, 0, 0, 1}}
+				if which == "probe" {
+					r.probeErr = unix.EBADF
+				}
+				if which == "readback" {
+					r.masks = nil
+					r.actual = 20
+				}
+				tr.membershipFunc = func() error { return checkOwnedMemberships(r.read) }
+				var err error
+				if query {
+					_, err = c.Generation()
+				} else {
+					c.CreateTable(&Table{Name: "attempt", Family: TableFamilyIPv4})
+					err = c.Flush()
+				}
+				if err == nil || errors.Is(err, ErrUncertain) || c.owned.tainted || len(tr.sent) != 1 {
+					t.Fatal("membership preflight sent, tainted, or replayed", err)
+				}
+				if query {
+					after := c.LastTransaction()
+					if after.State != TransactionCommitted || after.Intent.Messages[1].Table != before.Intent.Messages[1].Table || len(j.completed) != 1 {
+						t.Fatal("query preflight rewrote historical confirmation")
+					}
+				} else if last := c.LastTransaction(); last.State != TransactionNotSent || last.Sent || len(j.completed) != 2 {
+					t.Fatal("mutation preflight was not journaled NotSent")
+				}
+			})
+		}
+	}
+}
+
+func TestOwnedMembershipEverySendUsesFreshRead(t *testing.T) {
+	c, tr, _ := testOwnedConn(t)
+	checks := 0
+	tr.membershipFunc = func() error {
+		checks++
+		r := membershipReadResult{required: 8, actual: 8}
+		if checks == 3 {
+			r.masks = []uint32{0, 1}
+		}
+		return checkOwnedMemberships(r.read)
+	}
+	tr.onSend = func(m []netlink.Message) [][]netlink.Message {
+		if len(m) > 1 {
+			return successfulReplies(m)
+		}
+		return [][]netlink.Message{queryReplies(m[0], 0xfedcba98)}
+	}
+	c.CreateTable(&Table{Name: "confirmed", Family: TableFamilyIPv4})
+	if err := c.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if gen, err := c.Generation(); err != nil || gen != 0xfedcba98 {
+		t.Fatal(err)
+	}
+	if _, err := c.Generation(); err == nil || checks != 3 || len(tr.sent) != 2 || c.LastTransaction().State != TransactionCommitted {
+		t.Fatal("membership was cached, sent, or rewrote historical confirmation", err)
+	}
+}
+
+type failedMembershipRaw struct{ controls int }
+
+func (r *failedMembershipRaw) Control(func(uintptr)) error { r.controls++; return unix.EBADF }
+func (r *failedMembershipRaw) Read(func(uintptr) bool) error {
+	return errors.New("unexpected membership Read")
+}
+func (r *failedMembershipRaw) Write(func(uintptr) bool) error {
+	return errors.New("unexpected membership Write")
+}
+func TestOwnedMembershipUsesOriginalRawControlAndPropagatesFailure(t *testing.T) {
+	raw := &failedMembershipRaw{}
+	o := &ownedState{raw: raw}
+	if err := o.checkMemberships(); !errors.Is(err, unix.EBADF) || raw.controls != 1 {
+		t.Fatal("membership used fallback socket or lost original Control error", err)
+	}
+}
diff --git a/owned_peer_test.go b/owned_peer_test.go
new file mode 100644
index 0000000..9831e53
--- /dev/null
+++ b/owned_peer_test.go
@@ -0,0 +1,481 @@
+package nftables
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"iter"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mdlayher/netlink"
+	"github.com/sagernet/nftables/binaryutil"
+	"golang.org/x/sys/unix"
+)
+
+type peerPacket struct {
+	wire  []byte
+	flags int
+	from  unix.Sockaddr
+}
+type peerTransport struct {
+	*injectedTransport
+	packets     []peerPacket
+	makePackets func([]netlink.Message) []peerPacket
+}
+
+func (p *peerTransport) Send(m []netlink.Message) error {
+	p.sent = append(p.sent, cloneMessages(m))
+	p.packets = p.makePackets(m)
+	return p.sendErr
+}
+func (p *peerTransport) Receive(context ownedReceiveContext) (ownedReceivePacket, error) {
+	if len(p.packets) == 0 {
+		return ownedReceivePacket{}, io.ErrUnexpectedEOF
+	}
+	packet := p.packets[0]
+	p.packets = p.packets[1:]
+	return decodeOwnedReceivePacket(packet.wire, packet.flags, packet.from, context)
+}
+func newPeerConn(t *testing.T) (*Conn, *peerTransport, *memoryJournal) {
+	c, tr, j := testOwnedConn(t)
+	p := &peerTransport{injectedTransport: tr}
+	c.owned.transport = p
+	return c, p, j
+}
+func marshalPeerPacket(t *testing.T, group uint32, messages ...netlink.Message) peerPacket {
+	t.Helper()
+	packet := peerPacket{from: &unix.SockaddrNetlink{Family: unix.AF_NETLINK, Groups: group}}
+	for _, m := range messages {
+		m.Header.Length = uint32(16 + len(m.Data))
+		b, err := m.MarshalBinary()
+		if err != nil {
+			t.Fatal(err)
+		}
+		packet.wire = append(packet.wire, b...)
+	}
+	return packet
+}
+func changePeerAttribute(t *testing.T, m netlink.Message, kind uint16, data []byte) netlink.Message {
+	t.Helper()
+	attrs, err := netlink.UnmarshalAttributes(m.Data[4:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range attrs {
+		if attrs[i].Type&0x3fff == kind {
+			attrs[i].Data = bytes.Clone(data)
+		}
+	}
+	b, err := netlink.MarshalAttributes(attrs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.Data = append(bytes.Clone(m.Data[:4]), b...)
+	return m
+}
+func kernelPeerEcho(t *testing.T, m netlink.Message) netlink.Message {
+	t.Helper()
+	out := echo(m)
+	out.Header.Flags = m.Header.Flags & (netlink.Create | netlink.Excl)
+	intent, err := messageIntent(1, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if intent.Handle != 0 {
+		out = changePeerAttribute(t, out, unix.NFTA_RULE_HANDLE, binaryutil.BigEndian.PutUint64(intent.Handle))
+	}
+	return out
+}
+func peerACKs(t *testing.T, messages []netlink.Message) peerPacket {
+	t.Helper()
+	var result []netlink.Message
+	for _, m := range messages {
+		result = append(result, ack(m, 0))
+	}
+	return marshalPeerPacket(t, 0, result...)
+}
+func TestOwnedCorrectPeerCompleteMutation(t *testing.T) {
+	for _, group := range []uint32{0, 64} {
+		for _, count := range []int{1, 40} {
+			t.Run(fmt.Sprintf("group%d_echoes%d", group, count), func(t *testing.T) {
+				c, p, _ := newPeerConn(t)
+				table := c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+				for i := 1; i < count; i++ {
+					c.AddChain(&Chain{Name: fmt.Sprintf("chain-%d", i), Table: table})
+				}
+				checks := 0
+				p.membershipFunc = func() error { checks++; return nil }
+				p.makePackets = func(sent []netlink.Message) []peerPacket {
+					var es []netlink.Message
+					for _, m := range sent[1 : len(sent)-1] {
+						es = append(es, kernelPeerEcho(t, m))
+					}
+					return []peerPacket{marshalPeerPacket(t, group, es...), peerACKs(t, sent)}
+				}
+				if err := c.Flush(); err != nil {
+					t.Fatal(err)
+				}
+				if r := c.LastTransaction(); r.State != TransactionCommitted || !r.Sent || len(p.sent) != 1 || checks != 1 || len(r.Replies) != count+count+2 {
+					t.Fatalf("incomplete full receipt: %+v, checks=%d", r, checks)
+				}
+			})
+		}
+	}
+}
+func TestOwnedCorrectPeerExistingHandle(t *testing.T) {
+	for _, wrong := range []bool{false, true} {
+		t.Run(fmt.Sprint(wrong), func(t *testing.T) {
+			c, p, _ := newPeerConn(t)
+			table := &Table{Name: "own", Family: TableFamilyIPv4}
+			c.ReplaceRule(&Rule{Table: table, Chain: &Chain{Name: "c", Table: table}, Handle: 77})
+			p.makePackets = func(m []netlink.Message) []peerPacket {
+				e := kernelPeerEcho(t, m[1])
+				if wrong {
+					e = changePeerAttribute(t, e, unix.NFTA_RULE_HANDLE, binaryutil.BigEndian.PutUint64(78))
+				}
+				return []peerPacket{marshalPeerPacket(t, 64, e), peerACKs(t, m)}
+			}
+			err := c.Flush()
+			if wrong {
+				if !errors.Is(err, ErrUncertain) || c.LastTransaction().State != TransactionUnknown {
+					t.Fatal(err)
+				}
+			} else if err != nil || c.LastTransaction().State != TransactionCommitted {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+func TestOwnedCorrectPeerRejectsWholePacketAndNoReplay(t *testing.T) {
+	cases := []string{"nil", "typed-nil", "other-sockaddr", "foreign-pid", "wrong-group", "mixed-mask", "ack", "done", "overrun", "begin", "end", "query-type", "wrong-seq", "wrong-header-pid", "wrong-type", "wrong-family", "wrong-table", "zero-handle", "mixed-notification", "mixed-ack", "truncated", "ancillary-truncated", "interrupted", "malformed", "empty", "trailing-junk", "duplicate-same-packet", "duplicate-across-packets", "echo-only", "missing-end", "missing-member-ack"}
+	for _, fault := range cases {
+		t.Run(fault, func(t *testing.T) {
+			c, p, j := newPeerConn(t)
+			c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+			p.makePackets = func(m []netlink.Message) []peerPacket {
+				e := kernelPeerEcho(t, m[1])
+				valid := marshalPeerPacket(t, 64, e)
+				packet := valid
+				switch fault {
+				case "nil":
+					packet.from = nil
+				case "typed-nil":
+					packet.from = (*unix.SockaddrNetlink)(nil)
+				case "other-sockaddr":
+					packet.from = &unix.SockaddrUnix{}
+				case "foreign-pid":
+					packet.from = &unix.SockaddrNetlink{Pid: 17, Groups: 64}
+				case "wrong-group":
+					packet.from = &unix.SockaddrNetlink{Groups: 32}
+				case "mixed-mask":
+					packet.from = &unix.SockaddrNetlink{Groups: 65}
+				case "ack":
+					packet = marshalPeerPacket(t, 64, ack(m[1], 0))
+				case "done":
+					e.Header.Type = netlink.Done
+					packet = marshalPeerPacket(t, 64, e)
+				case "overrun":
+					e.Header.Type = netlink.Overrun
+					packet = marshalPeerPacket(t, 64, e)
+				case "begin":
+					packet = marshalPeerPacket(t, 64, m[0])
+				case "end":
+					packet = marshalPeerPacket(t, 64, m[len(m)-1])
+				case "query-type":
+					e.Header.Type = netlink.HeaderType((unix.NFNL_SUBSYS_NFTABLES << 8) | unix.NFT_MSG_NEWGEN)
+					packet = marshalPeerPacket(t, 64, e)
+				case "wrong-seq":
+					e.Header.Sequence++
+					packet = marshalPeerPacket(t, 64, e)
+				case "wrong-header-pid":
+					e.Header.PID++
+					packet = marshalPeerPacket(t, 64, e)
+				case "wrong-type":
+					e.Header.Type++
+					packet = marshalPeerPacket(t, 64, e)
+				case "wrong-family":
+					e.Data = bytes.Clone(e.Data)
+					e.Data[0] = byte(TableFamilyIPv6)
+					packet = marshalPeerPacket(t, 64, e)
+				case "wrong-table":
+					e = changePeerAttribute(t, e, unix.NFTA_TABLE_NAME, []byte("foreign\x00"))
+					packet = marshalPeerPacket(t, 64, e)
+				case "zero-handle":
+					e = changePeerAttribute(t, e, nftTableHandle, make([]byte, 8))
+					packet = marshalPeerPacket(t, 64, e)
+				case "mixed-notification":
+					bad := e
+					bad.Header.Sequence++
+					packet = marshalPeerPacket(t, 64, e, bad)
+				case "mixed-ack":
+					packet = marshalPeerPacket(t, 64, e, ack(m[1], 0))
+				case "truncated":
+					packet.flags = unix.MSG_TRUNC
+				case "ancillary-truncated":
+					packet.flags = unix.MSG_CTRUNC
+				case "interrupted":
+					e.Header.Flags |= netlink.DumpInterrupted
+					packet = marshalPeerPacket(t, 64, e)
+				case "malformed":
+					packet.wire[0] = 4
+					packet.wire[1] = 0
+				case "empty":
+					packet.wire = nil
+				case "trailing-junk":
+					packet.wire = append(packet.wire, 1)
+				case "duplicate-same-packet":
+					packet = marshalPeerPacket(t, 64, e, e)
+				case "duplicate-across-packets":
+					return []peerPacket{valid, valid, peerACKs(t, m)}
+				case "echo-only":
+					return []peerPacket{valid}
+				case "missing-end":
+					return []peerPacket{valid, marshalPeerPacket(t, 0, ack(m[0], 0), ack(m[1], 0))}
+				case "missing-member-ack":
+					return []peerPacket{valid, marshalPeerPacket(t, 0, ack(m[0], 0), ack(m[len(m)-1], 0))}
+				}
+				return []peerPacket{packet, peerACKs(t, m)}
+			}
+			if err := c.Flush(); !errors.Is(err, ErrUncertain) {
+				t.Fatal("bad peer/context committed", err)
+			}
+			if r := c.LastTransaction(); r.State != TransactionUnknown || !r.Sent || len(j.completed) != 1 {
+				t.Fatalf("rejected receive lost Unknown: %+v", r)
+			}
+			if fault == "mixed-notification" || fault == "mixed-ack" {
+				if len(c.LastTransaction().Replies) != 0 {
+					t.Fatal("valid prefix escaped rejected datagram")
+				}
+			}
+			c.CreateTable(&Table{Name: "later", Family: TableFamilyIPv4})
+			if err := c.Flush(); !errors.Is(err, ErrUncertain) || len(p.sent) != 1 {
+				t.Fatal("replay or later mutation allowed", err)
+			}
+		})
+	}
+}
+func TestOwnedCorrectPeerQueryAndStaleContext(t *testing.T) {
+	t.Run("query-no-echo-permission", func(t *testing.T) {
+		c, p, _ := newPeerConn(t)
+		p.makePackets = func(m []netlink.Message) []peerPacket {
+			return []peerPacket{marshalPeerPacket(t, 64, queryReplies(m[0], 0xfedcba98)...)}
+		}
+		if snapshot, err := c.ReadConsistent(TableFamilyIPv4); snapshot != nil || !errors.Is(err, ErrUncertain) || !c.owned.tainted {
+			t.Fatal("query accepted notification or partial snapshot", err)
+		}
+		if _, err := c.Generation(); !errors.Is(err, ErrUncertain) || len(p.sent) != 1 {
+			t.Fatal("query replayed after uncertain peer", err)
+		}
+	})
+	t.Run("current-context-only", func(t *testing.T) {
+		c, _, _ := testOwnedConn(t)
+		c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4})
+		m, intent, err := c.freezeOwned()
+		if err != nil {
+			t.Fatal(err)
+		}
+		packet := marshalPeerPacket(t, 64, kernelPeerEcho(t, m[1]))
+		old := cloneIntent(intent)
+		old.Messages[1].Header.Sequence--
+		for _, context := range []ownedReceiveContext{{}, ownedMutationReceiveContext(old)} {
+			if _, err := decodeOwnedDatagramContext(packet.wire, 0, packet.from, context); err == nil {
+				t.Fatal("old or absent context permitted echo")
+			}
+		}
+		intent.Messages[1].Header.Flags &^= unix.NLM_F_ECHO
+		if _, err := decodeOwnedDatagramContext(packet.wire, 0, packet.from, ownedMutationReceiveContext(intent)); err == nil {
+			t.Fatal("unrequested echo accepted")
+		}
+	})
+	t.Run("unrequested-elements", func(t *testing.T) {
+		c, p, _ := newPeerConn(t)
+		set := &Set{Name: "s", Table: &Table{Name: "own", Family: TableFamilyIPv4}, ID: 1, KeyType: TypeIPAddr}
+		if err := c.SetAddElements(set, []SetElement{{Key: []byte{10, 0, 0, 1}}}); err != nil {
+			t.Fatal(err)
+		}
+		p.makePackets = func(m []netlink.Message) []peerPacket {
+			return []peerPacket{marshalPeerPacket(t, 64, m[1]), peerACKs(t, m)}
+		}
+		if err := c.Flush(); !errors.Is(err, ErrUncertain) {
+			t.Fatal("unrequested element entered echo exception", err)
+		}
+	})
+}
+
+func TestOwnedSockOptionNeverEscapesRegardlessOfOrder(t *testing.T) {
+	for _, first := range []bool{false, true} {
+		t.Run(fmt.Sprint(first), func(t *testing.T) {
+			callbacks := 0
+			captured := false
+			callback := WithSockOptions(func(*netlink.Conn) error { callbacks++; captured = true; return nil })
+			owned := AsOwnedTransactions("birth", &memoryJournal{})
+			opts := []ConnOption{owned, callback}
+			if first {
+				opts = []ConnOption{callback, owned}
+			}
+			opts = append(opts, WithTestDial(func([]netlink.Message) ([]netlink.Message, error) { t.Fatal("dial exchange occurred"); return nil, nil }))
+			if c, err := New(opts...); c != nil || err == nil || callbacks != 0 || captured || !strings.Contains(err.Error(), "socket callbacks") {
+				t.Fatalf("callback escaped before Owned initialization: c=%v err=%v calls=%d", c, err, callbacks)
+			}
+		})
+	}
+	calls := 0
+	c, err := New(AsLasting(), WithTestDial(func([]netlink.Message) ([]netlink.Message, error) { return nil, io.EOF }), WithSockOptions(func(*netlink.Conn) error { calls++; return nil }))
+	if err != nil || calls != 1 {
+		t.Fatal("ordinary socket callback lost", err)
+	}
+	_ = c.CloseLasting()
+}
+
+type monitorControlSocket struct{ receives, joins, closes atomic.Int32 }
+
+func (s *monitorControlSocket) Close() error               { s.closes.Add(1); return nil }
+func (s *monitorControlSocket) Send(netlink.Message) error { return errors.New("unexpected Send") }
+func (s *monitorControlSocket) SendMessages([]netlink.Message) error {
+	return errors.New("unexpected SendMessages")
+}
+func (s *monitorControlSocket) Receive() ([]netlink.Message, error) {
+	s.receives.Add(1)
+	return nil, errors.New("use of closed file")
+}
+func (s *monitorControlSocket) ReceiveIter() iter.Seq2[netlink.Message, error] {
+	return func(yield func(netlink.Message, error) bool) {
+		s.receives.Add(1)
+		yield(netlink.Message{}, errors.New("use of closed file"))
+	}
+}
+func (s *monitorControlSocket) JoinGroup(uint32) error  { s.joins.Add(1); return nil }
+func (s *monitorControlSocket) LeaveGroup(uint32) error { return errors.New("unexpected group drop") }
+func TestOwnedMonitorEntrancesRejectBeforeAcquiringSocket(t *testing.T) {
+	for _, owned := range []bool{false, true} {
+		for _, flag := range []uint32{0, 1} {
+			for _, generational := range []bool{false, true} {
+				t.Run(fmt.Sprintf("owned%v_flags%d_gen%v", owned, flag, generational), func(t *testing.T) {
+					sock := &monitorControlSocket{}
+					c := &Conn{lasting: true, nlconn: netlink.NewConn(sock, 42)}
+					if owned {
+						c.owned = &ownedState{}
+					}
+					m := NewMonitor()
+					m.monitorFlags = flag
+					var err error
+					var closed <-chan struct{}
+					done := make(chan struct{})
+					if generational {
+						var ch chan *MonitorEvents
+						ch, err = c.AddGenerationalMonitor(m)
+						if err == nil {
+							go func() {
+								for range ch {
+								}
+								close(done)
+							}()
+							closed = done
+						}
+					} else {
+						var ch chan *MonitorEvent
+						ch, err = c.AddMonitor(m)
+						if err == nil {
+							go func() {
+								for range ch {
+								}
+								close(done)
+							}()
+							closed = done
+						}
+					}
+					if owned {
+						if err == nil || m.conn != nil || m.closer != nil || sock.joins.Load() != 0 || sock.receives.Load() != 0 {
+							t.Fatal("Owned monitor acquired or shared original socket", err)
+						}
+					} else {
+						if err != nil || m.conn == nil || sock.joins.Load() != int32(flag) {
+							t.Fatal("ordinary monitor behavior changed", err)
+						}
+						select {
+						case <-closed:
+						case <-time.After(time.Second):
+							t.Fatal("ordinary monitor goroutine did not actually exit")
+						}
+						if sock.receives.Load() != 1 {
+							t.Fatal("ordinary monitor did not use receiver")
+						}
+					}
+					_ = c.CloseLasting()
+					if sock.closes.Load() != 1 {
+						t.Fatal("fixture socket did not close")
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestOwnedCorrectPeerAllObjectKindsAndNames(t *testing.T) {
+	for _, fault := range []string{"none", "chain-name", "set-name"} {
+		t.Run(fault, func(t *testing.T) {
+			c, p, _ := newPeerConn(t)
+			table := c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4})
+			chain := c.AddChain(&Chain{Name: "c", Table: table})
+			set := &Set{Name: "s", Table: table, KeyType: TypeIPAddr}
+			if err := c.AddSet(set, nil); err != nil {
+				t.Fatal(err)
+			}
+			c.AddRule(&Rule{Table: table, Chain: chain})
+			p.makePackets = func(m []netlink.Message) []peerPacket {
+				var es []netlink.Message
+				for _, r := range m[1 : len(m)-1] {
+					e := kernelPeerEcho(t, r)
+					op := int(e.Header.Type) & 255
+					if fault == "chain-name" && op == unix.NFT_MSG_NEWCHAIN {
+						e = changePeerAttribute(t, e, unix.NFTA_CHAIN_NAME, []byte("foreign\x00"))
+					}
+					if fault == "set-name" && op == unix.NFT_MSG_NEWSET {
+						e = changePeerAttribute(t, e, unix.NFTA_SET_NAME, []byte("foreign\x00"))
+					}
+					es = append(es, e)
+				}
+				return []peerPacket{marshalPeerPacket(t, 64, es...), peerACKs(t, m)}
+			}
+			err := c.Flush()
+			if fault == "none" {
+				if err != nil || c.LastTransaction().State != TransactionCommitted {
+					t.Fatal("legal object echo failed", err)
+				}
+			} else if !errors.Is(err, ErrUncertain) || c.LastTransaction().State != TransactionUnknown || len(c.LastTransaction().Replies) != 0 {
+				t.Fatal("wrong name or partial echo packet accepted", err)
+			}
+		})
+	}
+}
+func TestOwnedCorrectPeerContextCopiesFrozenIntent(t *testing.T) {
+	c, _, _ := testOwnedConn(t)
+	c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4})
+	m, intent, err := c.freezeOwned()
+	if err != nil {
+		t.Fatal(err)
+	}
+	context := ownedMutationReceiveContext(intent)
+	packet := marshalPeerPacket(t, 64, kernelPeerEcho(t, m[1]))
+	intent.PortID++
+	intent.Messages[1].Header.Sequence++
+	intent.Messages[1].Table = "changed"
+	intent.Messages[1].Bytes[0] ^= 1
+	if out, err := decodeOwnedDatagramContext(packet.wire, 0, packet.from, context); err != nil || len(out) != 1 {
+		t.Fatal("receive context aliased its caller intent", err)
+	}
+	if context.mutation.Messages[1].Bytes[0] != byte(m[1].Header.Length) {
+		t.Fatal("receive context did not freeze bytes")
+	}
+}
+
+func TestOwnedEmptySocketCallbackListDoesNotCreateNewGate(t *testing.T) {
+	c, err := New(WithSockOptions(), AsOwnedTransactions("birth", &memoryJournal{}), WithTestDial(func([]netlink.Message) ([]netlink.Message, error) { return nil, io.EOF }))
+	if c != nil || err == nil || strings.Contains(err.Error(), "socket callbacks") || !strings.Contains(err.Error(), "pinned namespace") {
+		t.Fatal("empty callback list was blocked instead of reaching original Owned initialization", err)
+	}
+}
