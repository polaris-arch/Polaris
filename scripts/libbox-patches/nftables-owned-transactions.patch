+type kernelJournal struct {
+	mu    sync.Mutex
+	file  *os.File
+	nonce string
+}
+
+func (j *kernelJournal) Prepare(intent TransactionIntent) error {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	if err := json.NewEncoder(j.file).Encode(map[string]any{"phase": "pending", "nonce": j.nonce, "intent": intent}); err != nil {
+		return err
+	}
+	return j.file.Sync()
+}
+func (j *kernelJournal) Complete(receipt TransactionReceipt) {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	errorText := ""
+	if receipt.Err != nil {
+		errorText = receipt.Err.Error()
+	}
+	_ = json.NewEncoder(j.file).Encode(map[string]any{"phase": "complete", "nonce": j.nonce, "receipt": receipt, "original_error": errorText})
+	_ = j.file.Sync()
+}
+func kernelNamespace(t *testing.T) (int, *kernelJournal) {
+	t.Helper()
+	if os.Getenv("POLARIS_NFT_KERNEL_TEST") != "1" || os.Getenv("POLARIS_NO_KERNEL_RUN") == "1" {
+		t.Skip("requires reviewed private namespace guardian")
+	}
+	if os.Geteuid() != 0 {
+		t.Fatal("native nft test requires root inside its private namespace")
+	}
+	fd, err := strconv.Atoi(os.Getenv("POLARIS_NATIVE_NAMESPACE_FD"))
+	if err != nil || fd != 3 {
+		t.Fatal("missing pinned private namespace fd")
+	}
+	var target unix.Stat_t
+	if err = unix.Fstat(fd, &target); err != nil {
+		t.Fatal(err)
+	}
+	typ, err := unix.IoctlRetInt(fd, unix.NS_GET_NSTYPE)
+	if err != nil || typ != unix.CLONE_NEWNET {
+		t.Fatal("fd is not a network namespace")
+	}
+	dev, e1 := strconv.ParseUint(os.Getenv("POLARIS_NATIVE_PARENT_NETNS_DEV"), 10, 64)
+	ino, e2 := strconv.ParseUint(os.Getenv("POLARIS_NATIVE_PARENT_NETNS_INO"), 10, 64)
+	if e1 != nil || e2 != nil || dev == uint64(target.Dev) && ino == target.Ino {
+		t.Fatal("private namespace has not been separated from parent")
+	}
+	current, err := unix.Open("/proc/thread-self/ns/net", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(current)
+	var currentStat unix.Stat_t
+	if err = unix.Fstat(current, &currentStat); err != nil || currentStat.Dev != target.Dev || currentStat.Ino != target.Ino {
+		t.Fatal("test thread is not in pinned private namespace")
+	}
+	dir := os.Getenv("POLARIS_NATIVE_RECEIPT_DIR")
+	nonce := os.Getenv("POLARIS_NATIVE_NONCE")
+	if nonce == "" {
+		t.Fatal("missing guardian nonce")
+	}
+	st, err := os.Stat(dir)
+	if err != nil || !st.IsDir() || st.Mode().Perm()&0077 != 0 {
+		t.Fatal("receipt directory must be a private existing directory")
+	}
+	file, err := os.OpenFile(filepath.Join(dir, t.Name()+".ndjson"), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = file.Close() })
+	t.Logf("validated private netns dev=%d ino=%d parent=%d:%d", target.Dev, target.Ino, dev, ino)
+	return fd, &kernelJournal{file: file, nonce: nonce}
+}
+func kernelConn(t *testing.T, fd int, birth string, j *kernelJournal) *Conn {
+	t.Helper()
+	c, err := New(WithNetNSFd(fd), AsOwnedTransactions(birth, j))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = c.CloseLasting() })
+	return c
+}
+func kernelOwnerTable(t *testing.T, c *Conn, name string) *Table {
+	t.Helper()
+	table := c.CreateTable(&Table{Name: name, Family: TableFamilyIPv4, Flags: TableFlagOwner, UserData: []byte(name)})
+	beforeRead, readErr := c.nlconn.ReadBuffer()
+	beforeWrite, writeErr := c.nlconn.WriteBuffer()
+	if readErr != nil || writeErr != nil {
+		t.Fatal(errors.Join(readErr, writeErr))
+	}
+	flushErr := c.Flush()
+	afterRead, readErr := c.nlconn.ReadBuffer()
+	afterWrite, writeErr := c.nlconn.WriteBuffer()
+	t.Logf("actual original socket buffers before rcv=%d snd=%d after rcv=%d snd=%d", beforeRead, beforeWrite, afterRead, afterWrite)
+	if flushErr != nil || readErr != nil || writeErr != nil {
+		t.Fatal(errors.Join(flushErr, readErr, writeErr))
+	}
+	if afterRead < beforeRead || afterWrite < beforeWrite {
+		t.Fatal("owned transport reduced the original socket buffer")
+	}
+	receipt := c.LastTransaction()
+	objects, err := receipt.ConfirmedObjects()
+	if err != nil || len(objects.Tables) != 1 {
+		t.Fatalf("invalid table receipt: %v", err)
+	}
+	table = objects.Tables[0]
+	if table.Handle == 0 || table.Owner != receipt.Intent.PortID || table.Flags != TableFlagOwner {
+		t.Fatal("owner table receipt lacks actual socket association")
+	}
+	return table
+}
