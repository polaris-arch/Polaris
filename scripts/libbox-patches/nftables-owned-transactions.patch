+package nftables
+
+import (
+	"encoding/binary"
+	"fmt"
+	"testing"
+
+	"github.com/mdlayher/netlink"
+	"golang.org/x/sys/unix"
+)
+
+// This test also compiles against the frozen predecessor: no new receipt
+// field or transport interface is needed to expose the rejected legal GEN.
+func TestOwnedGenerationKernelProducerCounterexample(t *testing.T) {
+	for _, group := range []uint32{0, 64} {
+		t.Run(fmt.Sprintf("group%d", group), func(t *testing.T) {
+			c, p, _ := newPeerConn(t)
+			c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+			p.makePackets = func(sent []netlink.Message) []peerPacket {
+				attrs, err := netlink.MarshalAttributes([]netlink.Attribute{{Type: 1, Data: []byte{0, 1, 0, 2}}, {Type: 2, Data: []byte{0, 0, 4, 1}}, {Type: 3, Data: []byte("native.test\x00")}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				data := []byte{0, 0, 0, 0}
+				binary.BigEndian.PutUint16(data[2:], 2)
+				gen := netlink.Message{Header: netlink.Header{Type: (unix.NFNL_SUBSYS_NFTABLES << 8) | unix.NFT_MSG_NEWGEN, Sequence: sent[1].Header.Sequence, PID: sent[1].Header.PID}, Data: append(data, attrs...)}
+				return []peerPacket{marshalPeerPacket(t, group, kernelPeerEcho(t, sent[1]), gen), peerACKs(t, sent)}
+			}
+			if err := c.Flush(); err != nil {
+				t.Fatalf("legal full GEN/echo/ACK transaction, group %d: %v", group, err)
+			}
+			if c.LastTransaction().State != TransactionCommitted || len(p.sent) != 1 {
+				t.Fatal("missing original complete commit")
+			}
+		})
+	}
+}
diff --git a/owned_generation_test.go b/owned_generation_test.go
new file mode 100644
index 0000000..7d7ced7
--- /dev/null
+++ b/owned_generation_test.go
@@ -0,0 +1,438 @@
+package nftables
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/mdlayher/netlink"
+	"golang.org/x/sys/unix"
+)
+
+func generationMessage(t *testing.T, first netlink.Message, generation uint32, scalarFlags uint16, name []byte) netlink.Message {
+	t.Helper()
+	b, err := netlink.MarshalAttributes([]netlink.Attribute{
+		{Type: 1 | scalarFlags, Data: binary.BigEndian.AppendUint32(nil, generation)},
+		{Type: 2 | scalarFlags, Data: binary.BigEndian.AppendUint32(nil, 900001)},
+		{Type: 3, Data: append(bytes.Clone(name), 0)},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	data := []byte{0, 0, 0, 0}
+	binary.BigEndian.PutUint16(data[2:], uint16(generation))
+	return netlink.Message{Header: netlink.Header{Type: (unix.NFNL_SUBSYS_NFTABLES << 8) | unix.NFT_MSG_NEWGEN, Sequence: first.Header.Sequence, PID: first.Header.PID}, Data: append(data, b...)}
+}
+func rewriteGenerationAttrs(t *testing.T, m netlink.Message, change func([]netlink.Attribute) []netlink.Attribute) netlink.Message {
+	t.Helper()
+	a, err := netlink.UnmarshalAttributes(m.Data[4:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	a = change(a)
+	for i := range a {
+		a[i].Length = 0
+	}
+	b, err := netlink.MarshalAttributes(a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.Data = append(bytes.Clone(m.Data[:4]), b...)
+	return m
+}
+
+// Serialize deliberately malformed lengths without the message marshal helper
+// normalizing them; receive validation sees the exact fixture bytes.
+func marshalGenerationPacket(t *testing.T, group uint32, messages ...netlink.Message) peerPacket {
+	t.Helper()
+	p := peerPacket{from: &unix.SockaddrNetlink{Family: unix.AF_NETLINK, Groups: group}}
+	for _, m := range messages {
+		size := 16 + len(m.Data)
+		b := make([]byte, (size+3)&^3)
+		binary.NativeEndian.PutUint32(b[:4], uint32(size))
+		binary.NativeEndian.PutUint16(b[4:6], uint16(m.Header.Type))
+		binary.NativeEndian.PutUint16(b[6:8], uint16(m.Header.Flags))
+		binary.NativeEndian.PutUint32(b[8:12], m.Header.Sequence)
+		binary.NativeEndian.PutUint32(b[12:16], m.Header.PID)
+		copy(b[16:], m.Data)
+		p.wire = append(p.wire, b...)
+	}
+	return p
+}
+func assertGenerationUnknown(t *testing.T, c *Conn, p *peerTransport, err error) {
+	t.Helper()
+	if !errors.Is(err, ErrUncertain) || c.LastTransaction().State != TransactionUnknown || !c.owned.tainted || len(p.sent) != 1 {
+		t.Fatalf("lost Unknown/no replay: %v %+v", err, c.LastTransaction())
+	}
+	c.CreateTable(&Table{Name: "later", Family: TableFamilyIPv4})
+	if !errors.Is(c.Flush(), ErrUncertain) || len(p.sent) != 1 {
+		t.Fatal("sealed transaction replayed")
+	}
+}
+func TestOwnedGenerationCompleteAndImmutable(t *testing.T) {
+	for _, group := range []uint32{0, 64} {
+		for _, test := range []struct {
+			before, after uint32
+			flags         uint16
+			name          []byte
+		}{
+			{0, 0xfefe0002, 0, []byte("native.test")},
+			{0x10001, 0x10002, unix.NLA_F_NET_BYTEORDER, []byte{}},
+			{0xffffffff, 1, 0, []byte{0xff, 0xfe}},
+			{0, 7, 0, bytes.Repeat([]byte{'n'}, 4096)},
+		} {
+			t.Run(fmt.Sprintf("group%d_before%d_name%d", group, test.before, len(test.name)), func(t *testing.T) {
+				c, p, j := newPeerConn(t)
+				table := c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+				c.AddChain(&Chain{Name: "child", Table: table})
+				if test.before != 0 {
+					if err := c.UseGeneration(test.before); err != nil {
+						t.Fatal(err)
+					}
+				}
+				var received []byte
+				p.makePackets = func(m []netlink.Message) []peerPacket {
+					firstEcho := kernelPeerEcho(t, m[1])
+					ownerAttr, err := netlink.MarshalAttributes([]netlink.Attribute{{Type: nftTableOwner, Data: binary.BigEndian.AppendUint32(nil, m[1].Header.PID)}})
+					if err != nil {
+						t.Fatal(err)
+					}
+					firstEcho.Data = append(firstEcho.Data, ownerAttr...)
+					packet := marshalPeerPacket(t, group, firstEcho, generationMessage(t, m[1], test.after, test.flags, test.name), kernelPeerEcho(t, m[2]))
+					received = packet.wire
+					return []peerPacket{packet, peerACKs(t, m)}
+				}
+				if err := c.Flush(); err != nil {
+					t.Fatal(err)
+				}
+				r := c.LastTransaction()
+				if r.State != TransactionCommitted || len(r.GenerationNotifications) != 1 || len(r.Replies) != 6 || len(p.sent) != 1 || c.owned.generation != 0 {
+					t.Fatalf("GEN changed original success gate: %+v", r)
+				}
+				g := r.GenerationNotifications[0]
+				if g.Generation != test.after || g.TaskPID != 900001 || !bytes.Equal(g.TaskName, test.name) || g.MessageIndex != 1 || g.SenderPID != 0 || g.Groups != group || g.RecvmsgFlags != 0 || !bytes.Equal(g.RawDatagram, received) {
+					t.Fatal("lost actual raw or decoded metadata")
+				}
+				objects, err := r.ConfirmedObjects()
+				if err != nil || len(objects.Tables) != 1 || len(objects.Chains) != 1 {
+					t.Fatal("GEN became an object echo", err)
+				}
+				if directory := os.Getenv("POLARIS_GEN_PURE_RECEIPT_DIR"); directory != "" {
+					b, err := json.Marshal(r)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if err = os.WriteFile(filepath.Join(directory, fmt.Sprintf("group%d_before%d_name%d.json", group, test.before, len(test.name))), b, 0600); err != nil {
+						t.Fatal(err)
+					}
+				}
+				received[0] ^= 0xff
+				r.GenerationNotifications[0].RawDatagram[1] ^= 0xff
+				r.GenerationNotifications[0].RawMessage.Data[0] ^= 0xff
+				if len(r.GenerationNotifications[0].TaskName) > 0 {
+					r.GenerationNotifications[0].TaskName[0] ^= 0xff
+				}
+				j.completed[0].GenerationNotifications[0].RawDatagram[2] ^= 0xff
+				j.completed[0].GenerationNotifications[0].RawMessage.Data[1] ^= 0xff
+				if len(j.completed[0].GenerationNotifications[0].TaskName) > 0 {
+					j.completed[0].GenerationNotifications[0].TaskName[0] ^= 0xff
+				}
+				again := c.LastTransaction().GenerationNotifications[0]
+				if bytes.Equal(again.RawDatagram, r.GenerationNotifications[0].RawDatagram) || again.RawMessage.Data[0] != 0 || again.RawMessage.Data[1] != 0 || !bytes.Equal(again.TaskName, test.name) {
+					t.Fatal("aux aliases recv buffer, LastTransaction or Complete")
+				}
+			})
+		}
+	}
+}
+func TestOwnedGenerationRejectsSchemaAndAssociation(t *testing.T) {
+	cases := []struct {
+		name   string
+		change func(*testing.T, netlink.Message, []netlink.Message) netlink.Message
+	}{
+		{"begin-seq", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message {
+			g.Header.Sequence = m[0].Header.Sequence
+			return g
+		}},
+		{"later-member-seq", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message {
+			g.Header.Sequence = m[2].Header.Sequence
+			return g
+		}},
+		{"wrong-port", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message { g.Header.PID++; return g }},
+		{"request-flags", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message {
+			g.Header.Flags = netlink.Request
+			return g
+		}},
+		{"wrong-family", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message { g.Data[0] = 2; return g }},
+		{"wrong-version", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message { g.Data[1] = 1; return g }},
+		{"wrong-low16", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message { g.Data[3]++; return g }},
+		{"same-low16-wrong-high32", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message {
+			return generationMessage(t, m[1], 0x20002, 0, []byte("n"))
+		}},
+		{"trailing-byte", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message {
+			g.Data = append(g.Data, 1)
+			return g
+		}},
+		{"short-nfgen", func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message {
+			g.Data = g.Data[:3]
+			return g
+		}},
+	}
+	for _, kind := range []string{"duplicate", "duplicate-pid", "duplicate-name", "unknown", "missing", "nested-scalar", "short-scalar", "long-scalar", "nested-name", "byteorder-name", "unterminated-name", "internal-NUL", "zero-generation", "zero-task", "truncated-attr"} {
+		k := kind
+		cases = append(cases, struct {
+			name   string
+			change func(*testing.T, netlink.Message, []netlink.Message) netlink.Message
+		}{k, func(t *testing.T, g netlink.Message, m []netlink.Message) netlink.Message {
+			return rewriteGenerationAttrs(t, g, func(a []netlink.Attribute) []netlink.Attribute {
+				switch k {
+				case "duplicate":
+					a = append(a, a[0])
+				case "duplicate-pid":
+					a = append(a, a[1])
+				case "duplicate-name":
+					a = append(a, a[2])
+				case "unknown":
+					a = append(a, netlink.Attribute{Type: 4, Data: []byte{1}})
+				case "missing":
+					a = a[:2]
+				case "nested-scalar":
+					a[0].Type |= unix.NLA_F_NESTED
+				case "short-scalar":
+					a[0].Data = a[0].Data[:3]
+				case "long-scalar":
+					a[0].Data = append(a[0].Data, 0)
+				case "nested-name":
+					a[2].Type |= unix.NLA_F_NESTED
+				case "byteorder-name":
+					a[2].Type |= unix.NLA_F_NET_BYTEORDER
+				case "unterminated-name":
+					a[2].Data = []byte("bad")
+				case "internal-NUL":
+					a[2].Data = []byte{'a', 0, 'b', 0}
+				case "zero-generation":
+					a[0].Data = make([]byte, 4)
+				case "zero-task":
+					a[1].Data = make([]byte, 4)
+				case "truncated-attr":
+					a[0].Data = nil
+				}
+				return a
+			})
+		}})
+	}
+	for _, group := range []uint32{0, 64} {
+		for _, test := range cases {
+			t.Run(fmt.Sprintf("group%d/%s", group, test.name), func(t *testing.T) {
+				c, p, _ := newPeerConn(t)
+				table := c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+				c.AddChain(&Chain{Name: "child", Table: table})
+				if err := c.UseGeneration(0x10001); err != nil {
+					t.Fatal(err)
+				}
+				p.makePackets = func(m []netlink.Message) []peerPacket {
+					g := test.change(t, generationMessage(t, m[1], 0x10002, 0, []byte("n")), m)
+					return []peerPacket{marshalGenerationPacket(t, group, kernelPeerEcho(t, m[1]), g), peerACKs(t, m)}
+				}
+				assertGenerationUnknown(t, c, p, c.Flush())
+				r := c.LastTransaction()
+				if len(r.GenerationNotifications) != 0 || len(r.Replies) != 0 {
+					t.Fatal("published prefix of malformed packet")
+				}
+			})
+		}
+	}
+}
+func TestOwnedGenerationWholePacketErrnoContradiction(t *testing.T) {
+	for _, group := range []uint32{0, 64} {
+		for _, code := range []unix.Errno{unix.ERESTART, unix.EEXIST, unix.EBUSY} {
+			for _, before := range []bool{false, true} {
+				for _, malformed := range []bool{false, true} {
+					t.Run(fmt.Sprintf("group%d_errno%d_before%v_bad%v", group, code, before, malformed), func(t *testing.T) {
+						c, p, _ := newPeerConn(t)
+						c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+						p.makePackets = func(m []netlink.Message) []peerPacket {
+							g := generationMessage(t, m[1], 7, 0, []byte("n"))
+							if malformed {
+								g.Data[1] = 1
+							}
+							a := ack(m[0], code)
+							messages := []netlink.Message{g, a}
+							if before {
+								messages = []netlink.Message{a, g}
+							}
+							return []peerPacket{marshalPeerPacket(t, group, messages...), peerACKs(t, m)}
+						}
+						err := c.Flush()
+						assertGenerationUnknown(t, c, p, err)
+						if !errors.Is(err, code) || !bytes.HasPrefix([]byte(err.Error()), []byte(code.Error())) {
+							t.Fatal("original errno not first", err)
+						}
+						want := 0
+						if group == 0 && !malformed {
+							want = 1
+						}
+						if len(c.LastTransaction().GenerationNotifications) != want {
+							t.Fatal("invalid whole packet aux published")
+						}
+					})
+				}
+			}
+		}
+	}
+	for _, code := range []unix.Errno{unix.ERESTART, unix.EEXIST} {
+		t.Run(fmt.Sprintf("prior-packet_errno%d", code), func(t *testing.T) {
+			c, p, _ := newPeerConn(t)
+			c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+			p.makePackets = func(m []netlink.Message) []peerPacket {
+				return []peerPacket{marshalPeerPacket(t, 64, generationMessage(t, m[1], 7, 0, []byte("n"))), marshalPeerPacket(t, 0, ack(m[0], code), ack(m[1], 0))}
+			}
+			err := c.Flush()
+			assertGenerationUnknown(t, c, p, err)
+			if !errors.Is(err, code) || len(c.LastTransaction().GenerationNotifications) != 1 {
+				t.Fatal("lost prior aux or errno", err)
+			}
+		})
+	}
+}
+func TestOwnedGenerationDuplicateAndNoAuthority(t *testing.T) {
+	for _, kind := range []string{"duplicate-same", "duplicate-later", "no-end", "no-echo", "no-acks", "first-not-reporting", "query-notification", "mixed-unknown"} {
+		t.Run(kind, func(t *testing.T) {
+			c, p, _ := newPeerConn(t)
+			if kind == "first-not-reporting" {
+				c.DelTable(&Table{Name: "earlier", Family: TableFamilyIPv4})
+			}
+			c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+			p.makePackets = func(m []netlink.Message) []peerPacket {
+				if kind == "query-notification" {
+					return []peerPacket{marshalPeerPacket(t, 64, generationMessage(t, m[0], 7, 0, []byte("n")))}
+				}
+				g := generationMessage(t, m[1], 7, 0, []byte("n"))
+				e := kernelPeerEcho(t, m[1])
+				switch kind {
+				case "duplicate-same":
+					return []peerPacket{marshalPeerPacket(t, 64, e, g, g)}
+				case "duplicate-later":
+					return []peerPacket{marshalPeerPacket(t, 64, g), marshalPeerPacket(t, 0, g)}
+				case "no-end":
+					return []peerPacket{marshalPeerPacket(t, 64, e, g), marshalPeerPacket(t, 0, ack(m[0], 0), ack(m[1], 0))}
+				case "no-echo":
+					return []peerPacket{marshalPeerPacket(t, 64, g), peerACKs(t, m)}
+				case "no-acks":
+					return []peerPacket{marshalPeerPacket(t, 64, e, g)}
+				case "first-not-reporting":
+					return []peerPacket{marshalPeerPacket(t, 64, g)}
+				case "mixed-unknown":
+					bad := g
+					bad.Header.Type++
+					return []peerPacket{marshalPeerPacket(t, 64, e, g, bad)}
+				case "query-notification":
+					g.Header.Sequence = m[0].Header.Sequence
+					return []peerPacket{marshalPeerPacket(t, 64, g)}
+				}
+				return nil
+			}
+			if kind == "query-notification" {
+				c.DiscardPending()
+				_, err := c.Generation()
+				if !errors.Is(err, ErrUncertain) || len(p.sent) != 1 || !c.owned.tainted {
+					t.Fatal(err)
+				}
+				return
+			}
+			assertGenerationUnknown(t, c, p, c.Flush())
+			if _, err := c.LastTransaction().ConfirmedObjects(); !errors.Is(err, ErrUncertain) {
+				t.Fatal("aux granted ownership")
+			}
+		})
+	}
+}
+func TestOwnedGenerationQueryResponseRemainsOrdinary(t *testing.T) {
