+type memoryJournal struct {
+	mu        sync.Mutex
+	pending   []TransactionIntent
+	completed []TransactionReceipt
+	prepare   func(TransactionIntent) error
+}
+
+func (j *memoryJournal) Prepare(i TransactionIntent) error {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	j.pending = append(j.pending, cloneIntent(i))
+	if j.prepare != nil {
+		return j.prepare(i)
+	}
+	return nil
+}
+func (j *memoryJournal) Complete(r TransactionReceipt) {
+	j.mu.Lock()
+	defer j.mu.Unlock()
+	j.completed = append(j.completed, r)
+}
+
+type injectedTransport struct {
+	sent                           [][]netlink.Message
+	replies                        [][]netlink.Message
+	sendErr, receiveErr, bufferErr error
+	bufferFunc                     func(int, int, int) error
+	membershipFunc                 func() error
+	onSend                         func([]netlink.Message) [][]netlink.Message
+}
+
+func (t *injectedTransport) Send(m []netlink.Message) error {
+	t.sent = append(t.sent, cloneMessages(m))
+	if t.sendErr != nil {
+		return t.sendErr
+	}
+	t.replies = t.onSend(m)
+	return nil
+}
+func (t *injectedTransport) Receive(ownedReceiveContext) (ownedReceivePacket, error) {
+	if len(t.replies) == 0 {
+		if t.receiveErr != nil {
+			return ownedReceivePacket{}, t.receiveErr
+		}
+		return ownedReceivePacket{}, io.ErrUnexpectedEOF
+	}
+	m := t.replies[0]
+	t.replies = t.replies[1:]
+	return ownedReceivePacket{replies: m}, nil
+}
+func (t *injectedTransport) CheckMemberships() error {
+	if t.membershipFunc != nil {
+		return t.membershipFunc()
+	}
+	return nil
+}
+func (t *injectedTransport) Buffers(total, largest, count int) error {
+	if t.bufferFunc != nil {
+		return t.bufferFunc(total, largest, count)
+	}
+	return t.bufferErr
+}
+func (t *injectedTransport) Deadline(time.Time) error { return nil }
+func testOwnedConn(t *testing.T) (*Conn, *injectedTransport, *memoryJournal) {
+	t.Helper()
+	tr := &injectedTransport{onSend: successfulReplies}
+	j := &memoryJournal{}
+	c := &Conn{lasting: true, owned: &ownedState{birth: "test-birth", portID: 42, sequence: 99, namespaceDevice: 1, namespaceInode: 2, journal: j, transport: tr, timeout: time.Second}}
+	return c, tr, j
+}
+func ack(m netlink.Message, errno unix.Errno) netlink.Message {
+	data := make([]byte, 20)
+	binary.NativeEndian.PutUint32(data, uint32(-int32(errno)))
+	wire, _ := m.MarshalBinary()
+	copy(data[4:], wire[:16])
+	return netlink.Message{Header: netlink.Header{Type: netlink.Error, Sequence: m.Header.Sequence, PID: m.Header.PID}, Data: data}
+}
+func echo(m netlink.Message) netlink.Message {
+	out := m
+	out.Data = bytes.Clone(m.Data)
+	op := int(m.Header.Type) & 0xff
+	var typ uint16
+	switch op {
+	case unix.NFT_MSG_NEWTABLE:
+		typ = nftTableHandle
+	case unix.NFT_MSG_NEWCHAIN:
+		typ = unix.NFTA_CHAIN_HANDLE
+	case unix.NFT_MSG_NEWRULE:
+		typ = unix.NFTA_RULE_HANDLE
+	case unix.NFT_MSG_NEWSET:
+		typ = nftSetHandle
+	}
+	if typ != 0 {
+		a, _ := netlink.MarshalAttributes([]netlink.Attribute{{Type: typ, Data: binaryutil.BigEndian.PutUint64(100 + uint64(m.Header.Sequence))}})
+		out.Data = append(out.Data, a...)
+	}
+	out.Header.Length = uint32(16 + len(out.Data))
+	return out
+}
+func successfulReplies(m []netlink.Message) [][]netlink.Message {
+	var replies []netlink.Message
+	for _, x := range m {
+		if x.Header.Flags&unix.NLM_F_ECHO != 0 {
+			replies = append(replies, echo(x))
+		}
+	}
+	for _, x := range m {
+		if x.Header.Flags&netlink.Acknowledge != 0 {
+			replies = append(replies, ack(x, 0))
+		}
+	}
+	return [][]netlink.Message{replies}
+}
+func TestOwnedFrozenCompleteBatch(t *testing.T) {
