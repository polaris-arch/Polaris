+func TestOwnedGenerationPacketQualification(t *testing.T) {
+	for _, fault := range []string{"nil", "typed-nil", "pid", "group32", "group65", "trunc", "ctrunc", "trailing", "partial-header", "malformed-length", "mixed-query", "mixed-done"} {
+		t.Run(fault, func(t *testing.T) {
+			c, p, _ := newPeerConn(t)
+			c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+			p.makePackets = func(m []netlink.Message) []peerPacket {
+				g := generationMessage(t, m[1], 7, 0, []byte("n"))
+				packet := marshalPeerPacket(t, 64, g)
+				switch fault {
+				case "nil":
+					packet.from = nil
+				case "typed-nil":
+					packet.from = (*unix.SockaddrNetlink)(nil)
+				case "pid":
+					packet.from = &unix.SockaddrNetlink{Pid: 1, Groups: 64}
+				case "group32":
+					packet.from = &unix.SockaddrNetlink{Groups: 32}
+				case "group65":
+					packet.from = &unix.SockaddrNetlink{Groups: 65}
+				case "trunc":
+					packet.flags = unix.MSG_TRUNC
+				case "ctrunc":
+					packet.flags = unix.MSG_CTRUNC
+				case "trailing":
+					packet.wire = append(packet.wire, 1)
+				case "partial-header":
+					packet.wire = append(packet.wire, make([]byte, 15)...)
+				case "malformed-length":
+					binary.NativeEndian.PutUint32(packet.wire[:4], 15)
+				case "mixed-query":
+					bad := g
+					bad.Header.Type++
+					packet = marshalPeerPacket(t, 0, g, bad)
+				case "mixed-done":
+					bad := g
+					bad.Header.Type = netlink.Done
+					packet = marshalPeerPacket(t, 0, g, bad)
+				}
+				return []peerPacket{packet, peerACKs(t, m)}
+			}
+			assertGenerationUnknown(t, c, p, c.Flush())
+			if len(c.LastTransaction().GenerationNotifications) != 0 || len(c.LastTransaction().Replies) != 0 {
+				t.Fatal("bad packet prefix published")
+			}
+		})
+	}
+}
