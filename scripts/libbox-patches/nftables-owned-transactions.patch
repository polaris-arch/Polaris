+package nftables
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/mdlayher/netlink"
+)
+
+func TestOwnedRejectedEchoDiagnosticPreservesUnknown(t *testing.T) {
+	for _, rejectedIndex := range []int{0, 9} {
+		t.Run(fmt.Sprint(rejectedIndex), func(t *testing.T) {
+			c, p, j := newPeerConn(t)
+			table := c.CreateTable(&Table{Name: "own", Family: TableFamilyIPv4, Flags: TableFlagOwner})
+			for i := 0; i < rejectedIndex; i++ {
+				c.AddChain(&Chain{Name: fmt.Sprintf("chain-%d", i), Table: table})
+			}
+			var rejectedPacket peerPacket
+			var rejectedHeader netlink.Header
+			p.makePackets = func(sent []netlink.Message) []peerPacket {
+				first := marshalPeerPacket(t, 64, kernelPeerEcho(t, sent[1]))
+				var mixed []netlink.Message
+				for _, message := range sent[2 : len(sent)-1] {
+					mixed = append(mixed, kernelPeerEcho(t, message))
+				}
+				bad := ack(sent[1], 0)
+				bad.Header.Length = uint32(16 + len(bad.Data))
+				rejectedHeader = bad.Header
+				mixed = append(mixed, bad)
+				rejectedPacket = marshalPeerPacket(t, 64, mixed...)
+				return []peerPacket{first, rejectedPacket, peerACKs(t, sent)}
+			}
+			err := c.Flush()
+			if !errors.Is(err, ErrUncertain) {
+				t.Fatal("rejected echo did not retain uncertainty", err)
+			}
+			text := err.Error()
+			for _, field := range []string{
+				"nft notification is not a requested current mutation echo:",
+				"from_type=*unix.SockaddrNetlink from_pid=0 from_groups=64 recvmsg_flags=0x0",
+				fmt.Sprintf("datagram_bytes=%d datagram_sha256=%x", len(rejectedPacket.wire), sha256.Sum256(rejectedPacket.wire)),
+				fmt.Sprintf("header_count=%d", rejectedIndex+1),
+				fmt.Sprintf("rejected_header_index=%d rejected_header={Len:%d Type:%d Flags:%d Seq:%d Pid:%d}", rejectedIndex, rejectedHeader.Length, uint16(rejectedHeader.Type), uint16(rejectedHeader.Flags), rejectedHeader.Sequence, rejectedHeader.PID),
+			} {
+				if !strings.Contains(text, field) {
+					t.Fatalf("missing actual diagnostic field %q in %s", field, text)
+				}
+			}
+			prefix := strings.Split(strings.Split(text, " headers=[")[1], "] header_parse_error=")[0]
+			if strings.Count(prefix, "{Len:") != min(rejectedIndex+1, 8) {
+				t.Fatal("diagnostic prefix was not bounded to eight headers", text)
+			}
+			receipt := c.LastTransaction()
+			if receipt.State != TransactionUnknown || !receipt.Sent || len(receipt.Replies) != 1 || len(p.sent) != 1 || len(j.completed) != 1 {
+				t.Fatal("diagnostic accepted a mixed prefix or changed the single-send Unknown receipt", receipt)
+			}
+			if err := c.Flush(); !errors.Is(err, ErrUncertain) || len(p.sent) != 1 {
+				t.Fatal("diagnostic replayed the sealed transaction", err)
+			}
+		})
+	}
+}
diff --git a/owned_generation.go b/owned_generation.go
new file mode 100644
index 0000000..59ebd3d
--- /dev/null
+++ b/owned_generation.go
@@ -0,0 +1,196 @@
+package nftables
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"syscall"
+
+	"github.com/mdlayher/netlink"
+	"golang.org/x/sys/unix"
+)
+
+// GenerationNotification preserves an actual receive on the original owned
+// socket. TaskPID is the kernel's initial-namespace task ID, not the socket port
+// or a PID in the caller's namespace. No field grants ACK or ownership authority.
+type GenerationNotification struct {
+	RawDatagram       []byte
+	DatagramSHA256    string
+	RawMessage        netlink.Message
+	MessageIndex      int
+	SenderPID, Groups uint32
+	RecvmsgFlags      int
+	Generation        uint32
+	TaskPID           uint32
+	TaskName          []byte // bytes before the single terminating NUL
+}
+
+func cloneGenerationNotifications(in []GenerationNotification) []GenerationNotification {
+	out := append([]GenerationNotification(nil), in...)
+	for i := range out {
+		out[i].RawDatagram = bytes.Clone(in[i].RawDatagram)
+		out[i].RawMessage.Data = bytes.Clone(in[i].RawMessage.Data)
+		out[i].TaskName = bytes.Clone(in[i].TaskName)
+	}
+	return out
+}
+
+// Only this private carrier can attach metadata from recvmsg to a receipt.
+// A rejected packet exposes no accepted prefix/aux. kernelError retains an
+// exactly associated negative ACK as an error, even when the packet is invalid.
+type ownedReceivePacket struct {
+	replies       []netlink.Message
+	notifications []GenerationNotification
+	kernelError   error
+}
+
+func decodeOwnedReceivePacket(buf []byte, flags int, from unix.Sockaddr, context ownedReceiveContext) (ownedReceivePacket, error) {
+	var packet ownedReceivePacket
+	sender, ok := from.(*unix.SockaddrNetlink)
+	const nftNotifyGroupMask = 1 << (unix.NFNLGRP_NFTABLES - 1)
+	if !ok || sender == nil || sender.Pid != 0 || sender.Groups != 0 && (sender.Groups != nftNotifyGroupMask || context.mutation == nil) {
+		return packet, rejectedOwnedSender(buf, flags, from)
+	}
+	if flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 {
+		return packet, errors.New("nft received truncated datagram")
+	}
+	parsed, err := syscall.ParseNetlinkMessage(buf)
+	if err != nil {
+		return packet, err
+	}
+	var consumed int
+	messages := make([]netlink.Message, len(parsed))
+	for i, m := range parsed {
+		consumed += (int(m.Header.Len) + 3) &^ 3
+		messages[i] = netlink.Message{Header: netlink.Header{Length: m.Header.Len, Type: netlink.HeaderType(m.Header.Type), Flags: netlink.HeaderFlags(m.Header.Flags), Sequence: m.Header.Seq, PID: m.Header.Pid}, Data: bytes.Clone(m.Data)}
+	}
+	if consumed != len(buf) || sender.Groups != 0 && len(messages) == 0 {
+		return packet, errors.New("nft datagram has empty or unparsed framing")
+	}
+	if context.mutation == nil {
+		// Ordinary group-zero queries keep their own complete query validator.
+		packet.replies = messages
+		return packet, nil
+	}
+	// Inspect the complete packet for original errno before any validation or
+	// terminal return. This does not publish an invalid packet as ACK authority.
+	for _, m := range messages {
+		intent, found := context.requested[m.Header.Sequence]
+		if found && m.Header.PID == context.mutation.PortID && m.Header.Flags&netlink.DumpInterrupted == 0 && m.Header.Type == netlink.Error {
+			code, ackErr := validateACK(m, netlink.Message{Header: intent.Header})
+			if ackErr == nil && code != 0 && packet.kernelError == nil {
+				packet.kernelError = code
+			}
+		}
+	}
+	var replies []netlink.Message
+	var notifications []GenerationNotification
+	reject := func(index int, m netlink.Message, reason error) (ownedReceivePacket, error) {
+		return ownedReceivePacket{kernelError: packet.kernelError}, fmt.Errorf("%w rejected_header_index=%d rejected_header={Len:%d Type:%d Flags:%d Seq:%d Pid:%d}",
+			errors.Join(reason, rejectedOwnedDatagram("nft notification is not a requested current mutation echo", buf, flags, from)),
+			index, m.Header.Length, uint16(m.Header.Type), uint16(m.Header.Flags), m.Header.Sequence, m.Header.PID)
+	}
+	for index, m := range messages {
+		if int(m.Header.Type) == (unix.NFNL_SUBSYS_NFTABLES<<8)|unix.NFT_MSG_NEWGEN {
+			generation, pid, name, err := validateGenerationNotification(context, m)
+			if err != nil {
+				return reject(index, m, err)
+			}
+			if len(notifications) != 0 {
+				return reject(index, m, errors.New("duplicate nft generation notification"))
+			}
+			notifications = append(notifications, GenerationNotification{RawDatagram: bytes.Clone(buf), DatagramSHA256: fmt.Sprintf("%x", sha256.Sum256(buf)), RawMessage: cloneMessages([]netlink.Message{m})[0], MessageIndex: index, SenderPID: sender.Pid, Groups: sender.Groups, RecvmsgFlags: flags, Generation: generation, TaskPID: pid, TaskName: bytes.Clone(name)})
+			continue
+		}
+		intent, found := context.requested[m.Header.Sequence]
+		if !found || m.Header.PID != context.mutation.PortID || m.Header.Flags&netlink.DumpInterrupted != 0 {
+			return reject(index, m, errors.New("nft reply has wrong sequence/PID or interrupted dump"))
+		}
+		if sender.Groups == 0 && m.Header.Type == netlink.Error {
+			if _, err := validateACK(m, netlink.Message{Header: intent.Header}); err != nil {
+				return reject(index, m, err)
+			}
+		} else {
+			if !ownedObjectEchoType(m.Header.Type) || intent.Header.Flags&unix.NLM_F_ECHO == 0 {
+				return reject(index, m, errors.New("unexpected nft notification/echo type"))
+			}
+			if err := validateEcho(intent, m); err != nil {
+				return reject(index, m, err)
+			}
+		}
+		replies = append(replies, m)
+	}
+	packet.replies, packet.notifications = replies, notifications
+	return packet, nil
+}
+
+func ownedObjectEchoType(typ netlink.HeaderType) bool {
+	if int(typ)>>8 != unix.NFNL_SUBSYS_NFTABLES {
+		return false
+	}
+	switch int(typ) & 0xff {
+	case unix.NFT_MSG_NEWTABLE, unix.NFT_MSG_NEWCHAIN, unix.NFT_MSG_NEWRULE, unix.NFT_MSG_NEWSET:
+		return true
+	}
+	return false
+}
+
+func validateGenerationNotification(context ownedReceiveContext, m netlink.Message) (uint32, uint32, []byte, error) {
+	if context.mutation == nil || len(context.mutation.Messages) < 3 {
+		return 0, 0, nil, errors.New("nft generation notification has no current mutation")
+	}
+	first := context.mutation.Messages[1]
+	if first.Index != 1 || !ownedObjectEchoType(first.Header.Type) || first.Header.Flags&unix.NLM_F_ECHO == 0 || m.Header.Sequence != first.Header.Sequence || m.Header.PID != context.mutation.PortID || m.Header.Flags != 0 {
+		return 0, 0, nil, errors.New("nft generation notification differs from first reporting member")
+	}
+	if len(m.Data) < 4 || m.Data[0] != unix.AF_UNSPEC || m.Data[1] != unix.NFNETLINK_V0 {
+		return 0, 0, nil, errors.New("invalid nft generation nfgen header")
+	}
+	var generation, pid uint32
+	var name []byte
+	var seen [4]bool
+	for data := m.Data[4:]; len(data) != 0; {
+		if len(data) < 4 {
+			return 0, 0, nil, errors.New("truncated nft generation attribute header")
+		}
+		size, typ := int(binary.NativeEndian.Uint16(data[:2])), binary.NativeEndian.Uint16(data[2:4])
+		aligned := (size + 3) &^ 3
+		id, attrFlags := typ&0x3fff, typ&0xc000
+		if size < 4 || size > len(data) || aligned > len(data) || id < 1 || id > 3 || seen[id] {
+			return 0, 0, nil, errors.New("unknown, duplicate or truncated nft generation attribute")
+		}
+		seen[id] = true
+		value := data[4:size]
+		if id < 3 {
+			if len(value) != 4 || attrFlags != 0 && attrFlags != unix.NLA_F_NET_BYTEORDER {
+				return 0, 0, nil, errors.New("invalid nft generation scalar encoding")
+			}
+			if id == 1 {
+				generation = binary.BigEndian.Uint32(value)
+			} else {
+				pid = binary.BigEndian.Uint32(value)
+			}
+		} else {
+			if attrFlags != 0 || len(value) == 0 || value[len(value)-1] != 0 || bytes.IndexByte(value[:len(value)-1], 0) >= 0 {
+				return 0, 0, nil, errors.New("invalid nft generation task name")
+			}
+			name = bytes.Clone(value[:len(value)-1])
+		}
+		data = data[aligned:]
+	}
+	if !seen[1] || !seen[2] || !seen[3] || generation == 0 || pid == 0 || binary.BigEndian.Uint16(m.Data[2:4]) != uint16(generation) {
+		return 0, 0, nil, errors.New("incomplete or inconsistent nft generation notification")
+	}
+	if before := context.mutation.Generation; before != 0 {
+		next := before + 1
+		if next == 0 {
+			next = 1
+		}
+		if generation != next {
+			return 0, 0, nil, errors.New("nft generation notification differs from full conditional successor")
+		}
+	}
+	return generation, pid, name, nil
+}
