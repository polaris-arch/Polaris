diff --git a/dns/transport_manager_ownership_test.go b/dns/transport_manager_ownership_test.go
new file mode 100644
index 0000000..a3f5a2f
--- /dev/null
+++ b/dns/transport_manager_ownership_test.go
@@ -0,0 +1,113 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/construction"
+	"github.com/sagernet/sing-box/log"
+)
+
+// No DisposeConstruction method: ordinary Close represents an unsafe runtime effect.
+type unknownOwnerProbe struct {
+	adapter.DNSTransport
+	tag       string
+	closed    *int
+	failStart bool
+}
+
+func (p *unknownOwnerProbe) Type() string           { return "unknown-owner" }
+func (p *unknownOwnerProbe) Tag() string            { return p.tag }
+func (p *unknownOwnerProbe) Close() error           { *p.closed++; return nil }
+func (p *unknownOwnerProbe) Dependencies() []string { return nil }
+func (p *unknownOwnerProbe) Start(stage adapter.StartStage) error {
+	if stage == adapter.StartStateStart && p.failStart {
+		return errors.New("injected runtime Start failure")
+	}
+	return nil
+}
+
+func TestOnlySuccessfulChildStartAllowsRuntimeClose(t *testing.T) {
+	for _, mode := range []string{"constructed", "initialize", "partial-start"} {
+		t.Run(mode, func(t *testing.T) {
+			logger := log.NewNOPFactory().Logger()
+			closed := []int{0, 0, 0}
+			children := []adapter.DNSTransport{
+				&unknownOwnerProbe{tag: "first", closed: &closed[0]},
+				&unknownOwnerProbe{tag: "failed", closed: &closed[1], failStart: true},
+				&unknownOwnerProbe{tag: "untouched", closed: &closed[2]},
+			}
+			m := &TransportManager{logger: logger, transports: children, transportByTag: map[string]adapter.DNSTransport{"first": children[0], "failed": children[1], "untouched": children[2]}, defaultTransport: children[0]}
+			if mode != "constructed" {
+				if err := m.Start(adapter.StartStateInitialize); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if mode == "partial-start" {
+				if err := m.Start(adapter.StartStateStart); err == nil {
+					t.Fatal("injected Start failure missing")
+				}
+			}
+			if err := m.Close(); !errors.Is(err, construction.ErrUnknownDisposal) {
+				t.Fatalf("close = %v", err)
+			}
+			wantFirst := 0
+			if mode == "partial-start" {
+				wantFirst = 1
+			}
+			if closed[0] != wantFirst || closed[1] != 0 || closed[2] != 0 {
+				t.Fatalf("unsafe runtime Close counts: %v", closed)
+			}
+		})
+	}
+}
+
+func TestUnknownConstructionRemoveReplaceAndFactoryErrorNeverRuntimeClose(t *testing.T) {
+	for _, mode := range []string{"remove", "replace", "factory-error"} {
+		t.Run(mode, func(t *testing.T) {
+			var scope construction.Scope
+			ctx := construction.WithScope(context.Background(), &scope)
+			logger := log.NewNOPFactory().Logger()
+			closed := 0
+			registry := NewTransportRegistry()
+			failure := errors.New("injected object plus error")
+			RegisterTransport[struct{}](registry, "unknown-owner", func(ctx context.Context, _ log.ContextLogger, tag string, _ struct{}) (adapter.DNSTransport, error) {
+				child := &unknownOwnerProbe{tag: tag, closed: &closed}
+				if mode == "factory-error" {
+					return child, failure
+				}
+				return child, nil
+			})
+			m := &TransportManager{logger: logger, registry: registry, transportByTag: make(map[string]adapter.DNSTransport)}
+			err := m.Create(ctx, logger, "same", "unknown-owner", nil)
+			if mode == "factory-error" {
+				if !errors.Is(err, failure) {
+					t.Fatal(err)
+				}
+			} else {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if mode == "remove" {
+					if err = m.Remove("same"); !errors.Is(err, construction.ErrUnknownDisposal) {
+						t.Fatal(err)
+					}
+				} else {
+					if err = m.Create(ctx, logger, "same", "unknown-owner", nil); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			if mode != "remove" {
+				if err = scope.Close(); !errors.Is(err, construction.ErrUnknownDisposal) {
+					t.Fatalf("cleanup = %v", err)
+				}
+			}
+			if closed != 0 {
+				t.Fatalf("unowned object runtime-closed %d times", closed)
+			}
+		})
+	}
+}
diff --git a/dns/transport_manager_replacement_scope_test.go b/dns/transport_manager_replacement_scope_test.go
new file mode 100644
index 0000000..cc4aad7
--- /dev/null
+++ b/dns/transport_manager_replacement_scope_test.go
@@ -0,0 +1,133 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/construction"
+	"github.com/sagernet/sing-box/log"
+)
+
+type replacementScopeProbe struct {
+	constructionProbe
+	beforeDispose func()
+}
+
+func (p *replacementScopeProbe) DisposeConstruction() error {
+	if p.beforeDispose != nil {
+		p.beforeDispose()
+	}
+	return p.constructionProbe.DisposeConstruction()
+}
+func (*replacementScopeProbe) Dependencies() []string { return nil }
+
+func TestReplacementFailureDoesNotPublishWithoutActiveParent(t *testing.T) {
+	for _, state := range []string{"no-parent", "closed", "transferred", "active"} {
+		for _, outcome := range []string{"error", "panic", "success"} {
+			t.Run(state+"/"+outcome, func(t *testing.T) {
+				ctx := context.Background()
+				var parent construction.Scope
+				if state != "no-parent" {
+					ctx = construction.WithScope(ctx, &parent)
+				}
+				switch state {
+				case "closed":
+					if err := parent.Close(); err != nil {
+						t.Fatal(err)
+					}
+				case "transferred":
+					if err := parent.TransferAll().Close(); err != nil {
+						t.Fatal(err)
+					}
+				}
+				logger := log.NewNOPFactory().Logger()
+				failure := errors.New("replaced child cleanup failed")
+				oldDisposed, newDisposed := 0, 0
+				old := &replacementScopeProbe{constructionProbe: constructionProbe{tag: "probe", closed: &oldDisposed}}
+				next := &replacementScopeProbe{constructionProbe: constructionProbe{tag: "probe", closed: &newDisposed}}
+				registry := NewTransportRegistry()
+				child := old
+				RegisterTransport[struct{}](registry, "replacement-factory", func(_ context.Context, _ log.ContextLogger, _ string, _ struct{}) (adapter.DNSTransport, error) {
+					return child, nil
+				})
+				m := NewTransportManager(logger, registry, nil, "")
+				if err := m.Create(context.Background(), logger, "probe", "replacement-factory", nil); err != nil {
+					t.Fatal(err)
+				}
+				if outcome == "error" {
+					old.failure = failure
+				}
+				if outcome == "panic" {
+					old.panicOnClose = true
+				}
+				old.beforeDispose = func() {
+					expected := old
+					if state == "active" {
+						expected = next
+					}
+					if m.transportByTag["probe"] != expected || len(m.transports) != 1 || m.transports[0] != expected {
+						t.Error("replacement disposal observed an unexpected publication")
+					}
+				}
+				next.beforeDispose = func() {
+					if m.transportByTag["probe"] != old || len(m.transports) != 1 || m.transports[0] != old {
+						t.Error("failed replacement child was published before rollback")
+					}
+				}
+				child = next
+				err := m.Create(ctx, logger, "probe", "replacement-factory", nil)
+				if state == "active" {
+					if err != nil {
+						t.Fatalf("active construction parent lost prompt return: %v", err)
+					}
+					if oldDisposed != 0 || newDisposed != 0 {
+						t.Fatal("active parent disposal ran synchronously")
+					}
+					if m.transportByTag["probe"] != next || len(m.transports) != 1 || m.transports[0] != next {
+						t.Fatal("successful child was not published")
+					}
+					err = parent.Close()
+				}
+				switch outcome {
+				case "error":
+					if !errors.Is(err, failure) {
+						t.Fatalf("replacement cleanup error was lost: %v", err)
+					}
+				case "panic":
+					if err == nil || !strings.Contains(err.Error(), "injected cleanup panic") {
+						t.Fatalf("replacement cleanup panic was lost: %v", err)
+					}
+				default:
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+				failed := state != "active" && outcome != "success"
+				if failed {
+					if m.transportByTag["probe"] != old || len(m.transports) != 1 || m.transports[0] != old {
+						t.Fatal("failed Create published its new child")
+					}
+					if oldDisposed != 1 || newDisposed != 1 {
+						t.Fatalf("replacement/rollback disposal = %d/%d", oldDisposed, newDisposed)
+					}
+				} else {
+					if m.transportByTag["probe"] != next || len(m.transports) != 1 || m.transports[0] != next {
+						t.Fatal("successful Create did not publish its child")
+					}
+					if oldDisposed != 1 || newDisposed != 0 {
+						t.Fatalf("replacement/published disposal = %d/%d", oldDisposed, newDisposed)
+					}
+				}
+				if err = parent.Close(); err != nil {
+					t.Fatal(err)
+				}
+				if oldDisposed != 1 || (failed && newDisposed != 1) || (!failed && newDisposed != 0) {
+					t.Fatal("scope retried current-operation disposal")
+				}
+			})
+		}
+	}
+}
diff --git a/dns/transport_manager_terminal_scope_test.go b/dns/transport_manager_terminal_scope_test.go
new file mode 100644
index 0000000..8510005
--- /dev/null
+++ b/dns/transport_manager_terminal_scope_test.go
@@ -0,0 +1,84 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/construction"
+	"github.com/sagernet/sing-box/log"
+	"testing"
+)
+
+type terminalFactoryProbe struct{ constructionProbe }
+
+func (terminalFactoryProbe) Dependencies() []string { return nil }
+
+func TestTerminalContextFactoryCleanupAndSuccessfulPublication(t *testing.T) {
+	for _, transfer := range []bool{false, true} {
+		for _, result := range []string{"object-error", "internal-error", "published"} {
+			t.Run(map[bool]string{false: "closed", true: "transferred"}[transfer]+"/"+result, func(t *testing.T) {
+				var parent construction.Scope
+				ctx := construction.WithScope(context.Background(), &parent)
+				if transfer {
+					if err := parent.TransferAll().Close(); err != nil {
+						t.Fatal(err)
+					}
+				} else if err := parent.Close(); err != nil {
+					t.Fatal(err)
+				}
+				logger := log.NewNOPFactory().Logger()
+				failure := errors.New("late factory failed")
+				cleanupFailure := errors.New("late cleanup failed")
+				disposed, internal := 0, 0
+				registry := NewTransportRegistry()
+				RegisterTransport[struct{}](registry, "terminal-factory", func(ctx context.Context, _ log.ContextLogger, tag string, _ struct{}) (adapter.DNSTransport, error) {
+					if result == "internal-error" {
+						token := construction.Register(ctx, "internal late acquire", func() error { internal++; return cleanupFailure })
+						if token.Err() != nil {
+							t.Fatalf("current factory has no live scope: %v", token.Err())
+						}
+						return nil, failure
+					}
+					child := terminalFactoryProbe{constructionProbe{tag: tag, closed: &disposed}}
+					if result == "object-error" {
+						child.failure = cleanupFailure
+						return child, failure
+					}
+					return child, nil
+				})
+				m := NewTransportManager(logger, registry, nil, "")
+				err := m.Create(ctx, logger, "probe", "terminal-factory", nil)
+				if result == "published" {
+					if err != nil {
+						t.Fatal(err)
+					}
+					if disposed != 0 {
+						t.Fatal("scope destroyed a successfully published child")
+					}
+					if err = m.Close(); err != nil {
+						t.Fatal(err)
+					}
+					if err = m.Close(); err != nil {
+						t.Fatal(err)
+					}
+					if disposed != 1 {
+						t.Fatalf("published child disposal count = %d", disposed)
+					}
+				} else {
+					if !errors.Is(err, failure) || !errors.Is(err, cleanupFailure) {
+						t.Fatalf("current operation lost constructor or cleanup error: %v", err)
+					}
+					if result == "object-error" && disposed != 1 || result == "internal-error" && internal != 1 {
+						t.Fatalf("late cleanup was stranded: object/internal = %d/%d", disposed, internal)
+					}
+					if err = parent.Close(); err != nil {
+						t.Fatal(err)
+					}
+					if result == "object-error" && disposed != 1 || result == "internal-error" && internal != 1 {
+						t.Fatal("terminated parent reclaimed current operation's resource twice")
+					}
+				}
+			})
+		}
+	}
+}
