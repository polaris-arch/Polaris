 	m.services = append(m.services, service)
+	owned = true
 	m.serviceByTag[tag] = service
+	if m.runtimeOwners == nil {
+		m.runtimeOwners = make(map[string]bool)
+	}
+	m.runtimeOwners[tag] = runtimeOwned
 	return nil
 }
+
+// markRuntimeOwner records this child's successful runtime Start, never manager initialization.
+func (m *Manager) markRuntimeOwner(tag string) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	if m.runtimeOwners == nil {
+		m.runtimeOwners = make(map[string]bool)
+	}
+	m.runtimeOwners[tag] = true
+}
