@@ -0,0 +1,97 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/construction"
+	"github.com/sagernet/sing-box/log"
+	"testing"
+)
+
+type publishedHandleProbe struct {
+	constructionProbe
+	internal *int
+}
+
+func (p publishedHandleProbe) DisposeConstruction() error {
+	*p.internal++
+	return p.constructionProbe.DisposeConstruction()
+}
+
+func TestTerminalContextFactoryCleanupAndSuccessfulPublication(t *testing.T) {
+	for _, transfer := range []bool{false, true} {
+		for _, result := range []string{"object-error", "internal-error", "published"} {
+			t.Run(map[bool]string{false: "closed", true: "transferred"}[transfer]+"/"+result, func(t *testing.T) {
+				var parent construction.Scope
+				ctx := construction.WithScope(context.Background(), &parent)
+				if transfer {
+					if err := parent.TransferAll().Close(); err != nil {
+						t.Fatal(err)
+					}
+				} else if err := parent.Close(); err != nil {
+					t.Fatal(err)
+				}
+				logger := log.NewNOPFactory().Logger()
+				failure := errors.New("late factory failed")
+				cleanupFailure := errors.New("late cleanup failed")
+				disposed, internal := 0, 0
+				registry := NewRegistry()
+				Register[struct{}](registry, "terminal-factory", func(ctx context.Context, _ log.ContextLogger, tag string, _ struct{}) (adapter.Service, error) {
+					if result == "internal-error" {
+						token := construction.Register(ctx, "internal late acquire", func() error { internal++; return cleanupFailure })
+						if token.Err() != nil {
+							t.Fatalf("current factory has no live scope: %v", token.Err())
+						}
+						return nil, failure
+					}
+					child := constructionProbe{tag: tag, closed: &disposed}
+					if result == "object-error" {
+						child.failure = cleanupFailure
+						return child, failure
+					}
+					token := construction.Register(ctx, "published internal handle", func() error { internal++; return nil })
+					if token.Err() != nil {
+						t.Fatal(token.Err())
+					}
+					if err := token.Transfer(); err != nil {
+						t.Fatal(err)
+					}
+					return publishedHandleProbe{child, &internal}, nil
+				})
+				m := NewManager(logger, registry)
+				err := m.Create(ctx, logger, "probe", "terminal-factory", nil)
+				if result == "published" {
+					if err != nil {
+						t.Fatal(err)
+					}
+					if disposed != 0 || internal != 0 {
+						t.Fatal("scope destroyed a successfully published child")
+					}
+					if err = m.Close(); err != nil {
+						t.Fatal(err)
+					}
+					if err = m.Close(); err != nil {
+						t.Fatal(err)
+					}
+					if disposed != 1 || internal != 1 {
+						t.Fatalf("published child disposal count = %d", disposed)
+					}
+				} else {
+					if !errors.Is(err, failure) || !errors.Is(err, cleanupFailure) {
+						t.Fatalf("current operation lost constructor or cleanup error: %v", err)
+					}
+					if result == "object-error" && disposed != 1 || result == "internal-error" && internal != 1 {
+						t.Fatalf("late cleanup was stranded: object/internal = %d/%d", disposed, internal)
+					}
+					if err = parent.Close(); err != nil {
+						t.Fatal(err)
+					}
+					if result == "object-error" && disposed != 1 || result == "internal-error" && internal != 1 {
+						t.Fatal("terminated parent reclaimed current operation's resource twice")
+					}
+				}
+			})
+		}
+	}
+}
