diff --git a/protocol/direct/disposition.go b/protocol/direct/disposition.go
new file mode 100644
index 0000000..907df5f
--- /dev/null
+++ b/protocol/direct/disposition.go
@@ -0,0 +1,12 @@
+package direct
+
+import "github.com/sagernet/sing-box/common/construction"
+
+// DisposeConstruction is restricted to the same unstarted native validation
+// leaf admitted by Box. Ordinary Direct Close does not establish a proof.
+func (h *Outbound) DisposeConstruction() error {
+	if !h.isEmpty {
+		return construction.ErrUnknownDisposal
+	}
+	return construction.DisposeObserved(h.ctx, h, h.Close)
+}
diff --git a/protocol/direct/disposition_test.go b/protocol/direct/disposition_test.go
new file mode 100644
index 0000000..47ef402
--- /dev/null
+++ b/protocol/direct/disposition_test.go
@@ -0,0 +1,28 @@
+package direct
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing-box/common/construction"
+	"testing"
+)
+
+func TestConstructionDispositionRequiresExactObservedLeaf(t *testing.T) {
+	h := &Outbound{ctx: context.Background(), isEmpty: true}
+	if h.Close() != nil {
+		t.Fatal("ordinary Close behavior changed")
+	}
+	if !errors.Is(h.DisposeConstruction(), construction.ErrUnknownDisposal) {
+		t.Fatal("unbound ordinary nil Close minted disposal")
+	}
+	observation := new(construction.Observation)
+	h.ctx = construction.WithObservation(context.Background(), observation)
+	other := &Outbound{ctx: h.ctx, isEmpty: true}
+	observation.BindDisposer(other)
+	if !errors.Is(h.DisposeConstruction(), construction.ErrUnknownDisposal) {
+		t.Fatal("different original leaf borrowed admission")
+	}
+	if observation.LeafCompleted() {
+		t.Fatal("wrong leaf promoted")
+	}
+}
