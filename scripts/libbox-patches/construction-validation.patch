+// SupportsBoundValidationProfile bounds the audited native constructor surface.
+// This is eligibility only: options never prove acquisition or disposal.
+func SupportsBoundValidationProfile(options option.Options) bool {
+	if options.Log == nil || options.Log.Disabled || options.Log.Output != "" ||
+		options.Certificate == nil || !reflect.DeepEqual(*options.Certificate, option.CertificateOptions{Store: C.CertificateStoreNone}) ||
+		len(options.Outbounds) != 1 || options.Outbounds[0].Type != C.TypeDirect || options.Outbounds[0].Tag == "" ||
+		options.Route == nil || !reflect.DeepEqual(*options.Route, option.RouteOptions{Final: options.Outbounds[0].Tag}) {
+		return false
+	}
+	directOptions, ok := options.Outbounds[0].Options.(*option.DirectOutboundOptions)
+	if !ok || directOptions == nil || !reflect.DeepEqual(*directOptions, option.DirectOutboundOptions{}) {
+		return false
+	}
+	// Unknown/new fields stay nonzero here and cannot silently join this profile.
+	options.RawMessage, options.CommentsSet, options.Schema = nil, nil, ""
+	options.Log, options.Certificate, options.Outbounds, options.Route = nil, nil, nil, nil
+	return reflect.DeepEqual(options, option.Options{})
+}
