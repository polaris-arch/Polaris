new file mode 100644
index 0000000..2108245
--- /dev/null
+++ b/adapter/outbound/manager_replacement_scope_test.go
@@ -0,0 +1,133 @@
+package outbound
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/construction"
+	"github.com/sagernet/sing-box/log"
+)
+
+type replacementScopeProbe struct {
+	constructionProbe
+	beforeDispose func()
+}
+
+func (p *replacementScopeProbe) DisposeConstruction() error {
+	if p.beforeDispose != nil {
+		p.beforeDispose()
+	}
+	return p.constructionProbe.DisposeConstruction()
+}
+func (*replacementScopeProbe) Dependencies() []string { return nil }
+
+func TestReplacementFailureDoesNotPublishWithoutActiveParent(t *testing.T) {
+	for _, state := range []string{"no-parent", "closed", "transferred", "active"} {
+		for _, outcome := range []string{"error", "panic", "success"} {
+			t.Run(state+"/"+outcome, func(t *testing.T) {
+				ctx := context.Background()
+				var parent construction.Scope
+				if state != "no-parent" {
+					ctx = construction.WithScope(ctx, &parent)
+				}
+				switch state {
+				case "closed":
+					if err := parent.Close(); err != nil {
+						t.Fatal(err)
+					}
+				case "transferred":
+					if err := parent.TransferAll().Close(); err != nil {
+						t.Fatal(err)
+					}
+				}
+				logger := log.NewNOPFactory().Logger()
+				failure := errors.New("replaced child cleanup failed")
+				oldDisposed, newDisposed := 0, 0
+				old := &replacementScopeProbe{constructionProbe: constructionProbe{tag: "probe", closed: &oldDisposed}}
+				next := &replacementScopeProbe{constructionProbe: constructionProbe{tag: "probe", closed: &newDisposed}}
+				registry := NewRegistry()
+				child := old
+				Register[struct{}](registry, "replacement-factory", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, _ string, _ struct{}) (adapter.Outbound, error) {
+					return child, nil
+				})
+				m := NewManager(logger, registry, noEndpoints{}, "")
+				if err := m.Create(context.Background(), nil, logger, "probe", "replacement-factory", nil); err != nil {
+					t.Fatal(err)
+				}
+				if outcome == "error" {
+					old.failure = failure
+				}
+				if outcome == "panic" {
+					old.panicOnClose = true
+				}
+				old.beforeDispose = func() {
+					expected := old
+					if state == "active" {
+						expected = next
+					}
+					if m.outboundByTag["probe"] != expected || len(m.outbounds) != 1 || m.outbounds[0] != expected {
+						t.Error("replacement disposal observed an unexpected publication")
+					}
+				}
+				next.beforeDispose = func() {
+					if m.outboundByTag["probe"] != old || len(m.outbounds) != 1 || m.outbounds[0] != old {
+						t.Error("failed replacement child was published before rollback")
+					}
+				}
+				child = next
+				err := m.Create(ctx, nil, logger, "probe", "replacement-factory", nil)
+				if state == "active" {
+					if err != nil {
+						t.Fatalf("active construction parent lost prompt return: %v", err)
+					}
+					if oldDisposed != 0 || newDisposed != 0 {
+						t.Fatal("active parent disposal ran synchronously")
+					}
+					if m.outboundByTag["probe"] != next || len(m.outbounds) != 1 || m.outbounds[0] != next {
+						t.Fatal("successful child was not published")
+					}
+					err = parent.Close()
+				}
+				switch outcome {
+				case "error":
+					if !errors.Is(err, failure) {
+						t.Fatalf("replacement cleanup error was lost: %v", err)
+					}
+				case "panic":
+					if err == nil || !strings.Contains(err.Error(), "injected cleanup panic") {
+						t.Fatalf("replacement cleanup panic was lost: %v", err)
+					}
+				default:
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+				failed := state != "active" && outcome != "success"
+				if failed {
+					if m.outboundByTag["probe"] != old || len(m.outbounds) != 1 || m.outbounds[0] != old {
+						t.Fatal("failed Create published its new child")
+					}
+					if oldDisposed != 1 || newDisposed != 1 {
+						t.Fatalf("replacement/rollback disposal = %d/%d", oldDisposed, newDisposed)
+					}
+				} else {
+					if m.outboundByTag["probe"] != next || len(m.outbounds) != 1 || m.outbounds[0] != next {
+						t.Fatal("successful Create did not publish its child")
+					}
+					if oldDisposed != 1 || newDisposed != 0 {
+						t.Fatalf("replacement/published disposal = %d/%d", oldDisposed, newDisposed)
+					}
+				}
+				if err = parent.Close(); err != nil {
+					t.Fatal(err)
+				}
+				if oldDisposed != 1 || (failed && newDisposed != 1) || (!failed && newDisposed != 0) {
+					t.Fatal("scope retried current-operation disposal")
+				}
+			})
+		}
+	}
+}
