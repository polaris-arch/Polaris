+package construction
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+)
+
+func TestRollbackOrderTransferAndErrorContinuation(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	var closed []string
+	failure := errors.New("injected close error")
+	Register(ctx, "first", func() error { closed = append(closed, "first"); return nil })
+	Register(ctx, "parent-owned", func() error { t.Fatal("transferred resource closed"); return nil }).Transfer()
+	Register(ctx, "error", func() error { closed = append(closed, "error"); return failure })
+	Register(ctx, "panic", func() error { closed = append(closed, "panic"); panic("injected") })
+	if err := scope.Close(); !errors.Is(err, failure) {
+		t.Fatalf("rollback = %v", err)
+	}
+	if !reflect.DeepEqual(closed, []string{"panic", "error", "first"}) {
+		t.Fatal(closed)
+	}
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type disposalProbe struct{ disposed, runtimeClosed *int }
+
+func (p disposalProbe) DisposeConstruction() error { *p.disposed++; return nil }
+func (p disposalProbe) Close() error               { *p.runtimeClosed++; return nil }
+
+func TestReplacementDisposalSurvivesCompletedParentTransfer(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	disposed, runtimeClosed := 0, 0
+	if err := Replace(ctx, "replaced child", disposalProbe{&disposed, &runtimeClosed}, false); err != nil {
+		t.Fatal(err)
+	}
+	Register(ctx, "completed parent", func() error { t.Fatal("parent ownership was transferred"); return nil })
+	cleanup := scope.TransferAll()
+	if err := cleanup.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if disposed != 1 || runtimeClosed != 0 {
+		t.Fatalf("disposal/runtime Close = %d/%d", disposed, runtimeClosed)
+	}
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if disposed != 1 {
+		t.Fatal("replacement disposed twice")
+	}
+}
+
+func TestPartialConstructorInternalAcquisition(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	closed := 0
+	constructor := func() error {
+		Register(ctx, "internal handle", func() error { closed++; return nil })
+		return errors.New("failure after first acquire")
+	}
+	if err := constructor(); err == nil {
+		t.Fatal("fault missing")
+	}
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if closed != 1 {
+		t.Fatalf("internal close count = %d", closed)
+	}
+}
+
+func TestObservedFirstCloseCannotBeReplacedByDuplicateNil(t *testing.T) {
+	observation := new(Observation)
+	var scope Scope
+	WithScope(WithObservation(context.Background(), observation), &scope)
+	entered, release, finished := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	scope.Add("actual member", func() error { close(entered); <-release; return nil })
+	go func() { scope.Close(); close(finished) }()
+	<-entered
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if scope.ObservedCompletion([]string{"actual member"}, false) {
+		t.Fatal("duplicate nil replaced original pending callback")
+	}
+	close(release)
+	<-finished
+	if !scope.ObservedCompletion([]string{"actual member"}, false) {
+		t.Fatal("actual first callback completion not observed")
+	}
+}
+
+func TestObservedTransferResidualAndLateMembership(t *testing.T) {
+	for _, mode := range []string{"transfer", "extra", "error", "panic", "late"} {
+		t.Run(mode, func(t *testing.T) {
+			var scope Scope
+			ctx := WithScope(WithObservation(context.Background(), new(Observation)), &scope)
+			entry := Register(ctx, "member", func() error {
+				if mode == "error" {
+					return errors.New("actual failure")
+				}
+				if mode == "panic" {
+					panic("actual cleanup panic")
+				}
+				return nil
+			})
+			if mode == "transfer" {
+				if err := entry.Transfer(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if mode == "extra" {
+				Register(ctx, "unreviewed", func() error { return nil })
+			}
+			scope.Close()
+			if mode == "late" {
+				late := Register(ctx, "late", func() error { return nil })
+				if late.Err() == nil {
+					t.Fatal("late admitted")
+				}
+				late.Close()
+			}
+			if scope.ObservedCompletion([]string{"member"}, false) {
+				t.Fatal("unobserved or incomplete original disposition promoted")
+			}
+		})
+	}
+	var scope Scope
+	ctx := WithScope(WithObservation(context.Background(), new(Observation)), &scope)
+	child, complete := Begin(ctx)
+	entered, release, finished := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	Register(child, "actual residual", func() error { close(entered); <-release; return nil })
+	if err := complete(false); err != nil {
+		t.Fatal(err)
+	}
+	go func() { scope.Close(); close(finished) }()
+	<-entered
+	if scope.ObservedCompletion([]string{"failed factory operation"}, false) {
+		t.Fatal("pending residual promoted")
+	}
+	close(release)
+	<-finished
+	// This native profile has no factory acquisitions. Even a drained additional
+	// member remains outside that finite reviewed census.
+	if scope.ObservedCompletion([]string{"failed factory operation"}, false) {
+		t.Fatal("unreviewed child membership erased")
+	}
+}
+
+func TestObservedDisposerPreservesInvalidationAcrossPendingReturn(t *testing.T) {
+	observation := new(Observation)
+	ctx := WithObservation(context.Background(), observation)
+	leaf := new(int)
+	observation.BindDisposer(leaf)
+	entered, release, finished := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		DisposeObserved(ctx, leaf, func() error { close(entered); <-release; return nil })
+		close(finished)
+	}()
+	<-entered
+	if observation.LeafCompleted() {
+		t.Fatal("pending leaf counted as completed")
+	}
+	if !errors.Is(DisposeObserved(ctx, leaf, func() error { t.Fatal("duplicate disposed"); return nil }), ErrUnknownDisposal) {
+		t.Fatal("duplicate admission")
+	}
+	observation.Invalidate()
+	close(release)
+	<-finished
+	if observation.LeafCompleted() {
+		t.Fatal("late return erased sticky invalidation")
+	}
+}
