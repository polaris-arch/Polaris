+++ b/box_construction_test.go
@@ -0,0 +1,215 @@
+package box
+
+import (
+	"context"
+	"errors"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	boxCertificate "github.com/sagernet/sing-box/adapter/certificate"
+	"github.com/sagernet/sing-box/adapter/endpoint"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	boxService "github.com/sagernet/sing-box/adapter/service"
+	"github.com/sagernet/sing-box/common/construction"
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+type constructedService struct {
+	adapter.Service
+	tag          string
+	closed       *int
+	cleanupError error
+}
+
+func TestOrdinaryNewPropagatesErrorOrPanicWithoutWaitingForBlockedRollback(t *testing.T) {
+	for _, panicConstructor := range []bool{false, true} {
+		t.Run(strconv.FormatBool(panicConstructor), func(t *testing.T) {
+			entered, release, disposed := make(chan struct{}), make(chan struct{}), make(chan struct{})
+			registry := boxService.NewRegistry()
+			failure := errors.New("ordinary constructor failure")
+			boxService.Register[struct{}](registry, "blocking-rollback", func(ctx context.Context, _ log.ContextLogger, _ string, _ struct{}) (adapter.Service, error) {
+				construction.Register(ctx, "blocked acquired resource", func() error {
+					close(entered)
+					<-release
+					close(disposed)
+					return nil
+				})
+				if panicConstructor {
+					panic("ordinary constructor panic")
+				}
+				return nil, failure
+			})
+			ctx := Context(context.Background(), inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry(), dns.NewTransportRegistry(), registry, boxCertificate.NewRegistry())
+			done := make(chan any, 1)
+			go func() {
+				defer func() {
+					if p := recover(); p != nil {
+						done <- p
+					}
+				}()
+				_, err := New(Options{Context: ctx, Options: option.Options{Log: &option.LogOptions{Disabled: true}, Services: []option.Service{{Type: "blocking-rollback"}}}})
+				done <- err
+			}()
+			select {
+			case result := <-done:
+				if panicConstructor {
+					if result != "ordinary constructor panic" {
+						t.Fatalf("panic changed: %v", result)
+					}
+				} else if err, ok := result.(error); !ok || !errors.Is(err, failure) {
+					t.Fatalf("error changed: %v", result)
+				}
+			case <-time.After(time.Second):
+				close(release)
+				t.Fatal("ordinary New waited for blocked cleanup")
+			}
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				close(release)
+				t.Fatal("rollback lost acquired resource")
+			}
+			close(release)
+			select {
+			case <-disposed:
+			case <-time.After(time.Second):
+				t.Fatal("rollback failed to complete after release")
+			}
+		})
+	}
+}
+
+func (s *constructedService) Type() string               { return "construction-probe" }
+func (s *constructedService) Tag() string                { return s.tag }
+func (s *constructedService) Close() error               { *s.closed++; return s.cleanupError }
+func (s *constructedService) DisposeConstruction() error { return s.Close() }
+
+func TestNewRollbackAtEveryServiceConstructor(t *testing.T) {
+	for nth := 0; nth < 4; nth++ {
+		t.Run(strconv.Itoa(nth), func(t *testing.T) {
+			failure := errors.New("injected constructor failure")
+			cleanupFailure := errors.New("injected internal cleanup failure")
+			closed := make([]int, 4)
+			internalClosed := 0
+			registry := boxService.NewRegistry()
+			index := 0
+			boxService.Register[struct{}](registry, "construction-probe", func(ctx context.Context, _ log.ContextLogger, tag string, _ struct{}) (adapter.Service, error) {
+				current := index
+				index++
+				child := &constructedService{tag: tag, closed: &closed[current]}
+				if current == nth {
+					// Model an internal acquire followed by nil/error, and a
+					// constructor returning both its partial object and error.
+					construction.Register(ctx, "internal probe", func() error { internalClosed++; return cleanupFailure })
+					return child, failure
+				}
+				return child, nil
+			})
+			ctx := Context(context.Background(), inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry(), dns.NewTransportRegistry(), registry, boxCertificate.NewRegistry())
+			options := option.Options{Log: &option.LogOptions{Disabled: true}}
+			for i := 0; i < 4; i++ {
+				options.Services = append(options.Services, option.Service{Type: "construction-probe", Tag: strconv.Itoa(i)})
+			}
+			instance, err, report := NewWithConstructionReport(Options{Context: ctx, Options: options})
+			if instance != nil || !errors.Is(err, failure) {
+				t.Fatalf("New = %v, %v", instance, err)
+			}
+			if err.Error() != "initialize service["+strconv.Itoa(nth)+"]: injected constructor failure" {
+				t.Fatalf("config error changed: %v", err)
+			}
+			if !report.Attempted || !errors.Is(report.CleanupError, cleanupFailure) {
+				t.Fatalf("report = %+v", report)
+			}
+			for i := 0; i < 4; i++ {
+				want := 0
+				if i <= nth {
+					want = 1
+				}
+				if closed[i] != want {
+					t.Fatalf("child %d close = %d, want %d", i, closed[i], want)
+				}
+			}
+			if internalClosed != 1 {
+				t.Fatalf("internal close = %d", internalClosed)
+			}
+		})
+	}
+}
+
+func TestNewTransfersCompleteUnstartedConstruction(t *testing.T) {
+	closed := 0
+	registry := boxService.NewRegistry()
+	boxService.Register[struct{}](registry, "construction-probe", func(_ context.Context, _ log.ContextLogger, tag string, _ struct{}) (adapter.Service, error) {
+		return &constructedService{tag: tag, closed: &closed}, nil
+	})
+	ctx := Context(context.Background(), inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry(), dns.NewTransportRegistry(), registry, boxCertificate.NewRegistry())
+	instance, err := New(Options{Context: ctx, Options: option.Options{Log: &option.LogOptions{Disabled: true}, Services: []option.Service{{Type: "construction-probe", Tag: "one"}}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if closed != 0 {
+		t.Fatal("resource closed before ownership transfer")
+	}
+	if err = instance.CloseWithResult(); err != nil {
+		t.Fatal(err)
+	}
+	if closed != 1 {
+		t.Fatalf("unstarted child close = %d", closed)
+	}
+	if err = instance.CloseWithResult(); err != nil {
+		t.Fatal(err)
+	}
+	if closed != 1 {
+		t.Fatal("resource closed twice")
+	}
+}
+
+func TestNewRollbackAfterCancellationOrConstructorPanic(t *testing.T) {
+	for _, panicConstructor := range []bool{false, true} {
+		t.Run(strconv.FormatBool(panicConstructor), func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			closed := 0
+			registry := boxService.NewRegistry()
+			index := 0
+			boxService.Register[struct{}](registry, "construction-probe", func(ctx context.Context, _ log.ContextLogger, tag string, _ struct{}) (adapter.Service, error) {
+				index++
+				if index == 2 {
+					if panicConstructor {
+						panic("injected construction panic")
+					}
+					cancel()
+				}
+				return &constructedService{tag: tag, closed: &closed}, nil
+			})
+			ctx = Context(ctx, inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry(), dns.NewTransportRegistry(), registry, boxCertificate.NewRegistry())
+			options := Options{Context: ctx, Options: option.Options{Log: &option.LogOptions{Disabled: true}, Services: []option.Service{{Type: "construction-probe", Tag: "first"}, {Type: "construction-probe", Tag: "second"}, {Type: "construction-probe", Tag: "never"}}}}
+			if panicConstructor {
+				func() {
+					defer func() {
+						if recover() == nil {
+							t.Fatal("constructor panic disappeared")
+						}
+					}()
+					NewWithConstructionReport(options)
+				}()
+				if closed != 1 {
+					t.Fatalf("panic rollback closed %d children", closed)
+				}
+			} else {
+				instance, err, _ := NewWithConstructionReport(options)
+				if instance != nil || !errors.Is(err, context.Canceled) {
+					t.Fatalf("canceled New = %v, %v", instance, err)
+				}
+				if closed != 2 || index != 2 {
+					t.Fatalf("cancellation closed %d children, entered %d constructors", closed, index)
+				}
+			}
+		})
+	}
+}
