+// ObservedValidationDisposition consumes the same report, original Scope and
+// exact Box close completion. It is not a receipt for started boxes, custom
+// factories, unrelated scopes, empty members, or an ordinary nil Close.
+func (r ConstructionReport) ObservedValidationDisposition(instance *Box) bool {
+	if !r.profile || !r.Attempted || r.CleanupError != nil || r.scope == nil || r.observation == nil || r.context == nil || r.context.Err() != nil || !r.context.completed() || !r.observation.LeafCompleted() {
+		return false
+	}
+	if instance == nil {
+		return r.instance == nil && r.partialLog && r.scope.ObservedCompletion([]string{"partial log factory"}, false)
+	}
+	if instance != r.instance || instance.validationStarted.Load() || r.monitor == nil || !r.monitor.completed() {
+		return false
+	}
+	select {
+	case <-instance.closeFinished:
+	default:
+		return false
+	}
+	if instance.closeResult != nil {
+		return false
+	}
+	return r.scope.ObservedCompletion([]string{
+		"logger", "certificate store", "network namespace manager", "endpoint manager", "inbound manager", "outbound manager", "DNS transport manager", "service manager", "certificate provider manager", "DNS router", "connection manager", "network manager", "HTTP client manager", "router", "reference manager",
+	}, true)
+}
+
+// validationContext preserves the original worker's cancellation/deadline and
+// deliberately inherits no service/registry/platform values from its caller.
+type validationContext struct {
+	context.Context
+	access    sync.Mutex
+	callbacks []*validationCancellation
+	finishing bool
+	finished  bool
+	late      bool
+	cancel    context.CancelFunc
+}
+
+func (*validationContext) Value(any) any { return nil }
+
+type validationCancellation struct {
+	stop    func() bool
+	done    chan struct{}
+	once    sync.Once
+	stopped bool
+}
+
+func (c *validationCancellation) stopAndJoin() bool {
+	c.once.Do(func() {
+		c.stopped = c.stop()
+		if !c.stopped {
+			<-c.done
+		}
+	})
+	return c.stopped
+}
+
+// WithCancel's original propagation uses this standard AfterFunc adapter rather
+// than acquiring an unobserved fallback goroutine because Value is isolated.
+// A false stop must join the actual original callback return, never merely Done.
+func (c *validationContext) AfterFunc(callback func()) func() bool {
+	entry := &validationCancellation{done: make(chan struct{})}
+	c.access.Lock()
+	if c.finishing {
+		c.late = true
+	}
+	entry.stop = context.AfterFunc(c.Context, func() { defer close(entry.done); callback() })
+	c.callbacks = append(c.callbacks, entry)
+	c.access.Unlock()
+	return entry.stopAndJoin
+}
+func (c *validationContext) finish() {
+	if c.cancel != nil {
+		c.cancel()
+	}
+	c.access.Lock()
+	c.finishing = true
+	entries := append([]*validationCancellation(nil), c.callbacks...)
+	c.access.Unlock()
+	for _, entry := range entries {
+		entry.stopAndJoin()
+	}
+	c.access.Lock()
+	c.finished = true
+	c.access.Unlock()
+}
+func (c *validationContext) completed() bool {
+	c.access.Lock()
+	defer c.access.Unlock()
+	return c.finished && !c.late
+}
+
+// ConstructAndDisposeBoundValidation retains the qualified Box/report through
+// the original Close. No qualified instance escapes to a caller before its
+// reviewed construction/cleanup facts are consumed.
+func ConstructAndDisposeBoundValidation(options Options, worker *ValidationWorker) (error, error, bool) {
+	instance, validationErr, report := newWithBoundValidationReport(options, worker)
+	if validationErr != nil {
+		return validationErr, report.CleanupError, report.ObservedValidationDisposition(nil)
+	}
+	cleanupErr := errors.Join(report.CleanupError, instance.CloseWithResult())
+	return nil, cleanupErr, report.ObservedValidationDisposition(instance)
+}
+
+// newWithBoundValidationReport owns the finite native factory provenance. It
+// does not execute a supplied factory or platform, and never exposes its private
+// qualification context before the original constructor/cleanup returns.
+func newWithBoundValidationReport(options Options, worker *ValidationWorker) (*Box, error, ConstructionReport) {
+	// Only the original context privately created by this lifetime is admitted.
+	// An arbitrary parent/AfterFunc implementation or wrapper cannot borrow it.
+	if worker == nil || worker.ctx == nil || options.Context != worker.ctx {
+		return nil, construction.ErrUnknownDisposal, ConstructionReport{}
+	}
+	if !SupportsBoundValidationProfile(options.Options) || options.PlatformLogWriter != nil || len(options.NetworkNamespaceHolderArgs) != 0 {
+		return NewWithConstructionReport(options)
+	}
+	parent := worker.ctx
+	nativeOutbound := outbound.NewRegistry()
+	direct.RegisterOutbound(nativeOutbound)
+	controlled := &validationContext{Context: parent}
+	// The propagation owner is established before value wrappers, which do not
+	// preserve AfterFunc as an interface method. Subsequent original WithCancel
+	// children then discover this same standard child through its own Value key.
+	nativeContext, cancel := context.WithCancel(controlled)
+	controlled.cancel = cancel
+	ctx := Context(nativeContext, inbound.NewRegistry(), nativeOutbound, endpoint.NewRegistry(), dns.NewTransportRegistry(), boxService.NewRegistry(), boxCertificate.NewRegistry())
+	monitor := new(boundValidationMonitor)
+	ctx = service.ContextWith[adapter.PlatformInterface](ctx, &boundValidationPlatform{monitor: monitor})
+	options.Context, options.ObserveValidation, options.validationMonitor, options.validationContext = ctx, new(construction.Observation), monitor, controlled
+	return NewWithConstructionReport(options)
+}
+
+// Only these original constructor touchpoints are audited. The embedded nil
+// interfaces deliberately panic on any unexpected method, instead of pretending
+// that an unreviewed platform operation or resource succeeded.
+type boundValidationPlatform struct {
+	adapter.PlatformInterface
+	monitor *boundValidationMonitor
+}
+type boundValidationMonitor struct {
+	tun.DefaultInterfaceMonitor
+	access  sync.Mutex
+	started bool
+	closed  bool
+}
+
+func (p *boundValidationPlatform) UsePlatformDefaultInterfaceMonitor() bool { return true }
+func (p *boundValidationPlatform) CreateDefaultInterfaceMonitor(logger.Logger) tun.DefaultInterfaceMonitor {
+	return p.monitor
+}
+func (p *boundValidationPlatform) UsePlatformNetworkInterfaces() bool      { return false }
+func (p *boundValidationPlatform) Initialize(adapter.NetworkManager) error { return nil }
+func (m *boundValidationMonitor) Start() error {
+	m.access.Lock()
+	m.started = true
+	m.access.Unlock()
+	return os.ErrInvalid
+}
+func (m *boundValidationMonitor) Close() error {
+	m.access.Lock()
+	defer m.access.Unlock()
+	if m.closed {
+		return os.ErrClosed
+	}
+	m.closed = true
+	if m.started {
+		return construction.ErrUnknownDisposal
+	}
+	return nil
+}
+func (m *boundValidationMonitor) completed() bool {
+	m.access.Lock()
+	defer m.access.Unlock()
+	return m.closed && !m.started
+}
+
+// ValidationWorker owns the original standard timer/cancel context. Its private
+// context can neither be supplied nor replaced by an external implementation.
+// This lifetime is construction custody, never a global ownership receipt.
+type ValidationWorker struct {
+	ctx    context.Context
+	cancel context.CancelFunc
+}
+
+func NewValidationWorker(timeout time.Duration) *ValidationWorker {
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	return &ValidationWorker{ctx: ctx, cancel: cancel}
+}
+func (w *ValidationWorker) Context() context.Context { return w.ctx }
+func (w *ValidationWorker) Cancel() {
+	if w.cancel != nil {
+		w.cancel()
+	}
+}
