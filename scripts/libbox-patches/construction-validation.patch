+func TestObservedActualSubscriberCloseAndTransferCannotMintDisposition(t *testing.T) {
+	var scope construction.Scope
+	ctx := construction.WithScope(construction.WithObservation(context.Background(), new(construction.Observation)), &scope)
+	// NewDefaultFactory really acquires the original Subscriber's buffer/done.
+	// Subscribe/Start are intentionally absent: they would enter another lifecycle.
+	factory := log.NewDefaultFactory(ctx, log.Formatter{}, io.Discard, "", nil, false)
+	scope.Add("logger", factory.Close)
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if !scope.ObservedCompletion([]string{"logger"}, false) {
+		t.Fatal("actual Subscriber.Close return lost")
+	}
+	if !errors.Is(factory.Close(), os.ErrClosed) {
+		t.Fatal("first callback did not close the actual original Subscriber")
+	}
+	if (ConstructionReport{Attempted: true, scope: &scope}).ObservedValidationDisposition(nil) {
+		t.Fatal("one real member promoted to full Box disposition")
+	}
+	var transferred construction.Scope
+	construction.WithScope(construction.WithObservation(context.Background(), new(construction.Observation)), &transferred)
+	transferred.Add("logger", func() error { t.Fatal("transferred callback closed without its owner"); return nil })
+	transferred.TransferAll().Close()
+	if transferred.ObservedCompletion([]string{"logger"}, false) {
+		t.Fatal("transfer counted as original completion")
+	}
