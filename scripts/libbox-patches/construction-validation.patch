+func TestCloseInterleavedLateRegistrationAndCleanupHaveSeparateLiveOwners(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	entered, release, closed := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	Register(ctx, "first acquired", func() error { close(entered); <-release; return nil })
+	go func() { closed <- scope.Close() }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("rollback did not enter")
+	}
+	lateEntered, lateRelease, lateDone := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	go func() {
+		lateDone <- DeferCleanup(ctx, "late acquired", func() error { close(lateEntered); <-lateRelease; return nil })
+	}()
+	select {
+	case <-lateEntered:
+	case <-time.After(time.Second):
+		t.Fatal("late operation cleanup was stranded")
+	}
+	assertDetached(t, &scope)
+	select {
+	case <-closed:
+		t.Fatal("rollback returned while its callback was blocked")
+	default:
+	}
+	select {
+	case <-lateDone:
+		t.Fatal("late operation returned while its own callback was blocked")
+	default:
+	}
+	close(release)
+	if err := <-closed; err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-lateDone:
+		t.Fatal("scope completion impersonated late operation completion")
+	default:
+	}
+	close(lateRelease)
+	if err := <-lateDone; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRegisterTransferAndCloseRaceNeverLoseCleanup(t *testing.T) {
+	for i := 0; i < 300; i++ {
+		var scope Scope
+		ctx := WithScope(context.Background(), &scope)
+		var closed atomic.Int32
+		start := make(chan struct{})
+		registered := make(chan *Ownership, 1)
+		var tasks sync.WaitGroup
+		tasks.Add(3)
+		go func() {
+			defer tasks.Done()
+			<-start
+			registered <- Register(ctx, "raced acquire", func() error { closed.Add(1); return nil })
+		}()
+		go func() {
+			defer tasks.Done()
+			<-start
+			token := <-registered
+			if token.Err() != nil {
+				if err := token.Close(); err != nil {
+					t.Error(err)
+				}
+				return
+			}
+			if err := token.Transfer(); err == nil {
+				closed.Add(1)
+			} else if !errors.Is(err, ErrScopeTerminated) {
+				t.Error(err)
+			}
+		}()
+		go func() {
+			defer tasks.Done()
+			<-start
+			if err := scope.Close(); err != nil {
+				t.Error(err)
+			}
+		}()
+		close(start)
+		tasks.Wait()
+		if closed.Load() != 1 {
+			t.Fatalf("race %d released resource %d times", i, closed.Load())
+		}
+		assertDetached(t, &scope)
+	}
+}
+
+func TestDetachedReplacementBatchRetainsAnActualOwner(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	entered, release, done := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	if !scope.appendPending("replacement", func() error { close(entered); <-release; return nil }) {
+		t.Fatal("admission rejected")
+	}
+	Register(ctx, "published child", func() error { t.Error("published child was reclaimed by its former scope"); return nil })
+	cleanup := scope.TransferAll()
+	assertDetached(t, &scope)
+	go func() { done <- cleanup.Close() }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("detached batch was dropped")
+	}
+	if err := DeferCleanup(ctx, "later constructor", func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-done:
+		t.Fatal("detached owner returned before replacement cleanup")
+	default:
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestOwnershipCloseAndTransferRaceCannotPublishDisposedResource(t *testing.T) {
+	for i := 0; i < 300; i++ {
+		var scope Scope
+		var closed atomic.Int32
+		token := scope.Add("raced owner", func() error { closed.Add(1); return nil })
+		start := make(chan struct{})
+		var tasks sync.WaitGroup
+		tasks.Add(2)
+		go func() {
+			defer tasks.Done()
+			<-start
+			if err := token.Close(); err != nil {
+				t.Error(err)
+			}
+		}()
+		go func() {
+			defer tasks.Done()
+			<-start
+			if err := token.Transfer(); err == nil {
+				closed.Add(1)
+			} else if !errors.Is(err, ErrOwnershipReleased) {
+				t.Error(err)
+			}
+		}()
+		close(start)
+		tasks.Wait()
+		if err := scope.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if closed.Load() != 1 {
+			t.Fatalf("disposed resource was also published in race %d: closes=%d", i, closed.Load())
+		}
+	}
+}
