+++ b/service/ocm/construction_save_latch_test.go
@@ -0,0 +1,127 @@
+package ocm
+
+import (
+	"bytes"
+	"errors"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/service"
+	"github.com/sagernet/sing/service/filemanager"
+	"net"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// This blocks the real WriteFile path immediately before opening/truncating a
+// real temporary fixture, rather than replacing Save with a mocked callback.
+type saveOpenLatch struct {
+	filemanager.Manager
+	entered    chan struct{}
+	release    chan struct{}
+	writes     atomic.Int32
+	returned   atomic.Bool
+	lateWrites atomic.Int32
+}
+
+func (m *saveOpenLatch) BasePath(path string) string                  { return path }
+func (m *saveOpenLatch) MkdirAll(path string, perm os.FileMode) error { return os.MkdirAll(path, perm) }
+func (m *saveOpenLatch) Remove(path string) error                     { return os.Remove(path) }
+func (m *saveOpenLatch) Rename(from, to string) error                 { return os.Rename(from, to) }
+func (m *saveOpenLatch) OpenFile(path string, flag int, perm os.FileMode) (*os.File, error) {
+	if flag&os.O_WRONLY != 0 {
+		if m.writes.Add(1) == 1 {
+			close(m.entered)
+			<-m.release
+		}
+		if m.returned.Load() {
+			m.lateWrites.Add(1)
+		}
+	}
+	return os.OpenFile(path, flag, perm)
+}
+
+func TestRealSaveInFlightBlocksCloseAndConstructionDisposal(t *testing.T) {
+	for _, persist := range []bool{true, false} {
+		t.Run(map[bool]string{true: "close", false: "construction-disposal"}[persist], func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "state.json")
+			before := []byte(`{"last_updated":"2026-09-30T00:00:00Z","combinations":[{"model":"probe","total":{"input_tokens":41},"by_user":{}}]}`)
+			if err := os.WriteFile(path, before, 0600); err != nil {
+				t.Fatal(err)
+			}
+			s := usageTestService(t, path)
+			latch := &saveOpenLatch{entered: make(chan struct{}), release: make(chan struct{})}
+			s.usageTracker.ctx = service.ContextWith[filemanager.Manager](s.usageTracker.ctx, latch)
+			if err := s.Start(adapter.StartStateStart); err != nil {
+				t.Fatal(err)
+			}
+			s.usageTracker.mutex.Lock()
+			s.usageTracker.Combinations[0].Total.InputTokens = 42
+			s.usageTracker.mutex.Unlock()
+			saved := make(chan error, 1)
+			go func() { saved <- s.usageTracker.Save() }()
+			select {
+			case <-latch.entered:
+			case <-time.After(time.Second):
+				t.Fatal("real Save did not enter file acquire")
+			}
+			after, err := os.ReadFile(path)
+			if err != nil || !bytes.Equal(after, before) {
+				t.Fatalf("latched Save unexpectedly wrote: %s / %v", after, err)
+			}
+			closed := make(chan error, 1)
+			closing := make(chan struct{})
+			go func() {
+				close(closing)
+				var err error
+				if persist {
+					err = s.Close()
+				} else {
+					err = s.DisposeConstruction()
+				}
+				latch.returned.Store(true)
+				closed <- err
+			}()
+			<-closing
+			select {
+			case err := <-closed:
+				close(latch.release)
+				<-saved
+				t.Fatalf("disposal returned while real Save was still in flight: %v", err)
+			case <-time.After(40 * time.Millisecond):
+			}
+			close(latch.release)
+			select {
+			case err := <-saved:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("Save failed to leave acquire after release")
+			}
+			select {
+			case err := <-closed:
+				// Runtime double-close can report net.ErrClosed; the Save barrier
+				// still must drain before returning, and exact cleanup stays disabled.
+				if err != nil && !errors.Is(err, net.ErrClosed) {
+					t.Fatal(err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("disposal did not drain in-flight Save")
+			}
+			final, err := os.ReadFile(path)
+			if err != nil || !bytes.Contains(final, []byte(`"input_tokens": 42`)) {
+				t.Fatalf("in-flight Save did not commit before disposal: %s / %v", final, err)
+			}
+			writes := latch.writes.Load()
+			if err = s.usageTracker.Save(); err != nil {
+				t.Fatal(err)
+			}
+			late, err := os.ReadFile(path)
+			if err != nil || !bytes.Equal(late, final) || latch.writes.Load() != writes || latch.lateWrites.Load() != 0 {
+				t.Fatal("late Save wrote after disposal returned")
+			}
+		})
+	}
+}
