diff --git a/common/construction/scope.go b/common/construction/scope.go
new file mode 100644
index 0000000..78dfd60
--- /dev/null
+++ b/common/construction/scope.go
@@ -0,0 +1,318 @@
+// Package construction tracks resources acquired before a lifecycle owner exists.
+// Completing this stack is cleanup evidence, not proof of a complete resource audit.
+package construction
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+)
+
+type Scope struct {
+	access   sync.Mutex
+	entries  []*Ownership
+	errors   []error
+	terminal bool
+	// Factory scopes cannot retain replacement cleanup past publication. Only
+	// their enclosing construction owner can accept that deferred work.
+	factory          bool
+	replacementOwner *Scope
+}
+
+type Ownership struct {
+	name      string
+	cleanup   func() error
+	owner     *Scope
+	access    *sync.Mutex
+	rejection error
+	residual  bool
+}
+
+// Cleanup owns detached residual disposal, never the published runtime child.
+type Cleanup struct {
+	entries []*Ownership
+	errors  []error
+	once    sync.Once
+	result  error
+}
+
+func (c *Cleanup) Close() error {
+	if c == nil {
+		return nil
+	}
+	c.once.Do(func() {
+		errs := c.errors
+		for i := len(c.entries) - 1; i >= 0; i-- {
+			errs = append(errs, c.entries[i].Close())
+		}
+		c.entries, c.errors = nil, nil
+		c.result = errors.Join(errs...)
+	})
+	return c.result
+}
+
+var ErrScopeTerminated = errors.New("construction scope has terminated")
+var ErrScopeUnavailable = errors.New("no active construction scope")
+var ErrOwnershipReleased = errors.New("construction ownership has been released")
+
+// Begin gives the current factory operation its own scope. Failed operations
+// and residual replacement cleanup can defer to an active construction parent;
+// after that parent terminates, the current operation drains them itself.
+func Begin(ctx context.Context) (context.Context, func(published bool) error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	parent, _ := ctx.Value(contextKey{}).(*Scope)
+	replacementOwner := parent
+	if parent != nil && parent.factory {
+		replacementOwner = parent.replacementOwner
+	}
+	scope := &Scope{factory: true, replacementOwner: replacementOwner}
+	return WithScope(ctx, scope), func(published bool) error {
+		if published {
+			cleanup := scope.TransferAll()
+			if cleanup == nil {
+				return nil
+			}
+			if parent != nil && parent.appendPending("factory residual cleanup", cleanup.Close) {
+				return nil
+			}
+			return cleanup.Close()
+		}
+		if parent != nil && parent.appendPending("failed factory operation", scope.Close) {
+			return nil
+		}
+		return scope.Close()
+	}
+}
+
+type contextKey struct{}
+
+// Disposer promises construction-state disposal without persistence, global
+// rule deletion, or other runtime effects owned by a different instance.
+// Implementations must track any resources actually acquired during Start.
+type Disposer interface{ DisposeConstruction() error }
+
+var ErrUnknownDisposal = errors.New("construction disposal capability is unknown")
+
+func Dispose(name string, value any, runtimeOwner bool) error {
+	if value == nil {
+		return nil
+	}
+	if !runtimeOwner {
+		if disposer, ok := value.(Disposer); ok {
+			return Close(name, disposer.DisposeConstruction)
+		}
+		return fmt.Errorf("%s: %w", name, ErrUnknownDisposal)
+	}
+	if closer, ok := value.(io.Closer); ok {
+		return Close(name, closer.Close)
+	}
+	return nil
+}
+
+// DeferCleanup keeps a failed constructor's disposal on the construction
+// owner, so ordinary New can preserve prompt error/panic propagation.
+func DeferCleanup(ctx context.Context, name string, cleanup func() error) error {
+	if ctx != nil {
+		if scope, _ := ctx.Value(contextKey{}).(*Scope); scope != nil {
+			if scope.appendPending(name, cleanup) {
+				return nil
+			}
+		}
+	}
+	return Close(name, cleanup)
+}
+
+func DisposeOrDefer(ctx context.Context, name string, value any, runtimeOwner bool) error {
+	return DeferCleanup(ctx, name, func() error { return Dispose(name, value, runtimeOwner) })
+}
+
+// Replace can defer only to an enclosing construction owner that accepts the
+// work now. A factory without that owner must dispose before publishing its new
+// child and return any failure. Runtime replacement stays synchronous.
+func Replace(ctx context.Context, name string, value any, runtimeOwner bool) error {
+	if !runtimeOwner && ctx != nil {
+		if scope, _ := ctx.Value(contextKey{}).(*Scope); scope != nil {
+			if scope.factory {
+				scope = scope.replacementOwner
+			}
+			if scope != nil && scope.appendPending(name, func() error { return Dispose(name, value, false) }) {
+				return nil
+			}
+		}
+	}
+	return Dispose(name, value, runtimeOwner)
+}
+
+func WithScope(ctx context.Context, scope *Scope) context.Context {
+	return context.WithValue(ctx, contextKey{}, scope)
+}
+
+// Register must follow the first successful acquire, before another operation
+// can fail. Transfer when a parent assumes responsibility for that resource.
+func Register(ctx context.Context, name string, cleanup func() error) *Ownership {
+	var scope *Scope
+	if ctx != nil {
+		scope, _ = ctx.Value(contextKey{}).(*Scope)
+	}
+	if scope == nil {
+		return &Ownership{name: name, cleanup: cleanup, access: new(sync.Mutex), rejection: ErrScopeUnavailable}
+	}
+	return scope.Add(name, cleanup)
+}
+
+func (s *Scope) Add(name string, cleanup func() error) *Ownership {
+	if entry := s.appendEntry(name, cleanup); entry != nil {
+		return entry
+	}
+	// Rejected registration stays caller-owned. Inspect Err and dispose it; it
+	// is never closed eagerly, queued on a terminal scope, or transferable.
+	return &Ownership{name: name, cleanup: cleanup, owner: s, access: &s.access, rejection: ErrScopeTerminated}
+}
+
+func (s *Scope) appendEntry(name string, cleanup func() error) *Ownership {
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.terminal {
+		return nil
+	}
+	entry := &Ownership{name: name, cleanup: cleanup, owner: s, access: &s.access}
+	s.entries = append(s.entries, entry)
+	return entry
+}
+
+func (s *Scope) appendPending(name string, cleanup func() error) bool {
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.terminal {
+		return false
+	}
+	s.entries = append(s.entries, &Ownership{name: name, cleanup: cleanup, owner: s, access: &s.access, residual: true})
+	return true
+}
+
+// Err reports admission rejection. The caller retains a rejected resource and
+// must Close it before returning the rejection, rather than continuing to use it.
+func (o *Ownership) Err() error { return o.rejection }
+
+// Transfer relinquishes an admitted cleanup only before scope termination. The
+// shared scope lock linearizes it with terminal detach and Close.
+func (o *Ownership) Transfer() error {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if o.rejection != nil {
+		return o.rejection
+	}
+	if o.owner.terminal {
+		return ErrScopeTerminated
+	}
+	if o.cleanup == nil {
+		return ErrOwnershipReleased
+	}
+	o.cleanup = nil
+	return nil
+}
+
+func (o *Ownership) Close() error {
+	o.access.Lock()
+	cleanup := o.cleanup
+	o.cleanup = nil
+	o.access.Unlock()
+	if cleanup == nil {
+		return nil
+	}
+	return Close(o.name, cleanup)
+}
+
+func RecordError(ctx context.Context, err error) bool {
+	if err == nil || ctx == nil {
+		return false
+	}
+	if scope, _ := ctx.Value(contextKey{}).(*Scope); scope != nil {
+		scope.access.Lock()
+		defer scope.access.Unlock()
+		if scope.terminal {
+			return false
+		}
+		scope.errors = append(scope.errors, err)
+		return true
+	}
+	return false
+}
+
+// Close keeps draining the stack after an error or a cleanup panic. A blocking
+// callback still owns the stack; cancellation alone never proves quiescence.
+func (s *Scope) Close() error {
+	s.access.Lock()
+	if s.terminal {
+		s.access.Unlock()
+		return nil
+	}
+	s.terminal = true
+	entries, errs := s.entries, s.errors
+	s.entries, s.errors = nil, nil
+	s.access.Unlock()
+	return (&Cleanup{entries: entries, errors: errs}).Close()
+}
+
+func (s *Scope) DisposePending() error {
+	s.access.Lock()
+	var entries, retained []*Ownership
+	for _, entry := range s.entries {
+		if entry.residual {
+			entries = append(entries, entry)
+		} else {
+			retained = append(retained, entry)
+		}
+	}
+	s.entries = retained
+	s.access.Unlock()
+	return (&Cleanup{entries: entries}).Close()
+}
+
+// TransferAll atomically terminates admission and hands admitted resources to
+// their published runtime owner. It returns residual cleanup to the current
+// operation; that batch must actually be drained and is never owned by Box.
+func (s *Scope) TransferAll() *Cleanup {
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.terminal {
+		return &Cleanup{errors: []error{ErrScopeTerminated}}
+	}
+	s.terminal = true
+	cleanup := &Cleanup{errors: s.errors}
+	for _, entry := range s.entries {
+		if entry.residual {
+			cleanup.entries = append(cleanup.entries, entry)
+		} else {
+			entry.cleanup = nil
+		}
+	}
+	s.entries = nil
+	s.errors = nil
+	if len(cleanup.entries) == 0 && len(cleanup.errors) == 0 {
+		return nil
+	}
+	return cleanup
+}
+
+func (s *Scope) Errors() error {
+	s.access.Lock()
+	defer s.access.Unlock()
+	return errors.Join(s.errors...)
+}
+
+func Close(name string, cleanup func() error) (err error) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			err = fmt.Errorf("close %s panicked: %v", name, recovered)
+		}
+	}()
+	if err = cleanup(); err != nil {
+		return fmt.Errorf("close %s: %w", name, err)
+	}
+	return nil
+}
diff --git a/common/construction/scope_replacement_test.go b/common/construction/scope_replacement_test.go
new file mode 100644
index 0000000..b159c7c
--- /dev/null
+++ b/common/construction/scope_replacement_test.go
@@ -0,0 +1,162 @@
+package construction
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type replacementCleanupProbe struct{ cleanup func() error }
+
+func (p replacementCleanupProbe) DisposeConstruction() error { return p.cleanup() }
+
+func TestFactoryReplacementWithoutConstructionOwnerIsSynchronous(t *testing.T) {
+	for _, state := range []string{"no-parent", "closed", "transferred", "closed-after-begin", "transferred-after-begin"} {
+		for _, outcome := range []string{"error", "panic"} {
+			t.Run(state+"/"+outcome, func(t *testing.T) {
+				ctx := context.Background()
+				var parent Scope
+				if state != "no-parent" {
+					ctx = WithScope(ctx, &parent)
+				}
+				terminate := func() {
+					if strings.HasPrefix(state, "closed") {
+						if err := parent.Close(); err != nil {
+							t.Fatal(err)
+						}
+					} else if strings.HasPrefix(state, "transferred") {
+						if err := parent.TransferAll().Close(); err != nil {
+							t.Fatal(err)
+						}
+					}
+				}
+				if !strings.HasSuffix(state, "after-begin") {
+					terminate()
+				}
+				outer, completeOuter := Begin(ctx)
+				inner, completeInner := Begin(outer)
+				if strings.HasSuffix(state, "after-begin") {
+					terminate()
+				}
+				failure := errors.New("replacement cleanup failed")
+				disposed := 0
+				err := Replace(inner, "replaced child", replacementCleanupProbe{func() error {
+					disposed++
+					if outcome == "panic" {
+						panic("replacement cleanup panic")
+					}
+					return failure
+				}}, false)
+				if outcome == "error" && !errors.Is(err, failure) || outcome == "panic" && (err == nil || !strings.Contains(err.Error(), "replacement cleanup panic")) {
+					t.Fatalf("replacement was deferred past its caller: %v", err)
+				}
+				if disposed != 1 {
+					t.Fatalf("synchronous replacement disposal = %d", disposed)
+				}
+				if err = completeInner(false); err != nil {
+					t.Fatal(err)
+				}
+				if err = completeOuter(false); err != nil {
+					t.Fatal(err)
+				}
+				if err = parent.Close(); err != nil {
+					t.Fatal(err)
+				}
+				if disposed != 1 {
+					t.Fatal("nested factory scopes retried replacement disposal")
+				}
+			})
+		}
+	}
+}
+
+func TestActiveParentReplacementReturnsBeforeBlockedDisposal(t *testing.T) {
+	var parent Scope
+	outer, completeOuter := Begin(WithScope(context.Background(), &parent))
+	inner, completeInner := Begin(outer)
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	t.Cleanup(func() { releaseOnce.Do(func() { close(release) }) })
+	failure := errors.New("blocked replacement cleanup failed")
+	var disposed atomic.Int32
+	replaced := make(chan error, 1)
+	go func() {
+		replaced <- Replace(inner, "blocked old child", replacementCleanupProbe{func() error {
+			disposed.Add(1)
+			close(entered)
+			<-release
+			return failure
+		}}, false)
+	}()
+	select {
+	case err := <-replaced:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("replacement blocked despite an active construction owner")
+	}
+	if disposed.Load() != 0 {
+		t.Fatal("factory operation ran deferred disposal")
+	}
+	if err := completeInner(true); err != nil {
+		t.Fatal(err)
+	}
+	if err := completeOuter(true); err != nil {
+		t.Fatal(err)
+	}
+	drained := make(chan error, 1)
+	go func() { drained <- parent.Close() }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("enclosing construction owner did not retain replacement disposal")
+	}
+	select {
+	case err := <-drained:
+		t.Fatalf("owner returned while replacement was blocked: %v", err)
+	default:
+	}
+	releaseOnce.Do(func() { close(release) })
+	if err := <-drained; !errors.Is(err, failure) {
+		t.Fatalf("enclosing owner lost replacement failure: %v", err)
+	}
+	if disposed.Load() != 1 {
+		t.Fatal("replacement was not disposed exactly once by its retained owner")
+	}
+}
+
+func TestFactoryReplacementAndParentCloseRace(t *testing.T) {
+	for i := 0; i < 100; i++ {
+		var parent Scope
+		ctx, complete := Begin(WithScope(context.Background(), &parent))
+		failure := errors.New("raced replacement cleanup failed")
+		var disposed atomic.Int32
+		start := make(chan struct{})
+		replaced, closed := make(chan error, 1), make(chan error, 1)
+		go func() {
+			<-start
+			replaced <- Replace(ctx, "raced old child", replacementCleanupProbe{func() error { disposed.Add(1); return failure }}, false)
+		}()
+		go func() {
+			<-start
+			closed <- parent.Close()
+		}()
+		close(start)
+		replacementErr, closeErr := <-replaced, <-closed
+		if errors.Is(replacementErr, failure) == errors.Is(closeErr, failure) {
+			t.Fatalf("iteration %d: replacement failure must have one active owner: %v / %v", i, replacementErr, closeErr)
+		}
+		if disposed.Load() != 1 {
+			t.Fatalf("iteration %d: replacement disposal = %d", i, disposed.Load())
+		}
+		if err := complete(false); err != nil {
+			t.Fatal(err)
+		}
+		assertDetached(t, &parent)
+	}
+}
diff --git a/common/construction/scope_terminal_test.go b/common/construction/scope_terminal_test.go
new file mode 100644
index 0000000..dac1482
--- /dev/null
+++ b/common/construction/scope_terminal_test.go
@@ -0,0 +1,282 @@
+package construction
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func assertDetached(t *testing.T, scope *Scope) {
+	t.Helper()
+	scope.access.Lock()
+	defer scope.access.Unlock()
+	if !scope.terminal || len(scope.entries) != 0 || len(scope.errors) != 0 {
+		t.Fatal("terminated scope retained admission or unconsumed work")
+	}
+}
+
+func TestHandledFactoryFailureStaysResidualAfterParentPublication(t *testing.T) {
+	var parent Scope
+	ctx := WithScope(context.Background(), &parent)
+	child, complete := Begin(ctx)
+	closed := 0
+	failure := errors.New("handled constructor cleanup failed")
+	if err := DeferCleanup(child, "failed constructor", func() error { closed++; return failure }); err != nil {
+		t.Fatal(err)
+	}
+	if err := complete(false); err != nil {
+		t.Fatal("active parent should retain failed-operation cleanup", err)
+	}
+	if closed != 0 {
+		t.Fatal("active parent cleanup was forced synchronous")
+	}
+	cleanup := parent.TransferAll()
+	if err := cleanup.Close(); !errors.Is(err, failure) {
+		t.Fatalf("failed operation was incorrectly transferred as a published resource: %v", err)
+	}
+	if closed != 1 {
+		t.Fatalf("residual cleanup count = %d", closed)
+	}
+	assertDetached(t, &parent)
+}
+
+type failedDisposal struct {
+	disposed, runtime *atomic.Int32
+	failure           error
+}
+
+func (p failedDisposal) DisposeConstruction() error { p.disposed.Add(1); return p.failure }
+func (p failedDisposal) Close() error               { p.runtime.Add(1); return nil }
+
+func TestTerminatedContextRetainsCleanupAtCurrentOperation(t *testing.T) {
+	for _, transfer := range []bool{false, true} {
+		t.Run(map[bool]string{false: "closed", true: "transferred"}[transfer], func(t *testing.T) {
+			var scope Scope
+			ctx := WithScope(context.Background(), &scope)
+			if transfer {
+				if err := scope.TransferAll().Close(); err != nil {
+					t.Fatal(err)
+				}
+			} else if err := scope.Close(); err != nil {
+				t.Fatal(err)
+			}
+			failure := errors.New("current operation cleanup failure")
+			var disposed, runtime atomic.Int32
+			if err := Replace(ctx, "late replacement", failedDisposal{&disposed, &runtime, failure}, false); !errors.Is(err, failure) {
+				t.Fatalf("replacement error was lost: %v", err)
+			}
+			if disposed.Load() != 1 || runtime.Load() != 0 {
+				t.Fatal("late construction disposal used runtime Close or was lost")
+			}
+			entered, release, done := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+			go func() {
+				done <- DeferCleanup(ctx, "late failed constructor", func() error { close(entered); <-release; return failure })
+			}()
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("late callback has no active owner")
+			}
+			select {
+			case err := <-done:
+				t.Fatalf("current operation returned before its cleanup: %v", err)
+			default:
+			}
+			assertDetached(t, &scope)
+			if RecordError(ctx, failure) {
+				t.Fatal("terminal scope accepted orphaned error")
+			}
+			close(release)
+			if err := <-done; !errors.Is(err, failure) {
+				t.Fatalf("late cleanup failure was lost: %v", err)
+			}
+			assertDetached(t, &scope)
+		})
+	}
+}
+
+func TestRejectedRegistrationRemainsCallerOwnedAndCannotTransfer(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+	var closed atomic.Int32
+	token := Register(ctx, "late acquire", func() error { closed.Add(1); return nil })
+	if !errors.Is(token.Err(), ErrScopeTerminated) || closed.Load() != 0 {
+		t.Fatal("late registration was accepted or eagerly destroyed a resource")
+	}
+	if !errors.Is(token.Transfer(), ErrScopeTerminated) {
+		t.Fatal("rejected token abandoned its cleanup")
+	}
+	if err := token.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := token.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if closed.Load() != 1 {
+		t.Fatal("caller did not dispose rejected resource exactly once")
+	}
+	assertDetached(t, &scope)
+}
+
+func TestCloseInterleavedLateRegistrationAndCleanupHaveSeparateLiveOwners(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	entered, release, closed := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	Register(ctx, "first acquired", func() error { close(entered); <-release; return nil })
+	go func() { closed <- scope.Close() }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("rollback did not enter")
+	}
+	lateEntered, lateRelease, lateDone := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	go func() {
+		lateDone <- DeferCleanup(ctx, "late acquired", func() error { close(lateEntered); <-lateRelease; return nil })
+	}()
+	select {
+	case <-lateEntered:
+	case <-time.After(time.Second):
+		t.Fatal("late operation cleanup was stranded")
+	}
+	assertDetached(t, &scope)
+	select {
+	case <-closed:
+		t.Fatal("rollback returned while its callback was blocked")
+	default:
+	}
+	select {
+	case <-lateDone:
+		t.Fatal("late operation returned while its own callback was blocked")
+	default:
+	}
+	close(release)
+	if err := <-closed; err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-lateDone:
+		t.Fatal("scope completion impersonated late operation completion")
+	default:
+	}
+	close(lateRelease)
+	if err := <-lateDone; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRegisterTransferAndCloseRaceNeverLoseCleanup(t *testing.T) {
+	for i := 0; i < 300; i++ {
+		var scope Scope
+		ctx := WithScope(context.Background(), &scope)
+		var closed atomic.Int32
+		start := make(chan struct{})
+		registered := make(chan *Ownership, 1)
+		var tasks sync.WaitGroup
+		tasks.Add(3)
+		go func() {
+			defer tasks.Done()
+			<-start
+			registered <- Register(ctx, "raced acquire", func() error { closed.Add(1); return nil })
+		}()
+		go func() {
+			defer tasks.Done()
+			<-start
+			token := <-registered
+			if token.Err() != nil {
+				if err := token.Close(); err != nil {
+					t.Error(err)
+				}
+				return
+			}
+			if err := token.Transfer(); err == nil {
+				closed.Add(1)
+			} else if !errors.Is(err, ErrScopeTerminated) {
+				t.Error(err)
+			}
+		}()
+		go func() {
+			defer tasks.Done()
+			<-start
+			if err := scope.Close(); err != nil {
+				t.Error(err)
+			}
+		}()
+		close(start)
+		tasks.Wait()
+		if closed.Load() != 1 {
+			t.Fatalf("race %d released resource %d times", i, closed.Load())
+		}
+		assertDetached(t, &scope)
+	}
+}
+
+func TestDetachedReplacementBatchRetainsAnActualOwner(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	entered, release, done := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	if !scope.appendPending("replacement", func() error { close(entered); <-release; return nil }) {
+		t.Fatal("admission rejected")
+	}
+	Register(ctx, "published child", func() error { t.Error("published child was reclaimed by its former scope"); return nil })
+	cleanup := scope.TransferAll()
+	assertDetached(t, &scope)
+	go func() { done <- cleanup.Close() }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("detached batch was dropped")
+	}
+	if err := DeferCleanup(ctx, "later constructor", func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-done:
+		t.Fatal("detached owner returned before replacement cleanup")
+	default:
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestOwnershipCloseAndTransferRaceCannotPublishDisposedResource(t *testing.T) {
+	for i := 0; i < 300; i++ {
+		var scope Scope
+		var closed atomic.Int32
+		token := scope.Add("raced owner", func() error { closed.Add(1); return nil })
+		start := make(chan struct{})
+		var tasks sync.WaitGroup
+		tasks.Add(2)
+		go func() {
+			defer tasks.Done()
+			<-start
+			if err := token.Close(); err != nil {
+				t.Error(err)
+			}
+		}()
+		go func() {
+			defer tasks.Done()
+			<-start
+			if err := token.Transfer(); err == nil {
+				closed.Add(1)
+			} else if !errors.Is(err, ErrOwnershipReleased) {
+				t.Error(err)
+			}
+		}()
+		close(start)
+		tasks.Wait()
+		if err := scope.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if closed.Load() != 1 {
+			t.Fatalf("disposed resource was also published in race %d: closes=%d", i, closed.Load())
+		}
+	}
+}
diff --git a/common/construction/scope_test.go b/common/construction/scope_test.go
new file mode 100644
index 0000000..16874de
--- /dev/null
+++ b/common/construction/scope_test.go
@@ -0,0 +1,75 @@
+package construction
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+)
+
+func TestRollbackOrderTransferAndErrorContinuation(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	var closed []string
+	failure := errors.New("injected close error")
+	Register(ctx, "first", func() error { closed = append(closed, "first"); return nil })
+	Register(ctx, "parent-owned", func() error { t.Fatal("transferred resource closed"); return nil }).Transfer()
+	Register(ctx, "error", func() error { closed = append(closed, "error"); return failure })
+	Register(ctx, "panic", func() error { closed = append(closed, "panic"); panic("injected") })
+	if err := scope.Close(); !errors.Is(err, failure) {
+		t.Fatalf("rollback = %v", err)
+	}
+	if !reflect.DeepEqual(closed, []string{"panic", "error", "first"}) {
+		t.Fatal(closed)
+	}
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+type disposalProbe struct{ disposed, runtimeClosed *int }
+
+func (p disposalProbe) DisposeConstruction() error { *p.disposed++; return nil }
+func (p disposalProbe) Close() error               { *p.runtimeClosed++; return nil }
+
+func TestReplacementDisposalSurvivesCompletedParentTransfer(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	disposed, runtimeClosed := 0, 0
+	if err := Replace(ctx, "replaced child", disposalProbe{&disposed, &runtimeClosed}, false); err != nil {
+		t.Fatal(err)
+	}
+	Register(ctx, "completed parent", func() error { t.Fatal("parent ownership was transferred"); return nil })
+	cleanup := scope.TransferAll()
+	if err := cleanup.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if disposed != 1 || runtimeClosed != 0 {
+		t.Fatalf("disposal/runtime Close = %d/%d", disposed, runtimeClosed)
+	}
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if disposed != 1 {
+		t.Fatal("replacement disposed twice")
+	}
+}
+
+func TestPartialConstructorInternalAcquisition(t *testing.T) {
+	var scope Scope
+	ctx := WithScope(context.Background(), &scope)
+	closed := 0
+	constructor := func() error {
+		Register(ctx, "internal handle", func() error { closed++; return nil })
+		return errors.New("failure after first acquire")
+	}
+	if err := constructor(); err == nil {
+		t.Fatal("fault missing")
+	}
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if closed != 1 {
+		t.Fatalf("internal close count = %d", closed)
+	}
+}
