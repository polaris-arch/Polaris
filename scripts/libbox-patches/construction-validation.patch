+// ConstructionReport retains original acquisition/rollback facts. Ordinary
+// entries remain unqualified; only the factory-owned native validation entry
+// can consume its private finite member, leaf, monitor and context completion.
+type ConstructionReport struct {
+	Attempted    bool
+	CleanupError error
+	scope        *construction.Scope
+	observation  *construction.Observation
+	profile      bool
+	partialLog   bool
+	instance     *Box
+	monitor      *boundValidationMonitor
+	context      *validationContext
+}
+
+// New preserves prompt error/panic propagation. A failed construction's scope
+// retains its cleanup work asynchronously; this API provides no disposal receipt.
 func New(options Options) (*Box, error) {
+	instance, err, _ := newWithConstructionReport(options, false)
+	return instance, err
+}
+
+// NewWithConstructionReport waits for observed rollback, which can block on a
+// cleanup callback. Validation callers need a separate timeout and Unknown state.
+func NewWithConstructionReport(options Options) (instance *Box, err error, report ConstructionReport) {
+	return newWithConstructionReport(options, true)
+}
+
+func newWithConstructionReport(options Options, awaitRollback bool) (instance *Box, err error, report ConstructionReport) {
+	var scope construction.Scope
+	report.scope, report.observation = &scope, options.ObserveValidation
+	report.monitor, report.context = options.validationMonitor, options.validationContext
+	report.profile = options.validationMonitor != nil && options.ObserveValidation != nil && SupportsBoundValidationProfile(options.Options) && options.PlatformLogWriter == nil && len(options.NetworkNamespaceHolderArgs) == 0
+	if report.profile {
+		_, levelErr := log.ParseLevel(options.Log.Level)
+		report.partialLog = options.Log.Level != "" && levelErr != nil
+	}
+	ctx := options.Context
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	if options.ObserveValidation != nil {
+		ctx = construction.WithObservation(ctx, options.ObserveValidation)
+	}
