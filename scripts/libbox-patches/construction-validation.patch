new file mode 100644
index 0000000..f83d7b4
--- /dev/null
+++ b/adapter/outbound/manager_ownership_test.go
@@ -0,0 +1,117 @@
+package outbound
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/construction"
+	"github.com/sagernet/sing-box/log"
+)
+
+// No DisposeConstruction method: ordinary Close represents an unsafe runtime effect.
+type unknownOwnerProbe struct {
+	adapter.Outbound
+	tag       string
+	closed    *int
+	failStart bool
+}
+
+type noEndpoints struct{ adapter.EndpointManager }
+
+func (noEndpoints) Endpoints() []adapter.Endpoint { return nil }
+
+func (p *unknownOwnerProbe) Type() string           { return "unknown-owner" }
+func (p *unknownOwnerProbe) Tag() string            { return p.tag }
+func (p *unknownOwnerProbe) Close() error           { *p.closed++; return nil }
+func (p *unknownOwnerProbe) Dependencies() []string { return nil }
+func (p *unknownOwnerProbe) Start(stage adapter.StartStage) error {
+	if stage == adapter.StartStateStart && p.failStart {
+		return errors.New("injected runtime Start failure")
+	}
+	return nil
+}
+
+func TestOnlySuccessfulChildStartAllowsRuntimeClose(t *testing.T) {
+	for _, mode := range []string{"constructed", "initialize", "partial-start"} {
+		t.Run(mode, func(t *testing.T) {
+			logger := log.NewNOPFactory().Logger()
+			closed := []int{0, 0, 0}
+			children := []adapter.Outbound{
+				&unknownOwnerProbe{tag: "first", closed: &closed[0]},
+				&unknownOwnerProbe{tag: "failed", closed: &closed[1], failStart: true},
+				&unknownOwnerProbe{tag: "untouched", closed: &closed[2]},
+			}
+			m := &Manager{logger: logger, endpoint: noEndpoints{}, outbounds: children, outboundByTag: map[string]adapter.Outbound{"first": children[0], "failed": children[1], "untouched": children[2]}, defaultOutbound: children[0]}
+			if mode != "constructed" {
+				if err := m.Start(adapter.StartStateInitialize); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if mode == "partial-start" {
+				if err := m.Start(adapter.StartStateStart); err == nil {
+					t.Fatal("injected Start failure missing")
+				}
+			}
+			if err := m.Close(); !errors.Is(err, construction.ErrUnknownDisposal) {
+				t.Fatalf("close = %v", err)
+			}
+			wantFirst := 0
+			if mode == "partial-start" {
+				wantFirst = 1
+			}
+			if closed[0] != wantFirst || closed[1] != 0 || closed[2] != 0 {
+				t.Fatalf("unsafe runtime Close counts: %v", closed)
+			}
+		})
+	}
+}
+
+func TestUnknownConstructionRemoveReplaceAndFactoryErrorNeverRuntimeClose(t *testing.T) {
+	for _, mode := range []string{"remove", "replace", "factory-error"} {
+		t.Run(mode, func(t *testing.T) {
+			var scope construction.Scope
+			ctx := construction.WithScope(context.Background(), &scope)
+			logger := log.NewNOPFactory().Logger()
+			closed := 0
+			registry := NewRegistry()
+			failure := errors.New("injected object plus error")
+			Register[struct{}](registry, "unknown-owner", func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ struct{}) (adapter.Outbound, error) {
+				child := &unknownOwnerProbe{tag: tag, closed: &closed}
+				if mode == "factory-error" {
+					return child, failure
+				}
+				return child, nil
+			})
+			m := &Manager{logger: logger, registry: registry, outboundByTag: make(map[string]adapter.Outbound)}
+			err := m.Create(ctx, nil, logger, "same", "unknown-owner", nil)
+			if mode == "factory-error" {
+				if !errors.Is(err, failure) {
+					t.Fatal(err)
+				}
+			} else {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if mode == "remove" {
+					if err = m.Remove("same"); !errors.Is(err, construction.ErrUnknownDisposal) {
+						t.Fatal(err)
+					}
+				} else {
+					if err = m.Create(ctx, nil, logger, "same", "unknown-owner", nil); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			if mode != "remove" {
+				if err = scope.Close(); !errors.Is(err, construction.ErrUnknownDisposal) {
+					t.Fatalf("cleanup = %v", err)
+				}
+			}
+			if closed != 0 {
+				t.Fatalf("unowned object runtime-closed %d times", closed)
+			}
+		})
+	}
+}
