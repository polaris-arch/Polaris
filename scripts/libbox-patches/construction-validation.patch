diff --git a/adapter/outbound/manager_construction_test.go b/adapter/outbound/manager_construction_test.go
new file mode 100644
index 0000000..428b571
--- /dev/null
+++ b/adapter/outbound/manager_construction_test.go
@@ -0,0 +1,59 @@
+package outbound
+
+import (
+	"errors"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"testing"
+)
+
+type constructionProbe struct {
+	adapter.Outbound
+	tag          string
+	closed       *int
+	panicOnClose bool
+	failure      error
+}
+
+func (p constructionProbe) Type() string { return "probe" }
+func (p constructionProbe) Tag() string  { return p.tag }
+func (p constructionProbe) Close() error {
+	*p.closed++
+	if p.panicOnClose {
+		panic("injected cleanup panic")
+	}
+	return p.failure
+}
+func TestConstructionCloseDrainsUnstartedChildrenAfterFailure(t *testing.T) {
+	failure := errors.New("injected cleanup failure")
+	counts := []int{0, 0, 0}
+	children := []adapter.Outbound{
+		constructionProbe{tag: "panic", closed: &counts[0], panicOnClose: true},
+		constructionProbe{tag: "error", closed: &counts[1], failure: failure},
+		constructionProbe{tag: "ok", closed: &counts[2]},
+	}
+	m := &Manager{logger: log.NewNOPFactory().Logger(), outbounds: children,
+		outboundByTag: map[string]adapter.Outbound{"panic": children[0], "error": children[1], "ok": children[2]},
+	}
+	if err := m.Close(); !errors.Is(err, failure) {
+		t.Fatalf("close = %v", err)
+	}
+	for i, count := range counts {
+		if count != 1 {
+			t.Fatalf("child %d close count = %d", i, count)
+		}
+	}
+	if len(m.outbounds) != 0 || len(m.outboundByTag) != 0 {
+		t.Fatal("closed children retained")
+	}
+	if err := m.Close(); err != nil {
+		t.Fatalf("second close = %v", err)
+	}
+	for i, count := range counts {
+		if count != 1 {
+			t.Fatalf("child %d disposed twice", i)
+		}
+	}
+}
+
+func (p constructionProbe) DisposeConstruction() error { return p.Close() }
