+type boundBlockedEntropy struct{ release, returned chan struct{} }
+
+func (r boundBlockedEntropy) Read(p []byte) (int, error) {
+	<-r.release
+	for i := range p {
+		p[i] = byte(i + 1)
+	}
+	close(r.returned)
+	return len(p), nil
+}
+func TestValidationBoundNativeTimeoutCannotUpgradeAfterLateEntropy(t *testing.T) {
+	entropy := boundBlockedEntropy{make(chan struct{}), make(chan struct{})}
+	result := checkConfigWithResultRandomMode(boundValidationProfile, "bound-timeout", 25, constructAndDisposeConfig, entropy, true)
+	if result.GetCleanup() != "CleanupUnknown" || result.GetValidation() != "InternalFailure" {
+		t.Fatalf("timeout=%+v", result)
+	}
+	snapshot := *result
+	close(entropy.release)
+	<-entropy.returned
+	// The old returned value is independent of the late worker's mutable facts.
+	if *result != snapshot || result.GetCleanup() != "CleanupUnknown" {
+		t.Fatal("late native qualification upgraded timed out receipt")
+	}
+}
