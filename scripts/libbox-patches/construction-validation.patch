+	"path/filepath"
+	"testing"
+)
+
+type unusedOutboundManager struct{ adapter.OutboundManager }
+
+func usageTestService(t *testing.T, path string, ports ...uint16) *Service {
+	var port uint16
+	if len(ports) > 0 {
+		port = ports[0]
+	}
+	t.Helper()
+	credentials := filepath.Join(t.TempDir(), "credentials.json")
+	if err := os.WriteFile(credentials, []byte(`{"claudeAiOauth":{"accessToken":"isolated-test"}}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	instance, err := NewService(service.ContextWith[adapter.OutboundManager](context.Background(), &unusedOutboundManager{}), log.NewNOPFactory().Logger(), "probe", option.CCMServiceOptions{ListenOptions: option.ListenOptions{ListenPort: port}, CredentialPath: credentials, UsagesPath: path, Detour: "unused-isolated-detour"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return instance.(*Service)
+}
+
+func TestConstructionDisposalPreservesUsageFile(t *testing.T) {
+	for _, operation := range []string{"close", "dispose", "initialize"} {
+		t.Run(operation, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "usage.json")
+			before := []byte(`{"last_updated":"2026-09-30T00:00:00Z","combinations":[{"model":"probe","total":{"input_tokens":41},"by_user":{}}]}`)
+			if err := os.WriteFile(path, before, 0600); err != nil {
+				t.Fatal(err)
+			}
+			s := usageTestService(t, path)
+			if operation == "initialize" {
+				if err := s.Start(adapter.StartStateInitialize); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var err error
+			if operation == "dispose" {
+				err = s.DisposeConstruction()
+			} else {
+				err = s.Close()
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			after, err := os.ReadFile(path)
+			if err != nil || !bytes.Equal(before, after) {
+				t.Fatalf("construction overwrote usage: %s / %v", after, err)
+			}
+		})
+	}
+}
+
+func TestStartedServicePersistsLoadedUsage(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "usage.json")
+	if err := os.WriteFile(path, []byte(`{"last_updated":"2026-09-30T00:00:00Z","combinations":[{"model":"probe","total":{"input_tokens":41},"by_user":{}}]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	s := usageTestService(t, path)
+	if err := s.Start(adapter.StartStateStart); err != nil {
+		t.Fatal(err)
+	}
+	s.usageTracker.mutex.Lock()
+	s.usageTracker.Combinations[0].Total.InputTokens = 42
+	s.usageTracker.mutex.Unlock()
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(after, []byte(`"input_tokens": 42`)) {
+		t.Fatalf("started service failed to persist loaded usage: %s", after)
+	}
+	if err = s.usageTracker.Save(); err != nil {
+		t.Fatal(err)
+	}
+	final, err := os.ReadFile(path)
+	if err != nil || !bytes.Equal(final, after) {
+		t.Fatal("late save persisted after shutdown")
+	}
+}
+
+func TestLoadFailureDoesNotReplaceUsageFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "usage.json")
+	before := []byte(`malformed existing usage`)
+	if err := os.WriteFile(path, before, 0600); err != nil {
+		t.Fatal(err)
+	}
+	s := usageTestService(t, path)
+	if err := s.Start(adapter.StartStateStart); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.ReadFile(path)
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatalf("load failure overwrote usage: %s / %v", after, err)
+	}
+}
+
+func TestListenerStartFailureCannotPersistLoadedUsage(t *testing.T) {
+	blocker, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer blocker.Close()
+	path := filepath.Join(t.TempDir(), "usage.json")
+	before := []byte(`{"last_updated":"2026-09-30T00:00:00Z","combinations":[{"model":"probe","total":{"input_tokens":41},"by_user":{}}]}`)
+	if err = os.WriteFile(path, before, 0600); err != nil {
+		t.Fatal(err)
+	}
+	s := usageTestService(t, path, uint16(blocker.Addr().(*net.TCPAddr).Port))
+	if err = s.Start(adapter.StartStateStart); err == nil {
+		t.Fatal("injected listener failure missing")
+	}
+	if err = s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.ReadFile(path)
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatalf("failed Start overwrote usage: %s / %v", after, err)
+	}
+}
+
+func TestRealConstructionRemoveAndReplacementCannotPersist(t *testing.T) {
+	for _, operation := range []string{"remove", "replace"} {
+		t.Run(operation, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "state.json")
+			before := []byte(`{"last_updated":"2026-09-30T00:00:00Z","combinations":[{"model":"probe","total":{"input_tokens":41},"by_user":{}}]}`)
+			if err := os.WriteFile(path, before, 0600); err != nil {
+				t.Fatal(err)
+			}
+			var scope construction.Scope
+			ctx := construction.WithScope(context.Background(), &scope)
+			registry := boxService.NewRegistry()
+			boxService.Register[struct{}](registry, "real-service", func(context.Context, log.ContextLogger, string, struct{}) (adapter.Service, error) {
+				return usageTestService(t, path), nil
+			})
+			logger := log.NewNOPFactory().Logger()
+			manager := boxService.NewManager(logger, registry)
+			if err := manager.Create(ctx, logger, "same", "real-service", nil); err != nil {
+				t.Fatal(err)
+			}
+			if operation == "remove" {
+				if err := manager.Remove("same"); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				if err := manager.Create(ctx, logger, "same", "real-service", nil); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := manager.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if err := scope.DisposePending(); err != nil {
+				t.Fatal(err)
+			}
+			after, err := os.ReadFile(path)
+			if err != nil || !bytes.Equal(before, after) {
+				t.Fatalf("manager construction disposal overwrote state: %s / %v", after, err)
+			}
+		})
+	}
+}
