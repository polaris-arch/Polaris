+package box
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	boxCertificate "github.com/sagernet/sing-box/adapter/certificate"
+	"github.com/sagernet/sing-box/adapter/endpoint"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	boxService "github.com/sagernet/sing-box/adapter/service"
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/option"
+)
+
+type failingCloseService struct {
+	startErr error
+	closeErr error
+	entered  chan struct{}
+	release  chan struct{}
+}
+
+func (s *failingCloseService) Name() string                     { return "failing-close" }
+func (s *failingCloseService) Start(_ adapter.StartStage) error { return s.startErr }
+func (s *failingCloseService) Close() error {
+	if s.entered != nil {
+		close(s.entered)
+		<-s.release
+	}
+	return s.closeErr
+}
+
+func testBoxWithService(t *testing.T, extra *failingCloseService) *Box {
+	t.Helper()
+	ctx := Context(context.Background(), inbound.NewRegistry(), outbound.NewRegistry(), endpoint.NewRegistry(), dns.NewTransportRegistry(), boxService.NewRegistry(), boxCertificate.NewRegistry())
+	instance, err := New(Options{Context: ctx, Options: option.Options{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	instance.internalService = append(instance.internalService, extra)
+	return instance
+}
+
+func TestEarlyStartFailureRetainsFirstCloseFailure(t *testing.T) {
+	startFailure := errors.New("synthetic initialize failure")
+	closeFailure := errors.New("synthetic endpoint cleanup failure")
+	instance := testBoxWithService(t, &failingCloseService{startErr: startFailure, closeErr: closeFailure})
+	if err := instance.Start(); !errors.Is(err, startFailure) {
+		t.Fatalf("Start = %v, want injected start failure", err)
+	}
+	if err := instance.CloseWithResult(); !errors.Is(err, closeFailure) {
+		t.Fatalf("CloseWithResult after automatic close = %v, want original cleanup failure", err)
+	}
+	if err := instance.Close(); !errors.Is(err, os.ErrClosed) {
+		t.Fatalf("duplicate public Close = %v, want ErrClosed", err)
+	}
+}
+
+func TestDuplicatePublicCloseReturnsBeforeStrictCloseCompletes(t *testing.T) {
+	service := &failingCloseService{entered: make(chan struct{}), release: make(chan struct{})}
+	instance := testBoxWithService(t, service)
+	first := make(chan error, 1)
+	go func() { first <- instance.Close() }()
+	<-service.entered
+	quick := make(chan error, 1)
+	go func() { quick <- instance.Close() }()
+	select {
+	case err := <-quick:
+		if !errors.Is(err, os.ErrClosed) {
+			t.Fatalf("duplicate public Close = %v, want ErrClosed", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("duplicate public Close waited for the first close")
+	}
+	close(service.release)
+	if err := <-first; err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/box_tailscale_state_store.go b/box_tailscale_state_store.go
new file mode 100644
index 0000000..6a69f6b
--- /dev/null
+++ b/box_tailscale_state_store.go
@@ -0,0 +1,77 @@
+package box
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"time"
+)
+
+// Capture original final endpoints before manager Close/DisposeConstruction
+// drops its list. The snapshot is part of this Box, not a separate registry.
+func (s *Box) CaptureTailscaleStateStores() []adapter.Endpoint {
+	s.tsStoreMu.Lock()
+	defer s.tsStoreMu.Unlock()
+	if !s.tsCaptured {
+		if s.endpoint != nil {
+			for _, endpoint := range s.endpoint.Endpoints() {
+				if endpoint.Type() == C.TypeTailscale {
+					s.tsStores = append(s.tsStores, endpoint)
+				}
+			}
+		}
+		s.tsCaptured = true
+	}
+	return append([]adapter.Endpoint(nil), s.tsStores...)
+}
+func (s *Box) TailscaleStateStoreScopes() []adapter.TailscaleStoreNode {
+	endpoints := s.CaptureTailscaleStateStores()
+	nodes := make([]adapter.TailscaleStoreNode, 0, len(endpoints))
+	for _, endpoint := range endpoints {
+		node := adapter.TailscaleStoreNode{Tag: endpoint.Tag(), WriterState: "Unknown", StateFileState: "Unknown", ProfileState: "Unknown"}
+		if owner, ok := endpoint.(adapter.TailscaleStateStoreOwner); ok {
+			node = owner.TailscaleStateStoreScope()
+		}
+		nodes = append(nodes, node)
+	}
+	return nodes
+}
+
+func (s *Box) retireTailscaleStateStores() {
+	endpoints := s.CaptureTailscaleStateStores()
+	// A newly inserted TS endpoint is sealed as well, but its extra entry makes
+	// the original daemon census incomplete rather than silently losing it.
+	if s.endpoint != nil {
+		for _, current := range s.endpoint.Endpoints() {
+			if current.Type() != C.TypeTailscale {
+				continue
+			}
+			found := false
+			for _, original := range endpoints {
+				if original == current {
+					found = true
+					break
+				}
+			}
+			if !found {
+				endpoints = append(endpoints, current)
+			}
+		}
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	nodes := make([]adapter.TailscaleStoreNode, 0, len(endpoints))
+	for _, endpoint := range endpoints {
+		node := adapter.TailscaleStoreNode{Tag: endpoint.Tag(), WriterState: "Unknown", StateFileState: "Unknown", ProfileState: "Unknown"}
+		if owner, ok := endpoint.(adapter.TailscaleStateStoreOwner); ok {
+			node = owner.RetireTailscaleStateStore(deadline)
+		}
+		nodes = append(nodes, node)
+	}
+	s.tsStoreMu.Lock()
+	s.tsRetirement = nodes
+	s.tsStoreMu.Unlock()
+}
+func (s *Box) TailscaleStoreRetirement() []adapter.TailscaleStoreNode {
+	s.tsStoreMu.Lock()
+	defer s.tsStoreMu.Unlock()
+	return append([]adapter.TailscaleStoreNode(nil), s.tsRetirement...)
+}
diff --git a/box_tailscale_state_store_test.go b/box_tailscale_state_store_test.go
new file mode 100644
index 0000000..cae20fc
--- /dev/null
+++ b/box_tailscale_state_store_test.go
@@ -0,0 +1,72 @@
+package box
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/endpoint"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"testing"
+	"time"
+)
+
+type retirementEndpoint struct {
+	adapter.Endpoint
+	tag     string
+	retired int
+}
+
+func (*retirementEndpoint) Type() string               { return C.TypeTailscale }
+func (e *retirementEndpoint) Tag() string              { return e.tag }
+func (*retirementEndpoint) DisposeConstruction() error { return nil }
+func (e *retirementEndpoint) TailscaleStateStoreScope() adapter.TailscaleStoreNode {
+	return adapter.TailscaleStoreNode{Tag: e.tag, StateFile: "/original/" + e.tag + "/tailscaled.state", WriterState: "Unknown"}
+}
+func (e *retirementEndpoint) RetireTailscaleStateStore(time.Time) adapter.TailscaleStoreNode {
+	e.retired++
+	node := e.TailscaleStateStoreScope()
+	node.WriterState = "NoStoreConstruction"
+	return node
+}
+func TestTailscaleStoreCensusRetainsOriginalAndSealsLateEndpoint(t *testing.T) {
+	logger := log.NewNOPFactory().Logger()
+	registry := endpoint.NewRegistry()
+	created := map[string]*retirementEndpoint{}
+	endpoint.Register[struct{}](registry, C.TypeTailscale, func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ struct{}) (adapter.Endpoint, error) {
+		e := &retirementEndpoint{tag: tag}
+		created[tag] = e
+		return e, nil
+	})
+	manager := endpoint.NewManager(logger, registry)
+	if err := manager.Create(context.Background(), nil, logger, "original", C.TypeTailscale, &struct{}{}); err != nil {
+		t.Fatal(err)
+	}
+	original := created["original"]
+	box := &Box{endpoint: manager}
+	scopes := box.TailscaleStateStoreScopes()
+	if len(scopes) != 1 || scopes[0].Tag != "original" || original.retired != 0 {
+		t.Fatal("readonly capture retired or lost original")
+	}
+	if err := manager.Remove("original"); err != nil {
+		t.Fatal(err)
+	}
+	if err := manager.Create(context.Background(), nil, logger, "replacement", C.TypeTailscale, &struct{}{}); err != nil {
+		t.Fatal(err)
+	}
+	replacement := created["replacement"]
+	box.retireTailscaleStateStores()
+	if original.retired != 1 || replacement.retired != 1 {
+		t.Fatal("original or late writer escaped sealing")
+	}
+	if err := manager.Close(); err != nil {
+		t.Fatal(err)
+	}
+	nodes := box.TailscaleStoreRetirement()
+	if len(nodes) != 2 || nodes[0].Tag != "original" || nodes[1].Tag != "replacement" {
+		t.Fatalf("final census omitted an original writer: %+v", nodes)
+	}
+	nodes[0].WriterState = "mutated"
+	if box.TailscaleStoreRetirement()[0].WriterState != "NoStoreConstruction" {
+		t.Fatal("caller changed immutable snapshot")
+	}
+}
