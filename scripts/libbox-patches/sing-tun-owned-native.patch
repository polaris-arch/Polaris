+// Frozen, complete configurations; every unlisted Options field remains zero.
+// No production dependency, C IO seam, mark rewrite or alternate claim path is
+// supplied. The conflict fixture changes only B's queue.
+func cNativeOptions(role string, queueConflict bool, handler AutoRedirectHandler) (AutoRedirectOptions, error) {
+	index := slices.Index([]string{"A", "B", "H"}, role)
+	if index < 0 {
+		return AutoRedirectOptions{}, fmt.Errorf("unknown C actor %q", role)
+	}
+	i := index + 1
+	letter := []string{"a", "b", "h"}[index]
+	mark := uint32(0x3100 + index*0x100)
+	queue := uint16(311 + index)
+	if queueConflict {
+		if role != "B" {
+			return AutoRedirectOptions{}, errors.New("queue conflict is B only")
+		}
+		queue = 311
+	}
+	opts := &Options{
+		Name: "pc-c" + letter, MTU: 1500,
+		Inet4Address:          []netip.Prefix{netip.MustParsePrefix(fmt.Sprintf("10.240.%d.1/30", i))},
+		Inet6Address:          []netip.Prefix{netip.MustParsePrefix(fmt.Sprintf("fd00:240:%d::1/64", i))},
+		DNSAddress:            []netip.Addr{netip.MustParseAddr(fmt.Sprintf("10.240.%d.2", i)), netip.MustParseAddr(fmt.Sprintf("fd00:240:%d::2", i))},
+		AutoRedirectInputMark: mark + 1, AutoRedirectOutputMark: mark + 2, AutoRedirectResetMark: mark + 3, AutoRedirectTProxyMark: mark + 4, AutoRedirectNFQueue: queue,
+	}
+	return AutoRedirectOptions{TunOptions: opts, Context: context.Background(), Handler: handler, Logger: logger.NOP(), TableName: "pc_c_" + letter}, nil
+}
