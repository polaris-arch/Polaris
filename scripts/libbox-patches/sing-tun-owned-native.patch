+		if err != nil {
+			return err
+		}
+		acquired = chain.identity
+		// The same chain name in another namespace/family is a different resource.
+		world.access.Lock()
+		other := chain.identity
+		other.scope.namespace.inode++
+		world.state.chains[other] = redirectBirth{}
+		other = chain.identity
+		other.scope.family = 6
