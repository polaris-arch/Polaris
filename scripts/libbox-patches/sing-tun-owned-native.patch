+//go:build linux
+
+package tun
+
+import (
+	"errors"
+	"testing"
+)
+
+// The original broad-deletion reproduction is frozen in 68b1913. This patch
+// tests the production lifecycle with in-memory operations only, not real
+// backend acquisition, NFQueue or live firewall state.
+func TestOwnershipEvidenceUnstartedAndPreNFQueueFailurePreserveA(t *testing.T) {
+	for _, startB := range []bool{false, true} {
+		t.Run(map[bool]string{false: "unstarted", true: "before-nfqueue-acquire"}[startB], func(t *testing.T) {
+			world := newOwnershipFakeWorld()
+			a := newOwnershipTestRedirect(t)
+			a.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+				_, err := op.acquire(redirectIPTables, "sing-box-prerouting", &ownershipFakeOps{world: world})
+				return err
+			}}
+			if err := a.Start(); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = a.Close() })
+			before := world.snapshot(a.ownership.birth)
+			b := newOwnershipTestRedirect(t)
+			b.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+				_, err := op.acquire(redirectNFQueue, b.ownership.birth.String()+"/queue", &ownershipFakeOps{world: world, acquireMode: "before"})
+				return err
+			}}
+			if startB {
+				if err := b.Start(); !errors.Is(err, ownershipTestFailure) {
+					t.Fatalf("Start = %v", err)
+				}
+			}
+			if err := b.Close(); err != nil {
+				t.Fatal(err)
+			}
+			world.assertPreserved(t, a.ownership.birth, before)
+			if events := world.releases(b.ownership.birth); len(events) != 0 {
+				t.Fatalf("B issued deletions without acquire: %v", events)
+			}
+		})
+	}
+}
diff --git a/redirect_ownership_iptables_linux.go b/redirect_ownership_iptables_linux.go
new file mode 100644
index 0000000..20b0f82
--- /dev/null
+++ b/redirect_ownership_iptables_linux.go
@@ -0,0 +1,318 @@
+package tun
+
+import (
+	"crypto/sha256"
+	"encoding/base32"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/netip"
+	"slices"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// A future OS adapter must resolve and retain the namespace handle. A path or
+// "current namespace" label is not identity; aliases must use the same dev/ino.
+type redirectNamespaceIdentity struct {
+	device uint64
+	inode  uint64
+}
+
+type redirectIPTablesScope struct {
+	namespace redirectNamespaceIdentity
+	family    uint8 // 4 or 6; never inferred from an executable path
+	table     string
+}
+
+type redirectIPTablesChainIdentity struct {
+	scope redirectIPTablesScope
+	name  string
+}
+
+type redirectIPTablesRuleIdentity struct {
+	chain redirectIPTablesChainIdentity
+	args  []string // exact delete-by-spec identity, including the birth comment
+}
+
+func (c redirectIPTablesChainIdentity) key() string {
+	return fmt.Sprintf("iptables/%d/%d/%d/%s/%s", c.scope.namespace.device, c.scope.namespace.inode, c.scope.family, c.scope.table, c.name)
+}
+
+func (r redirectIPTablesRuleIdentity) key() (string, error) {
+	encoded, err := json.Marshal(r.args)
+	return r.chain.key() + "/rule/" + string(encoded), err
+}
+
+func (r redirectIPTablesRuleIdentity) clone() redirectIPTablesRuleIdentity {
+	r.args = slices.Clone(r.args)
+	return r
+}
+
+// No real adapter is installed. These methods describe individual fake commits;
+// they cannot express list/scan, flush, policy changes, or global deletion.
+type redirectIPTablesOwnershipOps interface {
+	CreateChain(redirectIPTablesChainIdentity) redirectAcquireResult
+	AddRule(redirectIPTablesRuleIdentity, bool) redirectAcquireResult // true = insert
+	DeleteRule(redirectIPTablesRuleIdentity) error
+	DeleteChain(redirectIPTablesChainIdentity) error
+}
+
+type redirectOwnedIPTablesChain struct {
+	identity redirectIPTablesChainIdentity
+	resource redirectResourceID
+}
+
+func (s redirectIPTablesScope) valid() bool {
+	return s.namespace.device != 0 && s.namespace.inode != 0 && (s.family == 4 || s.family == 6) &&
+		(s.table == iptablesTableNAT || s.table == iptablesTableMangle || s.table == iptablesTableFilter)
+}
+
+func (s redirectIPTablesScope) supportsHook(hook string) bool {
+	switch s.table {
+	case iptablesTableNAT:
+		return hook == "PREROUTING" || hook == "OUTPUT" || hook == "POSTROUTING"
+	case iptablesTableMangle:
+		return hook == "PREROUTING" || hook == "INPUT" || hook == "FORWARD" || hook == "OUTPUT" || hook == "POSTROUTING"
+	case iptablesTableFilter:
+		return hook == "INPUT" || hook == "FORWARD" || hook == "OUTPUT"
+	}
+	return false
+}
+
+func validRedirectIPTablesLabel(value string) bool {
+	return value != "" && utf8.ValidString(value) && !strings.ContainsRune(value, 0)
+}
+
+func (p *redirectOperation) acquireIPTablesChain(scope redirectIPTablesScope, role string, ops redirectIPTablesOwnershipOps) (redirectOwnedIPTablesChain, error) {
+	if !scope.valid() || !validRedirectIPTablesLabel(role) || ops == nil {
+		return redirectOwnedIPTablesChain{}, errors.New("invalid owned iptables chain")
+	}
+	// 128 hash bits encoded in 26 safe ASCII bytes, plus a two-byte prefix. The
+	// caller's table label never determines ownership or a broad-cleanup prefix.
+	digest := sha256.Sum256([]byte(fmt.Sprintf("%d/%d/%d/%s/%s/%s", scope.namespace.device, scope.namespace.inode, scope.family, scope.table, p.owner.birth, role)))
+	identity := redirectIPTablesChainIdentity{scope, "po" + base32.StdEncoding.WithPadding(base32.NoPadding).EncodeToString(digest[:16])}
+	resource, err := p.acquire(redirectIPTables, identity.key(), redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult { return ops.CreateChain(identity) },
+		release: func(redirectResourceID) error { return ops.DeleteChain(identity) },
+	})
+	return redirectOwnedIPTablesChain{identity, resource}, err
+}
+
+func (p *redirectOperation) validIPTablesChain(chain redirectOwnedIPTablesChain) bool {
+	return chain.identity.scope.valid() && chain.resource == (redirectResourceID{p.owner.birth, redirectIPTables, chain.identity.key()})
+}
+
+type redirectIPTablesPort struct {
+	set   bool
+	value uint16
+}
+
+type redirectIPTablesMatch struct {
+	protocol        uint8
+	source          netip.Prefix
+	destination     netip.Prefix
+	sourcePort      redirectIPTablesPort
+	destinationPort redirectIPTablesPort
+}
+
+type redirectIPTablesTarget uint8
+
+const (
+	redirectIPTablesAccept redirectIPTablesTarget = iota + 1
+	redirectIPTablesDrop
+	redirectIPTablesReturn
+)
+
+type redirectIPTablesRuleTarget struct {
+	terminal redirectIPTablesTarget
+	chain    redirectOwnedIPTablesChain
+}
+
+func (t redirectIPTablesTarget) name() string {
+	switch t {
+	case redirectIPTablesAccept:
+		return "ACCEPT"
+	case redirectIPTablesDrop:
+		return "DROP"
+	case redirectIPTablesReturn:
+		return "RETURN"
+	}
+	return ""
+}
+
+// This is the complete grammar, not an approximation of xtables' option parser.
+// Only reviewed, separate flag/value pairs are accepted. No original argv is
+// submitted: numeric typed values generate a fixed canonical representation.
+func parseRedirectIPTablesArgs(scope redirectIPTablesScope, args []string, withTarget bool) (match redirectIPTablesMatch, target redirectIPTablesTarget, err error) {
+	if !scope.valid() || len(args)%2 != 0 {
+		return match, target, errors.New("invalid owned iptables grammar")
+	}
+	seen := make(map[string]bool)
+	for index := 0; index < len(args); index += 2 {
+		flag, value := args[index], args[index+1]
+		if seen[flag] || !validRedirectIPTablesLabel(value) {
+			return match, target, errors.New("duplicate or invalid owned iptables value")
+		}
+		seen[flag] = true
+		switch flag {
+		case "-p":
+			switch value {
+			case "tcp", "6":
+				match.protocol = 6
+			case "udp", "17":
+				match.protocol = 17
+			default:
+				return match, target, errors.New("unreviewed iptables protocol")
+			}
+		case "-s", "-d":
+			prefix, parseErr := netip.ParsePrefix(value)
+			if parseErr != nil {
+				address, addrErr := netip.ParseAddr(value)
+				if addrErr != nil || address.Zone() != "" {
+					return match, target, errors.New("iptables address must be numeric")
+				}
+				prefix = netip.PrefixFrom(address, address.BitLen())
+			}
+			if prefix.Addr().Is4In6() || prefix.Addr().Is4() != (scope.family == 4) {
+				return match, target, errors.New("iptables address family does not match its scope")
+			}
+			if flag == "-s" {
+				match.source = prefix.Masked()
+			} else {
+				match.destination = prefix.Masked()
+			}
+		case "--sport", "--dport":
+			for _, digit := range value {
+				if digit < '0' || digit > '9' {
+					return match, target, errors.New("iptables port must be numeric")
+				}
+			}
+			port, parseErr := strconv.ParseUint(value, 10, 16)
+			if parseErr != nil {
+				return match, target, errors.New("invalid numeric iptables port")
+			}
+			parsed := redirectIPTablesPort{true, uint16(port)}
+			if flag == "--sport" {
+				match.sourcePort = parsed
+			} else {
+				match.destinationPort = parsed
+			}
+		case "-j":
+			if !withTarget {
+				return match, target, errors.New("iptables reference cannot supply its own target")
+			}
+			switch value {
+			case "ACCEPT":
+				target = redirectIPTablesAccept
+			case "DROP":
+				target = redirectIPTablesDrop
+			case "RETURN":
+				target = redirectIPTablesReturn
+			default:
+				return match, target, errors.New("unreviewed iptables target")
+			}
+		default:
+			return match, target, errors.New("unreviewed iptables flag")
+		}
+	}
+	if withTarget && target == 0 || (match.sourcePort.set || match.destinationPort.set) && match.protocol == 0 {
+		return match, target, errors.New("iptables target/protocol is required")
+	}
+	return match, target, nil
+}
+
+func (m redirectIPTablesMatch) argv() []string {
+	var args []string
+	if m.protocol != 0 {
+		args = append(args, "-p", strconv.Itoa(int(m.protocol)))
+		if m.sourcePort.set || m.destinationPort.set {
+			module := "tcp"
+			if m.protocol == 17 {
+				module = "udp"
+			}
+			args = append(args, "-m", module)
+		}
+	}
+	// A /0 prefix and an omitted address match have the same native identity.
+	// Preserve host prefixes even when their address is unspecified.
+	if m.source.IsValid() && m.source.Bits() != 0 {
+		args = append(args, "-s", m.source.Masked().String())
+	}
+	if m.destination.IsValid() && m.destination.Bits() != 0 {
+		args = append(args, "-d", m.destination.Masked().String())
+	}
+	if m.sourcePort.set {
+		args = append(args, "--sport", strconv.Itoa(int(m.sourcePort.value)))
+	}
+	if m.destinationPort.set {
+		args = append(args, "--dport", strconv.Itoa(int(m.destinationPort.value)))
+	}
+	return args
+}
+
+func (m redirectIPTablesMatch) valid(scope redirectIPTablesScope) bool {
+	if !scope.valid() || (m.protocol != 0 && m.protocol != 6 && m.protocol != 17) ||
+		(m.sourcePort.set || m.destinationPort.set) && m.protocol == 0 {
+		return false
+	}
+	for _, prefix := range []netip.Prefix{m.source, m.destination} {
+		if prefix != (netip.Prefix{}) && (!prefix.IsValid() || prefix.Addr().Is4In6() || prefix.Addr().Is4() != (scope.family == 4)) {
+			return false
+		}
+	}
+	return true
+}
+
+func (p *redirectOperation) acquireIPTablesRule(chain redirectOwnedIPTablesChain, role string, args []string, ops redirectIPTablesOwnershipOps, requires ...redirectResourceID) (redirectResourceID, error) {
+	if !p.validIPTablesChain(chain) {
+		return redirectResourceID{}, errors.New("iptables chain does not belong to this birth")
+	}
+	match, target, err := parseRedirectIPTablesArgs(chain.identity.scope, args, true)
+	if err != nil {
+		return redirectResourceID{}, err
+	}
+	return p.acquireIPTablesRuleIdentity(chain.identity, role, match, redirectIPTablesRuleTarget{terminal: target}, false, ops, append(slices.Clone(requires), chain.resource)...)
+}
+
+func (p *redirectOperation) acquireIPTablesReference(chain redirectOwnedIPTablesChain, hook, role string, matches []string, ops redirectIPTablesOwnershipOps, requires ...redirectResourceID) (redirectResourceID, error) {
+	if !p.validIPTablesChain(chain) || !chain.identity.scope.supportsHook(hook) {
+		return redirectResourceID{}, errors.New("invalid owned iptables reference")
+	}
+	match, _, err := parseRedirectIPTablesArgs(chain.identity.scope, matches, false)
+	if err != nil {
+		return redirectResourceID{}, err
+	}
+	target := redirectIPTablesChainIdentity{chain.identity.scope, hook}
+	return p.acquireIPTablesRuleIdentity(target, role, match, redirectIPTablesRuleTarget{chain: chain}, true, ops, append(slices.Clone(requires), chain.resource)...)
+}
+
+func (p *redirectOperation) acquireIPTablesRuleIdentity(target redirectIPTablesChainIdentity, role string, match redirectIPTablesMatch, action redirectIPTablesRuleTarget, insert bool, ops redirectIPTablesOwnershipOps, requires ...redirectResourceID) (redirectResourceID, error) {
+	if !validRedirectIPTablesLabel(role) || !match.valid(target.scope) || ops == nil {
+		return redirectResourceID{}, errors.New("invalid owned iptables rule")
+	}
+	jump := action.terminal.name()
+	if action.terminal != 0 {
+		if jump == "" || action.chain != (redirectOwnedIPTablesChain{}) {
+			return redirectResourceID{}, errors.New("invalid typed iptables target")
+		}
+	} else {
+		if !p.validIPTablesChain(action.chain) || action.chain.identity.scope != target.scope || !slices.Contains(requires, action.chain.resource) {
+			return redirectResourceID{}, errors.New("iptables target chain prerequisite is missing")
+		}
+		jump = action.chain.identity.name
+	}
+	digest := sha256.Sum256([]byte(target.key() + "/" + role))
+	comment := "polaris-owner:" + p.owner.birth.String() + ":" + hex.EncodeToString(digest[:16])
+	identity := redirectIPTablesRuleIdentity{target, append(match.argv(), "-m", "comment", "--comment", comment, "-j", jump)}
+	key, err := identity.key()
+	if err != nil {
+		return redirectResourceID{}, err
+	}
+	return p.acquire(redirectIPTables, key, redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult { return ops.AddRule(identity.clone(), insert) },
+		release: func(redirectResourceID) error { return ops.DeleteRule(identity.clone()) },
+	}, requires...)
+}
