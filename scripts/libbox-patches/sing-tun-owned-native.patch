+func testICommandInput(t *testing.T, command *exec.Cmd) []byte {
+	t.Helper()
+	reader, ok := command.Stdin.(*bytes.Reader)
+	if !ok {
+		t.Error("command lost its frozen stdin")
+		return nil
+	}
+	input := make([]byte, reader.Size())
+	// ReadAt does not touch the offset concurrently consumed by os/exec.
+	if _, err := reader.ReadAt(input, 0); err != nil && !errors.Is(err, io.EOF) {
+		t.Error(err)
+	}
+	return input
+}
