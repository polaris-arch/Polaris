+func TestRedirectProductionSnapshotPhaseAndCandidateIsolation(t *testing.T) {
+	for _, state := range []RouteAddressSetUpdateState{RouteAddressSetUnchanged, RouteAddressSetCommitted, RouteAddressSetUnknown} {
+		t.Run(fmt.Sprint(state), func(t *testing.T) {
+			base := &runtimeFirewallTransport{}
+			r := newRuntimeProductionRedirect(t, filepath.Join(t.TempDir(), "claims"), base)
+			backend := &runtimeSnapshotFirewall{runtimeFirewallTransport: base, state: state, err: ownershipTestFailure, entered: make(chan struct{}), resume: make(chan struct{})}
+			r.productionDependencies.firewall = func(*autoRedirect) (redirectFirewallBackend, error) { return backend, nil }
+			live := []netip.Prefix{netip.MustParsePrefix("192.0.2.0/24")}
+			r.routeAddressSet = func() ([]netip.Prefix, []netip.Prefix, error) { return slices.Clone(live), nil, nil }
+			if err := r.Start(); err != nil {
+				t.Fatal(err)
+			}
+			candidate := []netip.Prefix{netip.MustParsePrefix("198.51.100.0/24")}
+			type outcome struct {
+				result RouteAddressSetUpdateResult
+				err    error
+			}
+			updated := make(chan outcome, 1)
+			go func() {
+				result, err := r.UpdateRouteAddressSetSnapshot(17, candidate, nil)
+				updated <- outcome{result, err}
+			}()
+			ownershipAwait(t, backend.entered)
+			candidate[0] = netip.MustParsePrefix("203.0.113.0/24")
+			// The consumer live getter still exposes A after this call returns.
+			// A network writer must see B if binding committed, before any consumer
+			// publication. It must never observe an unconfirmed candidate.
+			op, err := r.ownership.beginOperation(false, true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			observed := make(chan []netip.Prefix, 1)
+			go func() {
+				defer op.finish()
+				_ = op.withEffect(func() error { input, _, e := r.routeAddressSet(); observed <- input; return e })
+			}()
+			close(backend.resume)
+			got := ownershipAwait(t, updated)
+			if got.result.Generation != 17 || got.result.State != state || !errors.Is(got.err, ownershipTestFailure) || backend.input[0] != netip.MustParsePrefix("198.51.100.0/24") {
+				t.Fatalf("snapshot result/input: %+v %v %v", got.result, got.err, backend.input)
+			}
+			if state != RouteAddressSetUnknown {
+				want := live
+				if state == RouteAddressSetCommitted {
+					want = []netip.Prefix{netip.MustParsePrefix("198.51.100.0/24")}
+				}
+				if !slices.Equal(ownershipAwait(t, observed), want) {
+					t.Fatal("network writer used unconfirmed or stale consumer view")
+				}
+			}
+			if err = r.Close(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
