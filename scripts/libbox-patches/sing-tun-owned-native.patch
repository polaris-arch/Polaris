+type ownedRule struct {
+	id   redirectResourceID
+	spec *netlink.Rule
+}
+
+type ownedRuleSet struct {
+	api      routeNetlink
+	entries  []ownedRule
+	serial   uint64
+	revision uint64
+	unknown  error
+}
+
+func (s *ownedRuleSet) reconcile(op *redirectOperation, desired []*netlink.Rule, requires ...redirectResourceID) (err error) {
+	if s.unknown != nil {
+		return s.unknown
+	}
+	before := s.revision
+	defer func() {
+		if err != nil && (s.revision != before || errors.Is(err, errRedirectAmbiguous)) {
+			s.unknown = errors.Join(ErrRouteUpdateUnconfirmed, errRedirectAmbiguous, err)
+			err = s.unknown
+		}
+	}()
+	frozen := make([]*netlink.Rule, len(desired))
+	for index, rule := range desired {
+		frozen[index] = cloneRule(rule)
+	}
+	for _, rule := range frozen {
+		if slices.ContainsFunc(s.entries, func(entry ownedRule) bool { return reflect.DeepEqual(entry.spec, rule) }) {
+			continue
+		}
+		s.serial++
+		allowed := func(rule *netlink.Rule) bool {
+			return slices.ContainsFunc(s.entries, func(entry ownedRule) bool { return reflect.DeepEqual(entry.spec, rule) })
+		}
+		id, err := acquireOwnedRule(op, s.api, fmt.Sprintf("owned-rule-%d", s.serial), rule, allowed, requires...)
+		if err != nil {
+			if errors.Is(err, errRedirectAmbiguous) {
+				s.unknown = err
+			}
+			return err
+		}
+		s.entries = append(s.entries, ownedRule{id, cloneRule(rule)})
+		s.revision++
+	}
+	for index := len(s.entries) - 1; index >= 0; index-- {
+		entry := s.entries[index]
+		if slices.ContainsFunc(frozen, func(rule *netlink.Rule) bool { return reflect.DeepEqual(entry.spec, rule) }) {
+			continue
+		}
+		if err := op.release(entry.id); err != nil {
+			s.unknown = errors.Join(errRedirectAmbiguous, err)
+			return s.unknown
+		}
+		s.entries = slices.Delete(s.entries, index, index+1)
+		s.revision++
+	}
+	return nil
+}
