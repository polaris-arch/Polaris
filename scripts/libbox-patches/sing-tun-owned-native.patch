+func TestRNativeTunResolverWriterDrainsBeforeCloseAndCannotWriteNextBirth(t *testing.T) {
+	api := newRNetlinkAPI()
+	device := rNewNative(t, rNativeOptions("dns", 1011, 17000), api, rClaimDirectory(t))
+	entered, resume := make(chan struct{}), make(chan struct{})
+	var access sync.Mutex
+	var calls []string
+	run := func(_ string, arguments ...string) ([]byte, error) {
+		access.Lock()
+		calls = append(calls, arguments[0])
+		access.Unlock()
+		if arguments[0] == "domain" {
+			close(entered)
+			<-resume
+		}
+		return nil, nil
+	}
+	writer := make(chan error, 1)
+	go func() {
+		writer <- device.nativeOperation(func(*redirectOperation) error { return device.acquireOwnedSearchDomain("injected-resolvectl", run) })
+	}()
+	<-entered
+	closed := make(chan error, 1)
+	go func() { closed <- device.Close() }()
+	select {
+	case err := <-closed:
+		t.Fatal("Close passed a still-running command", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(resume)
+	if err := <-writer; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-closed; err != nil {
+		t.Fatal(err)
+	}
+	access.Lock()
+	defer access.Unlock()
+	if !slices.Equal(calls, []string{"domain", "default-route", "dns", "revert"}) {
+		t.Fatal("DNS release preceded actual writer completion", calls)
+	}
+}
