+	case err = <-closed:
+		t.Fatal("Close abandoned the admitted original command", err)
+	default:
+	}
+	entries := ownershipEntries(owner)
+	if len(entries) != 1 || entries[0].state != redirectPending {
+		t.Fatal("Closing erased the Pending command", entries)
