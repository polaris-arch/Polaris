index 0000000..b76c35e
--- /dev/null
+++ b/redirect_iptables_private_linux_test.go
@@ -0,0 +1,393 @@
+//go:build linux
+
+package tun
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func testINamespaceLease(t *testing.T) *networkNamespaceLease {
+	t.Helper()
+	// Readonly fd to this process's existing namespace. The scoped fixture only
+	// executes /bin/true or a recording script; it never runs a network binary.
+	lease, err := newNetworkNamespaceLease("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := lease.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	return lease
+}
+
+func testIPrivatePlan(t *testing.T, owner *redirectOwnership, namespace *networkNamespaceLease) *iptablesFamilyPlan {
+	t.Helper()
+	family := testIFamilyPlan(t, 4, 1)
+	family.plan.birth = owner.birth
+	identity := namespace.Identity()
+	family.plan.namespace = redirectNamespaceIdentity{identity.Device, identity.Inode}
+	source, err := family.planChain(iptablesTableNAT, "source")
+	if err != nil {
+		t.Fatal(err)
+	}
+	target, err := family.planChain(iptablesTableNAT, "target")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = family.planRule(iptablesTableNAT, source, []string{"-p", "tcp", "-j", target}); err != nil {
+		t.Fatal(err)
+	}
+	if err = family.planRule(iptablesTableNAT, target, []string{"-j", "RETURN"}); err != nil {
+		t.Fatal(err)
+	}
+	family.plan.sealed = true
+	return family.plan
+}
+
+func TestIPrivateActualCommandIsPendingBeforeWaitAndExactRetirement(t *testing.T) {
+	owner, err := newRedirectOwnership()
+	if err != nil {
+		t.Fatal(err)
+	}
+	namespace := testINamespaceLease(t)
+	op, err := owner.beginStart()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer op.finish()
+	plan := testIPrivatePlan(t, owner, namespace)
+	var access sync.Mutex
+	var observed [][]string
+	runner := &iptablesCommandRunner{wait: func(command *exec.Cmd) error {
+		entries := ownershipEntries(owner)
+		if command.Args[5] == "-N" || command.Args[5] == "-A" {
+			if entries[len(entries)-1].state != redirectPending {
+				t.Error("command started without prior common Pending intent")
+			}
+		}
+		access.Lock()
+		observed = append(observed, slices.Clone(command.Args[1:]))
+		access.Unlock()
+		return command.Wait()
+	}}
+	var generation *iptablesPrivateGeneration
+	err = op.withEffect(func() error {
+		var acquireErr error
+		generation, acquireErr = acquireIPTablesPrivateGeneration(context.Background(), op, plan, "/bin/true", runner, namespace, nil)
+		return acquireErr
+	})
+	if err != nil || len(generation.resources) != 4 {
+		t.Fatal(err, generation)
+	}
+	entries := ownershipEntries(owner)
+	if len(entries) != 4 || len(entries[2].requires) != 2 || len(entries[3].requires) != 1 {
+		t.Fatal("source and target dependency receipts were lost", entries)
+	}
+	if err = op.release(generation.resources[1]); !errors.Is(err, errRedirectDependency) {
+		t.Fatal("target chain retired before its referencing rules", err)
+	}
+	if err = op.withEffect(func() error { return retireIPTablesPrivateGeneration(op, generation) }); err != nil {
+		t.Fatal(err)
+	}
+	access.Lock()
+	commands := slices.Clone(observed)
+	access.Unlock()
+	if len(commands) != 8 {
+		t.Fatal("private acquisition/retirement added guessed commands", commands)
+	}
+	for index, command := range commands {
+		if command[0] != "-w" || command[1] != "2" || slices.Contains(command, "-F") || slices.Contains(command, "-S") {
+			t.Fatal("unbounded or broad command", command)
+		}
+		if index < 4 {
+			continue
+		}
+		original := commands[7-index]
+		want := slices.Clone(original)
+		if want[4] == "-N" {
+			want[4] = "-X"
+		} else {
+			want[4] = "-D"
+		}
+		if !slices.Equal(command, want) {
+			t.Fatal("retirement changed the acquired full specification", command, want)
+		}
+	}
+	for _, entry := range ownershipEntries(owner) {
+		if entry.state != redirectReleased {
+			t.Fatal("confirmed exact cleanup did not retire its own receipt", entry)
+		}
+	}
+}
