+// The source is an IPv4 UDP nonce subcase. It proves actual nonlocal routing
+// through TUN Read -> valid response Write -> endpoint receive. It neither
+// claims IPv6 UDP nor AutoRedirect/MAC/UID/DNS traffic coverage.
+func rNativeUDP(file *os.File, device io.ReadWriter, c rNativeCase, in *rNativeLauncherInputs, negative bool, deadline time.Time) error {
+	nonce := in.Nonce
+	end := minTime(deadline, time.Now().Add(time.Second))
+	conn, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("198.18.0.1")})
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	if err := conn.SetDeadline(end); err != nil {
+		return err
+	}
+	if err := file.SetReadDeadline(end); err != nil {
+		return err
+	}
+	payload := []byte(nonce)
+	if err := rNativePacket(c, in, "endpoint_send", payload); err != nil {
+		return err
+	}
+	if _, err := conn.WriteToUDP(payload, &net.UDPAddr{IP: net.ParseIP("198.18.99.10"), Port: 19001}); err != nil {
+		return err
+	}
+	buffer := make([]byte, 2048)
+	var packet []byte
+	for count := 0; count < 8; count++ {
+		n, err := device.Read(buffer)
+		if err != nil {
+			return err
+		}
+		if err := rNativePacket(c, in, "actual_TUN_Read", buffer[:n]); err != nil {
+			return err
+		}
+		if n >= 28 && buffer[0]>>4 == 4 && buffer[9] == 17 && bytes.Equal(buffer[16:20], net.ParseIP("198.18.99.10").To4()) {
+			packet = slices.Clone(buffer[:n])
+			break
+		}
+	}
+	if packet == nil {
+		return errors.New("nonlocal nonce did not enter actual TUN Read")
+	}
+	header := (int(packet[0]) & 15) * 4
+	if header != 20 || len(packet) != 28+len(payload) || binary.BigEndian.Uint16(packet[2:4]) != uint16(len(packet)) || !bytes.Equal(packet[header+8:], payload) {
+		return errors.New("actual TUN nonce/IPv4/UDP length mismatch")
+	}
+	source, destination := slices.Clone(packet[12:16]), slices.Clone(packet[16:20])
+	copy(packet[12:16], destination)
+	copy(packet[16:20], source)
+	port := slices.Clone(packet[20:22])
+	copy(packet[20:22], packet[22:24])
+	copy(packet[22:24], port)
+	packet[10], packet[11], packet[26], packet[27] = 0, 0, 0, 0
+	binary.BigEndian.PutUint16(packet[10:12], ^checksum.Checksum(packet[:20], 0))
+	response := make([]byte, 128)
+	if negative {
+		wrong := slices.Clone(packet)
+		wrong[28] ^= 1
+		if err := rNativePacket(c, in, "actual_TUN_Write_wrong_nonce", wrong); err != nil {
+			return err
+		}
+		if _, err := device.Write(wrong); err != nil {
+			return err
+		}
+		n, _, err := conn.ReadFromUDP(response)
+		if err == nil {
+			if journalErr := rNativePacket(c, in, "endpoint_receive_wrong_nonce", response[:n]); journalErr != nil {
+				return journalErr
+			}
+		}
+		if err != nil || bytes.Equal(response[:n], payload) {
+			return errors.Join(errors.New("wrong nonce negative control not observed/rejected"), err)
+		}
+	}
+	if err := rNativePacket(c, in, "actual_TUN_Write_valid_response", packet); err != nil {
+		return err
+	}
+	if n, err := device.Write(packet); err != nil || n != len(packet) {
+		return errors.Join(errors.New("actual TUN response Write incomplete"), err)
+	}
+	n, peer, err := conn.ReadFromUDP(response)
+	if err == nil {
+		if journalErr := rNativePacket(c, in, "endpoint_receive_valid_nonce", response[:n]); journalErr != nil {
+			return journalErr
+		}
+	}
+	if err != nil || !bytes.Equal(response[:n], payload) || peer.Port != 19001 || !peer.IP.Equal(net.ParseIP("198.18.99.10")) {
+		return errors.Join(errors.New("endpoint did not receive paired nonlocal nonce"), err)
+	}
+	if negative {
+		if err := rNativePacket(c, in, "endpoint_send_excluded", payload); err != nil {
+			return err
+		}
+		_, sendErr := conn.WriteToUDP(payload, &net.UDPAddr{IP: net.ParseIP("198.19.99.10"), Port: 19001})
+		if sendErr != nil && !errors.Is(sendErr, unix.ENETUNREACH) && !errors.Is(sendErr, unix.EHOSTUNREACH) {
+			return sendErr
+		}
+		if err := file.SetReadDeadline(minTime(deadline, time.Now().Add(100*time.Millisecond))); err != nil {
+			return err
+		}
+		_, readErr := device.Read(buffer)
+		if readErr == nil {
+			return errors.New("excluded-path packet entered TUN")
+		}
+		if !os.IsTimeout(readErr) {
+			return readErr
+		}
+	}
+	return nil
+}
