+	// A nonempty NO_KERNEL_RUN value wins even when other inputs appear valid.
+	if noKernelRun != "" {
+		return errors.New("NOT_EXECUTED: POLARIS_NO_KERNEL_RUN forbids native effects")
+	}
+	if optIn != "1" {
+		return errors.New("NOT_EXECUTED: explicit R opt-in absent")
+	}
+	return bindingError
+}
