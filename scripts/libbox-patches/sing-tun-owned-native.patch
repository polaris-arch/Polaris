+func TestRedirectOwnershipCallbackDrainAndLateRegistration(t *testing.T) {
+	for _, network := range []bool{true, false} {
+		for _, late := range []bool{false, true} {
+			t.Run(fmt.Sprintf("network=%v/late=%v", network, late), func(t *testing.T) {
+				r := newOwnershipTestRedirect(t)
+				nm := &ownershipFakeNetworkMonitor{}
+				im := &ownershipFakeInterfaceMonitor{}
+				registrationEntered := make(chan struct{})
+				registrationResume := make(chan struct{})
+				if network {
+					r.networkMonitor = nm
+					if late {
+						nm.registerEntered = registrationEntered
+						nm.registerResume = registrationResume
+					}
+				} else {
+					r.tunOptions.InterfaceMonitor = im
+					if late {
+						im.registerEntered = registrationEntered
+						im.registerResume = registrationResume
+					}
+				}
+				var bodies atomic.Int32
+				callbackEntered := make(chan struct{})
+				callbackResume := make(chan struct{})
+				r.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, _ *redirectOperation) error {
+					return r.registerNetworkCallback(func() {
+						bodies.Add(1)
+						close(callbackEntered)
+						<-callbackResume
+						r.iptablesAccess.Lock()
+						r.iptablesAccess.Unlock()
+					})
+				}}
+				startDone := make(chan error, 1)
+				go func() { startDone <- r.Start() }()
+				if late {
+					ownershipAwait(t, registrationEntered)
+				} else {
+					if err := ownershipAwait(t, startDone); err != nil {
+						t.Fatal(err)
+					}
+				}
+				// Retain the actual callback value before Unregister, just like emit's snapshot.
+				var callback func()
+				if network {
+					callback = nm.snapshot()[0]
+				} else {
+					value := im.snapshot()[0]
+					callback = func() { value(nil, 0) }
+				}
+				callbackDone := make(chan struct{})
+				if !late {
+					go func() { callback(); close(callbackDone) }()
+					ownershipAwait(t, callbackEntered)
+				}
+				closeDone := make(chan error, 1)
+				go func() { closeDone <- r.Close() }()
+				ownershipWaitClosing(t, r.ownership)
+				ownershipAssertWaiting(t, closeDone)
+				callback()
+				if late {
+					if bodies.Load() != 0 {
+						t.Fatal("late snapshot entered after Closing")
+					}
+					close(registrationResume)
+				} else {
+					if bodies.Load() != 1 {
+						t.Fatal("snapshot callback escaped Closing gate")
+					}
+					close(callbackResume)
+					ownershipAwait(t, callbackDone)
+				}
+				if err := ownershipAwait(t, closeDone); err != nil {
+					t.Fatal(err)
+				}
+				if late {
+					if err := ownershipAwait(t, startDone); !errors.Is(err, errRedirectClosing) {
+						t.Fatalf("late Start=%v", err)
+					}
+				}
+				count := im.count()
+				remaining := len(im.snapshot())
+				if network {
+					count = nm.count()
+					remaining = len(nm.snapshot())
+				}
+				if count != 1 || remaining != 0 {
+					t.Fatalf("callback leak: unregister=%d remaining=%d", count, remaining)
+				}
+				entries := ownershipEntries(r.ownership)
+				if len(entries) != 1 || entries[0].state != redirectReleased {
+					t.Fatalf("callback ledger=%v", entries)
+				}
+			})
+		}
+	}
+}
