+func TestRedirectClaimsActualUIDCapFileGate(t *testing.T) {
+	if os.Getenv("POLARIS_CLAIMS_ROOT_FILE_GATE") != "1" {
+		t.Skip("controlled root / actual two UID + ambient CAP file gate not opted in")
+	}
+	if os.Geteuid() != 0 {
+		t.Fatal("controlled file gate requires actual root; no sudo escalation")
+	}
+	var data [2]unix.CapUserData
+	if err := unix.Capget(&unix.CapUserHeader{Version: unix.LINUX_CAPABILITY_VERSION_3}, &data[0]); err != nil {
+		t.Fatal(err)
+	}
+	for _, capability := range []uint{unix.CAP_NET_ADMIN, unix.CAP_NET_RAW, unix.CAP_NET_BIND_SERVICE, unix.CAP_SETUID, unix.CAP_SETGID} {
+		if data[capability/32].Permitted&(uint32(1)<<(capability%32)) == 0 {
+			t.Fatalf("root lacks required capability %d for actual ambient/UID gate", capability)
+		}
+	}
+	fixture := newActualClaimsFixture(t)
+	// Child credentials must be able to execute the same inspected test binary;
+	// copy only it into this root-owned private fixture, never an installed path.
+	executable := copyClaimsFixtureTest(t, fixture)
+	directory := filepath.Join(fixture, "claims")
+	provisionTestRedirectClaimDirectory(t, directory)
+	store, err := openRedirectClaimStore(directory)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = store.close(); err != nil {
+		t.Fatal(err)
+	}
+	fd, err := unix.Open("/proc/self/ns/net", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fd)
+	var nsStat unix.Stat_t
+	if err = unix.Fstat(fd, &nsStat); err != nil {
+		t.Fatal(err)
+	}
+	namespace := networkNamespaceIdentity{uint64(nsStat.Dev), nsStat.Ino}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	command := func(uid uint32, mode string) *exec.Cmd {
+		if uid != 65531 && uid != 65530 {
+			t.Fatal("invalid closed file-worker UID")
+		}
+		cmd := exec.CommandContext(ctx, executable, "-test.run=^TestRedirectClaimsActualUIDHelper$", "-test.timeout=10s")
+		cmd.Env = append(os.Environ(), "POLARIS_CLAIMS_ACTUAL_MODE="+mode, "POLARIS_CLAIMS_ACTUAL_UID="+strconv.Itoa(int(uid)), "POLARIS_CLAIMS_ACTUAL_DIR="+directory)
+		cmd.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: uid, Gid: uid, NoSetGroups: false}, AmbientCaps: []uintptr{unix.CAP_NET_ADMIN, unix.CAP_NET_RAW, unix.CAP_NET_BIND_SERVICE}}
+		return cmd
+	}
+	run := func(uid uint32, mode string) {
+		t.Helper()
+		output, err := command(uid, mode).CombinedOutput()
+		if err != nil {
+			t.Fatalf("UID %d %s: %v: %s", uid, mode, err, output)
+		}
+		want := fmt.Sprintf("ns=%x:%x", namespace.Device, namespace.Inode)
+		if !strings.Contains(string(output), want) {
+			t.Fatalf("child actual namespace differs: %s", output)
+		}
+		t.Log(strings.TrimSpace(string(output)))
+	}
+	owner, _ := newRedirectOwnership()
+	keys := []redirectConflictKey{{"queue", "65001"}}
+	rootClaim, err := acquireRedirectClaims(directory, namespace, owner.birth, keys)
+	if err != nil {
+		t.Fatal(err)
+	}
+	run(65531, "conflict")
+	run(65530, "conflict")
+	if err = rootClaim.Release(); err != nil {
+		t.Fatal(err)
+	}
+	peer := command(65531, "hold")
+	stdout, err := peer.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdin, err := peer.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = peer.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		_ = stdin.Close()
+		if peer.ProcessState == nil {
+			_ = peer.Process.Kill()
+			_ = peer.Wait()
+		}
+	}()
+	scanner := bufio.NewScanner(stdout)
+	if !scanner.Scan() || !strings.Contains(scanner.Text(), fmt.Sprintf("claimed uid=65531 ns=%x:%x", namespace.Device, namespace.Inode)) {
+		t.Fatal("peer UID failed actual namespace acquisition")
+	}
+	t.Log(scanner.Text())
+	run(65530, "conflict")
+	run(65530, "coexist")
+	if _, err = acquireRedirectClaims(directory, namespace, owner.birth, keys); !errors.Is(err, errRedirectClaimConflict) {
+		t.Fatal("root bypassed peer claim")
+	}
+	if _, err = fmt.Fprintln(stdin, "release"); err != nil {
+		t.Fatal(err)
+	}
+	if err = peer.Wait(); err != nil {
+		t.Fatal(err)
+	}
+	run(65530, "clean")
+	run(65531, "crash")
+	run(65530, "conflict")
+	if _, err = acquireRedirectClaims(directory, namespace, owner.birth, keys); !errors.Is(err, errRedirectClaimResidual) {
+		t.Fatal("root took over peer crash residual")
+	}
+	policy, err := os.ReadFile("/proc/sys/fs/protected_regular")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.TrimSpace(string(policy)) == "0" {
+		t.Fatal("existing host policy does not meet protected_regular enabled gate")
+	}
+	t.Logf("actual root/UID65531/UID65530 ambient shape gate; protected_regular=%s; file-only, no helper handshake or native network proof", strings.TrimSpace(string(policy)))
+}
