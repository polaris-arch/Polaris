+func TestCEnvironmentChild(t *testing.T) {
+	if os.Getenv("POLARIS_C_CHILD") != "1" {
+		return
+	}
+	fd, err := unix.Open(os.Getenv("POLARIS_C_LOCK"), unix.O_RDONLY|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		os.Exit(18)
+	}
+	defer unix.Close(fd)
+	if err = unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		os.Exit(19)
+	}
+	if err = unix.Flock(fd, unix.LOCK_UN); err != nil {
+		os.Exit(20)
+	}
+	if marker := os.Getenv("POLARIS_C_STARTED"); marker != "" {
+		if os.WriteFile(marker, []byte("started"), 0600) != nil {
+			os.Exit(21)
+		}
+	}
+	if gate := os.Getenv("POLARIS_C_GATE"); gate != "" {
+		deadline := time.Now().Add(3 * time.Second)
+		for {
+			if _, err = os.Stat(gate); err == nil {
+				break
+			}
+			if time.Now().After(deadline) {
+				os.Exit(22)
+			}
+			time.Sleep(2 * time.Millisecond)
+		}
+	}
+	if os.Getenv("POLARIS_C_FAIL") == "1" {
+		os.Exit(23)
+	}
+	os.Exit(0)
+}
