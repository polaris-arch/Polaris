+func (w *cDockerIO) parent(tableHandle, chainHandle uint64) {
+	w.access.Lock()
+	defer w.access.Unlock()
+	table := &nftables.Table{Name: "filter", Family: nftables.TableFamilyIPv4, Handle: tableHandle}
+	chain := &nftables.Chain{Name: "DOCKER-USER", Table: table, Handle: chainHandle}
+	foreign := nftablesDockerCompatibilityRule(table, chain, "foreign-tun", expr.MetaKeyIIFNAME, "foreign-existing")
+	foreign.Handle = 99
+	w.snapshot = &nftables.ConsistentSnapshot{Generation: w.snapshot.Generation + 1, Tables: []*nftables.Table{table}, Chains: []*nftables.Chain{chain}, Rules: []*nftables.Rule{foreign}}
