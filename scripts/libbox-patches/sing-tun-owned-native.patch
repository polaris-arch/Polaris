+func rNativeIndependentActors(c rNativeCase, in *rNativeLauncherInputs, o Options, deadline time.Time) error {
+	if in.Actor == "b" {
+		opened := 0
+		birth := ""
+		device, err := newOwnedNativeTun(o, nativeTunDependencies{claimDirectory: redirectClaimDirectory, openTun: func(name string, gso, multi, exclusive bool) (int, bool, error) {
+			opened++
+			return openOwnedTun(name, gso, multi, exclusive)
+		}, openHandle: func(lease *networkNamespaceLease) (routeNetlink, error) {
+			nativeTunCustody.Range(func(key, value any) bool {
+				candidate := value.(*NativeTun)
+				if candidate.options.Name == o.Name {
+					birth = candidate.nativeOwnership.owner.birth.String()
+					return false
+				}
+				return true
+			})
+			return openRouteNetlink(lease)
+		}})
+		if device != nil || opened != 0 || !errors.Is(err, unix.EEXIST) || birth == "" {
+			return fmt.Errorf("independent B exact preflight refusal not reached: %v TUNcalls=%d birth=%s", err, opened, birth)
+		}
+		return rNativeEmit(c, in, "independent_b_allocator_priority_refusal", struct {
+			ActualBirth, Errno string
+			ReturnedNil        bool
+			TUNCalls           int
+			Started, Callback  bool
+		}{birth, err.Error(), true, opened, false, false})
+	}
+	d, err := rNativeNew(o, in, nil, nil)
+	if err != nil {
+		return err
+	}
+	if err := d.Start(); err != nil {
+		return err
+	}
+	api, err := openRouteNetlink(d.nativeOwnership.lease)
+	if err != nil {
+		return err
+	}
+	defer api.Close()
+	before, err := rNativeObserve(api, d, deadline)
+	if err != nil {
+		return err
+	}
+	if err := rNativeUDP(d.tunFile, d, c, in, false, deadline); err != nil {
+		return err
+	}
+	if err := rNativeEmit(c, in, "independent_a_running_before_b", struct {
+		Birth       string
+		Observation rNativeObservation
+	}{d.nativeOwnership.owner.birth.String(), before}); err != nil {
+		return err
+	}
+	// Exactly one bounded G control message; no synthetic Child attach, process
+	// creation or wait adapter. G retains both actual processes and sole Wait.
+	if err := rNativeReadActorControl(in.ActorControl, minTime(deadline, time.Now().Add(time.Second))); err != nil {
+		return err
+	}
+	after, err := rNativeObserve(api, d, deadline)
+	if err != nil {
+		return err
+	}
+	if !rNativeSameRoutes(before.Routes, after.Routes) || !reflect.DeepEqual(before.Rules, after.Rules) || !reflect.DeepEqual(before.Addresses, after.Addresses) {
+		return errors.New("A objects changed during independent B refusal/internal cleanup")
+	}
+	if err := rNativeUDP(d.tunFile, d, c, in, false, deadline); err != nil {
+		return err
+	}
+	if err := rNativeEmit(c, in, "independent_a_preserved_after_b_no_b_callback", after); err != nil {
+		return err
+	}
+	return d.Close()
+}
