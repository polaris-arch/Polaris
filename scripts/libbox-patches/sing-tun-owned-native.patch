+			return err
+		}
+	} else if errors.Is(err, unix.EEXIST) {
+		f.coordinatorFD, err = unix.Openat(f.dirFD, ".polaris-fw4-coordinate-v1", unix.O_RDONLY|unix.O_NONBLOCK|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	}
+	if err != nil {
+		return err
+	}
+	f.coordinatorIdentity, err = fw4Identity(f.coordinatorFD)
+	if err != nil || !f.regular(f.coordinatorIdentity) {
+		return errors.New("fw4 coordinator identity is not trusted")
+	}
+	actual, err := fw4ReadFD(f.coordinatorFD)
+	if err != nil || !bytes.Equal(actual, marker) {
+		return errors.New("fw4 coordinator deployment protocol differs")
+	}
+	f.coordinatorBytes = bytes.Clone(marker)
+	return f.validateDeployment()
+}
+func (f *redirectFW4Runtime) lockCoordinator() error {
