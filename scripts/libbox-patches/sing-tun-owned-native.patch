+func (b *runtimeFirewallTransport) UpdateRouteAddressSet(*autoRedirect, *redirectOperation) error {
+	current := b.active.Add(1)
+	defer b.active.Add(-1)
+	for {
+		old := b.maxActive.Load()
+		if current <= old || b.maxActive.CompareAndSwap(old, current) {
+			break
+		}
+	}
+	b.updates.Add(1)
+	if b.entered != nil {
+		select {
+		case b.entered <- struct{}{}:
+		default:
+		}
+		<-b.resume
+	}
+	return nil
+}
+func (b *runtimeFirewallTransport) UpdateNetwork(r *autoRedirect, op *redirectOperation) error {
+	return b.UpdateRouteAddressSet(r, op)
+}
