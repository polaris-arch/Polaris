+func rNativeQueueReceiver(c rNativeCase, in *rNativeLauncherInputs, d *NativeTun, deadline time.Time) error {
+	fd, err := d.openQueue()
+	if err != nil {
+		return err
+	}
+	queue := os.NewFile(uintptr(fd), "R receiver transferred queue")
+	if err := queue.SetReadDeadline(minTime(deadline, time.Now().Add(time.Second))); err != nil {
+		return err
+	}
+	joined := make(chan error, 1)
+	go func() { _, err := queue.Read(make([]byte, 2048)); joined <- err }()
+	if err := d.Close(); err != nil {
+		return err
+	}
+	var stat unix.Stat_t
+	if err := unix.Fstat(fd, &stat); err != nil {
+		return errors.New("NativeTun.Close closed transferred receiver queue")
+	}
+	if err := queue.Close(); err != nil {
+		return err
+	}
+	select {
+	case err := <-joined:
+		if err == nil {
+			return errors.New("unexpected packet instead of bounded receiver cancel")
+		}
+	case <-time.After(time.Until(deadline)):
+		return errors.New("receiver real Read did not join; custody unresolved")
+	}
+	return rNativeEmit(c, in, "receiver_actual_close_and_join", true)
+}
+
+func rNativeClosingWriter(c rNativeCase, in *rNativeLauncherInputs, d *NativeTun, update Options, entered, resume chan struct{}, release *sync.Once, facts *[]rNativeAPIFact, deadline time.Time) error {
+	updated, closed := make(chan error, 1), make(chan error, 1)
+	go func() { updated <- d.UpdateRouteOptions(update) }()
+	select {
+	case <-entered:
+	case <-time.After(time.Until(deadline)):
+		return errors.New("original admitted update did not enter real API seam")
+	}
+	go func() { closed <- d.Close() }()
+	closing := false
+	for time.Now().Before(deadline) {
+		d.nativeOwnership.owner.access.Lock()
+		closing = d.nativeOwnership.owner.closing
+		d.nativeOwnership.owner.access.Unlock()
+		if closing {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if !closing {
+		return errors.New("Close admission seal not observed")
+	}
+	var stat unix.Stat_t
+	if err := unix.Fstat(d.tunFd, &stat); err != nil {
+		return errors.New("Close retired original FD before writer return")
+	}
+	select {
+	case err := <-closed:
+		return fmt.Errorf("Close returned before actual writer release: %v", err)
+	default:
+	}
+	release.Do(func() { close(resume) })
+	select {
+	case err := <-updated:
+		if err == nil {
+			return errors.New("closing writer incorrectly published success")
+		}
+	case <-time.After(time.Until(deadline)):
+		return errors.New("actual update return not joined")
+	}
+	select {
+	case err := <-closed:
+		if err != nil {
+			return err
+		}
+	case <-time.After(time.Until(deadline)):
+		return errors.New("actual Close return not joined")
+	}
+	return rNativeEmit(c, in, "actual_update_return_then_close_join", *facts)
+}
