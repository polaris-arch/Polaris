+package tun
+
+import (
+	"errors"
+	"fmt"
+	"runtime"
+	"slices"
+	"strconv"
+	"sync"
+
+	"github.com/florianl/go-nfqueue/v2"
+	"github.com/sagernet/sing/common/control"
+)
+
+// Factories are registered once by the real backend files. They may inspect
+// configuration, but must not acquire resources before Start's common journal.
+type redirectFirewallBackend interface {
+	Prepare(*autoRedirect) error
+	Start(*autoRedirect, *redirectOperation, []redirectResourceID) error
+	UpdateRouteAddressSet(*autoRedirect, *redirectOperation) error
+	UpdateNetwork(*autoRedirect, *redirectOperation) error
+}
+
+type redirectRouteBackend interface {
+	Prepare(*autoRedirect) error
+	Start(*autoRedirect, *redirectOperation, []redirectResourceID) ([]redirectResourceID, error)
+	UpdateNetwork(*autoRedirect, *redirectOperation) error
+}
+
+type redirectEnvironmentBackend interface {
+	Start(*autoRedirect, *redirectOperation, []redirectResourceID) error
+	UpdateNetwork(*autoRedirect, *redirectOperation) error
+}
+
+type redirectProductionDependencies struct {
+	firewall       func(*autoRedirect) (redirectFirewallBackend, error)
+	routes         func(*autoRedirect) (redirectRouteBackend, error)
+	environment    func(*autoRedirect) (redirectEnvironmentBackend, error)
+	claimDirectory string
+	acquireClaims  func(string, networkNamespaceIdentity, redirectBirth, []redirectConflictKey) (*redirectClaims, error)
+	nfqueueOpen    func(*nfqueue.Config) (nfqueueConnection, error)
+}
+
+var redirectProductionRegistry struct {
+	sync.Mutex
+	firewall    map[string]func(*autoRedirect) (redirectFirewallBackend, error)
+	routes      func(*autoRedirect) (redirectRouteBackend, error)
+	environment func(*autoRedirect) (redirectEnvironmentBackend, error)
+}
+
+func registerRedirectFirewallBackend(name string, factory func(*autoRedirect) (redirectFirewallBackend, error)) {
+	redirectProductionRegistry.Lock()
+	defer redirectProductionRegistry.Unlock()
+	if name != "nftables" && name != "iptables" || factory == nil {
+		panic("invalid redirect firewall backend")
+	}
+	if redirectProductionRegistry.firewall == nil {
+		redirectProductionRegistry.firewall = make(map[string]func(*autoRedirect) (redirectFirewallBackend, error))
+	}
+	if redirectProductionRegistry.firewall[name] != nil {
+		panic("duplicate redirect firewall backend")
+	}
+	redirectProductionRegistry.firewall[name] = factory
+}
+
+func registerRedirectRouteBackend(factory func(*autoRedirect) (redirectRouteBackend, error)) {
+	redirectProductionRegistry.Lock()
+	defer redirectProductionRegistry.Unlock()
+	if factory == nil || redirectProductionRegistry.routes != nil {
+		panic("invalid or duplicate redirect route backend")
+	}
+	redirectProductionRegistry.routes = factory
+}
+
+func registerRedirectEnvironmentBackend(factory func(*autoRedirect) (redirectEnvironmentBackend, error)) {
+	redirectProductionRegistry.Lock()
+	defer redirectProductionRegistry.Unlock()
+	if factory == nil || redirectProductionRegistry.environment != nil {
+		panic("invalid or duplicate redirect environment backend")
+	}
+	redirectProductionRegistry.environment = factory
+}
+
+type redirectProductionCoordinator struct {
+	firewall       redirectFirewallBackend
+	routes         redirectRouteBackend
+	environment    redirectEnvironmentBackend
+	claimDirectory string
+	acquireClaims  func(string, networkNamespaceIdentity, redirectBirth, []redirectConflictKey) (*redirectClaims, error)
+}
+
+func newRedirectProductionCoordinator(r *autoRedirect) (*redirectProductionCoordinator, error) {
+	// Android's uncovered root route writers remain blocked before all effects.
+	if runtime.GOOS == "android" || r.androidVPNService {
+		return nil, ErrAutoRedirectOwnershipUnsupported
+	}
+	var dependencies redirectProductionDependencies
+	if r.productionDependencies != nil {
+		dependencies = *r.productionDependencies
+	} else {
+		name := "iptables"
+		if r.useNFTables {
+			name = "nftables"
+		}
+		redirectProductionRegistry.Lock()
+		dependencies = redirectProductionDependencies{firewall: redirectProductionRegistry.firewall[name], routes: redirectProductionRegistry.routes, environment: redirectProductionRegistry.environment, claimDirectory: redirectClaimDirectory}
+		redirectProductionRegistry.Unlock()
+	}
+	if dependencies.firewall == nil || (!r.useNFTables || r.tunOptions.AutoRedirectMarkMode) && dependencies.routes == nil {
+		return nil, ErrAutoRedirectOwnershipUnsupported
+	}
+	if dependencies.claimDirectory == "" {
+		return nil, errors.New("missing cooperative claim directory")
+	}
+	coordinator := &redirectProductionCoordinator{claimDirectory: dependencies.claimDirectory, acquireClaims: dependencies.acquireClaims}
+	if coordinator.acquireClaims == nil {
+		coordinator.acquireClaims = acquireRedirectClaims
+	}
+	var err error
+	coordinator.firewall, err = dependencies.firewall(r)
+	if err != nil {
+		return nil, err
+	}
+	if coordinator.firewall == nil {
+		return nil, ErrAutoRedirectOwnershipUnsupported
+	}
+	if !r.useNFTables || r.tunOptions.AutoRedirectMarkMode {
+		coordinator.routes, err = dependencies.routes(r)
+		if err != nil {
+			return nil, err
+		}
+		if coordinator.routes == nil {
+			return nil, ErrAutoRedirectOwnershipUnsupported
+		}
+	}
+	if dependencies.environment != nil {
+		coordinator.environment, err = dependencies.environment(r)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return coordinator, nil
+}
+
+func (r *autoRedirect) runInNamespace(block func() error) error {
+	if r.namespaceLease == nil {
+		return errors.New("auto_redirect namespace is not acquired")
+	}
+	return r.namespaceLease.Run(block)
+}
+
+func (r *autoRedirect) cooperativeClaimDirectory() string {
+	if backend, ok := r.ownershipBackend.(*redirectProductionCoordinator); ok {
+		return backend.claimDirectory
+	}
+	return redirectClaimDirectory
+}
+
+func (b *redirectProductionCoordinator) Start(r *autoRedirect, op *redirectOperation) error {
+	namespaceID, err := op.acquire(redirectNamespace, "pinned-netns", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			lease, openErr := newNetworkNamespaceLease(r.tunOptions.NetNs)
+			if openErr != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, openErr}
+			}
+			r.namespaceLease = lease
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return r.namespaceLease.Close() },
+	})
+	if err != nil {
+		return err
+	}
+	r.ownership.access.Lock()
+	r.ownership.namespaceIdentity = r.namespaceLease.Identity()
+	r.ownership.prerequisites = []redirectResourceID{namespaceID}
+	r.ownership.access.Unlock()
+	claimID, err := op.acquire(redirectClaim, "redirect-conflicts", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			claims, claimErr := b.acquireClaims(b.claimDirectory, r.namespaceLease.Identity(), r.ownership.birth, r.conflictKeys())
+			if claims != nil {
+				r.conflictClaims = claims
+			}
+			if claimErr != nil {
+				if claims != nil {
+					return redirectAcquireResult{redirectAcquireUnknown, claimErr}
+				}
+				return redirectAcquireResult{redirectAcquireNotCommitted, claimErr}
+			}
+			r.conflictClaims = claims
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return r.conflictClaims.Release() },
+	})
+	if err != nil {
+		return err
+	}
+	r.ownership.access.Lock()
+	r.ownership.prerequisites = []redirectResourceID{namespaceID, claimID}
+	r.ownership.mutationGuard = r.conflictClaims.Validate
+	r.ownership.access.Unlock()
+	// Capability checks see the same pinned namespace and validated cooperative
+	// claims as Start, and still precede listener/queue/network acquisitions.
+	if err = r.runInNamespace(func() error { return r.initializeBackend(op, b.firewall) }); err != nil {
+		return err
+	}
+	if err = r.runInNamespace(func() error { return b.firewall.Prepare(r) }); err != nil {
+		return err
+	}
+	if b.routes != nil {
+		if err = r.runInNamespace(func() error { return b.routes.Prepare(r) }); err != nil {
+			return err
+		}
+	}
+	if r.tunOptions.NetNs != "" || r.interfaceFinder == nil {
+		r.interfaceFinder = control.NewDefaultInterfaceFinder()
+	}
+	r.interfaceFinder = &networkNamespaceInterfaceFinder{InterfaceFinder: r.interfaceFinder, lease: r.namespaceLease}
+	listenerID, err := r.acquireRedirectServer(op)
+	if err != nil {
+		return err
+	}
+	queueID, err := r.acquireNFQueue(op)
+	if err != nil {
+		return err
+	}
+	requires := []redirectResourceID{listenerID, queueID}
+	if b.routes != nil {
+		var routeIDs []redirectResourceID
+		err = r.runInNamespace(func() error {
+			var routeErr error
+			routeIDs, routeErr = b.routes.Start(r, op, slices.Clone(requires))
+			return routeErr
+		})
+		if err != nil {
+			return err
+		}
+		anchors := slices.DeleteFunc(slices.Clone(routeIDs), func(id redirectResourceID) bool { return id.domain != redirectNetlink })
+		if len(anchors) == 0 {
+			return errors.New("route backend returned no owned netlink service anchor")
+		}
+		if err = r.ownership.markServiceAnchors(anchors); err != nil {
+			return err
+		}
+		requires = append(requires, routeIDs...)
+	}
+	if err = r.runInNamespace(func() error { return b.firewall.Start(r, op, slices.Clone(requires)) }); err != nil {
+		return err
+	}
+	if b.environment != nil {
+		if err = r.runInNamespace(func() error { return b.environment.Start(r, op, slices.Clone(requires)) }); err != nil {
+			return err
+		}
+	}
+	if r.tunOptions.NetNs != "" {
+		if err = r.acquireNamespaceMonitor(op); err != nil {
+			return err
+		}
+	}
+	return r.registerNetworkOperation(func(update *redirectOperation) error {
+		return b.updateNetwork(r, update)
+	}, requires...)
+}
+
+func (r *autoRedirect) conflictKeys() []redirectConflictKey {
+	keys := []redirectConflictKey{{"queue", strconv.Itoa(int(r.effectiveNFQueue()))}}
+	for _, mark := range []uint32{r.tunOptions.AutoRedirectInputMark, r.tunOptions.AutoRedirectOutputMark, r.tunOptions.AutoRedirectResetMark, r.tunOptions.AutoRedirectTProxyMark} {
+		keys = append(keys, redirectConflictKey{"mark", strconv.FormatUint(uint64(mark), 16)})
+	}
+	keys = append(keys, redirectConflictKey{"redirect-hook", r.tunOptions.Name + ":" + r.tableName})
+	return keys
+}
+
+func (b *redirectProductionCoordinator) updateNetwork(r *autoRedirect, op *redirectOperation) error {
+	if err := r.conflictClaims.Validate(); err != nil {
+		r.ownership.requestClose()
+		return errors.Join(errRedirectAmbiguous, err)
+	}
+	return r.runInNamespace(func() error {
+		var routeErr, environmentErr error
+		if b.routes != nil {
+			routeErr = b.routes.UpdateNetwork(r, op)
+			if errors.Is(routeErr, errRedirectAmbiguous) {
+				return routeErr
+			}
+		}
+		firewallErr := b.firewall.UpdateNetwork(r, op)
+		if errors.Is(firewallErr, errRedirectAmbiguous) {
+			return errors.Join(routeErr, firewallErr)
+		}
+		if b.environment != nil {
+			environmentErr = b.environment.UpdateNetwork(r, op)
+		}
+		return errors.Join(routeErr, firewallErr, environmentErr)
+	})
+}
+
+func (b *redirectProductionCoordinator) UpdateRouteAddressSet(r *autoRedirect, op *redirectOperation) error {
+	if err := r.conflictClaims.Validate(); err != nil {
+		r.ownership.requestClose()
+		return errors.Join(errRedirectAmbiguous, err)
+	}
+	return r.runInNamespace(func() error { return b.firewall.UpdateRouteAddressSet(r, op) })
+}
+
+func (b *redirectProductionCoordinator) UpdateRouteAddressSetSnapshot(r *autoRedirect, op *redirectOperation) (state RouteAddressSetUpdateState, err error) {
+	state = RouteAddressSetUnchanged
+	backend, ok := b.firewall.(interface {
+		UpdateRouteAddressSetSnapshot(*autoRedirect, *redirectOperation) (RouteAddressSetUpdateState, error)
+	})
+	if !ok {
+		return state, ErrAutoRedirectOwnershipUnsupported
+	}
+	if err = r.conflictClaims.Validate(); err != nil {
+		r.ownership.requestClose()
+		return state, errors.Join(errRedirectAmbiguous, err)
+	}
+	err = r.runInNamespace(func() error {
+		state, err = backend.UpdateRouteAddressSetSnapshot(r, op)
+		return err
+	})
+	return state, err
+}
+
+func (r *autoRedirect) acquireNamespaceMonitor(op *redirectOperation) error {
+	_, err := op.acquire(redirectMonitor, "network-monitor", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			monitor, monitorErr := NewNetworkUpdateMonitor(r.logger)
+			if monitorErr != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, monitorErr}
+			}
+			r.networkMonitor = monitor
+			r.ownedNetworkMonitor = true
+			monitorErr = r.runInNamespace(monitor.Start)
+			if monitorErr != nil {
+				closeErr := monitor.Close()
+				if closeErr != nil {
+					return redirectAcquireResult{err: errors.Join(monitorErr, closeErr)}
+				}
+				return redirectAcquireResult{redirectAcquireNotCommitted, monitorErr}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return r.networkMonitor.Close() },
+	})
+	return err
+}
+
+func (r *autoRedirect) acquireRedirectServer(op *redirectOperation) (redirectResourceID, error) {
+	return op.acquire(redirectListener, "redirect-listener", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			if err := r.startRedirectServer(); err != nil {
+				if r.redirectServer != nil {
+					if closeErr := r.redirectServer.Close(); closeErr != nil {
+						return redirectAcquireResult{err: errors.Join(err, closeErr)}
+					}
+				}
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			// A custom port is an explicitly supplied borrowed destination, with
+			// no authority to close the provider's original listener.
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error {
+			if r.redirectServer == nil {
+				return nil
+			}
+			return r.redirectServer.Close()
+		},
+	})
+}
+
+func (r *autoRedirect) acquireNFQueue(op *redirectOperation) (redirectResourceID, error) {
+	return op.acquire(redirectNFQueue, fmt.Sprintf("queue-%d", r.effectiveNFQueue()), redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			if err := r.startNFQueue(); err != nil {
+				if r.nfqueueHandler != nil {
+					if closeErr := r.nfqueueHandler.Close(); closeErr != nil {
+						return redirectAcquireResult{err: errors.Join(err, closeErr)}
+					}
+				}
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return r.nfqueueHandler.Close() },
+	})
+}
