+// Reject duplicate keys before decoding into structs; enforce exact case and
+// required nested fields by comparing canonical input to the typed encoding.
+func rNativeDecodeMetadata(data []byte, c rNativeCase) (rNativeAssociation, error) {
+	var a rNativeAssociation
+	if len(data) == 0 || len(data) > 65536 {
+		return a, errors.New("metadata length bound")
+	}
+	tokens := json.NewDecoder(bytes.NewReader(data))
+	if err := rNativeUniqueJSON(tokens, 0); err != nil {
+		return a, err
+	}
+	if _, err := tokens.Token(); err != io.EOF {
+		return a, errors.New("metadata trailing values")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&a); err != nil {
+		return a, err
+	}
+	actual, err := rNativeCanonicalJSON(data)
+	if err != nil {
+		return a, err
+	}
+	typed, err := json.Marshal(a)
+	if err != nil {
+		return a, err
+	}
+	typed, err = rNativeCanonicalJSON(typed)
+	if err != nil {
+		return a, err
+	}
+	if !bytes.Equal(actual, typed) {
+		return a, errors.New("metadata field case/required closure mismatch")
+	}
+	return a, rNativeValidateAssociation(a, c)
+}
+func rNativeUniqueJSON(decoder *json.Decoder, depth int) error {
+	if depth > 24 {
+		return errors.New("JSON nesting bound")
+	}
+	token, err := decoder.Token()
+	if err != nil {
+		return err
+	}
+	delimiter, ok := token.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delimiter {
+	case '{':
+		seen := map[string]bool{}
+		for decoder.More() {
+			key, err := decoder.Token()
+			if err != nil {
+				return err
+			}
+			name, ok := key.(string)
+			if !ok || seen[name] {
+				return errors.New("duplicate JSON key")
+			}
+			seen[name] = true
+			if err := rNativeUniqueJSON(decoder, depth+1); err != nil {
+				return err
+			}
+		}
+	case '[':
+		for decoder.More() {
+			if err := rNativeUniqueJSON(decoder, depth+1); err != nil {
+				return err
+			}
+		}
+	default:
+		return errors.New("unexpected JSON delimiter")
+	}
+	_, err = decoder.Token()
+	return err
+}
