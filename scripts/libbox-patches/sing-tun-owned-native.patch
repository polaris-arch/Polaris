diff --git a/redirect_claim_linux.go b/redirect_claim_linux.go
new file mode 100644
index 0000000..aa33145
--- /dev/null
+++ b/redirect_claim_linux.go
@@ -0,0 +1,525 @@
+package tun
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	redirectClaimDirectory     = "/run/polaris-sing-tun-claims"
+	redirectClaimProtocolName  = ".protocol"
+	redirectClaimAllocatorName = ".allocator"
+	redirectClaimProtocol      = "{\"protocol\":\"polaris-sing-tun-claims\",\"version\":2,\"layout\":\"sticky-flat\",\"allocator\":\".allocator\"}\n"
+)
+
+var errRedirectClaimConflict = errors.New("cooperative network resource is already claimed")
+var errRedirectClaimResidual = errors.New("cooperative network resource has an unresolved previous birth")
+
+type redirectConflictKey struct{ Domain, Key string }
+
+type redirectClaimFile struct {
+	file     *os.File
+	name     string
+	device   uint64
+	inode    uint64
+	journal  []byte
+	unlinked bool
+}
+
+// A store holds the original directory chain, protocol and allocator inodes.
+// Production always requires root provisioning; alternate owner/parent policy
+// is an internal explicit seam used only by private, unprivileged file fixtures.
+type redirectClaimStore struct {
+	directories    []*os.File
+	protocol       *os.File
+	allocator      *os.File
+	owner          uint32
+	trustedParents bool
+}
+
+func (s *redirectClaimStore) base() *os.File { return s.directories[len(s.directories)-1] }
+
+type redirectClaims struct {
+	access     sync.Mutex
+	store      *redirectClaimStore
+	birth      redirectBirth
+	files      []redirectClaimFile
+	released   bool
+	releaseErr error
+}
+
+func validateRedirectClaimStat(stat *unix.Stat_t, owner, kind, permissions uint32, singleLink bool) error {
+	if stat.Mode&unix.S_IFMT != kind || stat.Mode&07777 != permissions || stat.Uid != owner || singleLink && stat.Nlink != 1 {
+		return errors.New("unsafe cooperative claim ownership, type, links or permissions")
+	}
+	return nil
+}
+
+func validateRedirectClaimParentStat(stat *unix.Stat_t) error {
+	if stat.Mode&unix.S_IFMT != unix.S_IFDIR || stat.Uid != 0 || stat.Mode&0022 != 0 && stat.Mode&01000 == 0 {
+		return errors.New("cooperative claim parent is not a trusted root directory")
+	}
+	return nil
+}
+
+func openRedirectClaimStore(directory string) (*redirectClaimStore, error) {
+	return openRedirectClaimStoreOwned(directory, 0, true)
+}
+
+func openRedirectClaimStoreOwned(directory string, owner uint32, trustedParents bool) (store *redirectClaimStore, err error) {
+	directory, err = filepath.Abs(directory)
+	if err != nil || directory == "/" {
+		return nil, errors.Join(errors.New("invalid cooperative claim directory"), err)
+	}
+	store = &redirectClaimStore{owner: owner, trustedParents: trustedParents}
+	defer func() {
+		if err != nil && store != nil {
+			_ = store.close()
+		}
+	}()
+	fd, err := unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	store.directories = append(store.directories, os.NewFile(uintptr(fd), "/"))
+	for _, component := range strings.Split(strings.TrimPrefix(directory, "/"), "/") {
+		fd, err = unix.Openat(int(store.base().Fd()), component, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return store, err
+		}
+		store.directories = append(store.directories, os.NewFile(uintptr(fd), filepath.Join(store.base().Name(), component)))
+	}
+	for _, name := range []string{redirectClaimProtocolName, redirectClaimAllocatorName} {
+		var linked unix.Stat_t
+		if err = unix.Fstatat(int(store.base().Fd()), name, &linked, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+			return store, err
+		}
+		if err = validateRedirectClaimStat(&linked, owner, unix.S_IFREG, 0444, true); err != nil {
+			return store, err
+		}
+		fd, err = unix.Openat(int(store.base().Fd()), name, unix.O_RDONLY|unix.O_NONBLOCK|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return store, err
+		}
+		file := os.NewFile(uintptr(fd), name)
+		if name == redirectClaimProtocolName {
+			store.protocol = file
+		} else {
+			store.allocator = file
+		}
+	}
+	err = store.validate()
+	return store, err
+}
+
+func (s *redirectClaimStore) close() error {
+	var err error
+	for _, file := range []*os.File{s.protocol, s.allocator} {
+		if file != nil {
+			err = errors.Join(err, file.Close())
+		}
+	}
+	for i := len(s.directories) - 1; i >= 0; i-- {
+		err = errors.Join(err, s.directories[i].Close())
+	}
+	return err
+}
+
+func (s *redirectClaimStore) validate() error {
+	for index, file := range s.directories {
+		var held, linked unix.Stat_t
+		if err := unix.Fstat(int(file.Fd()), &held); err != nil {
+			return err
+		}
+		if index == len(s.directories)-1 {
+			if err := validateRedirectClaimStat(&held, s.owner, unix.S_IFDIR, 01777, false); err != nil {
+				return err
+			}
+		} else if s.trustedParents {
+			if err := validateRedirectClaimParentStat(&held); err != nil {
+				return err
+			}
+		} else if held.Mode&unix.S_IFMT != unix.S_IFDIR {
+			return errRedirectClaimResidual
+		}
+		var err error
+		if index == 0 {
+			err = unix.Lstat("/", &linked)
+		} else {
+			err = unix.Fstatat(int(s.directories[index-1].Fd()), filepath.Base(file.Name()), &linked, unix.AT_SYMLINK_NOFOLLOW)
+		}
+		if err != nil {
+			return err
+		}
+		if linked.Mode&unix.S_IFMT != unix.S_IFDIR || held.Dev != linked.Dev || held.Ino != linked.Ino {
+			return errRedirectClaimResidual
+		}
+	}
+	for _, entry := range []struct {
+		file           *os.File
+		name, contents string
+	}{
+		{s.protocol, redirectClaimProtocolName, redirectClaimProtocol},
+		{s.allocator, redirectClaimAllocatorName, ""},
+	} {
+		if err := s.validateFile(entry.file, entry.name, s.owner, 0444, 0, 0); err != nil {
+			return err
+		}
+		if err := validateRedirectClaimContents(entry.file, []byte(entry.contents)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (s *redirectClaimStore) validateFile(file *os.File, name string, owner, permissions uint32, device, inode uint64) error {
+	var held, linked unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &held); err != nil {
+		return err
+	}
+	if permissions == ^uint32(0) {
+		permissions = held.Mode & 07777
+	}
+	if err := validateRedirectClaimStat(&held, owner, unix.S_IFREG, permissions, true); err != nil {
+		return err
+	}
+	if inode != 0 && (uint64(held.Dev) != device || held.Ino != inode) {
+		return errRedirectClaimResidual
+	}
+	if err := unix.Fstatat(int(s.base().Fd()), name, &linked, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return err
+	}
+	if held.Dev != linked.Dev || held.Ino != linked.Ino || linked.Mode&unix.S_IFMT != unix.S_IFREG {
+		return errRedirectClaimResidual
+	}
+	return nil
+}
+
+func validateRedirectClaimContents(file *os.File, want []byte) error {
+	var stat unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &stat); err != nil {
+		return err
+	}
+	if stat.Size != int64(len(want)) {
+		return errRedirectClaimResidual
+	}
+	content := make([]byte, len(want))
+	n, err := unix.Pread(int(file.Fd()), content, 0)
+	if err != nil {
+		return err
+	}
+	if n != len(want) || string(content) != string(want) {
+		return errRedirectClaimResidual
+	}
+	return nil
+}
+
+// No retry or blocking wait: this global allocator covers only finite local
+// selection and pathname changes, never network effects or lifecycle waits.
+func (s *redirectClaimStore) withAllocator(block func() error) (err error) {
+	if err = s.validate(); err != nil {
+		return err
+	}
+	if err = unix.Flock(int(s.allocator.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		return errors.Join(errRedirectClaimConflict, err)
+	}
+	defer func() { err = errors.Join(err, unix.Flock(int(s.allocator.Fd()), unix.LOCK_UN)) }()
+	if err = s.validate(); err != nil {
+		return err
+	}
+	return errors.Join(block(), s.validate())
+}
+
+// Legacy selection-only API. A caller requiring atomic selection+claims uses
+// withRedirectClaimAllocator and acquireRedirectClaimsInAllocator below.
+func withRedirectAllocator(directory string, _ networkNamespaceIdentity, block func() error) error {
+	return withRedirectClaimAllocator(directory, func(*redirectClaimAllocator) error { return block() })
+}
+
+// The lease is synchronous and must not escape the callback. Claims keep their
+// own pinned store after the allocator is unlocked.
+type redirectClaimAllocator struct {
+	store  *redirectClaimStore
+	active bool
+}
+
+func withRedirectClaimAllocator(directory string, block func(*redirectClaimAllocator) error) error {
+	store, err := openRedirectClaimStore(directory)
+	if err != nil {
+		return err
+	}
+	defer store.close()
+	lease := &redirectClaimAllocator{store: store}
+	return store.withAllocator(func() error {
+		lease.active = true
+		defer func() { lease.active = false }()
+		return block(lease)
+	})
+}
+
+func redirectClaimName(namespace networkNamespaceIdentity, key redirectConflictKey) string {
+	encoded := binary.BigEndian.AppendUint64(nil, uint64(len(key.Domain)))
+	encoded = append(encoded, key.Domain...)
+	encoded = binary.BigEndian.AppendUint64(encoded, uint64(len(key.Key)))
+	encoded = append(encoded, key.Key...)
+	return fmt.Sprintf("v2-%x-%x-%x", namespace.Device, namespace.Inode, sha256.Sum256(encoded))
+}
+
+func redirectClaimJournal(namespace networkNamespaceIdentity, birth redirectBirth, key redirectConflictKey) []byte {
+	// All fields have fixed JSON encodings; strings are encoded by the standard
+	// library, preserving even conflict keys containing delimiters.
+	content, _ := json.Marshal(struct {
+		Version int    `json:"version"`
+		Birth   string `json:"birth"`
+		Device  uint64 `json:"netnsDevice"`
+		Inode   uint64 `json:"netnsInode"`
+		Domain  string `json:"domain"`
+		Key     string `json:"key"`
+	}{2, birth.String(), namespace.Device, namespace.Inode, key.Domain, key.Key})
+	return append(content, '\n')
+}
+
+func acquireRedirectClaims(directory string, namespace networkNamespaceIdentity, birth redirectBirth, keys []redirectConflictKey) (*redirectClaims, error) {
+	store, err := openRedirectClaimStore(directory)
+	if err != nil {
+		return nil, err
+	}
+	return acquireRedirectClaimsWithStore(store, namespace, birth, keys, writeRedirectClaimJournal)
+}
+
+func writeRedirectClaimJournal(file *os.File, content []byte) error {
+	n, err := file.WriteAt(content, 0)
+	if err == nil && n != len(content) {
+		err = io.ErrShortWrite
+	}
+	if err != nil {
+		return err
+	}
+	return file.Sync()
+}
+
+func acquireRedirectClaimsWithStore(store *redirectClaimStore, namespace networkNamespaceIdentity, birth redirectBirth, keys []redirectConflictKey, write func(*os.File, []byte) error) (*redirectClaims, error) {
+	claims := &redirectClaims{store: store, birth: birth}
+	err := store.withAllocator(func() error { return claims.acquireInAllocator(namespace, keys, write) })
+	if err == nil {
+		return claims, nil
+	}
+	// EXCL receipts exist before any journal write. Failed construction has no
+	// network effects and may remove only those original inodes, even half-written.
+	cleanupErr := claims.cleanupConstruction()
+	if cleanupErr != nil {
+		claims.releaseErr = errors.Join(errRedirectAmbiguous, cleanupErr)
+		return claims, errors.Join(err, claims.releaseErr)
+	}
+	return nil, err
+}
+
+func acquireRedirectClaimsInAllocator(allocator *redirectClaimAllocator, namespace networkNamespaceIdentity, birth redirectBirth, keys []redirectConflictKey) (*redirectClaims, error) {
+	if allocator == nil || !allocator.active {
+		return nil, errRedirectClaimConflict
+	}
+	if err := allocator.store.validate(); err != nil {
+		return nil, err
+	}
+	// Open a separate lifetime store and prove it sees the held lock's exact
+	// deployment, without acquiring a second lock on another open description.
+	store, err := openRedirectClaimStoreOwned(allocator.store.base().Name(), allocator.store.owner, allocator.store.trustedParents)
+	if err != nil {
+		return nil, err
+	}
+	for _, pair := range [][2]*os.File{{allocator.store.base(), store.base()}, {allocator.store.protocol, store.protocol}, {allocator.store.allocator, store.allocator}} {
+		var locked, opened unix.Stat_t
+		if err = unix.Fstat(int(pair[0].Fd()), &locked); err == nil {
+			err = unix.Fstat(int(pair[1].Fd()), &opened)
+		}
+		if err == nil && (locked.Dev != opened.Dev || locked.Ino != opened.Ino) {
+			err = errRedirectClaimResidual
+		}
+		if err != nil {
+			return nil, errors.Join(err, store.close())
+		}
+	}
+	claims := &redirectClaims{store: store, birth: birth}
+	if err == nil {
+		err = claims.acquireInAllocator(namespace, keys, writeRedirectClaimJournal)
+	}
+	if err == nil {
+		return claims, nil
+	}
+	if cleanupErr := claims.cleanupConstructionInAllocator(); cleanupErr != nil {
+		claims.releaseErr = errors.Join(errRedirectAmbiguous, cleanupErr)
+		return claims, errors.Join(err, claims.releaseErr)
+	}
+	claims.released = true
+	if closeErr := store.close(); closeErr != nil {
+		claims.releaseErr = errors.Join(errRedirectAmbiguous, closeErr)
+		return claims, errors.Join(err, claims.releaseErr)
+	}
+	return nil, err
+}
+
+func (c *redirectClaims) acquireInAllocator(namespace networkNamespaceIdentity, keys []redirectConflictKey, write func(*os.File, []byte) error) error {
+	keys = slices.Clone(keys)
+	slices.SortFunc(keys, func(a, b redirectConflictKey) int {
+		if a.Domain != b.Domain {
+			return strings.Compare(a.Domain, b.Domain)
+		}
+		return strings.Compare(a.Key, b.Key)
+	})
+	keys = slices.Compact(keys)
+	for _, key := range keys {
+		if key.Domain == "" || key.Key == "" {
+			return errors.New("invalid cooperative conflict key")
+		}
+		name := redirectClaimName(namespace, key)
+		fd, err := unix.Openat(int(c.store.base().Fd()), name, unix.O_RDWR|unix.O_CREAT|unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+		if err != nil {
+			if errors.Is(err, unix.EEXIST) {
+				return fmt.Errorf("%w: %w: %s/%s", errRedirectClaimConflict, errRedirectClaimResidual, key.Domain, key.Key)
+			}
+			return err
+		}
+		// Register immediately: neither stat nor journal failure may orphan an
+		// EXCL-created inode from this birth's construction cleanup.
+		c.files = append(c.files, redirectClaimFile{file: os.NewFile(uintptr(fd), name), name: name, journal: redirectClaimJournal(namespace, c.birth, key)})
+		entry := &c.files[len(c.files)-1]
+		var stat unix.Stat_t
+		if err = unix.Fstat(fd, &stat); err != nil {
+			return err
+		}
+		entry.device, entry.inode = uint64(stat.Dev), stat.Ino
+		if err = c.store.validateFile(entry.file, name, uint32(os.Geteuid()), 0600, entry.device, entry.inode); err != nil {
+			return err
+		}
+		if err = write(entry.file, entry.journal); err != nil {
+			return err
+		}
+	}
+	if err := c.store.base().Sync(); err != nil {
+		return err
+	}
+	return c.validateLocked()
+}
+
+func (c *redirectClaims) cleanupConstruction() error {
+	if len(c.files) != 0 {
+		if err := c.store.withAllocator(c.cleanupConstructionInAllocator); err != nil {
+			return err
+		}
+	}
+	c.released = true
+	return c.store.close()
+}
+
+func (c *redirectClaims) cleanupConstructionInAllocator() error {
+	if err := c.store.validate(); err != nil {
+		return err
+	}
+	for i := range c.files {
+		entry := &c.files[i]
+		if entry.unlinked {
+			continue
+		}
+		if err := c.store.validateFile(entry.file, entry.name, uint32(os.Geteuid()), ^uint32(0), entry.device, entry.inode); err != nil {
+			return err
+		}
+		if err := unix.Unlinkat(int(c.store.base().Fd()), entry.name, 0); err != nil {
+			return err
+		}
+		entry.unlinked = true
+		if err := entry.file.Close(); err != nil {
+			return err
+		}
+	}
+	if err := c.store.base().Sync(); err != nil {
+		return err
+	}
+	return nil
+}
+
+func (c *redirectClaims) validateLocked() error {
+	if c.released {
+		return errRedirectClosing
+	}
+	if c.releaseErr != nil {
+		return c.releaseErr
+	}
+	if err := c.store.validate(); err != nil {
+		return err
+	}
+	for _, entry := range c.files {
+		if entry.unlinked {
+			continue
+		}
+		if err := c.store.validateFile(entry.file, entry.name, uint32(os.Geteuid()), 0600, entry.device, entry.inode); err != nil {
+			return err
+		}
+		if err := validateRedirectClaimContents(entry.file, entry.journal); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *redirectClaims) Validate() error {
+	c.access.Lock()
+	defer c.access.Unlock()
+	return c.validateLocked()
+}
+
+// The caller supplies this authority only after actual OS retirement. Partial
+// unlink is sticky Unknown: retired entries never authorize a later pathname.
+func (c *redirectClaims) Release() error {
+	c.access.Lock()
+	defer c.access.Unlock()
+	return c.releaseLocked(unix.Unlinkat)
+}
+
+func (c *redirectClaims) releaseLocked(unlink func(int, string, int) error) error {
+	if c.released {
+		return c.releaseErr
+	}
+	if c.releaseErr != nil {
+		return c.releaseErr
+	}
+	err := c.store.withAllocator(func() error {
+		if err := c.validateLocked(); err != nil {
+			return err
+		}
+		for i := range c.files {
+			entry := &c.files[i]
+			if err := c.store.validateFile(entry.file, entry.name, uint32(os.Geteuid()), 0600, entry.device, entry.inode); err != nil {
+				return err
+			}
+			if err := validateRedirectClaimContents(entry.file, entry.journal); err != nil {
+				return err
+			}
+			if err := unlink(int(c.store.base().Fd()), entry.name, 0); err != nil {
+				return err
+			}
+			entry.unlinked = true
+			if err := entry.file.Close(); err != nil {
+				return err
+			}
+		}
+		return c.store.base().Sync()
+	})
+	if err != nil {
+		c.releaseErr = errors.Join(errRedirectAmbiguous, err)
+		return c.releaseErr
+	}
+	c.released = true
+	c.releaseErr = c.store.close()
+	return c.releaseErr
+}
