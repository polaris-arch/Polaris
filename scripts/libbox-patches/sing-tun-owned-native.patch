+func TestIProductionFactoryAndExecutableSelectionHaveNoCommandEffects(t *testing.T) {
+	r := newOwnershipTestRedirect(t)
+	r.tunOptions.Inet4Address = []netip.Prefix{netip.MustParsePrefix("172.19.0.1/30")}
+	r.namespaceLease = testINamespaceLease(t)
+	directory := t.TempDir()
