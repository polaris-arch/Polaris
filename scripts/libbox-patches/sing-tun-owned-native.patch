+		t.Fatal("actual NoStart was not preserved", err)
+	}
+	if err = f.owner.close(); err != nil || f.oldDeletes.Load() != 1 {
+		t.Fatal("actual NoStart removed old release authority", err)
+	}
+}
+
+func TestRedirectBindingTimedOutOriginalWait0CannotSettleTwice(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("only authorized nonroot file-only process fixture")
+	}
+	f := newBindingTestFixture(t)
+	ops := &bindingActualProcessOps{bindingTestOps: f.ops(), entered: make(chan *exec.Cmd, 1), actualDone: make(chan struct{}), role: "wait0", budget: 15 * time.Millisecond}
+	t.Cleanup(func() {
+		if ops.input != nil {
+			ops.input.Close()
+		}
+		if ops.command != nil && ops.command.Process != nil {
+			_ = ops.command.Process.Kill()
+			select {
+			case <-ops.actualDone:
+			case <-time.After(4 * time.Second):
+				t.Error("late original Wait was not joined")
+			}
+		}
+	})
+	returned := make(chan error, 1)
+	var next redirectIPTablesBinding
+	go func() {
+		returned <- f.effect(t, func(op *redirectOperation) error {
+			var err error
+			next, err = op.replaceIPTablesBindings([]redirectIPTablesBinding{f.old}, "timed-out-next", ops, nil)
+			return err
+		})
+	}()
+	original := ownershipAwait(t, ops.entered)
+	if err := ownershipAwait(t, returned); !errors.Is(err, errRedirectAmbiguous) {
+		t.Fatal(err)
+	}
+	if err := f.owner.close(); !errors.Is(err, errRedirectAmbiguous) {
+		t.Fatal(err)
+	}
+	if _, err := ops.input.Write([]byte{1}); err != nil {
+		t.Fatal(err)
+	}
+	ops.input.Close()
+	ownershipAwait(t, ops.actualDone)
+	if ops.actualErr != nil || ops.waits.Load() != 1 || ops.command != original {
+		t.Fatal("late actual original Wait0 missing", ops.actualErr)
+	}
+	for _, id := range []redirectResourceID{f.old.resource, next.resource} {
+		entry := bindingEntry(t, f.owner, id)
+		if entry.state != redirectAmbiguous {
+			t.Fatal("late Wait0 reopened settlement", entry)
+		}
+	}
+	if bindingEntry(t, f.owner, next.resource).ops != ops || f.oldDeletes.Load() != 0 {
+		t.Fatal("original process custody was lost or old delete replayed")
+	}
+	if err := f.owner.close(); !errors.Is(err, errRedirectAmbiguous) {
+		t.Fatal("repeated Close reclassified Unknown", err)
+	}
+}
+func TestRedirectBindingClosingDrainsOriginalActualCmdAndRegistersLateFact(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("only authorized nonroot file-only process fixture")
+	}
+	for _, role := range []string{"wait0", "wait4"} {
+		t.Run(role, func(t *testing.T) {
+			f := newBindingTestFixture(t)
+			ops := &bindingActualProcessOps{bindingTestOps: f.ops(), entered: make(chan *exec.Cmd, 1), actualDone: make(chan struct{}), role: role}
+			t.Cleanup(func() {
+				if ops.input != nil {
+					ops.input.Close()
+				}
+				if ops.command != nil && ops.command.Process != nil {
+					_ = ops.command.Process.Kill()
+					select {
+					case <-ops.actualDone:
+					case <-time.After(4 * time.Second):
+						t.Error("actual fixture Wait was not joined")
+					}
+				}
+			})
+			returned := make(chan error, 1)
+			var next redirectIPTablesBinding
+			go func() {
+				returned <- f.effect(t, func(op *redirectOperation) error {
+					var e error
+					next, e = op.replaceIPTablesBindings([]redirectIPTablesBinding{f.old}, "actual-next", ops, nil)
+					return e
+				})
+			}()
+			original := ownershipAwait(t, ops.entered)
+			closing := make(chan error, 1)
+			go func() { closing <- f.owner.close() }()
+			ownershipWaitClosing(t, f.owner)
+			ownershipAssertWaiting(t, closing)
+			if ops.command != original {
+				t.Fatal("replaced original Cmd")
+			}
+			if _, e := ops.input.Write([]byte{1}); e != nil {
+				t.Fatal(e)
+			}
+			ops.input.Close()
+			e := ownershipAwait(t, returned)
+			closeErr := ownershipAwait(t, closing)
+			if role == "wait0" {
+				if e != nil || closeErr != nil || bindingEntry(t, f.owner, next.resource).state != redirectReleased {
+					t.Fatal(e, closeErr)
+				}
+			} else {
+				if !errors.Is(e, errRedirectAmbiguous) || !errors.Is(closeErr, errRedirectAmbiguous) {
+					t.Fatal(e, closeErr)
+				}
+			}
+			if ops.waits.Load() != 1 || f.oldDeletes.Load() != 0 {
+				t.Fatal("original Wait/delete count", ops.waits.Load(), f.oldDeletes.Load())
+			}
+			f.owner.access.Lock()
+			running := f.owner.running
+			f.owner.access.Unlock()
+			if running {
+				t.Fatal("Closing late success reopened Running")
+			}
+		})
+	}
+}
+
+type bindingProbeTransport struct {
+	*runtimeFirewallTransport
+	r                             *autoRedirect
+	acquired, released, factories atomic.Int32
+	mode                          string
+	intent                        redirectIPTablesReadonlyProbeIntent
+}
+
+func (b *bindingProbeTransport) ReadonlyIPTablesProbe(intent redirectIPTablesReadonlyProbeIntent) (redirectResourceOps, error) {
+	b.factories.Add(1)
+	b.intent = intent
+	if b.r.nfqueueHandler != nil || b.r.redirectServer != nil {
+		return nil, errors.New("probe factory after service acquire")
+	}
+	return redirectResourceFuncs{acquire: func(id redirectResourceID) redirectAcquireResult {
+		b.acquired.Add(1)
+		b.r.ownership.access.Lock()
+		entry := b.r.ownership.resourceLocked(id)
+		valid := entry != nil && entry.state == redirectPending && entry.id.domain == redirectReadOnlyProbe && slices.Contains(entry.requires, b.r.ownership.prerequisites[0]) && slices.Contains(entry.requires, b.r.ownership.prerequisites[1])
+		b.r.ownership.access.Unlock()
+		if !valid {
+			return redirectAcquireResult{err: errors.New("readonly Cmd before Pending/anchors")}
+		}
+		switch b.mode {
+		case "no-start":
+			return redirectAcquireResult{redirectAcquireNotCommitted, ownershipTestFailure}
+		case "started-unknown":
+			return redirectAcquireResult{err: ownershipTestFailure}
+		case "panic":
+			panic("readonly started")
+		}
+		return redirectAcquireResult{status: redirectAcquireCreated}
+	}, release: func(redirectResourceID) error { b.released.Add(1); return nil }}, nil
+}
+func (b *bindingProbeTransport) Prepare(r *autoRedirect) error {
+	if !r.enableIPv4 || r.iptablesPath == "" || b.released.Load() != 1 {
+		return errors.New("Prepare did not see completed bounded probe/config")
+	}
+	return nil
+}
+func newBindingProbeRedirect(t *testing.T, mode string, capability bool) (*autoRedirect, *bindingProbeTransport) {
+	t.Helper()
+	// Executable is only LookPath data; a common fallback would try this invalid
+	// fixture and fail. No production or test command executes it.
+	bin := t.TempDir()
+	if e := os.WriteFile(filepath.Join(bin, "iptables"), []byte("not a runnable iptables fixture\n"), 0700); e != nil {
+		t.Fatal(e)
+	}
+	t.Setenv("PATH", bin)
+	base := &runtimeFirewallTransport{}
+	r := newRuntimeProductionRedirect(t, filepath.Join(t.TempDir(), "claims"), base)
+	r.useNFTables = false
+	r.tunOptions.Inet4Address = []netip.Prefix{netip.MustParsePrefix("10.0.0.1/30")}
+	probe := &bindingProbeTransport{runtimeFirewallTransport: base, r: r, mode: mode}
+	if capability {
+		r.productionDependencies.firewall = func(*autoRedirect) (redirectFirewallBackend, error) { return probe, nil }
+	}
+	var releases []string
+	routes := &runtimeRouteServiceTransport{releases: &releases, claimDirectory: r.productionDependencies.claimDirectory}
+	r.productionDependencies.routes = func(*autoRedirect) (redirectRouteBackend, error) { return routes, nil }
+	t.Cleanup(func() {
+		_ = r.Close()
+		if r.conflictClaims != nil {
+			_ = r.conflictClaims.Release()
+		}
+		if r.namespaceLease != nil {
+			_ = r.namespaceLease.Close()
+		}
+	})
+	return r, probe
+}
+func TestRedirectBindingProductionReadonlyProbeJournalAndNoFallback(t *testing.T) {
+	for _, mode := range []string{"success", "no-start", "started-unknown", "panic", "unsupported"} {
+		t.Run(mode, func(t *testing.T) {
+			r, probe := newBindingProbeRedirect(t, mode, mode != "unsupported")
+			e := r.Start()
+			if mode == "success" {
+				if e != nil {
+					t.Fatal(e)
+				}
+				actual := r.namespaceLease.Identity()
+				want := redirectNamespaceIdentity{actual.Device, actual.Inode}
+				if probe.factories.Load() != 1 || probe.acquired.Load() != 1 || probe.released.Load() != 1 || probe.intent.scope.namespace != want || probe.intent.scope.family != 4 || probe.intent.scope.table != iptablesTableNAT || probe.intent.binary != r.iptablesPath || probe.intent.context != r.ctx || !slices.Equal(probe.intent.arguments(), []string{"-w", "2", "-t", "nat", "-S"}) {
+					t.Fatal("wrong bounded read-only request", probe.intent)
+				}
+				args := probe.intent.arguments()
+				args[0] = "-F"
+				if probe.intent.arguments()[0] != "-w" {
+					t.Fatal("probe argv leaked mutable slice")
+				}
+				if e = r.Close(); e != nil {
+					t.Fatal(e)
+				}
+			} else {
+				if e == nil || r.nfqueueHandler != nil || r.redirectServer != nil {
+					t.Fatal("probe failure acquired services", e)
+				}
+				if mode == "unsupported" {
+					if !errors.Is(e, ErrAutoRedirectOwnershipUnsupported) || probe.factories.Load() != 0 {
+						t.Fatal("missing capability fell back to common exec", e)
+					}
+				} else if mode == "no-start" {
+					if errors.Is(e, errRedirectAmbiguous) {
+						t.Fatal("NoStart became Unknown", e)
+					}
+				} else {
+					if !errors.Is(e, errRedirectAmbiguous) || probe.released.Load() != 0 {
+						t.Fatal("Unknown discarded process custody", e)
+					}
+					for _, entry := range ownershipEntries(r.ownership) {
+						if (entry.id.domain == redirectClaim || entry.id.domain == redirectNamespace) && entry.state != redirectOwned {
+							t.Fatal("readonly Unknown released anchor", entry)
+						}
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestRedirectBindingGuardPanicDoesNotAbandonDrain(t *testing.T) {
+	for _, mode := range []string{"acquire", "release"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newBindingTestFixture(t)
+			err := f.effect(t, func(op *redirectOperation) error {
+				f.owner.access.Lock()
+				f.owner.mutationGuard = func() error { panic("guard boundary") }
+				f.owner.access.Unlock()
+				if mode == "release" {
+					return op.release(f.old.resource)
+				}
+				scope := f.scope
+				scope.table = iptablesTableMangle
+				_, err := op.acquireIPTablesBinding(scope, "guard-pending", f.ops())
+				return err
+			})
+			if !errors.Is(err, errRedirectEffectPanic) || !errors.Is(err, errRedirectAmbiguous) {
+				t.Fatal(err)
+			}
+			closed := make(chan error, 1)
+			go func() { closed <- f.owner.close() }()
+			if err = ownershipAwait(t, closed); !errors.Is(err, errRedirectAmbiguous) {
+				t.Fatal(err)
+			}
+		})
+	}
+}
