+func (t *NativeTun) ownedFDIdentity() (nativeTunFDIdentity, error) {
+	if t.nativeOwnership.dependency.identityOfFD != nil {
+		return t.nativeOwnership.dependency.identityOfFD(t.tunFd)
+	}
+	request, err := unix.NewIfreq("")
+	if err != nil {
+		return nativeTunFDIdentity{}, err
+	}
+	if err := unix.IoctlIfreq(t.tunFd, unix.TUNGETIFF, request); err != nil {
+		return nativeTunFDIdentity{}, err
+	}
+	return nativeTunFDIdentity{request.Name(), request.Uint16()}, nil
+}
+
+func newOwnedNativeTun(options Options, dependencies nativeTunDependencies) (Tun, error) {
+	options = freezeRedirectOptions(options)
+	owner, err := newRedirectOwnership()
+	if err != nil {
+		return nil, err
+	}
+	t := &NativeTun{options: options, tunFd: -1, nativeOwnership: &nativeTunOwnership{owner: owner, dependency: dependencies}}
+	nativeTunCustody.Store(owner.birth, t)
+	op, err := owner.beginStart()
+	if err != nil {
+		nativeTunCustody.Delete(owner.birth)
+		return nil, err
+	}
+	err = func() (err error) {
+		defer func() {
+			if value := recover(); value != nil {
+				err = owner.recordPanic(value)
+			}
+		}()
+		return op.withEffect(func() error {
+			t.nativeOwnership.operation = op
+			defer func() { t.nativeOwnership.operation = nil }()
+			return t.acquireNativeTun(op)
+		})
+	}()
+	err = owner.finishStart(err)
+	op.finish()
+	if err != nil {
+		return nil, errors.Join(err, t.Close())
+	}
+	return t, nil
+}
