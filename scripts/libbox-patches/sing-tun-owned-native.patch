+func ownershipNFTBackend(scope redirectNFTScope, ops *ownershipNFTFakeOps) ownershipFakeBackend {
+	return ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+		members, err := ownershipNFTPlan(op, scope, "main")
+		if err != nil {
+			return err
+		}
+		_, err = op.acquireNFTBatch(members, ops)
+		return err
+	}, update: func(*autoRedirect, *redirectOperation) error { return ErrAutoRedirectOwnershipUnsupported }}
+}
