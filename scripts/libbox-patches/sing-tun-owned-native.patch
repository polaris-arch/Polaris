+// This closed file-only test role proves original Cmd/Wait integration. It is
+// not an I restore/parser/COMMIT test and cannot authorize kernel ownership.
+func TestRedirectBindingActualCommandHelper(t *testing.T) {
+	role := os.Getenv("POLARIS_BINDING_PROCESS_ROLE")
+	if role == "" {
+		return
+	}
+	if os.Geteuid() == 0 || (role != "wait0" && role != "wait4") {
+		t.Fatal("unapproved process fixture role")
+	}
+	var input [1]byte
+	if _, e := io.ReadFull(os.Stdin, input[:]); e != nil {
+		t.Fatal(e)
+	}
+	if role == "wait4" {
+		os.Exit(4)
+	}
+}
+
+type bindingActualProcessOps struct {
+	*bindingTestOps
+	command    *exec.Cmd
+	input      *os.File
+	entered    chan *exec.Cmd
+	actualDone chan struct{}
+	waits      atomic.Int32
+	role       string
+	binary     string
+	budget     time.Duration
+	actualErr  error // published by closing actualDone
+}
+
+func (b *bindingActualProcessOps) Transfer(intent redirectIPTablesBindingTransferIntent) redirectIPTablesBindingTransferResult {
+	b.transfers.Add(1)
+	read, write, e := os.Pipe()
+	if e != nil {
+		return redirectIPTablesBindingTransferResult{status: redirectAcquireNotCommitted, err: e}
+	}
+	b.input = write
+	binary := b.binary
+	if binary == "" {
+		binary = os.Args[0]
+	}
+	cmd := exec.Command(binary, "-test.run=^TestRedirectBindingActualCommandHelper$", "-test.timeout=3s")
+	cmd.Env = []string{"POLARIS_NO_KERNEL_RUN=1", "POLARIS_BINDING_PROCESS_ROLE=" + b.role}
+	cmd.Stdin, cmd.Stdout, cmd.Stderr = read, io.Discard, io.Discard
+	b.command = cmd
+	if e = cmd.Start(); e != nil {
+		read.Close()
+		write.Close()
+		return redirectIPTablesBindingTransferResult{status: redirectAcquireNotCommitted, err: e}
+	}
+	read.Close()
+	done := make(chan error, 1)
+	go func() { b.waits.Add(1); e := cmd.Wait(); b.actualErr = e; close(b.actualDone); done <- e }()
+	b.entered <- cmd
+	if b.budget > 0 {
+		timer := time.NewTimer(b.budget)
+		defer timer.Stop()
+		select {
+		case e = <-done:
+		case <-timer.C:
+			return redirectIPTablesBindingTransferResult{err: errors.Join(errRedirectAmbiguous, errors.New("file-only caller wait budget elapsed"))}
+		}
+	} else {
+		e = <-done
+	}
+	if e != nil {
+		return redirectIPTablesBindingTransferResult{err: errors.Join(errRedirectAmbiguous, e)}
+	}
+	return b.commit(intent)
+}
+
+func TestRedirectBindingActualNoStartRetainsOldRelease(t *testing.T) {
+	f := newBindingTestFixture(t)
+	ops := &bindingActualProcessOps{bindingTestOps: f.ops(), binary: filepath.Join(t.TempDir(), "absent"), role: "wait0"}
+	var next redirectIPTablesBinding
+	err := f.effect(t, func(op *redirectOperation) error {
+		var err error
+		next, err = op.replaceIPTablesBindings([]redirectIPTablesBinding{f.old}, "actual-not-started", ops, nil)
+		return err
+	})
