+
+type redirectNFTFamily uint8
+
+const (
+	redirectNFTINet redirectNFTFamily = 1
+	redirectNFTIPv4 redirectNFTFamily = 2
+	redirectNFTIPv6 redirectNFTFamily = 10
+)
+
+type redirectNFTScope struct {
+	namespace redirectNamespaceIdentity
+	family    redirectNFTFamily
+}
+
+func (s redirectNFTScope) valid() bool {
+	return s.namespace.device != 0 && s.namespace.inode != 0 &&
+		(s.family == redirectNFTINet || s.family == redirectNFTIPv4 || s.family == redirectNFTIPv6)
+}
+
+type redirectNFTKind uint8
+
+const (
+	redirectNFTTable redirectNFTKind = iota + 1
+	redirectNFTChain
+	redirectNFTSet
+	redirectNFTElement
+	redirectNFTRule
+)
+
+// Closed descriptors only: private containers, finite address elements and
+// finite rules. This is not raw expressions/attributes or a wire encoder.
+type redirectNFTSpec struct {
+	version uint8
+	kind    redirectNFTKind
+	content redirectNFTContent
+}
+
+type redirectNFTAddress struct {
+	scope    redirectNFTScope
+	kind     redirectNFTKind
+	table    string
+	chain    string
+	set      string
+	element  netip.Addr
+	ruleRole string // creation intent, not a kernel rule name
+}
+
+func (a redirectNFTAddress) key() string {
+	key := fmt.Sprintf("nft/%d/%d/%d/%d/%s/%s", a.scope.namespace.device, a.scope.namespace.inode, a.scope.family, a.kind, a.table, a.chain)
+	if a.kind >= redirectNFTSet {
+		key += fmt.Sprintf("/%s/%s/%s", a.set, a.element, a.ruleRole)
+	}
+	return key
+}
+
+type redirectNFTStamp struct {
+	version uint8
+	birth   redirectBirth
+	intent  [32]byte
+}
+
+type redirectNFTIntent struct {
+	id       redirectResourceID
+	address  redirectNFTAddress
+	stamp    redirectNFTStamp
+	spec     redirectNFTSpec
+	role     string
+	parent   redirectResourceID
+	requires []redirectResourceID
+}
+
+func (i redirectNFTIntent) clone() redirectNFTIntent {
+	i.requires = slices.Clone(i.requires)
+	return i
+}
+
+// An incarnation is the fake oracle's creation version, not a claimed kernel
+// API. Scope, birth, handle and immutable spec jointly bind the actual object.
+type redirectNFTObjectIdentity struct {
+	id          redirectResourceID
+	address     redirectNFTAddress
+	stamp       redirectNFTStamp
+	spec        redirectNFTSpec
+	handle      uint64
+	incarnation uint64
+}
+
+type redirectNFTIdentity struct {
+	object   redirectNFTObjectIdentity
+	parent   redirectNFTObjectIdentity
+	ancestor redirectNFTObjectIdentity // table for an element or rule
+	lookup   redirectNFTObjectIdentity // receipt of a finite rule's referenced set
+}
+
+type redirectNFTTransaction struct {
+	birth    redirectBirth
+	sequence uint64 // local request correlation; never a durable handle
+}
+
+type redirectNFTBatch struct {
+	transaction   redirectNFTTransaction
+	scope         redirectNFTScope
+	members       []redirectNFTIntent                        // entire submitted queue, stable parent-first
+	prerequisites map[redirectResourceID]redirectNFTIdentity // external NFT receipts, not just names
+}
+
+func (b redirectNFTBatch) clone() redirectNFTBatch {
+	b.members = slices.Clone(b.members)
+	b.prerequisites = maps.Clone(b.prerequisites)
+	for index := range b.members {
+		b.members[index] = b.members[index].clone()
+	}
+	return b
+}
+
+type redirectNFTBatchResult struct {
+	transaction redirectNFTTransaction
+	status      redirectAcquireStatus
+	receipts    []redirectNFTIdentity
+	err         error
+}
+
+// Fake-only, stronger than the current pinned adapter. No real adapter is
+// installed here. Atomic compare-and-delete cannot be replaced by a read/delete.
+type redirectNFTOwnershipOps interface {
+	SubmitCreateBatch(redirectNFTBatch) redirectNFTBatchResult
+	ReleaseExact(redirectNFTIdentity) error
+}
+
+type redirectNFTBinding struct {
+	intent   redirectNFTIntent   // frozen Pending plan, retained even without a receipt
+	identity redirectNFTIdentity // finalized once under owner.access before Owned
+	ops      redirectNFTOwnershipOps
+}
+
+func (*redirectNFTBinding) Acquire(redirectResourceID) redirectAcquireResult {
+	return redirectAcquireResult{redirectAcquireNotCommitted, errors.New("nft resource requires a complete batch")}
+}
+
+func (b *redirectNFTBinding) Release(id redirectResourceID) error {
+	if b.identity.object.id != id || !validNFTReceiptHandle(b.identity.object) || b.identity.object.incarnation == 0 {
+		return errors.New("nft release has no confirmed identity")
+	}
+	return b.ops.ReleaseExact(b.identity)
+}
+
+func redirectNFTPrivateName(birth redirectBirth, address redirectNFTAddress, role string) string {
+	digest := sha256.Sum256([]byte(birth.String() + "/" + address.key() + "/" + role))
+	return "pn" + base32.StdEncoding.WithPadding(base32.NoPadding).EncodeToString(digest[:16])
+}
+
+func (p *redirectOperation) nftTableIntent(scope redirectNFTScope, role string, requires ...redirectResourceID) (redirectNFTIntent, error) {
+	address := redirectNFTAddress{scope: scope, kind: redirectNFTTable}
+	address.table = redirectNFTPrivateName(p.owner.birth, address, role)
+	return p.nftIntent(address, role, redirectResourceID{}, requires)
+}
+
+func (p *redirectOperation) nftChainIntent(table redirectNFTIntent, role string, requires ...redirectResourceID) (redirectNFTIntent, error) {
+	if !p.validNFTIntent(table) || table.address.kind != redirectNFTTable {
+		return redirectNFTIntent{}, errors.New("nft parent table does not belong to this birth")
+	}
+	address := redirectNFTAddress{scope: table.address.scope, kind: redirectNFTChain, table: table.address.table}
+	address.chain = redirectNFTPrivateName(p.owner.birth, address, role)
+	dependencies := slices.Clone(requires)
+	if !slices.Contains(dependencies, table.id) {
+		dependencies = append(dependencies, table.id)
+	}
+	return p.nftIntent(address, role, table.id, dependencies)
+}
+
+func (p *redirectOperation) nftIntent(address redirectNFTAddress, role string, parent redirectResourceID, requires []redirectResourceID) (redirectNFTIntent, error) {
+	if !supportedNFTKind(address.kind) {
+		return redirectNFTIntent{}, ErrAutoRedirectOwnershipUnsupported
+	}
+	id := redirectResourceID{p.owner.birth, redirectNFTables, address.key()}
+	intent := redirectNFTIntent{id, address, redirectNFTStamp{1, p.owner.birth, sha256.Sum256([]byte(id.key))}, redirectNFTSpec{version: 1, kind: address.kind}, role, parent, slices.Clone(requires)}
+	if !p.validNFTIntent(intent) {
+		return redirectNFTIntent{}, errors.New("invalid typed nft intent")
+	}
+	return intent, nil
+}
+
+func (p *redirectOperation) validNFTIntent(i redirectNFTIntent) bool {
+	if !i.address.scope.valid() || !validRedirectIPTablesLabel(i.role) ||
+		i.id != (redirectResourceID{p.owner.birth, redirectNFTables, i.address.key()}) ||
+		i.stamp != (redirectNFTStamp{1, p.owner.birth, sha256.Sum256([]byte(i.id.key))}) || !validNFTContent(i.address, i.spec) {
+		return false
+	}
+	address := i.address
+	switch address.kind {
+	case redirectNFTTable:
+		address.table = ""
+		return i.address.chain == "" && i.address.set == "" && !i.address.element.IsValid() && i.address.ruleRole == "" && i.parent == (redirectResourceID{}) && i.address.table == redirectNFTPrivateName(p.owner.birth, address, i.role)
+	case redirectNFTChain:
+		address.chain = ""
+		parent := redirectNFTAddress{scope: address.scope, kind: redirectNFTTable, table: address.table}
+		return i.address.table != "" && i.address.set == "" && !i.address.element.IsValid() && i.address.ruleRole == "" && i.parent == (redirectResourceID{p.owner.birth, redirectNFTables, parent.key()}) &&
+			slices.Contains(i.requires, i.parent) && i.address.chain == redirectNFTPrivateName(p.owner.birth, address, i.role)
+	case redirectNFTSet, redirectNFTElement, redirectNFTRule:
+		return p.validNFTContentIntent(i)
+	}
+	return false
+}
+
+// Caller order is not release order. releaseResources traverses exactly once in
+// reverse registration order, so validate the complete DAG and register only
+// this stable parent-first order. Invalid graphs create no Pending entries.
+func (p *redirectOperation) orderNFTIntents(members []redirectNFTIntent) ([]redirectNFTIntent, map[redirectResourceID]redirectNFTIdentity, error) {
+	o := p.owner // caller holds o.access
+	if p.ended || len(members) == 0 {
+		return nil, nil, errors.New("invalid nft batch operation")
+	}
+	indices := make(map[redirectResourceID]int, len(members))
+	existing := make(map[redirectResourceID]*redirectResource, len(o.resources))
+	for _, entry := range o.resources {
+		existing[entry.id] = entry
+	}
+	for index, member := range members {
+		if !supportedNFTKind(member.address.kind) {
+			return nil, nil, ErrAutoRedirectOwnershipUnsupported
+		}
+		if !p.validNFTIntent(member) || member.address.scope != members[0].address.scope {
+			return nil, nil, errors.New("unsupported or inconsistent nft batch member")
+		}
+		if _, duplicate := indices[member.id]; duplicate || existing[member.id] != nil {
+			return nil, nil, errors.New("duplicate nft physical intent")
+		}
+		indices[member.id] = index
+	}
+	prerequisites := make(map[redirectResourceID]redirectNFTIdentity)
+	indegree := make([]int, len(members))
+	for index, member := range members {
+		seen := make(map[redirectResourceID]bool)
+		for _, dependency := range member.requires {
+			if dependency.birth != o.birth || seen[dependency] {
+				return nil, nil, errors.New("foreign or duplicate nft prerequisite")
+			}
+			seen[dependency] = true
+			if _, internal := indices[dependency]; internal {
+				indegree[index]++
+				continue
+			}
+			entry := existing[dependency]
+			if entry == nil || entry.state != redirectOwned || entry.releasing {
+				return nil, nil, errors.New("nft external prerequisite is not owned")
+			}
+			if dependency.domain == redirectNFTables {
+				binding, typed := entry.ops.(*redirectNFTBinding)
+				if !typed || binding.identity.object.id != dependency || binding.identity.object.address.scope != member.address.scope ||
+					!validNFTReceiptHandle(binding.identity.object) || binding.identity.object.incarnation == 0 || binding.identity.object.stamp.birth != o.birth {
+					return nil, nil, errors.New("nft prerequisite has no scoped typed creation receipt")
+				}
+				if dependency == member.parent {
+					want := member.address.parentAddress()
+					if binding.identity.object.address != want {
+						return nil, nil, errors.New("inconsistent owned nft parent")
+					}
+				}
+				prerequisites[dependency] = binding.identity
+			}
+		}
+		if member.address.kind != redirectNFTTable {
+			if parentIndex, internal := indices[member.parent]; internal {
+				parent := members[parentIndex]
+				if parent.address != member.address.parentAddress() {
+					return nil, nil, errors.New("inconsistent nft parent table")
+				}
+			}
+		}
+	}
+	if err := validateNFTContentDependencies(members, existing); err != nil {
+		return nil, nil, err
+	}
+	ordered := make([]redirectNFTIntent, 0, len(members))
+	used := make([]bool, len(members))
+	for len(ordered) < len(members) {
+		next := -1
+		for index := range members {
+			if !used[index] && indegree[index] == 0 {
+				next = index
+				break
+			}
+		}
+		if next < 0 {
+			return nil, nil, errors.New("cyclic nft batch prerequisites")
+		}
+		used[next] = true
+		ordered = append(ordered, members[next].clone())
+		for index, member := range members {
+			if !used[index] && slices.Contains(member.requires, members[next].id) {
+				indegree[index]--
+			}
+		}
+	}
+	return ordered, prerequisites, nil
+}
+
+// Names cannot make two handles in the same native scope distinct resources.
+type redirectNFTHandleAddress struct {
+	scope  redirectNFTScope
+	kind   redirectNFTKind
+	table  string // containers/rules have a parent table
+	chain  string // rules are located within their chain
+	handle uint64
+}
+
+func (i redirectNFTObjectIdentity) handleAddress() redirectNFTHandleAddress {
+	address := redirectNFTHandleAddress{scope: i.address.scope, kind: i.address.kind, handle: i.handle}
+	if i.address.kind != redirectNFTTable {
+		address.table = i.address.table
+	}
+	if i.address.kind == redirectNFTRule {
+		address.chain = i.address.chain
+	}
+	return address
+}
+
+// Caller holds owner.access, including while comparing previously Owned NFT
+// handles. Concurrent batches cannot confirm conflicting handle receipts.
+func validateNFTReceipts(batch redirectNFTBatch, receipts []redirectNFTIdentity, resources []*redirectResource) ([]redirectNFTIdentity, error) {
+	if len(receipts) != len(batch.members) {
+		return nil, errRedirectInvalidACK
+	}
+	byID := make(map[redirectResourceID]redirectNFTIdentity, len(receipts))
+	handles := make(map[redirectNFTHandleAddress]bool)
+	for _, entry := range resources {
+		if binding, nft := entry.ops.(*redirectNFTBinding); nft && entry.state == redirectOwned && binding.identity.object.address.kind != redirectNFTElement {
+			handles[binding.identity.object.handleAddress()] = true
+		}
+	}
+	parents := make(map[redirectResourceID]redirectNFTIdentity, len(batch.prerequisites)+len(receipts))
+	for id, identity := range batch.prerequisites {
+		parents[id] = identity
+	}
+	for _, identity := range receipts {
+		if _, duplicate := byID[identity.object.id]; duplicate {
+			return nil, errRedirectInvalidACK
+		}
+		byID[identity.object.id] = identity
+	}
+	ordered := make([]redirectNFTIdentity, 0, len(receipts))
+	for _, member := range batch.members {
+		identity, present := byID[member.id]
+		object := identity.object
+		if !present || object.address != member.address || object.stamp != member.stamp || object.spec != member.spec || !validNFTReceiptHandle(object) || object.incarnation == 0 {
+			return nil, errRedirectInvalidACK
+		}
+		if object.address.kind != redirectNFTElement {
+			handle := object.handleAddress()
+			if handles[handle] {
+				return nil, errRedirectInvalidACK
+			}
+			handles[handle] = true
+		}
+		if member.address.kind == redirectNFTTable {
+			if identity.parent != (redirectNFTObjectIdentity{}) || identity.ancestor != (redirectNFTObjectIdentity{}) {
+				return nil, errRedirectInvalidACK
+			}
+		} else if parent, present := parents[member.parent]; !present || identity.parent != parent.object || identity.ancestor != parent.parent {
+			return nil, errRedirectInvalidACK
+		}
+		if member.spec.content.lookup == (redirectResourceID{}) {
+			if identity.lookup != (redirectNFTObjectIdentity{}) {
+				return nil, errRedirectInvalidACK
+			}
+		} else if lookup, present := parents[member.spec.content.lookup]; !present || identity.lookup != lookup.object {
+			return nil, errRedirectInvalidACK
+		}
+		parents[member.id] = identity
+		ordered = append(ordered, identity)
+	}
+	return ordered, nil
+}
+
+func invokeNFTBatch(ops redirectNFTOwnershipOps, batch redirectNFTBatch) (result redirectNFTBatchResult) {
+	defer func() {
+		if value := recover(); value != nil {
+			result = redirectNFTBatchResult{err: fmt.Errorf("%w: %v", errRedirectEffectPanic, value)}
+		}
+	}()
+	return ops.SubmitCreateBatch(batch.clone())
+}
+
+func (p *redirectOperation) acquireNFTBatch(members []redirectNFTIntent, ops redirectNFTOwnershipOps) ([]redirectNFTIdentity, error) {
+	if ops == nil {
+		return nil, errors.New("missing fake nft batch adapter")
+	}
+	o := p.owner
+	o.access.Lock()
+	ordered, prerequisites, err := p.orderNFTIntents(members)
+	if err != nil || o.nftTransaction == ^uint64(0) {
+		o.access.Unlock()
+		if err == nil {
+			err = errors.New("nft transaction counter exhausted")
+		}
+		return nil, err
+	}
+	o.nftTransaction++
+	batch := redirectNFTBatch{redirectNFTTransaction{o.birth, o.nftTransaction}, ordered[0].address.scope, ordered, prerequisites}
+	entries := make([]*redirectResource, 0, len(ordered))
+	for _, member := range ordered {
+		entry := &redirectResource{id: member.id, state: redirectPending, ops: &redirectNFTBinding{intent: member.clone(), ops: ops}, requires: slices.Clone(member.requires)}
+		entries = append(entries, entry)
+	}
+	o.resources = append(o.resources, entries...)
+	o.operations++
+	o.access.Unlock()
+
+	result := invokeNFTBatch(ops, batch)
+	o.access.Lock()
+	defer func() {
+		o.operations--
+		o.drain.Broadcast()
+		o.access.Unlock()
+	}()
+	state := redirectAmbiguous
+	err = result.err
+	var identities []redirectNFTIdentity
+	if result.transaction == batch.transaction && result.status == redirectAcquireCreated && err == nil {
+		identities, err = validateNFTReceipts(batch, result.receipts, o.resources)
+		if err == nil {
+			state = redirectOwned
+		}
+	} else if result.transaction == batch.transaction && result.status == redirectAcquireNotCommitted && len(result.receipts) == 0 && err != nil &&
+		!errors.Is(err, errRedirectEffectPanic) && !errors.Is(err, errRedirectInvalidACK) && !errors.Is(err, errRedirectAmbiguous) {
+		state = redirectReleased
+	}
+	if state == redirectAmbiguous {
+		if result.status != redirectAcquireUnknown || err == nil {
+			err = errors.Join(errRedirectInvalidACK, err)
+		}
+		err = errors.Join(errRedirectAmbiguous, err)
+		identities = nil
+	}
+	for index, entry := range entries {
+		if state == redirectOwned {
+			entry.ops.(*redirectNFTBinding).identity = identities[index]
+		}
+		entry.state, entry.err = state, err
+	}
+	return identities, err
+}
