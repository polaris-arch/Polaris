+func (t *NativeTun) updateOwnedRouteOptions(options Options) error {
+	return t.nativeOperation(func(op *redirectOperation) error {
+		n := t.nativeOwnership
+		options = freezeRedirectOptions(options)
+		if options.Name != t.options.Name || options.NetNs != t.options.NetNs || options.FileDescriptor != t.options.FileDescriptor ||
+			options.IPRoute2TableIndex != t.options.IPRoute2TableIndex || options.IPRoute2RuleIndex != t.options.IPRoute2RuleIndex ||
+			options.IPRoute2AutoRedirectFallbackRuleIndex != t.options.IPRoute2AutoRedirectFallbackRuleIndex || options.AutoRoute != t.options.AutoRoute ||
+			options.AutoRedirectMarkMode != t.options.AutoRedirectMarkMode || options.MTU != t.options.MTU ||
+			!slices.Equal(options.Inet4Address, t.options.Inet4Address) || !slices.Equal(options.Inet6Address, t.options.Inet6Address) {
+			return errors.New("route update cannot change frozen TUN, namespace, table, priority, or address acquisition")
+		}
+		if t.options.FileDescriptor > 0 || t.options.EXP_ExternalConfiguration {
+			return nil
+		}
+		if !n.started {
+			return errRedirectNotStarted
+		}
+		planOptions := freezeRedirectOptions(t.options)
+		planOptions.Inet4RouteAddress, planOptions.Inet6RouteAddress = options.Inet4RouteAddress, options.Inet6RouteAddress
+		planOptions.Inet4RouteExcludeAddress, planOptions.Inet6RouteExcludeAddress = options.Inet4RouteExcludeAddress, options.Inet6RouteExcludeAddress
+		planOptions.Inet4Gateway, planOptions.Inet6Gateway = options.Inet4Gateway, options.Inet6Gateway
+		planOptions.StrictRoute = options.StrictRoute
+		planOptions.IncludeInterface, planOptions.ExcludeInterface = options.IncludeInterface, options.ExcludeInterface
+		planOptions.IncludeUID, planOptions.ExcludeUID = options.IncludeUID, options.ExcludeUID
+		// A route-only update cannot republish new descriptor/offload/DNS/monitor
+		// capabilities or move our rules outside the frozen priority claims.
+		options = planOptions
+		previous := t.options
+		routeRevision, ruleRevision := n.routes.revision, n.rules.revision
+		t.options = options // private builder input; no callback can observe under effect
+		defer func() { t.options = previous }()
+		err := n.lease.Run(func() error {
+			routes, err := t.routes(n.link)
+			if err != nil {
+				return err
+			}
+			plan := t.rules() // freeze once; nextIndex6 cannot allocate again
+			if err := n.routes.reconcile(op, routes); err != nil {
+				return err
+			}
+			if err := n.rules.reconcile(op, plan); err != nil {
+				return err
+			}
+			return nil
+		})
+		if err == nil {
+			// Lease.Run must also have confirmed namespace restoration. Publish
+			// the candidate before releasing the writer gate, atomically with
+			// Close admission; successful mutations alone do not commit options.
+			n.owner.access.Lock()
+			if n.owner.closing {
+				err = errRedirectClosing
+			} else {
+				previous = options
+			}
+			n.owner.access.Unlock()
+		}
+		if err != nil && (n.routes.revision != routeRevision || n.rules.revision != ruleRevision || errors.Is(err, errRedirectAmbiguous)) {
+			n.sealed = errors.Join(ErrRouteUpdateUnconfirmed, errRedirectAmbiguous, err)
+			// Keep the last confirmed options as history, not a claimed rollback.
+			// Explicit consumer Close is the only retirement request here: a
+			// stack or transferred queue can still be using the main TUN fd.
+			return n.sealed
+		}
+		return err
+	})
+}
+
+func (t *NativeTun) acquireProvidedNativeTun(op *redirectOperation) error {
+	n := t.nativeOwnership
+	_, err := op.acquire(redirectTun, "provided-tun-duplicate", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			// Duplicate first. All identity observations belong to this exact
+			// reference, not a provider fd that might be closed/reused meanwhile.
+			fd, err := unix.FcntlInt(uintptr(t.options.FileDescriptor), unix.F_DUPFD_CLOEXEC, 0)
+			if err != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			t.tunFd, t.tunFile = fd, os.NewFile(uintptr(fd), "tun")
+			n.borrowed = true
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return t.tunFile.Close() },
+	})
+	if err != nil {
+		return err
+	}
+	identity, err := t.ownedFDIdentity()
+	if err != nil {
+		return err
+	}
+	if identity.flags&unix.IFF_TUN == 0 {
+		return errors.New("provided duplicate is not a TUN device")
+	}
+	if t.options.Name != "" && t.options.Name != identity.name {
+		return errors.New("provided TUN duplicate does not match the frozen interface name")
+	}
+	t.options.Name = identity.name
+	// Linux UAPI _IO('T', 227). The ioctl grants a new actual namespace fd.
+	// EPERM/unsupported is not evidence that this explicitly provided TUN fd
+	// cannot perform I/O. In that case no namespace/tun/table/shared-config
+	// claim is inferred from Options.NetNs or from an interface name.
+	const tunGetDeviceNamespace = uint(0x54e3)
+	namespaceFD, namespaceErr := unix.IoctlRetInt(t.tunFd, tunGetDeviceNamespace)
+	if namespaceErr == nil {
+		_, err = op.acquire(redirectNamespace, "provided-tun-actual-netns", redirectResourceFuncs{
+			acquire: func(redirectResourceID) redirectAcquireResult {
+				lease, err := newNetworkNamespaceLease("/proc/self/fd/" + strconv.Itoa(namespaceFD))
+				n.lease = lease
+				closeErr := unix.Close(namespaceFD)
+				if err != nil {
+					return redirectAcquireResult{redirectAcquireNotCommitted, errors.Join(err, closeErr)}
+				}
+				if closeErr != nil {
+					return redirectAcquireResult{err: closeErr}
+				}
+				n.fdNamespaceKnown = true
+				return redirectAcquireResult{status: redirectAcquireCreated}
+			},
+			release: func(redirectResourceID) error { return n.lease.Close() },
+		})
+		if err != nil {
+			return err
+		}
+	}
+	if t.options.GSO {
+		// This is the provider's explicit fd+GSO capability, including actual
+		// TUNSETOFFLOAD writes. Unknown namespace is never promoted into the
+		// shared-config cooperative safety claim; the existing capability stays.
+		if err := t.enableGSO(); err != nil && t.options.Logger != nil {
+			t.options.Logger.Warn(err)
+		}
+	}
+	return nil
+}
+
+func (n *nativeTunOwnership) acquireRouteSocket(op *redirectOperation, key string) (redirectResourceID, error) {
+	var actual routeNetlink
+	return op.acquire(redirectNetlink, key, redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			var err error
+			actual, err = n.dependency.openHandle(n.lease)
+			n.api = actual
+			if err != nil {
+				if actual == nil {
+					return redirectAcquireResult{redirectAcquireNotCommitted, err}
+				}
+				return redirectAcquireResult{err: err}
+			}
+			if actual == nil {
+				return redirectAcquireResult{err: errRedirectInvalidACK}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error {
+			err := actual.Close()
+			if err == nil {
+				n.api = nil
+			}
+			return err
+		},
+	})
+}
+
+func (t *NativeTun) acquireOwnedQueue(op *redirectOperation) (int, error) {
+	n := t.nativeOwnership
+	if !t.multiQueue {
+		return -1, errors.New("tun device is not multi-queue")
+	}
+	if err := t.validateNativeLink(); err != nil {
+		return -1, err
+	}
+	n.queueSerial++
+	fd := -1
+	handoff := false
+	id, err := op.acquire(redirectTun, fmt.Sprintf("tun-queue-%d", n.queueSerial), redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			err := n.lease.Run(func() error {
+				var err error
+				var multiQueue bool
+				// The ledger is already Pending. Capture the actual fd before
+				// Run can report any namespace restoration error.
+				fd, multiQueue, err = n.dependency.openTun(t.options.Name, t.options.GSO, true, false)
+				if err == nil && (fd < 0 || !multiQueue) {
+					return errors.New("additional TUN queue was not acquired in multi-queue mode")
+				}
+				return err
+			})
+			if err != nil {
+				if fd >= 0 {
+					closeErr := unix.Close(fd) // exact, untransferred owned queue; once only
+					if closeErr != nil {
+						return redirectAcquireResult{err: errors.Join(err, closeErr)}
+					}
+					fd = -1
+					return redirectAcquireResult{redirectAcquireNotCommitted, err}
+				}
+				return routeAcquireResult(err)
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error {
+			if handoff {
+				return nil // this admitted operation transfers the fd to goLinuxIO
+			}
+			return unix.Close(fd)
+		},
+	})
+	if err != nil {
+		return -1, err
+	}
+	handoff = true
+	if err := op.release(id); err != nil {
+		handoff = false // no caller received the fd; retain the ledger responsibility
+		return -1, err
+	}
+	return fd, nil
+}
+
+func (t *NativeTun) configureOwnedRPFilter() error {
+	n := t.nativeOwnership
+	if n.dependency.configureRPFilter != nil {
+		return n.dependency.configureRPFilter(t)
+	}
+	path := "/proc/sys/net/ipv4/conf/" + t.options.Name + "/rp_filter"
+	var maximum int
+	for _, name := range []string{"/proc/sys/net/ipv4/conf/all/rp_filter", path} {
+		content, err := os.ReadFile(name)
+		if err != nil {
+			continue
+		}
+		value, err := strconv.Atoi(strings.TrimSpace(string(content)))
+		if err == nil {
+			maximum = max(maximum, value)
+		}
+	}
+	if maximum != 1 {
+		return nil
+	}
+	previous, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	return t.acquireOwnedRPFilter(path, previous)
+}
+
+func (t *NativeTun) acquireOwnedRPFilter(path string, previous []byte) error {
+	n := t.nativeOwnership
+	previous = slices.Clone(previous)
+	var file *os.File
+	readValue := func() (string, error) {
+		buffer := make([]byte, 32)
+		length, err := file.ReadAt(buffer, 0)
+		if err != nil && !errors.Is(err, io.EOF) {
+			return "", err
+		}
+		return strings.TrimSpace(string(buffer[:length])), nil
+	}
+	_, err := n.operation.acquire(redirectFile, "tun-rp-filter", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			if err := t.validateNativeLink(); err != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			fd, err := unix.Open(path, unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+			if err != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			file = os.NewFile(uintptr(fd), "tun-rp-filter")
+			value, err := readValue()
+			if err != nil || value != strings.TrimSpace(string(previous)) {
+				closeErr := file.Close()
+				if closeErr != nil {
+					return redirectAcquireResult{err: errors.Join(err, closeErr)}
+				}
+				return redirectAcquireResult{redirectAcquireNotCommitted, errors.Join(errors.New("rp_filter changed before acquisition"), err, closeErr)}
+			}
+			if length, err := file.WriteAt([]byte("2"), 0); err != nil || length != 1 {
+				return redirectAcquireResult{err: errors.Join(io.ErrShortWrite, err)}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error {
+			if err := t.validateNativeLink(); err != nil {
+				return err
+			}
+			value, err := readValue()
+			if err != nil || value != "2" {
+				return errors.Join(errors.New("rp_filter changed after acquisition"), err)
+			}
+			if length, err := file.WriteAt(previous, 0); err != nil || length != len(previous) {
+				return errors.Join(io.ErrShortWrite, err)
+			}
+			return file.Close()
+		},
+	})
+	return err
+}
