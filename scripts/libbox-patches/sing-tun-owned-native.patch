+func TestIProductionCoordinatorUsesRegisteredAdapterAndJournaledProbeBeforeQueue(t *testing.T) {
+	directory := t.TempDir()
+	commands := filepath.Join(directory, "commands")
+	if err := os.Mkdir(commands, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", commands)
+	for name, script := range map[string]string{
+		"iptables":         "#!/bin/sh\nexit 0\n",
+		"iptables-restore": "#!/bin/sh\n/bin/cat >/dev/null || exit 1\nexit 0\n",
+	} {
+		if err := os.WriteFile(filepath.Join(commands, name), []byte(script), 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	claims := filepath.Join(directory, "claims")
+	r := newRuntimeProductionRedirect(t, claims, &runtimeFirewallTransport{})
+	r.useNFTables = false
+	r.enableIPv4 = false // common initializeBackend must derive the actual family
+	r.networkMonitor = &ownershipFakeNetworkMonitor{}
+	var released []string
+	routes := &runtimeRouteServiceTransport{releases: &released, claimDirectory: claims, claimRequired: true}
+	r.productionDependencies.routes = func(*autoRedirect) (redirectRouteBackend, error) { return routes, nil }
+	redirectProductionRegistry.Lock()
+	factory := redirectProductionRegistry.firewall["iptables"]
+	redirectProductionRegistry.Unlock()
+	var backend *iptablesProductionBackend
+	r.productionDependencies.firewall = func(r *autoRedirect) (redirectFirewallBackend, error) {
+		result, err := factory(r)
+		if err == nil {
+			backend = result.(*iptablesProductionBackend)
+		}
+		return result, err
+	}
+	queue := &runtimeNFQueueTransport{}
+	probeObserved := false
+	r.productionDependencies.nfqueueOpen = func(config *nfqueue.Config) (nfqueueConnection, error) {
+		for _, entry := range ownershipEntries(r.ownership) {
+			if entry.id.domain != redirectReadOnlyProbe {
+				continue
+			}
+			probe := entry.ops.(*iptablesReadonlyProbeOps)
+			if entry.state != redirectReleased || !probe.result.nativeExit || probe.result.err != nil || config.NetNS <= 0 {
+				return nil, errors.New("queue admission preceded its original probe Wait0/retirement or omitted namespace")
+			}
+			probeObserved = true
+		}
+		if !probeObserved {
+			return nil, errors.New("common initializeBackend skipped the I probe")
+		}
+		return queue, nil
+	}
+	if err := r.Start(); err != nil {
+		t.Fatal("registered production caller failed", err)
+	}
+	if !probeObserved || backend == nil || backend.namespace != r.namespaceLease || len(backend.current) != 3 {
+		t.Fatal("production factory/probe/full IPv4 graph was not consumed", probeObserved, backend)
+	}
+	if err := r.UpdateRouteAddressSet(); err != nil {
+		t.Fatal("production legacy update entry did not use the typed handoff", err)
+	}
+	if err := r.Close(); err != nil || queue.closeCount.Load() != 1 || r.conflictClaims.Validate() == nil {
+		t.Fatal("exact I cleanup did not join the real common queue/claim custody", err, queue.closeCount.Load())
+	}
+	for _, entry := range ownershipEntries(r.ownership) {
+		if entry.state != redirectReleased {
+			t.Fatal("production caller signed close with remaining responsibility", entry)
+		}
+	}
+}
