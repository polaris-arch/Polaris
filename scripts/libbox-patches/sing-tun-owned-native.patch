+
+type ownershipIPTablesFakeRule struct {
+	identity redirectIPTablesRuleIdentity
+	owner    redirectBirth
+}
+type ownershipIPTablesFakeState struct {
+	chains map[redirectIPTablesChainIdentity]redirectBirth
+	rules  []ownershipIPTablesFakeRule
+}
+type ownershipIPTablesFakeWorld struct {
+	access        sync.Mutex
+	state         ownershipIPTablesFakeState
+	deletedChains []redirectIPTablesChainIdentity
+	deletedRules  []redirectIPTablesRuleIdentity
+}
+
+func newOwnershipIPTablesFakeWorld(scope redirectIPTablesScope) *ownershipIPTablesFakeWorld {
+	legacy := redirectIPTablesChainIdentity{scope, "sing-box-prerouting"}
+	return &ownershipIPTablesFakeWorld{state: ownershipIPTablesFakeState{
+		chains: map[redirectIPTablesChainIdentity]redirectBirth{legacy: {}},
+		rules:  []ownershipIPTablesFakeRule{{redirectIPTablesRuleIdentity{redirectIPTablesChainIdentity{scope, "PREROUTING"}, []string{"-j", legacy.name}}, redirectBirth{}}},
+	}}
+}
+func (w *ownershipIPTablesFakeWorld) except(birth redirectBirth) ownershipIPTablesFakeState {
+	w.access.Lock()
+	defer w.access.Unlock()
+	result := ownershipIPTablesFakeState{chains: make(map[redirectIPTablesChainIdentity]redirectBirth)}
+	for chain, owner := range w.state.chains {
+		if owner != birth {
+			result.chains[chain] = owner
+		}
+	}
+	for _, rule := range w.state.rules {
+		if rule.owner != birth {
+			rule.identity = rule.identity.clone()
+			result.rules = append(result.rules, rule)
+		}
+	}
+	return result
+}
+func (w *ownershipIPTablesFakeWorld) assertPreserved(t *testing.T, birth redirectBirth, before ownershipIPTablesFakeState) {
+	t.Helper()
+	if after := w.except(birth); !reflect.DeepEqual(before, after) {
+		t.Fatalf("foreign iptables state changed: before=%v after=%v", before, after)
+	}
+}
+
+type ownershipIPTablesFakeOps struct {
+	world       *ownershipIPTablesFakeWorld
+	birth       redirectBirth
+	failAt      int
+	mode        string
+	releaseMode string
+	mutateInput bool
+	collide     bool
+	acquires    atomic.Int32
+	before      func()
+}
+
+func (f *ownershipIPTablesFakeOps) commit(effect func() error) redirectAcquireResult {
+	stage := int(f.acquires.Add(1)) - 1
+	if f.before != nil {
+		f.before()
+	}
+	if stage == f.failAt && f.mode == "before" {
+		return redirectAcquireResult{redirectAcquireNotCommitted, ownershipTestFailure}
+	}
+	if stage == f.failAt && f.mode == "panic-before" {
+		panic("iptables before commit")
+	}
+	if err := effect(); err != nil {
+		return redirectAcquireResult{redirectAcquireNotCommitted, err}
+	}
+	if stage == f.failAt {
+		switch f.mode {
+		case "lost-ack":
+			return redirectAcquireResult{err: ownershipTestFailure}
+		case "panic-after":
+			panic("iptables after commit")
+		case "invalid-ack":
+			return redirectAcquireResult{redirectAcquireCreated, ownershipTestFailure}
+		}
+	}
+	return redirectAcquireResult{status: redirectAcquireCreated}
+}
+func (f *ownershipIPTablesFakeOps) CreateChain(chain redirectIPTablesChainIdentity) redirectAcquireResult {
+	return f.commit(func() error {
+		f.world.access.Lock()
+		defer f.world.access.Unlock()
+		if f.collide {
+			f.world.state.chains[chain] = redirectBirth{}
+		}
+		if _, exists := f.world.state.chains[chain]; exists {
+			return syscall.EEXIST
+		}
+		f.world.state.chains[chain] = f.birth
+		return nil
+	})
+}
+func (f *ownershipIPTablesFakeOps) AddRule(rule redirectIPTablesRuleIdentity, insert bool) redirectAcquireResult {
+	result := f.commit(func() error {
+		f.world.access.Lock()
+		defer f.world.access.Unlock()
+		if rule.chain.name != "PREROUTING" && rule.chain.name != "INPUT" {
+			if _, exists := f.world.state.chains[rule.chain]; !exists {
+				return syscall.ENOENT
+			}
+		}
+		for _, current := range f.world.state.rules {
+			if current.identity.chain == rule.chain && slices.Equal(current.identity.args, rule.args) {
+				return syscall.EEXIST
+			}
+		}
+		entry := ownershipIPTablesFakeRule{rule.clone(), f.birth}
+		if insert {
+			f.world.state.rules = append([]ownershipIPTablesFakeRule{entry}, f.world.state.rules...)
+		} else {
+			f.world.state.rules = append(f.world.state.rules, entry)
+		}
+		return nil
+	})
+	if f.mutateInput && len(rule.args) > 0 {
+		rule.args[0] = "backend-mutated-argument"
+	}
+	return result
+}
+func (f *ownershipIPTablesFakeOps) DeleteRule(rule redirectIPTablesRuleIdentity) error {
+	f.world.access.Lock()
+	defer f.world.access.Unlock()
+	f.world.deletedRules = append(f.world.deletedRules, rule.clone())
+	if rule.chain.name == "PREROUTING" {
+		if f.releaseMode == "reference-error" {
+			return ownershipTestFailure
+		}
+		if f.releaseMode == "reference-panic" {
+			panic("iptables reference delete")
+		}
+	}
+	for index, current := range f.world.state.rules {
+		if current.identity.chain == rule.chain && slices.Equal(current.identity.args, rule.args) {
+			if current.owner != f.birth {
+				return errors.New("foreign rule delete")
+			}
+			f.world.state.rules = slices.Delete(f.world.state.rules, index, index+1)
+			return nil
+		}
+	}
+	return errors.New("rule delete identity changed")
+}
+func (f *ownershipIPTablesFakeOps) DeleteChain(chain redirectIPTablesChainIdentity) error {
+	f.world.access.Lock()
+	defer f.world.access.Unlock()
+	f.world.deletedChains = append(f.world.deletedChains, chain)
+	if f.releaseMode == "chain-error" {
+		return ownershipTestFailure
+	}
+	if owner, exists := f.world.state.chains[chain]; !exists || owner != f.birth {
+		return errors.New("foreign chain delete")
+	}
+	for _, rule := range f.world.state.rules {
+		if rule.identity.chain == chain {
+			return errors.New("chain is not empty")
+		}
+		for _, arg := range rule.identity.args {
+			if arg == chain.name && rule.identity.chain.scope == chain.scope {
+				return errors.New("chain still referenced")
+			}
+		}
+	}
+	delete(f.world.state.chains, chain)
+	return nil
+}
+
+func ownershipIPTablesFixture(r *autoRedirect, scope redirectIPTablesScope, ops *ownershipIPTablesFakeOps) ownershipFakeBackend {
+	return ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+		chain, err := op.acquireIPTablesChain(scope, "prerouting", ops)
+		if err != nil {
+			return err
+		}
+		if len(chain.identity.name) != 28 || strings.HasPrefix(chain.identity.name, r.tableName+"-") {
+			return errors.New("non-private chain identity")
+		}
+		if _, err = op.acquireIPTablesRule(chain, "accept", []string{"-p", "tcp", "-j", "ACCEPT"}, ops); err != nil {
+			return err
+		}
+		hook := "PREROUTING"
+		if scope.table == iptablesTableFilter {
+			hook = "INPUT"
+		}
+		_, err = op.acquireIPTablesReference(chain, hook, "reference", []string{"-p", "tcp"}, ops)
+		return err
+	}}
+}
