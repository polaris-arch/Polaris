+func (b *runtimeFirewallTransport) Prepare(*autoRedirect) error { return nil }
+func (b *runtimeFirewallTransport) Start(_ *autoRedirect, op *redirectOperation, requires []redirectResourceID) error {
+	if b.startError != nil {
+		return b.startError
+	}
+	id, err := op.acquire(redirectNFTables, "production-transport-rules", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error {
+			b.releases.Add(1)
+			if b.onRelease != nil {
+				b.onRelease()
+			}
+			if b.queue.closeCount.Load() != 0 {
+				return errors.New("queue closed while reachable rules remain")
+			}
+			return b.releaseError
+		},
+	}, requires...)
+	b.resourceID = id
+	return err
+}
