+	if entry.state != redirectPending || !slices.Contains(entry.requires, f.old.resource) || !slices.Contains(entry.requires, f.private) || !slices.Contains(entry.requires, nextPrivate) {
+		t.Fatal("Pending lost one graph", entry)
