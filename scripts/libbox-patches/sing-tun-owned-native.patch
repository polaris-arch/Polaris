diff --git a/redirect_iptables_command_linux.go b/redirect_iptables_command_linux.go
new file mode 100644
index 0000000..debe784
--- /dev/null
+++ b/redirect_iptables_command_linux.go
@@ -0,0 +1,207 @@
+//go:build linux
+
+package tun
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"os/exec"
+	"slices"
+	"sync"
+	"time"
+)
+
+const iptablesCommandBudget = 5 * time.Second
+
+// The command result is a local process fact. Exit zero can confirm the frozen
+// command intent; it is not a resource owner receipt by itself. A started
+// command with any other result is not evidence that its mutation was absent.
+type iptablesCommandResult struct {
+	started    bool
+	nativeExit bool // original Cmd.Wait obtained the original ProcessState
+	waitErr    error
+	output     string
+	err        error
+	custody    *iptablesCommandCustody
+	scopeError bool
+}
+
+type iptablesCommandCustody struct {
+	command *exec.Cmd
+	done    chan struct{}
+	result  iptablesCommandResult // published by closing done
+}
+
+// One runner belongs to one backend birth. A timeout, cancellation or failed
+// native wait permanently blocks its next command; completion of the same
+// process cannot resolve an already unknown network mutation. The original Cmd
+// and the single Wait worker remain in custody until Wait really returns.
+type iptablesCommandRunner struct {
+	access      sync.Mutex
+	active      *iptablesCommandCustody
+	unconfirmed *iptablesCommandCustody
+	sealed      error
+	budget      time.Duration
+	wait        func(*exec.Cmd) error // actual Wait by default; finite test seam
+}
+
+type iptablesCommandOutput struct {
+	access sync.Mutex
+	bytes  []byte
+}
+
+func (w *iptablesCommandOutput) Write(value []byte) (int, error) {
+	w.access.Lock()
+	defer w.access.Unlock()
+	const limit = 64 << 10
+	if remaining := limit - len(w.bytes); remaining > 0 {
+		w.bytes = append(w.bytes, value[:min(len(value), remaining)]...)
+	}
+	return len(value), nil
+}
+
+func (w *iptablesCommandOutput) String() string {
+	w.access.Lock()
+	defer w.access.Unlock()
+	return string(w.bytes)
+}
+
+func (r *iptablesCommandRunner) run(ctx context.Context, binary string, args []string, input []byte) iptablesCommandResult {
+	if ctx == nil || binary == "" {
+		return iptablesCommandResult{err: errors.New("missing iptables command context or executable")}
+	}
+	r.access.Lock()
+	if r.sealed != nil || r.active != nil {
+		err := errors.Join(errRedirectAmbiguous, r.sealed)
+		r.access.Unlock()
+		return iptablesCommandResult{err: err}
+	}
+	if err := ctx.Err(); err != nil {
+		r.access.Unlock()
+		return iptablesCommandResult{err: err}
+	}
+	budget := r.budget
+	if budget <= 0 {
+		budget = iptablesCommandBudget
+	}
+	ctx, cancel := context.WithTimeout(ctx, budget)
+	defer cancel()
+	output := new(iptablesCommandOutput)
+	command := exec.Command(binary, slices.Clone(args)...)
+	command.Stdin = bytes.NewReader(slices.Clone(input))
+	command.Stdout, command.Stderr = output, output
+	// Descendants retaining a pipe cannot make our Wait worker wait forever
+	// after the original process exits. ErrWaitDelay remains unconfirmed.
+	command.WaitDelay = time.Second
+	custody := &iptablesCommandCustody{command: command, done: make(chan struct{})}
+	r.active = custody
+	if err := command.Start(); err != nil {
+		r.active = nil
+		r.access.Unlock()
+		return iptablesCommandResult{output: output.String(), err: err}
+	}
+	wait := r.wait
+	if wait == nil {
+		wait = (*exec.Cmd).Wait
+	}
+	r.access.Unlock()
+	go func() {
+		err := waitIPTablesCommand(wait, command)
+		result := iptablesCommandResult{
+			started: true, nativeExit: command.ProcessState != nil && !errors.Is(err, errRedirectEffectPanic),
+			waitErr: err, output: output.String(), custody: custody,
+		}
+		if err != nil {
+			result.err = fmt.Errorf("%w: iptables command wait: %w", errRedirectAmbiguous, err)
+		} else if !result.nativeExit {
+			result.err = errors.Join(errRedirectAmbiguous, errRedirectInvalidACK)
+		}
+		r.access.Lock()
+		custody.result = result
+		if r.active == custody && (result.err != nil || r.sealed != nil) {
+			r.active = nil
+		}
+		if result.err != nil {
+			r.sealed = errors.Join(r.sealed, result.err)
+			r.unconfirmed = custody
+		}
+		close(custody.done)
+		r.access.Unlock()
+	}()
+	select {
+	case <-custody.done:
+		r.access.Lock()
+		defer r.access.Unlock()
+		if r.active == custody {
+			r.active = nil
+		}
+		if err := ctx.Err(); err != nil {
+			err = errors.Join(errRedirectAmbiguous, err)
+			r.sealed = errors.Join(r.sealed, err)
+			r.unconfirmed = custody
+			return iptablesCommandResult{started: true, output: custody.result.output, err: err, custody: custody}
+		}
+		return custody.result
+	case <-ctx.Done():
+		// Even a subsequently successful native Wait cannot turn a caller's
+		// lost completion boundary into a confirmed network transaction.
+		err := errors.Join(errRedirectAmbiguous, ctx.Err())
+		r.access.Lock()
+		r.sealed = errors.Join(r.sealed, err)
+		r.unconfirmed = custody
+		select {
+		case <-custody.done:
+			if r.active == custody {
+				r.active = nil
+			}
+		default:
+		}
+		r.access.Unlock()
+		// Do not signal through os.Process's possible PID fallback. A concurrent
+		// lost Wait may already have made that number reusable. The original Cmd
+		// and its sole waiter remain retained; a late Wait0 cannot reopen this
+		// unknown network boundary. Physical cancellation would require a
+		// separately reviewed retained pidfd, not a cached PID or kill ACK.
+		return iptablesCommandResult{started: true, output: output.String(), err: err, custody: custody}
+	}
+}
+
+// The lease is captured by each resource's release closure. Common Close runs
+// on another goroutine: inheriting that goroutine's current namespace would
+// direct an otherwise exact delete at the wrong table. Scope restoration errors
+// are also unconfirmed; a successful inner Wait must not hide them.
+func (r *iptablesCommandRunner) runInNamespace(lease *networkNamespaceLease, ctx context.Context, binary string, args []string, input []byte) iptablesCommandResult {
+	if lease == nil {
+		return iptablesCommandResult{err: errors.New("missing pinned iptables namespace")}
+	}
+	var result iptablesCommandResult
+	err := lease.Run(func() error {
+		result = r.run(ctx, binary, args, input)
+		return nil
+	})
+	if err != nil {
+		result.err = errors.Join(errRedirectAmbiguous, result.err, err)
+		result.scopeError = true
+		r.access.Lock()
+		r.sealed = errors.Join(r.sealed, result.err)
+		if result.custody != nil {
+			r.unconfirmed = result.custody
+		}
+		r.access.Unlock()
+	}
+	return result
+}
+
+func waitIPTablesCommand(wait func(*exec.Cmd) error, command *exec.Cmd) (err error) {
+	defer func() {
+		if value := recover(); value != nil {
+			// A panicked Wait is not an exit fact. Retain the original Cmd in
+			// the sealed runner; neither replay nor a second guessed Wait can
+			// turn this into a successful network transaction.
+			err = fmt.Errorf("%w: iptables command wait: %v", errRedirectEffectPanic, value)
+		}
+	}()
+	return wait(command)
+}
diff --git a/redirect_iptables_command_linux_test.go b/redirect_iptables_command_linux_test.go
