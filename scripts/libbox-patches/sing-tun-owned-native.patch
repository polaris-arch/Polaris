+
+func testIFamilyPlan(t *testing.T, family uint8, generation uint64) *iptablesFamily {
+	t.Helper()
+	plan, err := newIPTablesFamilyPlan(redirectNamespaceIdentity{11, 22}, redirectBirth{1, 2, 3}, family, generation)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &iptablesFamily{isIPv6: family == 6, plan: plan}
+}
+
+func TestIPrivateGenerationAndReferencesHaveExactScopes(t *testing.T) {
+	family := testIFamilyPlan(t, 4, 1)
+	first, err := family.planChain(iptablesTableNAT, "input")
+	if err != nil || len(first) != 28 {
+		t.Fatal(first, err)
+	}
+	second, err := family.planChain(iptablesTableNAT, "next")
+	if err != nil {
+		t.Fatal(err)
+	}
+	args := []string{"-p", "tcp", "-j", second}
+	if err = family.planRule(iptablesTableNAT, first, args); err != nil {
+		t.Fatal(err)
+	}
+	args[1], args[3] = "udp", "foreign"
+	intent := family.plan.private[2]
+	if intent.rule.args[len(intent.rule.args)-1] != second || len(intent.jumps) != 1 || intent.jumps[0].name != second {
+		t.Fatal("caller mutation changed frozen rule or dependency", intent)
+	}
+	if !strings.Contains(strings.Join(intent.rule.args, " "), family.plan.birth.String()+":1:") {
+		t.Fatal("rule lost its birth/generation comment", intent.rule)
+	}
+	next := testIFamilyPlan(t, 4, 2)
+	newName, err := next.planChain(iptablesTableNAT, "input")
+	if err != nil || newName == first {
+		t.Fatal("generation reused a chain identity", newName, err)
+	}
+	for _, call := range []func() error{
+		func() error { _, err := family.planChain(iptablesTableNAT, "input"); return err },
+		func() error { return family.planRule(iptablesTableFilter, first, []string{"-j", "RETURN"}) },
+		func() error { return family.planRule(iptablesTableNAT, first, []string{"-g", "foreign"}) },
+		func() error { return family.planHook(iptablesTableNAT, "INPUT", []string{"-j", first}) },
+		func() error { return family.planHook(iptablesTableNAT, "OUTPUT", []string{"-j", "RETURN"}) },
+	} {
+		if err = call(); err == nil {
+			t.Fatal("invalid scope, borrowed target, or duplicate intent accepted")
+		}
+	}
+	family.plan.sealed = true
+	if err = family.planRule(iptablesTableNAT, first, []string{"-j", "RETURN"}); err == nil {
+		t.Fatal("frozen generation admitted another rule")
+	}
+}
+
+func TestIPlanRejectsCommandInjectionBeforeAnyExecution(t *testing.T) {
+	family := testIFamilyPlan(t, 4, 1)
+	name, err := family.planChain(iptablesTableNAT, "source")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range [][]string{
+		{"-i", "bad\nCOMMIT\n*filter", "-j", "RETURN"},
+		{"-i", "bad\x00", "-j", "RETURN"},
+		{"-F", "OUTPUT", "-j", "RETURN"},
+		{"-j", "RETURN", "-j", "ACCEPT"},
+		{"-m", "comment", "--comment", "borrowed", "-j", "RETURN"},
+	} {
+		before := len(family.plan.private)
+		if err = family.planRule(iptablesTableNAT, name, args); err == nil || len(family.plan.private) != before {
+			t.Fatal("invalid argv entered a command plan", args, err)
+		}
+	}
+}
+
+func TestIHookTransactionOnlySwitchesOneExactHookset(t *testing.T) {
+	var plans []*iptablesFamilyPlan
+	for _, generation := range []uint64{1, 2} {
+		family := testIFamilyPlan(t, 4, generation)
+		chain, err := family.planChain(iptablesTableMangle, "target")
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, protocol := range []string{"udp", "tcp"} {
+			if err = family.planHook(iptablesTableMangle, "OUTPUT", []string{"-p", protocol, "-j", chain}); err != nil {
+				t.Fatal(err)
+			}
+		}
+		plans = append(plans, family.plan)
+	}
+	old, next := plans[0].tableHooks(iptablesTableMangle), plans[1].tableHooks(iptablesTableMangle)
+	input, err := iptablesHookTransaction(plans[0].scope(iptablesTableMangle), old, next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lines := strings.Split(strings.TrimSuffix(string(input), "\n"), "\n")
+	if len(lines) != 6 || lines[0] != "*mangle" || lines[5] != "COMMIT" ||
+		!strings.HasPrefix(lines[1], "-D OUTPUT ") || !strings.HasPrefix(lines[2], "-D OUTPUT ") ||
+		!strings.HasPrefix(lines[3], "-I OUTPUT ") || !strings.HasPrefix(lines[4], "-I OUTPUT ") {
+		t.Fatal("transaction contains extra effects or reordered insertion", lines)
+	}
+	if !strings.Contains(lines[3], "-p udp") || !strings.Contains(lines[4], "-p tcp") {
+		t.Fatal("original backwards insertion order changed", lines)
+	}
+	for _, forbidden := range []string{"\n:", "\n-F", "\n-P", "\n*nat"} {
+		if strings.Contains(string(input), forbidden) {
+			t.Fatal("transaction contains broad table mutations", string(input))
+		}
+	}
+	next[0].args[0] = "corrupted"
+	if plans[1].hooks[0].args[0] != "-m" {
+		t.Fatal("returned hook specs mutated the frozen generation")
+	}
+	foreign := plans[1].tableHooks(iptablesTableMangle)
+	foreign[0].chain.scope.family = 6
+	if _, err = iptablesHookTransaction(plans[0].scope(iptablesTableMangle), old, foreign); err == nil {
+		t.Fatal("cross-family transaction accepted")
+	}
+	private := plans[1].tableHooks(iptablesTableMangle)
+	private[0].chain.name = plans[1].private[0].chain.name
+	if _, err = iptablesHookTransaction(plans[0].scope(iptablesTableMangle), old, private); err == nil {
+		t.Fatal("private chain supplied as a public hook")
+	}
+}
+
+func TestIRestoreTokenQuotesWithoutAddingCommands(t *testing.T) {
+	for value, want := range map[string]string{
+		"tcp": "tcp", "a b": `"a b"`, `a"b`: `"a\"b"`, `a\b`: `"a\\b"`,
+	} {
+		got, err := iptablesRestoreToken(value)
+		if err != nil || got != want {
+			t.Fatal(value, got, want, err)
+		}
+	}
+	for _, invalid := range []string{"", "\nCOMMIT", "\r", "\x00", string([]byte{0xff})} {
+		if _, err := iptablesRestoreToken(invalid); err == nil {
+			t.Fatal("invalid restore token accepted", invalid)
+		}
+	}
+}
+
+func TestIWholePlanFreezesGetterUnionAndLocalCache(t *testing.T) {
+	r := newOwnershipTestRedirect(t)
+	r.tunOptions.Name = "tun-fixture"
+	r.customRedirectPort, r.enableIPv4, r.enableIPv6 = 23456, true, true
+	r.tunOptions.Inet4Address = []netip.Prefix{netip.MustParsePrefix("172.19.0.1/30")}
+	r.tunOptions.Inet6Address = []netip.Prefix{netip.MustParsePrefix("fd00::1/126")}
+	r.tunOptions.Inet4RouteAddress = []netip.Prefix{netip.MustParsePrefix("10.0.0.0/8")}
+	r.tunOptions.IncludeInterface = []string{"eth0"}
+	include, exclude := []netip.Prefix{netip.MustParsePrefix("192.0.2.0/24"), netip.MustParsePrefix("2001:db8::/32")}, []netip.Prefix{netip.MustParsePrefix("198.51.100.0/24")}
+	calls := 0
+	r.routeAddressSet = func() ([]netip.Prefix, []netip.Prefix, error) { calls++; return include, exclude, nil }
+	locals := []netip.Prefix{netip.MustParsePrefix("127.0.0.0/8"), netip.MustParsePrefix("::1/128")}
+	plan, err := buildIPTablesGeneration(r, redirectNamespaceIdentity{11, 22}, 1, locals, []iptablesPreparedFamily{
+		{path: "fixture4", restorePath: "restore4"}, {path: "fixture6", restorePath: "restore6", isIPv6: true, tproxy: true},
+	})
+	if err != nil || calls != 1 || len(plan.families) != 2 {
+		t.Fatal(err, calls, plan)
+	}
+	include[0], exclude[0], locals[0] = netip.Prefix{}, netip.Prefix{}, netip.Prefix{}
+	r.tunOptions.IncludeInterface[0] = "changed"
+	var all []string
+	for _, family := range plan.families {
+		if !family.sealed || len(family.hooks) == 0 || len(family.private) == 0 {
+			t.Fatal("incomplete or mutable family plan", family)
+		}
+		for _, intent := range family.private {
+			if intent.rule != nil {
+				all = append(all, intent.rule.args...)
+			}
+		}
+	}
+	for _, expected := range []string{"eth0", "10.0.0.0/8", "192.0.2.0/24", "198.51.100.0/24", "2001:db8::/32", "127.0.0.0/8", "::1/128", "TPROXY", "NFQUEUE"} {
+		if !slices.Contains(all, expected) {
+			t.Error("frozen grammar lost a configured/getter/local capability", expected)
+		}
+	}
+	if plan.locals[0].String() != "127.0.0.0/8" || slices.Contains(all, "changed") || len(r.iptablesLocalChains) != 0 {
+		t.Fatal("caller mutated plan, or planning published a live cache")
+	}
+}
+
+func TestIStrictDisabledFamilyPreservesRejectAndExclusions(t *testing.T) {
+	r := newOwnershipTestRedirect(t)
+	r.tunOptions.Name = "tun-fixture"
+	r.customRedirectPort, r.enableIPv4 = 23456, true
+	r.tunOptions.StrictRoute = true
+	r.tunOptions.IncludeInterface = []string{"eth0"}
+	plan, err := buildIPTablesGeneration(r, redirectNamespaceIdentity{11, 22}, 1, nil, []iptablesPreparedFamily{{path: "fixture6", restorePath: "restore6", isIPv6: true, unreachable: true}})
+	if err != nil || len(plan.families[0].hooks) != 2 {
+		t.Fatal(err, plan)
+	}
+	var args []string
+	for _, intent := range plan.families[0].private {
+		if intent.chain.scope.table != iptablesTableFilter {
+			t.Fatal("disabled family gained another table", intent)
+		}
+		if intent.rule != nil {
+			args = append(args, intent.rule.args...)
+		}
+	}
+	if !slices.Contains(args, "REJECT") || !slices.Contains(args, "eth0") {
+		t.Fatal("strict disabled family lost its original behavior", args)
+	}
+}
diff --git a/redirect_iptables_private_linux.go b/redirect_iptables_private_linux.go
new file mode 100644
index 0000000..4bacb33
--- /dev/null
+++ b/redirect_iptables_private_linux.go
@@ -0,0 +1,101 @@
+//go:build linux
+
+package tun
+
+import (
+	"context"
+	"errors"
+	"slices"
+)
+
+// Individual private resources use the existing common Pending journal. Public
+// bindings use L's typed transfer API; no local replacement ledger lives here.
+type iptablesPrivateGeneration struct {
+	resources []redirectResourceID
+	chains    map[redirectIPTablesChainIdentity]redirectResourceID
+	byTable   map[string][]redirectResourceID
+}
+
+func iptablesAcquireResult(result iptablesCommandResult) redirectAcquireResult {
+	if result.started && result.nativeExit && result.err == nil {
+		return redirectAcquireResult{status: redirectAcquireCreated}
+	}
+	if !result.started && result.err != nil && !errors.Is(result.err, errRedirectAmbiguous) && !errors.Is(result.err, errRedirectEffectPanic) {
+		return redirectAcquireResult{status: redirectAcquireNotCommitted, err: result.err}
+	}
+	return redirectAcquireResult{status: redirectAcquireUnknown, err: errors.Join(errRedirectAmbiguous, result.err)}
+}
+
+func acquireIPTablesPrivateGeneration(ctx context.Context, op *redirectOperation, plan *iptablesFamilyPlan, binary string, runner *iptablesCommandRunner, namespace *networkNamespaceLease, anchors []redirectResourceID) (*iptablesPrivateGeneration, error) {
+	if ctx == nil || op == nil || op.owner == nil || plan == nil || !plan.sealed || plan.birth != op.owner.birth || binary == "" || runner == nil || namespace == nil {
+		return nil, errors.New("invalid private iptables generation admission")
+	}
+	identity := namespace.Identity()
+	if plan.namespace != (redirectNamespaceIdentity{identity.Device, identity.Inode}) {
+		return nil, errors.New("private iptables plan is not bound to the retained namespace")
+	}
+	generation := &iptablesPrivateGeneration{chains: make(map[redirectIPTablesChainIdentity]redirectResourceID), byTable: make(map[string][]redirectResourceID)}
+	for _, intent := range plan.private {
+		chain := intent.chain
+		requires := slices.Clone(anchors)
+		key, create, remove := chain.key(), "-N", "-X"
+		var args []string
+		if intent.rule != nil {
+			identity := intent.rule.clone()
+			var err error
+			key, err = identity.key()
+			if err != nil {
+				return generation, err
+			}
+			create, remove, args = "-A", "-D", identity.args
+			source, exists := generation.chains[chain]
+			if !exists {
+				return generation, errors.New("private rule source has no acquisition receipt")
+			}
+			requires = append(requires, source)
+			for _, jump := range intent.jumps {
+				dependency, exists := generation.chains[jump]
+				if !exists {
+					return generation, errors.New("private rule target has no acquisition receipt")
+				}
+				if !slices.Contains(requires, dependency) {
+					requires = append(requires, dependency)
+				}
+			}
+		}
+		acquireArgs := iptablesCommandArgs(chain.scope.table, create, chain.name, args)
+		releaseArgs := iptablesCommandArgs(chain.scope.table, remove, chain.name, args)
+		resource, err := op.acquire(redirectIPTables, key, redirectResourceFuncs{
+			acquire: func(redirectResourceID) redirectAcquireResult {
+				return iptablesAcquireResult(runner.runInNamespace(namespace, ctx, binary, acquireArgs, nil))
+			},
+			release: func(redirectResourceID) error {
+				// Ordinary cleanup gets its own finite command budget. A canceled
+				// start context cannot erase an already acquired resource. A runner
+				// sealed by an unknown command still refuses this cleanup.
+				return runner.runInNamespace(namespace, context.Background(), binary, releaseArgs, nil).err
+			},
+		}, requires...)
+		generation.resources = append(generation.resources, resource)
+		generation.byTable[chain.scope.table] = append(generation.byTable[chain.scope.table], resource)
+		if intent.rule == nil {
+			generation.chains[chain] = resource
+		}
+		if err != nil {
+			return generation, err
+		}
+	}
+	return generation, nil
+}
+
+func retireIPTablesPrivateGeneration(op *redirectOperation, generation *iptablesPrivateGeneration) error {
+	if op == nil || generation == nil {
+		return errors.New("missing private iptables generation retirement")
+	}
+	for _, id := range slices.Backward(generation.resources) {
+		if err := op.release(id); err != nil {
+			return err
+		}
+	}
+	return nil
+}
