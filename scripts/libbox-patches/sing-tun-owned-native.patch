+func TestRNativeTunEEXISTAddressIsBorrowedAndPersistentModeRetained(t *testing.T) {
+	api := newRNetlinkAPI()
+	api.links["persistent"] = &netlink.Tuntap{LinkAttrs: netlink.LinkAttrs{Index: 7, Name: "persistent", MTU: 1400}}
+	api.addrExisting = true
+	device := rNewNative(t, rNativeOptions("persistent", 1004, 11000), api, rClaimDirectory(t))
+	if !device.nativeOwnership.borrowed || api.newExclusive[0] {
+		t.Fatal("persistent TUN was forced into exclusive creation")
