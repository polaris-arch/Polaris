+// Synthetic in-memory validator vectors. They are not admission tokens for
+// cNativeAdmit (G is nil and the offline guard remains active).
+func cNativePureAdmission(c cNativeCase) cNativeAdmission {
+	sha := fmt.Sprintf("%064x", 1)
+	a := cNativeAdmission{Case: c.path(), Nonce: "pure-validator-synthetic-nonce-00001", SourceBase: cNativeBase, Bindings: map[string]string{}, Actors: map[string]cNativeIdentity{}}
+	for _, key := range cNativeRequiredBindings {
+		a.Bindings[key] = sha
+	}
+	for index, role := range []string{"A", "B", "H"} {
+		config, _ := cNativeConfigSHA(role, role == "B" && c.Scenario == "claim")
+		a.Actors[role] = cNativeIdentity{Role: role, PID: 100 + index, ConfigSHA: config, Namespace: "synthetic-netns", UserNamespace: "synthetic-userns", RootIdentity: "synthetic-root"}
+	}
+	return a
+}
+func cNativePureReceipt() cNativeReceipt {
+	c := cNativeDockerCases[0]
+	a := cNativePureAdmission(c)
+	sha := fmt.Sprintf("%064x", 1)
+	r := cNativeReceipt{Case: c, Admission: a}
+	for i, name := range c.Expected {
