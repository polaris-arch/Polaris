+// This oracle locates rules by scoped native handle, never birth/role/spec.
+// Named containers and elements use native name/key tuples, not ledger keys.
+type ownershipNFTContentPhysical struct {
+	namespace         redirectNamespaceIdentity
+	family            redirectNFTFamily
+	kind              redirectNFTKind
+	table, chain, set string
+	key               netip.Addr
+	handle            uint64
+}
+
+func ownershipNFTContentAddress(i redirectNFTObjectIdentity) ownershipNFTContentPhysical {
+	a := i.address
+	p := ownershipNFTContentPhysical{namespace: a.scope.namespace, family: a.scope.family, kind: a.kind, table: a.table, chain: a.chain, set: a.set, key: a.element}
+	if a.kind == redirectNFTRule {
+		p.handle = i.handle
+	}
+	return p
+}
+
+type ownershipNFTContentOps struct {
+	access      *sync.Mutex
+	owner       *redirectOwnership
+	world       map[ownershipNFTContentPhysical]redirectNFTIdentity
+	next        *uint64
+	batches     []redirectNFTBatch
+	releases    []redirectNFTIdentity
+	failBatch   int
+	mode        string
+	failRelease redirectNFTKind
+}
+
+func newOwnershipNFTContentOps(owner *redirectOwnership, scope redirectNFTScope) *ownershipNFTContentOps {
+	legacyTable := redirectNFTObjectIdentity{address: redirectNFTAddress{scope: scope, kind: redirectNFTTable, table: "sing-box"}, handle: 900, incarnation: 900}
+	legacyChain := redirectNFTObjectIdentity{address: redirectNFTAddress{scope: scope, kind: redirectNFTChain, table: "sing-box", chain: "prerouting"}, handle: 901, incarnation: 901}
+	legacyRule := redirectNFTObjectIdentity{address: redirectNFTAddress{scope: scope, kind: redirectNFTRule, table: "sing-box", chain: "prerouting"}, handle: 902, incarnation: 902}
+	creation := uint64(1000)
+	return &ownershipNFTContentOps{access: &sync.Mutex{}, owner: owner, next: &creation, world: map[ownershipNFTContentPhysical]redirectNFTIdentity{
+		ownershipNFTContentAddress(legacyTable): {object: legacyTable},
+		ownershipNFTContentAddress(legacyChain): {object: legacyChain, parent: legacyTable},
+		ownershipNFTContentAddress(legacyRule):  {object: legacyRule, parent: legacyChain, ancestor: legacyTable},
+	}}
+}
+
+func (f *ownershipNFTContentOps) foreignSnapshot(birth redirectBirth) map[ownershipNFTContentPhysical]redirectNFTIdentity {
+	f.access.Lock()
+	defer f.access.Unlock()
+	world := maps.Clone(f.world)
+	for address, identity := range world {
+		if identity.object.stamp.birth == birth {
+			delete(world, address)
+		}
+	}
+	return world
+}
+
+func (f *ownershipNFTContentOps) SubmitCreateBatch(batch redirectNFTBatch) redirectNFTBatchResult {
+	f.access.Lock()
+	defer f.access.Unlock()
+	f.batches = append(f.batches, batch.clone())
+	abort := func(err error) redirectNFTBatchResult {
+		return redirectNFTBatchResult{transaction: batch.transaction, status: redirectAcquireNotCommitted, err: err}
+	}
+	wanted := make([]redirectResourceID, len(batch.members))
+	for n, member := range batch.members {
+		wanted[n] = member.id
+	}
+	var recorded []redirectResourceID
+	for _, entry := range ownershipEntries(f.owner) {
+		if slices.Contains(wanted, entry.id) {
+			if entry.state != redirectPending {
+				return abort(errors.New("whole helper queue not Pending"))
+			}
+			recorded = append(recorded, entry.id)
+		}
+	}
+	if !slices.Equal(recorded, wanted) {
+		return abort(errors.New("helper queue missing from journal"))
+	}
+	shadow := maps.Clone(f.world)
+	objects := make(map[redirectResourceID]redirectNFTIdentity)
+	for _, identity := range shadow {
+		objects[identity.object.id] = identity
+	}
+	for id, prerequisite := range batch.prerequisites {
+		if shadow[ownershipNFTContentAddress(prerequisite.object)] != prerequisite {
+			return abort(errors.New("replaced prerequisite"))
+		}
+		for _, ancestor := range []redirectNFTObjectIdentity{prerequisite.parent, prerequisite.ancestor, prerequisite.lookup} {
+			if ancestor != (redirectNFTObjectIdentity{}) && shadow[ownershipNFTContentAddress(ancestor)].object != ancestor {
+				return abort(errors.New("replaced prerequisite ancestry"))
+			}
+		}
+		objects[id] = prerequisite
+	}
+	fault := len(f.batches) == f.failBatch
+	if fault && f.mode == "abort" {
+		return abort(ownershipTestFailure)
+	}
+	result := redirectNFTBatchResult{transaction: batch.transaction, status: redirectAcquireCreated}
+	for n, member := range batch.members {
+		(*f.next)++
+		object := redirectNFTObjectIdentity{member.id, member.address, member.stamp, member.spec, *f.next, *f.next}
+		if member.address.kind == redirectNFTElement {
+			object.handle = 0
+		}
+		identity := redirectNFTIdentity{object: object}
+		if member.address.kind != redirectNFTTable {
+			parent, found := objects[member.parent]
+			if !found || parent.object.address != member.address.parentAddress() || parent.object.stamp.birth != batch.transaction.birth {
+				return abort(errors.New("foreign/missing parent"))
+			}
+			identity.parent, identity.ancestor = parent.object, parent.parent
+		}
+		if member.spec.content.lookup != (redirectResourceID{}) {
+			identity.lookup = objects[member.spec.content.lookup].object
+			if identity.lookup.id != member.spec.content.lookup {
+				return abort(errors.New("missing lookup receipt"))
+			}
+		}
+		address := ownershipNFTContentAddress(object)
+		if _, exists := shadow[address]; exists {
+			return abort(syscall.EEXIST)
+		}
+		shadow[address], objects[member.id] = identity, identity
+		result.receipts = append(result.receipts, identity)
+		if fault && f.mode == "partial" && n == 0 {
+			clear(f.world)
+			maps.Copy(f.world, shadow) // adversarial adapter, not kernel batch semantics
+			result.status, result.err = redirectAcquireUnknown, ownershipTestFailure
+			return result
+		}
+	}
+	clear(f.world)
+	maps.Copy(f.world, shadow)
+	if fault {
+		switch f.mode {
+		case "lost-ack":
+			result.status, result.receipts, result.err = redirectAcquireUnknown, nil, ownershipTestFailure
+		case "wrong-ack":
+			result.transaction.sequence++
+		case "anonymous-rule", "zero-rule-handle", "rule-handle-alias", "wrong-program", "wrong-ancestor", "wrong-lookup":
+			var first uint64
+			for n := range result.receipts {
+				i := &result.receipts[n]
+				if f.mode == "wrong-ancestor" && i.object.address.kind == redirectNFTElement {
+					i.ancestor.incarnation++
+					break
+				}
+				if i.object.address.kind != redirectNFTRule {
+					continue
+				}
+				switch f.mode {
+				case "anonymous-rule":
+					i.object.stamp = redirectNFTStamp{}
+				case "zero-rule-handle":
+					i.object.handle = 0
+				case "rule-handle-alias":
+					if first == 0 {
+						first = i.object.handle
+					} else {
+						i.object.handle = first
+					}
+				case "wrong-program":
+					i.object.spec.content.verdict = redirectNFTDrop
+				case "wrong-lookup":
+					i.lookup.incarnation++
+				}
+			}
+		}
+	}
+	return result
+}
+
+func (f *ownershipNFTContentOps) ReleaseExact(identity redirectNFTIdentity) error {
+	f.access.Lock()
+	defer f.access.Unlock()
+	f.releases = append(f.releases, identity)
+	if identity.object.address.kind == f.failRelease {
+		return ownershipTestFailure
+	}
+	address := ownershipNFTContentAddress(identity.object)
+	if f.world[address] != identity {
+		return errors.New("foreign/reused/changed native object")
+	}
+	for _, prerequisite := range []redirectNFTObjectIdentity{identity.parent, identity.ancestor, identity.lookup} {
+		if prerequisite != (redirectNFTObjectIdentity{}) && f.world[ownershipNFTContentAddress(prerequisite)].object != prerequisite {
+			return errors.New("replaced exact prerequisite")
+		}
+	}
+	for current, child := range f.world {
+		if current == address {
+			continue
+		}
+		if child.parent == identity.object || child.ancestor == identity.object || child.lookup == identity.object ||
+			identity.object.address.kind == redirectNFTElement && child.lookup != (redirectNFTObjectIdentity{}) && child.lookup == identity.parent {
+			return errors.New("foreign child/reference remains")
+		}
+	}
+	delete(f.world, address)
+	return nil
+}
+
+// This test-only bridge is not a kernel adapter. It translates exactly the
+// existing IPConst helper's calls; no clone of its 1000-element loop exists.
+type ownershipNFTIPConstBridge struct {
+	queue      *redirectNFTCreateQueue
+	set        redirectNFTIntent
+	descriptor *nftables.Set
+}
+
+func (b *ownershipNFTIPConstBridge) validate(set *nftables.Set) error {
+	if set == nil || !reflect.DeepEqual(set, b.descriptor) || set.ID == 0 {
+		b.queue.err = ErrAutoRedirectOwnershipUnsupported
+	}
+	return b.queue.err
+}
+
+func (b *ownershipNFTIPConstBridge) elements(elements []nftables.SetElement) ([]redirectNFTIntent, error) {
+	addresses := make([]netip.Addr, 0, len(elements))
+	for _, element := range elements {
+		if !reflect.DeepEqual(element, nftables.SetElement{Key: element.Key}) {
+			b.queue.err = ErrAutoRedirectOwnershipUnsupported
+			return nil, b.queue.err
+		}
+		address, ok := netip.AddrFromSlice(element.Key)
+		if !ok {
+			b.queue.err = ErrAutoRedirectOwnershipUnsupported
+			return nil, b.queue.err
+		}
+		addresses = append(addresses, address)
+	}
+	intents, err := b.queue.operation.nftElementIntents(b.set, addresses)
+	if err != nil {
+		b.queue.err = err
+	}
+	return intents, err
+}
+
+func (b *ownershipNFTIPConstBridge) AddSet(set *nftables.Set, elements []nftables.SetElement) error {
+	if err := b.validate(set); err != nil {
+		return err
+	}
+	intents, err := b.elements(elements)
+	if err != nil {
+		return err
+	}
+	return b.queue.add(append([]redirectNFTIntent{b.set}, intents...)...)
+}
+
+func (b *ownershipNFTIPConstBridge) SetAddElements(set *nftables.Set, elements []nftables.SetElement) error {
+	if err := b.validate(set); err != nil {
+		return err
+	}
+	intents, err := b.elements(elements)
+	if err != nil {
+		return err
+	}
+	return b.queue.add(intents...)
+}
+
+func (b *ownershipNFTIPConstBridge) Flush() error { return b.queue.Flush() }
+
+func ownershipNFTContentPlan(op *redirectOperation, scope redirectNFTScope, addresses []netip.Addr) ([]redirectNFTIntent, error) {
+	table, err := op.nftTableIntent(scope, "main")
+	if err != nil {
+		return nil, err
+	}
+	chain, err := op.nftChainIntent(table, "main")
+	if err != nil {
+		return nil, err
+	}
+	set, err := op.nftSetIntent(table, "addresses", redirectNFTIPv6)
+	if err != nil {
+		return nil, err
+	}
+	elements, err := op.nftElementIntents(set, addresses)
+	if err != nil {
+		return nil, err
+	}
+	rule, err := op.nftRuleIntent(chain, "lookup", redirectNFTContent{family: redirectNFTIPv6, verdict: redirectNFTAccept}, &set, elements)
+	if err != nil {
+		return nil, err
+	}
+	return append([]redirectNFTIntent{rule, chain, set, table}, elements...), nil
+}
+
+func TestRedirectOwnershipNFTRealIPConstHelperFlushWholeQueue(t *testing.T) {
+	for _, count := range []int{1000, 1001} {
+		for _, fault := range []struct {
+			batch int
+			mode  string
+		}{{0, ""}, {1, "abort"}, {1, "partial"}, {1, "wrong-ack"}, {2, "abort"}, {2, "partial"}, {2, "lost-ack"}, {2, "wrong-ack"}} {
+			if count == 1000 && fault.batch == 2 {
+				continue
+			}
+			t.Run(fmt.Sprintf("elements=%d/batch=%d/%s", count, fault.batch, fault.mode), func(t *testing.T) {
+				scope := redirectNFTScope{redirectNamespaceIdentity{3, 910}, redirectNFTINet}
+				r := newOwnershipTestRedirect(t)
+				ops := newOwnershipNFTContentOps(r.ownership, scope)
+				ops.failBatch, ops.mode = fault.batch, fault.mode
+				a := newOwnershipTestRedirect(t)
+				aOps := newOwnershipNFTContentOps(a.ownership, scope)
+				a.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+					members, err := ownershipNFTContentPlan(op, scope, []netip.Addr{netip.MustParseAddr("2001:db8::ff")})
+					if err != nil {
+						return err
+					}
+					_, err = op.acquireNFTBatch(members, aOps)
+					return err
+				}}
+				if err := a.Start(); err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { _ = a.Close() })
+				ops.access, ops.world, ops.next = aOps.access, aOps.world, aOps.next
+				before := ops.foreignSnapshot(r.ownership.birth)
+				var table, set redirectNFTIntent
+				r.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+					var err error
+					table, err = op.nftTableIntent(scope, "helper")
+					if err != nil {
+						return err
+					}
