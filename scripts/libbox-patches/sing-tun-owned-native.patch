+					err = os.WriteFile(marker, []byte(strings.TrimSuffix(redirectClaimProtocol, "\n")), 0644)
+				}
+				if err == nil {
+					err = os.Chmod(marker, 0444)
+				}
+			case "marker-mode":
+				err = os.Chmod(marker, 0644)
+			case "allocator-mode":
+				err = os.Chmod(allocator, 0666)
+			case "allocator-content":
+				err = os.Chmod(allocator, 0644)
+				if err == nil {
+					err = os.WriteFile(allocator, []byte("x"), 0644)
