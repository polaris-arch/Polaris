+	for _, name := range []string{"xtables-nft-multi", "xtables-legacy-multi"} {
+		if err := os.WriteFile(filepath.Join(directory, name), []byte("#!/bin/sh\n: > '"+marker+"'\nexit 0\n"), 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for name, target := range map[string]string{"iptables": "xtables-nft-multi", "iptables-restore": "xtables-nft-multi"} {
+		if err := os.Symlink(target, filepath.Join(directory, name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	redirectProductionRegistry.Lock()
+	factory := redirectProductionRegistry.firewall["iptables"]
+	redirectProductionRegistry.Unlock()
+	if factory == nil {
+		t.Fatal("production iptables adapter was not registered")
+	}
+	backend, err := factory(r)
+	if err != nil || backend == nil || len(ownershipEntries(r.ownership)) != 0 {
+		t.Fatal("pure production factory acquired resources", err)
+	}
+	if err = backend.Prepare(r); err != nil {
+		t.Fatal(err)
+	}
+	program := backend.(*iptablesProductionBackend).programs[0]
+	if program.path != filepath.Join(directory, "iptables") || program.restorePath != filepath.Join(directory, "iptables-restore") {
+		t.Fatal("prepared a different selected executable pair", program)
+	}
+	if err = os.Remove(program.restorePath); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = prepareIPTablesProgram(false); err == nil {
+		t.Fatal("missing restore silently fell back to a different backend")
+	}
+	if err = os.Symlink("xtables-legacy-multi", program.restorePath); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = prepareIPTablesProgram(false); err == nil {
+		t.Fatal("mixed nft/legacy executable pair was accepted")
+	}
+	if _, err = os.Stat(marker); !errors.Is(err, os.ErrNotExist) || len(ownershipEntries(r.ownership)) != 0 {
+		t.Fatal("selection executed a capability command before common Pending", err)
+	}
+}
