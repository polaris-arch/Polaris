+func (f *ownershipNFTFakeOps) ReleaseExact(identity redirectNFTIdentity) error {
+	f.access.Lock()
+	f.releases = append(f.releases, identity)
+	f.access.Unlock()
+	f.world.access.Lock()
+	defer f.world.access.Unlock()
+	if identity.object.address.kind == f.releaseKind {
+		if f.releaseMode == "error" {
+			return ownershipTestFailure
+		}
+		if f.releaseMode == "panic-before" {
+			panic("nft release before delete")
+		}
+	}
+	address := ownershipNFTPhysical(identity.object.address)
+	if current, exists := f.world.objects[address]; !exists || current != identity {
+		return errors.New("fake exact release refuses replaced object")
+	}
+	if identity.parent != (redirectNFTObjectIdentity{}) && f.world.objects[ownershipNFTPhysical(identity.parent.address)].object != identity.parent {
+		return errors.New("fake exact release refuses replaced parent")
+	}
+	if identity.object.address.kind == redirectNFTTable {
+		for current := range f.world.objects {
+			if current != address && current.device == address.device && current.inode == address.inode && current.family == address.family && current.table == address.table {
+				return errors.New("fake table still contains a child")
+			}
+		}
+	}
+	delete(f.world.objects, address)
+	f.world.deleted = append(f.world.deleted, identity)
+	if identity.object.address.kind == f.releaseKind {
+		if f.releaseMode == "panic-after" {
+			panic("nft release after delete")
+		}
+		if f.releaseMode == "lost-ack" {
+			return ownershipTestFailure
+		}
+	}
+	return nil
+}
+
+func ownershipNFTPlan(op *redirectOperation, scope redirectNFTScope, role string) ([]redirectNFTIntent, error) {
+	table, err := op.nftTableIntent(scope, role)
+	if err != nil {
+		return nil, err
+	}
+	chain, err := op.nftChainIntent(table, role)
+	return []redirectNFTIntent{chain, table}, err // deliberately reverse DAG order
+}
