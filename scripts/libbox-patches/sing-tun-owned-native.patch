+type rNativeRawReceive struct {
+	SenderPortID   uint32 `json:"senderPortID"`
+	SenderGroups   uint32 `json:"senderGroups"`
+	RecvFlags      int    `json:"recvFlags"`
+	ReceivedLength int    `json:"receivedLength"`
+}
+type rNativeRawAttribute struct {
+	RawType uint16 `json:"rawType"`
+	Type    uint16 `json:"type"`
+	Flags   uint16 `json:"flags"`
+	Payload []byte `json:"payload"`
+}
+type rNativeDecodedMessage struct {
+	Type        uint16                `json:"type"`
+	Flags       uint16                `json:"flags"`
+	Sequence    uint32                `json:"sequence"`
+	PortID      uint32                `json:"portID"`
+	FixedHeader []byte                `json:"fixedHeader"`
+	Attributes  []rNativeRawAttribute `json:"attributes"`
+}
+type rNativeRawDump struct {
+	Request        uint16                  `json:"request"`
+	Sequence       uint32                  `json:"sequence"`
+	LocalPortID    uint32                  `json:"localPortID"`
+	SenderPortID   uint32                  `json:"senderPortID"`
+	SenderGroups   uint32                  `json:"senderGroups"`
+	RecvFlags      int                     `json:"recvFlags"`
+	ReceivedLength int                     `json:"receivedLength"`
+	Datagrams      [][]byte                `json:"rawDatagrams"`
+	Receives       []rNativeRawReceive     `json:"receives"`
+	Decoded        []rNativeDecodedMessage `json:"decoded"`
+	TerminalStatus string                  `json:"terminalStatus"`
+}
+
+// Only observations use this separate socket. Production mutations stay in
+// the frozen realRouteNetlink dependency, with its own actual ACK processing.
+func rNativeObserveDump(request uint16, family byte, deadline time.Time) (rNativeRawDump, error) {
+	dump := rNativeRawDump{Request: request, Sequence: 1}
+	fd, err := unix.Socket(unix.AF_NETLINK, unix.SOCK_RAW|unix.SOCK_NONBLOCK|unix.SOCK_CLOEXEC, unix.NETLINK_ROUTE)
+	if err != nil {
+		return dump, err
+	}
+	defer unix.Close(fd)
+	if err = unix.Bind(fd, &unix.SockaddrNetlink{Family: unix.AF_NETLINK}); err != nil {
+		return dump, err
+	}
+	address, err := unix.Getsockname(fd)
+	if err != nil {
+		return dump, err
+	}
+	local, ok := address.(*unix.SockaddrNetlink)
+	if !ok {
+		return dump, errors.New("invalid local netlink address")
+	}
+	dump.LocalPortID = local.Pid
+	headerLen := map[uint16]int{unix.RTM_GETROUTE: 12, unix.RTM_GETRULE: 12, unix.RTM_GETADDR: 8, unix.RTM_GETLINK: 16}[request]
+	if headerLen == 0 {
+		return dump, errors.New("request not in R observation closure")
+	}
+	message := make([]byte, unix.NLMSG_HDRLEN+headerLen)
+	binary.NativeEndian.PutUint32(message, uint32(len(message)))
+	binary.NativeEndian.PutUint16(message[4:], request)
+	binary.NativeEndian.PutUint16(message[6:], unix.NLM_F_REQUEST|unix.NLM_F_DUMP)
+	binary.NativeEndian.PutUint32(message[8:], dump.Sequence)
+	binary.NativeEndian.PutUint32(message[12:], local.Pid)
+	message[unix.NLMSG_HDRLEN] = family
+	if err = unix.Sendto(fd, message, 0, &unix.SockaddrNetlink{Family: unix.AF_NETLINK}); err != nil {
+		return dump, err
+	}
+	buffer := make([]byte, 65536)
+	total := 0
+	for count := 0; count < 128; count++ {
+		remaining := time.Until(deadline)
+		if remaining <= 0 {
+			return dump, errors.New("raw dump deadline; incomplete multipart")
+		}
+		poll := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN}}
+		if _, err := unix.Poll(poll, max(1, int(remaining.Milliseconds()))); err != nil {
+			return dump, err
+		}
+		n, _, flags, sender, err := unix.Recvmsg(fd, buffer, nil, 0)
+		if errors.Is(err, unix.EAGAIN) {
+			continue
+		}
+		if err != nil {
+			return dump, err
+		} // includes ENOBUFS
+		peer, ok := sender.(*unix.SockaddrNetlink)
+		if !ok || peer.Pid != 0 || peer.Groups != 0 || flags&(unix.MSG_TRUNC|unix.MSG_CTRUNC) != 0 {
+			return dump, errors.New("raw dump sender/truncation invalid")
+		}
+		data := slices.Clone(buffer[:n])
+		total += n
+		if total > 262144 {
+			return dump, errors.New("raw dump evidence bound exceeded")
+		}
+		done, err := rNativeValidateDatagram(data, dump.Sequence, local.Pid, request)
+		if err != nil {
+			return dump, err
+		}
+		decoded, decodeErr := rNativeDecodeRawAttributes(data)
+		if decodeErr != nil {
+			return dump, decodeErr
+		}
+		dump.Decoded = append(dump.Decoded, decoded...)
+		dump.SenderPortID = peer.Pid
+		dump.SenderGroups = peer.Groups
+		dump.RecvFlags = flags
+		dump.ReceivedLength += n
+		dump.Receives = append(dump.Receives, rNativeRawReceive{peer.Pid, peer.Groups, flags, n})
+		dump.Datagrams = append(dump.Datagrams, data)
+		if done {
+			dump.TerminalStatus = "DONE_ZERO"
+			return dump, nil
+		}
+	}
+	return dump, errors.New("raw dump multipart count exceeded")
+}
+
+func rNativeDecodeRawAttributes(data []byte) ([]rNativeDecodedMessage, error) {
+	messages, err := syscall.ParseNetlinkMessage(data)
+	if err != nil {
+		return nil, err
+	}
+	result := make([]rNativeDecodedMessage, 0, len(messages))
+	for _, m := range messages {
+		headerLength := map[uint16]int{unix.RTM_NEWROUTE: 12, unix.RTM_NEWRULE: 12, unix.RTM_NEWADDR: 8, unix.RTM_NEWLINK: 16, unix.NLMSG_DONE: 4}[m.Header.Type]
+		if headerLength == 0 || len(m.Data) < headerLength {
+			return nil, errors.New("raw fixed header incomplete")
+		}
+		decoded := rNativeDecodedMessage{Type: m.Header.Type, Flags: m.Header.Flags, Sequence: m.Header.Seq, PortID: m.Header.Pid, FixedHeader: slices.Clone(m.Data[:headerLength]), Attributes: []rNativeRawAttribute{}}
+		for attrs := m.Data[headerLength:]; len(attrs) > 0; {
+			if len(attrs) < 4 {
+				return nil, errors.New("raw attribute header truncated")
+			}
+			length := int(binary.NativeEndian.Uint16(attrs))
+			kind := binary.NativeEndian.Uint16(attrs[2:])
+			aligned := (length + 3) &^ 3
+			if length < 4 || length > len(attrs) || aligned > len(attrs) {
+				return nil, errors.New("raw attribute length/alignment invalid")
+			}
+			decoded.Attributes = append(decoded.Attributes, rNativeRawAttribute{kind, kind & 0x3fff, kind & 0xc000, slices.Clone(attrs[4:length])})
+			attrs = attrs[aligned:]
+			if len(decoded.Attributes) > 1024 {
+				return nil, errors.New("raw attribute count bound")
+			}
+		}
+		result = append(result, decoded)
+	}
+	return result, nil
+}
+
+func rNativeValidateDatagram(data []byte, sequence, localPID uint32, request uint16) (bool, error) {
+	messages, err := syscall.ParseNetlinkMessage(data)
+	if err != nil || len(messages) == 0 {
+		return false, errors.Join(errors.New("malformed raw dump"), err)
+	}
+	response := map[uint16]uint16{unix.RTM_GETROUTE: unix.RTM_NEWROUTE, unix.RTM_GETRULE: unix.RTM_NEWRULE, unix.RTM_GETADDR: unix.RTM_NEWADDR, unix.RTM_GETLINK: unix.RTM_NEWLINK}[request]
+	done := false
+	for _, message := range messages {
+		if done || message.Header.Seq != sequence || message.Header.Pid != localPID || message.Header.Flags&unix.NLM_F_DUMP_INTR != 0 {
+			return false, errors.New("raw dump seq/pid/DumpIntr/terminal invalid")
+		}
+		switch message.Header.Type {
+		case unix.NLMSG_DONE:
+			if len(message.Data) != 4 || binary.NativeEndian.Uint32(message.Data) != 0 {
+				return false, errors.New("raw dump terminal status invalid")
+			}
+			done = true
+		case unix.NLMSG_ERROR, unix.NLMSG_OVERRUN:
+			return false, errors.New("raw dump error/overrun")
+		default:
+			if response == 0 || message.Header.Type != response || message.Header.Flags&unix.NLM_F_MULTI == 0 {
+				return false, errors.New("raw dump response type/multipart invalid")
+			}
+		}
+	}
+	return done, nil
+}
+
+func rNativeReadActorControl(file *os.File, deadline time.Time) error {
+	if file == nil || int(file.Fd()) != 10 {
+		return errors.New("actual A-only FD10 absent")
+	}
+	var stat unix.Stat_t
+	if err := unix.Fstat(10, &stat); err != nil {
+		return err
+	}
+	flags, err := unix.FcntlInt(10, unix.F_GETFL, 0)
+	if err != nil {
+		return err
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFIFO || flags&unix.O_ACCMODE != unix.O_RDONLY || flags&unix.O_NONBLOCK == 0 {
+		return errors.New("actual control FD is not readonly nonblocking pipe")
+	}
+	data := make([]byte, 15)
+	offset := 0
+	for {
+		remaining := time.Until(deadline)
+		if remaining <= 0 {
+			return errors.New("14-byte control/EOF deadline")
+		}
+		poll := []unix.PollFd{{Fd: 10, Events: unix.POLLIN | unix.POLLHUP}}
+		if _, err := unix.Poll(poll, max(1, int(remaining.Milliseconds()))); err != nil {
+			return err
+		}
+		n, err := unix.Read(10, data[offset:])
+		if errors.Is(err, unix.EAGAIN) {
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return rNativeValidateActorControl(data[:offset], true)
+		}
+		offset += n
+		if offset > 14 {
+			return errors.New("extra actor control bytes")
+		}
+	}
+}
+
+func rNativeValidateActorControl(data []byte, eof bool) error {
+	if !eof || len(data) != 14 || string(data) != "B_NEW_REFUSED\n" {
+		return errors.New("actual actor control payload/EOF mismatch")
+	}
+	return nil
+}
+
+func rNativeClaimFacts(tun *NativeTun) ([]json.RawMessage, error) {
+	n := tun.nativeOwnership
+	if n == nil || n.owner == nil || n.claims == nil || n.lease == nil {
+		return nil, errors.New("actual native birth/lease/claims missing")
+	}
+	if err := n.claims.Validate(); err != nil {
+		return nil, err
+	}
+	n.claims.access.Lock()
+	defer n.claims.access.Unlock()
+	facts := make([]json.RawMessage, 0, len(n.claims.files))
+	for _, original := range n.claims.files {
+		var journal struct {
+			Version                 int
+			Birth                   string
+			NetnsDevice, NetnsInode uint64
+			Domain, Key             string
+		}
+		if err := json.Unmarshal(original.journal, &journal); err != nil {
+			return nil, err
+		}
+		if journal.Version != 2 || journal.Birth != n.owner.birth.String() || journal.NetnsDevice != n.lease.Identity().Device || journal.NetnsInode != n.lease.Identity().Inode || journal.Domain == "" || journal.Key == "" {
+			return nil, errors.New("original L journal birth/netns binding mismatch")
+		}
+		// Consume L's original journal; do not reimplement its hash/name schema.
+		facts = append(facts, slices.Clone(original.journal))
+	}
+	return facts, nil
+}
+
+func rNativeRPValue(file *os.File, want string) error {
+	if file == nil {
+		return errors.New("original rp_filter FD missing")
+	}
+	buffer := make([]byte, 16)
+	n, err := file.ReadAt(buffer, 0)
+	if err != nil && !errors.Is(err, io.EOF) {
+		return err
+	}
+	if strings.TrimSpace(string(buffer[:n])) != want {
