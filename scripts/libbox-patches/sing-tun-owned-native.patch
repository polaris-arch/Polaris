+func cNativeValidateReceipt(r cNativeReceipt) error {
+	if err := cNativeValidateAdmission(r.Admission, r.Case); err != nil {
+		return err
+	}
+	var canonical *cNativeCase
+	for _, c := range cNativeAllCases() {
+		if c.path() == r.Case.path() {
+			v := c
+			canonical = &v
+			break
+		}
+	}
+	if canonical == nil || !reflect.DeepEqual(*canonical, r.Case) {
+		return errors.New("case not in exact frozen closure")
+	}
+	if len(r.Witnesses) != len(r.Case.Expected) {
+		return errors.New("missing/extra milestone")
+	}
+	previous := int64(0)
+	for i, w := range r.Witnesses {
+		if w.Name != r.Case.Expected[i] || w.At <= previous || !cNativeSHA(w.RawSHA) || w.Nonce != r.Admission.Nonce || w.Namespace != r.Admission.Actors["A"].Namespace || !slices.Contains([]string{"A", "B", "H", "producer"}, w.Actor) {
+			return errors.New("invalid raw milestone/order/identity")
+		}
+		previous = w.At
+	}
+	if r.ActualFailure != "" || len(r.Errors) != 0 {
+		return errors.New("actual fixture failure retained")
+	}
+	errorFound := false
+	counts := make(map[string]int)
+	actualIdentities := make(map[string]cNativeIdentity)
+	birthRoles := make(map[string]string)
+	for _, call := range r.Calls {
+		if call.Started <= 0 || call.Returned < call.Started || !slices.Contains([]string{"A", "B", "H"}, call.Role) || !slices.Contains([]string{"Construct", "Start", "Close"}, call.Method) {
+			return errors.New("invalid original call fact")
+		}
+		if err := cNativeValidateActualIdentity(call.Identity, r.Admission, call.Role); err != nil {
+			return err
+		}
+		if original, ok := actualIdentities[call.Role]; ok && !reflect.DeepEqual(original, call.Identity) {
+			return errors.New("actual actor birth/resources identity changed during calls")
+		}
+		if role, ok := birthRoles[call.Identity.Birth]; ok && role != call.Role {
+			return errors.New("independent actor births conflated")
+		}
+		actualIdentities[call.Role] = call.Identity
+		birthRoles[call.Identity.Birth] = call.Role
+		counts[call.Role+"/"+call.Method]++
+		if call.Role == "B" && call.Method == r.Case.ErrorCall && call.Error != "" {
+			errorFound = true
+		}
+		if call.Error != "" && (call.Role != "B" || call.Method != r.Case.ErrorCall) {
+			return errors.New("unexpected original callee error")
+		}
+	}
+	if counts["A/Construct"] != 1 || counts["A/Start"] != 1 || counts["B/Construct"] != 1 {
+		return errors.New("default public constructor/Start chain incomplete")
+	}
+	if r.Case.Scenario == "unstarted" {
+		if counts["B/Start"] != 0 || counts["B/Close"] != 1 {
+			return errors.New("unstarted Close case entered Start")
+		}
+	} else {
+		if counts["B/Start"] != 1 {
+			return errors.New("B default public Start missing or repeated")
+		}
+	}
+	if r.Case.ErrorCall != "" && !errorFound {
+		return errors.New("expected original error missing")
+	}
+	before, after := (*cNativeWindow)(nil), (*cNativeWindow)(nil)
+	var active *cNativeWindow
+	for i := range r.Windows {
+		w := &r.Windows[i]
+		if w.At <= 0 || !cNativeSHA(w.RawSHA) || w.Nonce != r.Admission.Nonce || w.Namespace != r.Admission.Actors["A"].Namespace {
+			return errors.New("window lacks actual raw time/identity")
+		}
+		if w.Name == "B_active" {
+			if active != nil {
+				return errors.New("duplicate active window")
+			}
+			active = w
+		}
+		if w.Name == "A_before" || w.Name == "A_new_parent_stable" {
+			before = w
+		}
+		if w.Name == "A_after" {
+			after = w
+		}
+	}
+	if before == nil || after == nil || active == nil || before.A == nil || after.A == nil {
+		return errors.New("A preservation window not established")
+	}
+	if active.At < r.Windows[0].At || after.At < active.At {
+		return errors.New("actual active/after windows are out of order")
+	}
+	if active.B == nil {
+		return errors.New("complete B active-window inventory missing")
+	}
+	if err := cNativeValidateActualIdentity(active.B.Identity, r.Admission, "B"); err != nil {
+		return err
+	}
+	bLedger, err := cNativeHash(active.B.Resources)
+	if err != nil || bLedger != active.B.LedgerSHA || !cNativeSHA(active.B.KernelResourcesSHA) {
+		return errors.New("B actual ledger/kernel inventory incomplete")
+	}
+	if !slices.Contains([]string{"unstarted", "claim", "partial", "fw4-live-Pending", "fw4-live-Unknown", "fw4-orphan", "fw4-crafted-Pending", "fw4-crafted-Unknown", "fw4-script", "fw4-acquire-timeout"}, r.Case.Scenario) {
+		if !active.B.Running || active.B.Closing {
+			return errors.New("B Committed window not established")
+		}
+		if err := cNativeValidateObservation(active.B, r.Admission, "B"); err != nil {
+			return err
+		}
+		for _, family := range []string{"v4", "v6"} {
+			for _, positive := range []bool{false, true} {
+				count := 0
+				for _, n := range active.NonceResults {
+					if n.Role == "B" && n.Family == family && n.Positive == positive {
+						if n.Nonce != r.Admission.Nonce || n.Matched != positive || !cNativeSHA(n.RawSHA) || n.At <= 0 {
+							return errors.New("B actual nonce control failed")
+						}
+						count++
+					}
+				}
+				if count != 1 {
+					return errors.New("B v4/v6 nonce controls missing or duplicate")
+				}
+			}
+		}
+	}
+	if err := cNativePreservedA(*before, *after, r.Admission); err != nil {
+		return err
+	}
+	// B_active precedes a parent-rebuild producer delta; compare its original A
+	// baseline rather than the separately recaptured new-parent baseline.
+	activeBaseline := before
+	for i := range r.Windows {
+		if r.Windows[i].Name == "A_before" {
+			activeBaseline = &r.Windows[i]
+			break
+		}
+	}
+	if err := cNativePreservedA(*activeBaseline, *active, r.Admission); err != nil {
+		return err
+	}
+	for _, w := range r.Windows {
+		if w.Name == "A_during" {
+			if err := cNativePreservedA(*before, w, r.Admission); err != nil {
+				return err
+			}
+		}
+	}
+	if r.Case.Unknown && !slices.ContainsFunc(r.Witnesses, func(w cNativeWitness) bool {
+		return w.Name == "B_sealed_Unknown" || w.Name == "B_Unknown" || w.Name == "B_internal_timeout_Unknown"
+	}) {
+		return errors.New("Unknown not actually observed")
+	}
+	return cNativeValidateFW4(r)
+}
+func cNativePreservedA(before, after cNativeWindow, a cNativeAdmission) error {
+	x, y := before.A, after.A
+	if err := cNativeValidateObservation(x, a, "A"); err != nil {
+		return err
+	}
+	if err := cNativeValidateObservation(y, a, "A"); err != nil {
+		return err
+	}
+	if x == nil || y == nil || !x.Running || !y.Running || x.Closing || y.Closing || x.Identity.PID != a.Actors["A"].PID || !reflect.DeepEqual(x.Identity, y.Identity) || !cNativeSHA(x.LedgerSHA) || x.LedgerSHA != y.LedgerSHA || !cNativeSHA(x.KernelResourcesSHA) || x.KernelResourcesSHA != y.KernelResourcesSHA || x.NFTOwnerDomain == "" || x.NFTOwnerDomain != y.NFTOwnerDomain || !reflect.DeepEqual(x.Docker, y.Docker) || !reflect.DeepEqual(x.FW4, y.FW4) || x.ListenerInode == 0 || x.ListenerInode != y.ListenerInode || x.ListenerDevice != y.ListenerDevice {
+		return errors.New("A actual L/N/C resource identity changed")
+	}
+	if !cNativeSHA(before.ForeignSHA) || before.ForeignSHA != after.ForeignSHA || before.ParentIdentity != after.ParentIdentity {
+		return errors.New("foreign/parent baseline changed without declared producer delta")
+	}
+	for _, w := range []cNativeWindow{before, after} {
+		for _, family := range []string{"v4", "v6"} {
+			for _, positive := range []bool{false, true} {
+				matches := 0
+				for _, n := range w.NonceResults {
+					if n.Role == "A" && n.Family == family && n.Positive == positive {
+						if n.Nonce != a.Nonce || !cNativeSHA(n.RawSHA) || n.At <= 0 || n.Matched != positive {
+							return errors.New("A nonce control failed")
+						}
+						matches++
+					}
+				}
+				if matches != 1 {
+					return errors.New("missing/duplicate A positive or negative nonce control")
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func cNativeValidateActualIdentity(i cNativeIdentity, a cNativeAdmission, role string) error {
+	base := a.Actors[role]
+	birth, err := hex.DecodeString(i.Birth)
+	if err != nil || len(birth) != 16 || i.Birth != hex.EncodeToString(birth) || i.Role != role || i.PID != base.PID || i.ConfigSHA != base.ConfigSHA || i.Namespace != base.Namespace || i.UserNamespace != base.UserNamespace || i.RootIdentity != base.RootIdentity {
+		return errors.New("actual constructed actor identity not bound")
+	}
+	return nil
+}
+func cNativeValidateObservation(o *cNativeActorObservation, a cNativeAdmission, role string) error {
+	if o == nil {
+		return errors.New("actual actor observation missing")
+	}
+	if err := cNativeValidateActualIdentity(o.Identity, a, role); err != nil {
+		return err
+	}
+	sha, err := cNativeHash(o.Resources)
+	if err != nil || sha != o.LedgerSHA {
+		return errors.New("incomplete or forged full ledger snapshot")
+	}
+	domains := map[uint8]bool{}
+	ids := map[string]bool{}
+	for _, resource := range o.Resources {
+		id := fmt.Sprintf("%s/%d/%s", resource.Birth, resource.Domain, resource.Key)
+		if ids[id] || resource.Birth != o.Identity.Birth || resource.Domain < uint8(redirectListener) || resource.Domain > uint8(redirectTun) || resource.Key == "" {
+			return errors.New("invalid full resource inventory")
+		}
+		ids[id] = true
+		if resource.State == uint8(redirectOwned) {
+			domains[resource.Domain] = true
+		}
+	}
+	for _, resource := range o.Resources {
+		for _, dependency := range resource.Requires {
+			if !ids[dependency] {
+				return errors.New("full ledger dependency omitted")
+			}
+		}
+	}
+	for _, domain := range []redirectResourceDomain{redirectNamespace, redirectClaim, redirectListener, redirectNFQueue, redirectNFTables, redirectCallback} {
+		if !domains[uint8(domain)] {
+			return errors.New("actual default resource missing")
+		}
+	}
+	if !ids[o.NFTOwnerDomain] || !cNativeSHA(o.NFTSHA) || !cNativeSHA(o.KernelResourcesSHA) || o.ListenerInode == 0 || len(o.NFTReceipts) == 0 || len(o.NFTReceiptErrors) != len(o.NFTReceipts) {
+		return errors.New("full actual N/socket/listener evidence missing")
+	}
+	for _, group := range o.Docker {
+		parentSHA, err := cNativeHash([]any{group.Parent, group.Chain})
+		if err != nil {
+			return err
+		}
+		rulesSHA, err := cNativeHash(group.Rules)
+		if err != nil {
+			return err
+		}
+		if parentSHA != group.ParentSHA || rulesSHA != group.RulesSHA || len(group.Rules) != 2 || group.Parent == nil || group.Chain == nil {
+			return errors.New("Docker full spec inventory missing")
+		}
+		if !cNativeSHA(group.ParentSHA) || !cNativeSHA(group.RulesSHA) || len(group.Handles) != 2 || group.Handles[0] == 0 || group.Handles[1] == 0 || group.Handles[0] == group.Handles[1] || group.Acquired.State != nftables.TransactionCommitted || !group.Acquired.Sent || group.Acquired.Err != nil || group.Acquired.Intent.Birth != o.Identity.Birth || group.Acquired.Intent.PortID == 0 || group.Acquired.Intent.Generation == 0 || len(group.Acquired.Intent.Messages) != 4 || len(group.Acquired.Replies) == 0 {
+			return errors.New("Docker pair lacks original strict transaction/handle evidence")
+		}
+		objects, err := group.Acquired.ConfirmedObjects()
+		if err != nil || len(objects.Rules) != 2 || len(objects.Tables)+len(objects.Chains)+len(objects.Sets) != 0 {
+			return errors.New("Docker actual ACK/ECHO objects not confirmed")
+		}
+		for i, rule := range group.Rules {
+			if rule == nil || rule.Handle != group.Handles[i] || !dockerRuleParentMatches(rule, group.Parent, group.Chain) {
+				return errors.New("Docker full rule/parent identity mismatch")
+			}
+		}
+	}
+	return nil
+}
