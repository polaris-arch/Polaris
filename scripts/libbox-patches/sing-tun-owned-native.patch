+)
+
+func TestRedirectNamespacePinnedPathAndPermanentClose(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "netns")
+	if err := os.Symlink("/proc/thread-self/ns/net", path); err != nil {
+		t.Fatal(err)
+	}
+	lease, err := newNetworkNamespaceLease(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lease.Close()
+	if err = os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if err = lease.Run(func() error { return nil }); err != nil {
+		t.Fatalf("lease rediscovered deleted path: %v", err)
+	}
+	if err = lease.Run(func() error { panic("pinned worker") }); !errors.Is(err, errRedirectEffectPanic) {
+		t.Fatal(err)
+	}
+	if err = lease.Close(); err != nil {
+		t.Fatal(err)
+	}
+	called := false
+	if err = lease.Run(func() error { called = true; return nil }); err == nil || called {
+		t.Fatal("closed lease admitted a writer")
+	}
+	ordinary := filepath.Join(t.TempDir(), "ordinary")
+	if err = os.WriteFile(ordinary, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = newNetworkNamespaceLease(ordinary); err == nil {
+		t.Fatal("ordinary file accepted as network namespace")
+	}
+}
+
+func TestRedirectClaimProcessHelper(t *testing.T) {
+	mode := os.Getenv("POLARIS_L_CLAIM_HELPER")
+	if mode == "" {
+		return
+	}
+	owner, err := newRedirectOwnership()
+	if err != nil {
+		t.Fatal(err)
+	}
+	claims, err := acquireTestRedirectClaims(t, os.Getenv("POLARIS_L_CLAIM_DIR"), networkNamespaceIdentity{1234, 5678}, owner.birth, []redirectConflictKey{{"mark", "abcd"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Println("claimed")
+	if mode == "crash" {
+		os.Exit(0)
+	}
+	if !bufio.NewScanner(os.Stdin).Scan() {
+		t.Fatal("missing release request")
+	}
+	if err = claims.Release(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRedirectClaimsCrossProcessAndCrashResidual(t *testing.T) {
+	for _, mode := range []string{"hold", "crash"} {
+		t.Run(mode, func(t *testing.T) {
+			directory := filepath.Join(t.TempDir(), "claims")
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			command := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestRedirectClaimProcessHelper$")
+			command.Env = append(os.Environ(), "POLARIS_L_CLAIM_HELPER="+mode, "POLARIS_L_CLAIM_DIR="+directory)
+			output, err := command.StdoutPipe()
+			if err != nil {
+				t.Fatal(err)
+			}
+			input, err := command.StdinPipe()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = command.Start(); err != nil {
+				t.Fatal(err)
+			}
+			defer func() {
+				_ = input.Close()
+				if command.ProcessState == nil {
+					_ = command.Process.Kill()
+					_ = command.Wait()
+				}
+			}()
+			scanner := bufio.NewScanner(output)
+			if !scanner.Scan() || scanner.Text() != "claimed" {
+				t.Fatal("child did not claim resource")
+			}
+			if mode == "crash" {
+				if err = command.Wait(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			owner, err := newRedirectOwnership()
+			if err != nil {
+				t.Fatal(err)
+			}
+			keys := []redirectConflictKey{{"mark", "abcd"}}
+			_, err = acquireTestRedirectClaims(t, directory, networkNamespaceIdentity{1234, 5678}, owner.birth, keys)
+			want := errRedirectClaimConflict
+			if mode == "crash" {
+				want = errRedirectClaimResidual
+			}
+			if !errors.Is(err, want) {
+				t.Fatalf("wanted %v, got %v", want, err)
+			}
+			if mode == "hold" {
+				if _, err = fmt.Fprintln(input, "release"); err != nil {
+					t.Fatal(err)
+				}
+				if err = command.Wait(); err != nil {
+					t.Fatal(err)
+				}
+				claims, err := acquireTestRedirectClaims(t, directory, networkNamespaceIdentity{1234, 5678}, owner.birth, keys)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err = claims.Release(); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
+
+func TestRedirectClaimsDistinctDomainsAndForeignRecord(t *testing.T) {
+	directory := filepath.Join(t.TempDir(), "claims")
+	a, _ := newRedirectOwnership()
+	b, _ := newRedirectOwnership()
+	namespace := networkNamespaceIdentity{1, 2}
+	first, err := acquireTestRedirectClaims(t, directory, namespace, a.birth, []redirectConflictKey{{"queue", "100"}, {"mark", "1"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Release()
+	second, err := acquireTestRedirectClaims(t, directory, namespace, b.birth, []redirectConflictKey{{"queue", "101"}, {"mark", "2"}})
+	if err != nil {
+		t.Fatalf("namespace-wide lock prohibited distinct resources: %v", err)
+	}
+	if err = second.Release(); err != nil {
+		t.Fatal(err)
+	}
+	entry := first.files[0]
+	if _, err = entry.file.WriteAt([]byte(b.birth.String()+"\n"), 0); err != nil {
+		t.Fatal(err)
+	}
+	if err = first.Validate(); !errors.Is(err, errRedirectClaimResidual) {
+		t.Fatal(err)
+	}
+	if err = first.Release(); !errors.Is(err, errRedirectClaimResidual) {
+		t.Fatal(err)
+	}
+	content, err := os.ReadFile(filepath.Join(first.store.base().Name(), entry.name))
+	if err != nil || string(content[:len(b.birth.String())+1]) != b.birth.String()+"\n" {
+		t.Fatal("foreign journal modified")
+	}
+	if _, err = entry.file.WriteAt(entry.journal, 0); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRedirectClaimsUnsafeDirectoryAndSymlinkReject(t *testing.T) {
+	directory := filepath.Join(t.TempDir(), "claims")
+	if err := os.Mkdir(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(directory, 0777); err != nil {
+		t.Fatal(err)
+	}
+	owner, _ := newRedirectOwnership()
+	if _, err := acquireTestRedirectClaims(t, directory, networkNamespaceIdentity{1, 2}, owner.birth, []redirectConflictKey{{"queue", "100"}}); err == nil {
+		t.Fatal("unsafe directory accepted")
+	}
+	link := filepath.Join(t.TempDir(), "link")
+	if err := os.Symlink(directory, link); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := acquireTestRedirectClaims(t, link, networkNamespaceIdentity{1, 2}, owner.birth, []redirectConflictKey{{"queue", "100"}}); err == nil {
+		t.Fatal("symlink directory accepted")
+	}
+}
+
+type runtimeNFQueueTransport struct {
+	access         sync.Mutex
+	hook           nfqueue.HookFunc
+	errorFunc      nfqueue.ErrorFunc
+	events         chan nfqueue.Attribute
+	receiverErrors chan error
+	errorReturns   chan int
+	receiverExits  atomic.Int32
+	receiverDone   chan struct{}
+	registerError  error
+	optionError    error
+	closeError     error
+	onRegister     func(nfqueue.HookFunc)
+	closeCount     atomic.Int32
+	verdictCount   atomic.Int32
+}
+
+func (c *runtimeNFQueueTransport) SetOption(netlink.ConnOption, bool) error { return c.optionError }
+func (c *runtimeNFQueueTransport) SetVerdict(uint32, int) error             { c.verdictCount.Add(1); return nil }
+func (c *runtimeNFQueueTransport) SetVerdictWithOption(uint32, int, ...nfqueue.VerdictOption) error {
+	c.verdictCount.Add(1)
+	return nil
+}
+func (c *runtimeNFQueueTransport) RegisterWithErrorFunc(ctx context.Context, hook nfqueue.HookFunc, errorFunc nfqueue.ErrorFunc) error {
+	c.access.Lock()
+	c.hook = hook
+	c.errorFunc = errorFunc
+	c.access.Unlock()
+	if c.onRegister != nil {
+		c.onRegister(hook)
+	}
+	if c.registerError != nil {
+		return c.registerError
+	}
+	c.events = make(chan nfqueue.Attribute, 2)
+	c.receiverErrors = make(chan error, 1)
+	c.errorReturns = make(chan int, 1)
+	c.receiverDone = make(chan struct{})
+	go func() {
+		defer close(c.receiverDone)
+		defer c.receiverExits.Add(1) // socketCallback exit models its deferred UNBIND
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case event := <-c.events:
+				hook(event)
+			case err := <-c.receiverErrors:
+				ret := errorFunc(err)
+				c.errorReturns <- ret
+				if ret != 0 {
+					return
+				}
+			}
+		}
+	}()
+	return nil
+}
+func (c *runtimeNFQueueTransport) Close() error {
+	c.closeCount.Add(1)
+	if c.receiverDone != nil {
+		<-c.receiverDone
+	}
+	return c.closeError
+}
