+func (b *runtimeRouteServiceTransport) Start(_ *autoRedirect, op *redirectOperation, _ []redirectResourceID) ([]redirectResourceID, error) {
+	_, err := op.acquire(redirectNetlink, "route-initial", b.owned("initial"), b.anchor)
+	ids := []redirectResourceID{b.anchor}
+	if b.claim != (redirectResourceID{}) {
+		ids = append(ids, b.claim)
+	}
+	return ids, err
+}
+func (b *runtimeRouteServiceTransport) UpdateNetwork(_ *autoRedirect, op *redirectOperation) error {
+	var err error
+	b.late, err = op.acquire(redirectNetlink, "route-late-generation", b.owned("late"), b.anchor)
+	return err
+}
