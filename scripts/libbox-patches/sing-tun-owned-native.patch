+func TestRedirectOwnershipNFTFiniteDependencyAndContentNegativeControls(t *testing.T) {
+	for _, mode := range []string{"omit-element", "foreign-set", "bad-family", "mapped", "zone", "set-spec-alias", "duplicate-element", "duplicate-buffer", "append-bound-set"} {
+		t.Run(mode, func(t *testing.T) {
+			scope := redirectNFTScope{redirectNamespaceIdentity{3, 913}, redirectNFTINet}
+			r := newOwnershipTestRedirect(t)
+			ops := newOwnershipNFTContentOps(r.ownership, scope)
+			r.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+				members, err := ownershipNFTContentPlan(op, scope, []netip.Addr{netip.MustParseAddr("2001:db8::1")})
+				if err != nil {
+					return err
+				}
+				switch mode {
+				case "omit-element":
+					members[0].requires = slices.DeleteFunc(members[0].requires, func(id redirectResourceID) bool { return id == members[4].id })
+				case "foreign-set":
+					members[0].spec.content.lookup.birth[0] ^= 1
+				case "bad-family", "mapped", "zone":
+					address := netip.MustParseAddr("192.0.2.1")
+					if mode == "mapped" {
+						address = netip.MustParseAddr("::ffff:192.0.2.1")
+					}
+					if mode == "zone" {
+						address = netip.MustParseAddr("fe80::1%fake")
+					}
+					_, err = op.nftElementIntents(members[2], []netip.Addr{address})
+					return err
+				case "set-spec-alias":
+					alias, err := op.nftSetIntent(members[3], members[2].role, redirectNFTIPv4)
+					if err != nil || alias.id != members[2].id {
+						t.Fatal("set spec created a different physical identity")
+					}
+					members = append(members, alias)
+				case "duplicate-element":
+					members = append(members, members[4].clone())
+				case "duplicate-buffer":
+					queue := &redirectNFTCreateQueue{operation: op, ops: ops}
+					if err := queue.add(members...); err != nil {
+						return err
+					}
+					if err := queue.add(members[4]); err == nil {
+						t.Fatal("duplicate buffered key accepted")
+					}
+					return queue.Flush()
+				case "append-bound-set":
+					if _, err := op.acquireNFTBatch(members, ops); err != nil {
+						return err
+					}
+					later, err := op.nftElementIntents(members[2], []netip.Addr{netip.MustParseAddr("2001:db8::2")})
+					if err != nil {
+						return err
+					}
+					_, err = op.acquireNFTBatch(later, ops)
+					return err
+				}
+				_, err = op.acquireNFTBatch(members, ops)
+				return err
+			}}
+			if err := r.Start(); err == nil {
+				t.Fatal("invalid finite content/dependency accepted")
+			}
+			want := 0
+			if mode == "append-bound-set" {
+				want = 1
+			}
+			if len(ops.batches) != want {
+				t.Fatal("invalid content reached another Submit")
+			}
+		})
+	}
+}
