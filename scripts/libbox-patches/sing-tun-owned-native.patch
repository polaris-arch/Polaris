+func (t *NativeTun) acquireNativeTun(op *redirectOperation) error {
+	n := t.nativeOwnership
+	if t.options.FileDescriptor > 0 {
+		return t.acquireProvidedNativeTun(op)
+	}
+	leaseID, err := op.acquire(redirectNamespace, "tun-netns", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			lease, err := newNetworkNamespaceLease(t.options.NetNs)
+			if err != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			n.lease = lease
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return n.lease.Close() },
+	})
+	if err != nil {
+		return err
+	}
+	n.owner.access.Lock()
+	n.owner.prerequisites = []redirectResourceID{leaseID}
+	n.owner.access.Unlock()
+	preflightID, err := n.acquireRouteSocket(op, "tun-preflight-socket")
+	if err != nil {
+		return err
+	}
+	claimID, err := op.acquire(redirectClaim, "tun-conflicts", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			withAllocator := n.dependency.withClaimAllocator
+			if withAllocator == nil {
+				withAllocator = withRedirectClaimAllocator
+			}
+			err := withAllocator(n.dependency.claimDirectory, func(allocator *redirectClaimAllocator) error {
+				if t.options.Name == "" {
+					for index := 0; index < 128; index++ {
+						name := "tun" + strconv.Itoa(index)
+						_, err := n.api.LinkByName(name)
+						var absent netlink.LinkNotFoundError
+						if errors.As(err, &absent) || errors.Is(err, unix.ENODEV) {
+							t.options.Name = name
+							break
+						}
+						if err != nil {
+							return err
+						}
+					}
+					if t.options.Name == "" {
+						return errors.New("no unoccupied automatic TUN name within allocation budget")
+					}
+				}
+				keys := []redirectConflictKey{{"tun", t.options.Name}}
+				if !t.options.EXP_ExternalConfiguration {
+					if t.options.IPRoute2TableIndex == 0 {
+						table, err := chooseClaimedRouteTable(n.api)
+						if err != nil {
+							return err
+						}
+						t.options.IPRoute2TableIndex = table
+					} else {
+						occupied, err := routeTableOccupiedOn(n.api, t.options.IPRoute2TableIndex)
+						if err != nil {
+							return err
+						}
+						if occupied {
+							return fmt.Errorf("route table %d is occupied: %w", t.options.IPRoute2TableIndex, unix.EEXIST)
+						}
+					}
+					keys = append(keys, redirectConflictKey{"route-table", strconv.Itoa(t.options.IPRoute2TableIndex)})
+					var priorities []int
+					if t.options.AutoRoute {
+						if t.options.IPRoute2RuleIndex < 0 || t.options.IPRoute2RuleIndex > 0x7fffffff-10 {
+							return errors.New("invalid route rule priority range")
+						}
+						for priority := t.options.IPRoute2RuleIndex; priority <= t.options.IPRoute2RuleIndex+10; priority++ {
+							priorities = append(priorities, priority)
+						}
+						if t.options.AutoRedirectMarkMode {
+							priorities = append(priorities, t.options.IPRoute2AutoRedirectFallbackRuleIndex)
+							// These rules read the marks. autoRedirect's distinct birth
+							// owns the mark/queue domain; claiming it here conflicts
+							// with our own cooperating redirect instance.
+						}
+					} else if len(t.options.Inet6Address) > 0 {
+						rules, err := n.api.RuleList(unix.AF_INET6)
+						if err != nil {
+							return err
+						}
+						minimum := 32766
+						for _, rule := range rules {
+							if rule.Priority > 0 && rule.Priority < minimum {
+								minimum = rule.Priority
+							}
+						}
+						if minimum <= 1 {
+							return errors.New("no available IPv6 output rule priority")
+						}
+						n.priority6 = minimum - 1
+						priorities = append(priorities, n.priority6)
+					}
+					if err := rejectOccupiedPriorities(n.api, priorities); err != nil {
+						return err
+					}
+					keys = append(keys, priorityClaimKeys(priorities)...)
+					for _, address := range append(slices.Clone(t.options.Inet4Address), t.options.Inet6Address...) {
+						keys = append(keys, redirectConflictKey{"address", t.options.Name + ":" + address.String()})
+					}
+				}
+				var claimErr error
+				n.claims, claimErr = acquireRedirectClaimsInAllocator(allocator, n.lease.Identity(), n.owner.birth, keys)
+				// A failed constructor may still return original EXCL file
+				// custody. Preserve it before inspecting the error.
+				return claimErr
+			})
+			if err == nil {
+				if n.claims == nil {
+					return redirectAcquireResult{err: errRedirectInvalidACK}
+				}
+				// No network mutation or process wait is done in the short
+				// allocator callback. Validate again after its lock is gone.
+				err = n.claims.Validate()
+			}
+			if err != nil {
+				if n.claims != nil {
+					return redirectAcquireResult{err: errors.Join(errRedirectAmbiguous, err)}
+				}
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return n.claims.Release() },
+	})
+	if err != nil {
+		return err
+	}
+	// The read-only selection socket predates claims. Retire it now, then open
+	// the actual writer socket as a dependent of the acquired claims. This
+	// avoids both a dependency cycle and closing claims before a guarded socket.
+	if err := op.release(preflightID); err != nil {
+		return err
+	}
+	n.owner.access.Lock()
+	n.owner.prerequisites = append(n.owner.prerequisites, claimID)
+	n.owner.mutationGuard = n.claims.Validate
+	n.owner.access.Unlock()
+	handleID, err := n.acquireRouteSocket(op, "tun-route-socket")
+	if err != nil {
+		return err
+	}
+	n.owner.access.Lock()
+	n.owner.prerequisites = append(n.owner.prerequisites, handleID)
+	n.owner.access.Unlock()
+	n.api = &claimedRouteNetlink{routeNetlink: n.api, validate: n.claims.Validate}
+	n.routes.api, n.rules.api = n.api, n.api
+	tunID, err := op.acquire(redirectTun, "tun-main-fd", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+
+			var openErr error
+			openErr = n.lease.Run(func() error {
+				link, err := n.api.LinkByName(t.options.Name)
+				if err == nil {
+					n.borrowed = true
+					n.link = link
+				} else {
+					var absent netlink.LinkNotFoundError
+					if !errors.As(err, &absent) && !errors.Is(err, unix.ENODEV) {
+						return err
+					}
+				}
+				fd, multiQueue, err := n.dependency.openTun(t.options.Name, t.options.GSO, t.options.MultiQueue, !n.borrowed)
+				if fd >= 0 {
+					t.tunFd, t.multiQueue, t.tunFile = fd, multiQueue, os.NewFile(uintptr(fd), "tun")
+				}
+				if err != nil {
+					return err
+				}
+				if t.tunFile == nil {
+					return errRedirectInvalidACK
+				}
+				return nil
+			})
+			if openErr != nil {
+				if t.tunFile != nil {
+					return redirectAcquireResult{err: openErr}
+				}
+				return routeAcquireResult(openErr)
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error {
+			// detachRuntimePoller transfers this same TUN reference to a new owned
+			// duplicate under the effect gate. Release the current actual file.
+			return t.tunFile.Close()
+		},
+	})
+	if err != nil {
+		return err
+	}
+	n.owner.access.Lock()
+	n.owner.prerequisites = append(n.owner.prerequisites, tunID)
+	n.owner.access.Unlock()
+
+	link, err := n.api.LinkByName(t.options.Name)
+	if err != nil {
+		return err
+	}
+	identity, err := t.ownedFDIdentity()
+	if err != nil || identity.name != link.Attrs().Name || identity.flags&unix.IFF_TUN == 0 {
+		return errors.Join(errors.New("TUN fd/link binding does not match acquisition"), err)
+	}
+	if n.link != nil && n.link.Attrs().Index != link.Attrs().Index {
+		return errors.New("borrowed TUN interface changed during acquisition")
+	}
+	n.link = &netlink.Tuntap{LinkAttrs: *link.Attrs()}
+	return n.lease.Run(func() error { return t.configure(n.link) })
+}
+
+// IFF_TUN_EXCL applies only to a genuinely new interface, never an explicitly
+// borrowed persistent device or another queue of this birth.
+func openOwnedTun(name string, vnetHdr, multiQueue, exclusive bool) (int, bool, error) {
+	flags := unix.IFF_TUN | unix.IFF_NO_PI
+	if vnetHdr {
+		flags |= unix.IFF_VNET_HDR
+	}
+	if exclusive {
+		flags |= unix.IFF_TUN_EXCL
+	}
+	if multiQueue {
+		fd, err := openTun(name, flags|unix.IFF_MULTI_QUEUE)
+		if err == nil {
+			return fd, true, nil
+		}
+		if !errors.Is(err, unix.EINVAL) {
+			return -1, false, err
+		}
+	}
+	fd, err := openTun(name, flags)
+	return fd, false, err
+}
+
+func (t *NativeTun) validateNativeLink() error {
+	n := t.nativeOwnership
+	if err := n.claims.Validate(); err != nil {
+		return err
+	}
+	link, err := n.api.LinkByIndex(n.link.Attrs().Index)
+	if err != nil {
+		return err
+	}
+	if link.Attrs().Name != n.link.Attrs().Name {
+		return errRedirectAmbiguous
+	}
+	return nil
+}
+
+func (t *NativeTun) nativeOperation(block func(*redirectOperation) error) (err error) {
+	n := t.nativeOwnership
+	op, err := n.owner.beginOperation(false, true)
+	if err != nil {
+		return err
+	}
+	defer op.finish()
+	defer func() {
+		if value := recover(); value != nil {
+			err = errors.Join(err, n.owner.recordPanic(value))
+			n.owner.requestClose()
+		}
+	}()
+	return op.withEffect(func() error {
+		// An operation admitted before another writer failed can still be queued
+		// for effect. Recheck here, rather than only at beginOperation.
+		if n.sealed != nil {
+			return n.sealed
+		}
+		n.operation = op
+		defer func() { n.operation = nil }()
+		return block(op)
+	})
+}
+
+func (t *NativeTun) startOwnedNativeTun() error {
+	err := t.nativeOperation(func(op *redirectOperation) error {
+		n := t.nativeOwnership
+		if n.started {
+			return errRedirectAlreadyStarted
+		}
+		n.started = true
+		if t.options.FileDescriptor == 0 {
+			if !t.options.EXP_ExternalConfiguration && t.options.NetNs == "" && t.options.InterfaceMonitor != nil {
+				t.options.InterfaceMonitor.RegisterMyInterface(t.options.Name)
+			}
+			if err := n.lease.Run(t.start); err != nil {
+				return err
+			}
+		}
+		if t.vnetHdr && t.gro.canTCPGRO() {
+			if err := t.probeTCPGRO(); err != nil {
+				t.gro.disableTCPGRO()
+				t.gro.disableUDPGRO()
+				if t.options.Logger != nil {
+					t.options.Logger.Warn(err)
+				}
+			}
+		}
+		return nil
+	})
+	if err != nil && !errors.Is(err, errRedirectAlreadyStarted) {
+		return errors.Join(err, t.Close())
+	}
+	return err
+}
+
+// DisposeConstruction retires only this birth's actual acquisition ledger
+// when a consumer did not finish Start/PostStart. Partial Start is covered;
+// legacy/untracked objects cannot authorize broad cleanup through this API.
+func (t *NativeTun) DisposeConstruction() error {
+	if t.nativeOwnership == nil {
+		return errors.New("TUN construction has no acquisition ledger")
+	}
+	return t.closeOwnedNativeTun()
+}
+
+func (t *NativeTun) closeOwnedNativeTun() error {
+	err := t.nativeOwnership.owner.close()
+	if err == nil {
+		nativeTunCustody.Delete(t.nativeOwnership.owner.birth)
+	}
+	return err
+}
+
+func (t *NativeTun) configureOwnedMTU(link netlink.Link) error {
+	n := t.nativeOwnership
+	previous := link.Attrs().MTU
+	_, err := n.operation.acquire(redirectNetlink, "tun-mtu", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			return routeAcquireResult(n.api.LinkSetMTU(link, int(t.options.MTU)))
+		},
+		release: func(redirectResourceID) error {
+			if !n.borrowed {
+				return nil // the newly created interface is retired by our fd release
+			}
+			if err := t.validateNativeLink(); err != nil {
+				return err
+			}
+			return n.api.LinkSetMTU(n.link, previous)
+		},
+	})
+	return err
+}
+
+func (t *NativeTun) configureOwnedAddress(link netlink.Link, address *netlink.Addr) error {
+	n := t.nativeOwnership
+	spec := *address
+	spec.IPNet = &net.IPNet{IP: slices.Clone(address.IP), Mask: slices.Clone(address.Mask)}
+	spec.LinkIndex = link.Attrs().Index
+	_, err := n.operation.acquire(redirectNetlink, "tun-address-"+address.String(), redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult { return routeAcquireResult(n.api.AddrAdd(link, &spec)) },
+		release: func(redirectResourceID) error {
+			if err := t.validateNativeLink(); err != nil {
+				return err
+			}
+			return n.api.AddrDel(n.link, &spec)
+		},
+	})
+	if errors.Is(err, unix.EEXIST) && !errors.Is(err, errRedirectAmbiguous) {
+		return nil // externally present address is borrowed, never entered Owned
+	}
+	return err
+}
+
+func (t *NativeTun) setOwnedLinkUp() error {
+	n := t.nativeOwnership
+	wasUp := n.link.Attrs().Flags&net.FlagUp != 0
+	_, err := n.operation.acquire(redirectNetlink, "tun-link-up", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult { return routeAcquireResult(n.api.LinkSetUp(n.link)) },
+		release: func(redirectResourceID) error {
+			if !n.borrowed || wasUp {
+				return nil
+			}
+			if err := t.validateNativeLink(); err != nil {
+				return err
+			}
+			return n.api.LinkSetDown(n.link)
+		},
+	})
+	return err
+}
