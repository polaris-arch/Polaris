+	e := &redirectEnvironmentRuntime{monitorDone: make(chan struct{}), monitorStarted: true,
+		monitorConn: cMonitorCloser{func() error { close(closing); return nil }}, monitor: cMonitorCloser{func() error { return nil }}}
+	go e.loopDockerMonitor(r, events)
