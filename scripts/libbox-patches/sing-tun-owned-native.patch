+func cNativeValidateAdmission(a cNativeAdmission, c cNativeCase) error {
+	if a.Case != c.path() || a.SourceBase != cNativeBase || len(a.Nonce) < 32 || len(a.Nonce) > 256 {
+		return errCNativeUnfrozen
+	}
+	for _, key := range cNativeRequiredBindings {
+		if !cNativeSHA(a.Bindings[key]) {
+			return fmt.Errorf("%w: %s", errCNativeUnfrozen, key)
+		}
+	}
+	if len(a.Bindings) != len(cNativeRequiredBindings) {
+		return fmt.Errorf("%w: unexpected binding", errCNativeUnfrozen)
+	}
+	for _, role := range []string{"A", "B", "H"} {
+		i, ok := a.Actors[role]
+		configSHA, err := cNativeConfigSHA(role, role == "B" && c.Scenario == "claim")
+		// Birth is generated by the original constructor later; admission binds
+		// the already launched independent process, not a predicted random birth.
+		if !ok || err != nil || i.Role != role || i.PID <= 0 || i.Birth != "" || i.ConfigSHA != configSHA || i.Namespace == "" || i.UserNamespace == "" || i.RootIdentity == "" {
+			return fmt.Errorf("%w: actor %s", errCNativeUnfrozen, role)
+		}
+		if role != "A" {
+			root := a.Actors["A"]
+			if i.PID == root.PID || i.Namespace != root.Namespace || i.UserNamespace != root.UserNamespace || i.RootIdentity != root.RootIdentity {
+				return fmt.Errorf("%w: independent same-ns actors", errCNativeUnfrozen)
+			}
+		}
+	}
+	if len(a.Actors) != 3 || a.Actors["B"].PID == a.Actors["H"].PID {
+		return errCNativeUnfrozen
+	}
+	return nil
+}
+func cNativeSHA(s string) bool {
+	b, err := hex.DecodeString(s)
+	return err == nil && len(b) == sha256.Size && s == hex.EncodeToString(b)
+}
+func cNativeHash(v any) (string, error) {
+	data, err := json.Marshal(v)
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:]), nil
+}
+func cNativeAdmit(ctx context.Context, c cNativeCase) (cNativeAdmission, error) {
+	g := cNativeG
+	if g == nil || g.VerifyAdmission == nil || g.Actor == nil || g.Produce == nil || g.Observe == nil || g.Witness == nil || g.CallConcurrent == nil || g.JoinCall == nil || g.VerifyReceipt == nil || g.ServeActor == nil || g.Publish == nil || g.ActorSelection == nil || g.VerifyActorSelection == nil {
+		return cNativeAdmission{}, errCNativeUnfrozen
+	}
+	if os.Getenv("POLARIS_NO_KERNEL_RUN") == "1" {
+		return cNativeAdmission{}, fmt.Errorf("%w: offline guard", errCNativeUnfrozen)
+	}
+	a, err := g.VerifyAdmission(ctx, c)
