+func (f *redirectFW4Runtime) openDeployment() error {
+	var err error
+	f.dirFD, f.dirIdentity, err = fw4OpenDirectoryFor(f.dirPath, f.ownerUID)
+	if err != nil {
+		return fmt.Errorf("open fw4 include directory: %w", err)
