+func rNativeRunCase(t *testing.T, c rNativeCase, in *rNativeLauncherInputs, deadline time.Time) error {
+	o, _ := rNativePreparedConfig(c, in.Actor)
+	switch c.Sub {
+	case "same_ns_running_a_failed_b_old_callback":
+		return rNativeIndependentActors(c, in, o, deadline)
+	case "foreign_priority_early_refusal", "occupied_table_early_refusal":
+		return rNativeEarlyForeign(c, in, o, deadline)
+	case "persistent_external_address_preserved", "borrowed_mtu_up_restored", "provided_fd_duplicate_only_close":
+		return rNativeBorrowed(c, in, o, deadline)
+	}
+	var facts []rNativeAPIFact
+	var hook func() error
+	entered, resume := make(chan struct{}), make(chan struct{})
+	var release sync.Once
+	defer release.Do(func() { close(resume) })
+	updateEnabled, adds := false, 0
+	if c.Sub == "real_eexist_or_explicit_seam_partial_seal" || c.Sub == "admitted_update_close_writer_join" {
+		hook = func() error {
+			if !updateEnabled {
+				return nil
+			}
+			adds++
+			if c.Sub == "real_eexist_or_explicit_seam_partial_seal" && adds == 2 {
+				return unix.EIO
+			}
+			if c.Sub == "admitted_update_close_writer_join" && adds == 1 {
+				close(entered)
+				select {
+				case <-resume:
+				case <-time.After(time.Until(deadline)):
+					return errors.New("writer resume not witnessed before case deadline")
+				}
+			}
+			return nil
+		}
+	}
+	var destinationFacts *[]rNativeAPIFact
+	if hook != nil {
+		destinationFacts = &facts
+	}
+	if err := rNativeVerifyTopologyBeforeNew(in, c, o, deadline); err != nil {
+		return err
+	}
+	device, err := rNativeNew(o, in, destinationFacts, hook)
+	if err != nil {
+		return err
+	}
+	// Unknown Close stays in original nativeTunCustody. There is no retry/finalizer
+	// cleanup in this fixture. G must wait and settle its private domain separately.
+	observer, err := openRouteNetlink(device.nativeOwnership.lease)
+	if err != nil {
+		return errors.Join(err, device.Close())
+	}
+	defer observer.Close()
+	if c.Sub == "new_without_start_close" {
+		birth := device.nativeOwnership.owner.birth.String()
+		err := device.Close()
+		return errors.Join(err, rNativeEmit(c, in, "actual_new_without_start_close", birth))
+	}
+	if err := device.Start(); err != nil {
+		return err
+	}
+	if output := in.Association.Topology.IPv6Output; output != nil && device.nativeOwnership.priority6 != output.SelectedPriority {
+		return errors.New("actual original IPv6 output priority differs from observed G baseline")
+	}
+	before, err := rNativeObserve(observer, device, deadline)
+	if err != nil {
+		return err
+	}
+	claims, err := rNativeClaimFacts(device)
+	if err != nil {
+		return err
+	}
+	if err := rNativeEmit(c, in, "actual_start", struct {
+		Birth       string
+		Claims      []json.RawMessage
+		Observation rNativeObservation
+	}{device.nativeOwnership.owner.birth.String(), claims, before}); err != nil {
+		return err
+	}
+	switch c.Sub {
+	case "started_dispose_construction_double_close":
+		if err := device.DisposeConstruction(); err != nil {
+			return err
+		}
+		if err := device.Close(); err != nil {
+			return err
+		}
+		return rNativeEmit(c, in, "actual_dispose_and_double_close", true)
+	case "ipv4_default_nil_dst", "ipv6_default_nil_dst":
+		found := false
+		for _, route := range before.Routes {
+			if route.Dst == nil {
+				found = true
+			}
+		}
+		if !found {
+			return errors.New("real kernel omitted-Dst default was not observed")
+		}
+	case "ordinary_full_selectors", "strict_full_selectors", "marked_full_selectors":
+		if len(before.Rules) == 0 {
+			return errors.New("actual full-selector rules absent")
+		}
+		if c.Options.Marked && !slices.ContainsFunc(before.Rules, func(r netlink.Rule) bool { return r.MarkSet }) {
+			return errors.New("actual marked rule absent")
+		}
+	case "foreign_metric_preserved", "wrong_family_preserved", "wrong_gateway_preserved", "wrong_link_preserved", "absent_owned_unknown":
+		return rNativeForeignAfterStart(c, in, device, observer, deadline)
+	case "multiqueue_transfer_receiver_join":
+		return rNativeQueueReceiver(c, in, device, deadline)
+	case "include_exclude_gateway_success":
+		connected, err := observer.RouteListFiltered(unix.AF_INET, &netlink.Route{Table: unix.RT_TABLE_MAIN}, netlink.RT_FILTER_TABLE)
+		if err != nil {
+			return err
+		}
+		if !slices.ContainsFunc(connected, func(r netlink.Route) bool {
+			return r.LinkIndex == device.nativeOwnership.link.Attrs().Index && r.Dst != nil && r.Dst.String() == "198.18.0.0/24" && len(r.Gw) == 0 && r.Scope == netlink.SCOPE_LINK
+		}) {
+			return errors.New("actual subject connected route to configured gateway absent")
+		}
+		if err := rNativeEmit(c, in, "actual_gateway_connected_route", connected); err != nil {
+			return err
+		}
+		_, planned := rNativePreparedConfig(c, in.Actor)
+		update := planned[0]
+		if err := device.UpdateRouteOptions(update); err != nil {
+			return err
+		}
+		if _, err := rNativeObserve(observer, device, deadline); err != nil {
+			return err
+		}
+		if !reflect.DeepEqual(device.options.Inet4RouteExcludeAddress, update.Inet4RouteExcludeAddress) || device.options.Inet4Gateway != in.Gateway {
+			return errors.New("actual update was not published")
+		}
+	case "real_eexist_or_explicit_seam_partial_seal":
+		updateEnabled = true
+		_, planned := rNativePreparedConfig(c, in.Actor)
+		update := planned[0]
+		err := device.UpdateRouteOptions(update)
+		if !errors.Is(err, ErrRouteUpdateUnconfirmed) || adds != 2 {
+			return fmt.Errorf("partial forwarded-seam commit was not reached: %v adds=%d", err, adds)
+		}
+		beforeRetry := len(facts)
+		if err := device.UpdateRouteOptions(update); !errors.Is(err, ErrRouteUpdateUnconfirmed) || len(facts) != beforeRetry {
+			return errors.New("sealed writer retried actual API")
+		}
+		if err := rNativeEmit(c, in, "explicit_seam_partial_seal", facts); err != nil {
+			return err
+		}
+	case "admitted_update_close_writer_join":
+		updateEnabled = true
+		_, planned := rNativePreparedConfig(c, in.Actor)
+		return rNativeClosingWriter(c, in, device, planned[0], entered, resume, &release, &facts, deadline)
+	case "route_exclude_loopback_update":
+		_, planned := rNativePreparedConfig(c, in.Actor)
+		update := planned[0]
+
+		if err := device.UpdateRouteOptions(update); err != nil {
+			return err
+		}
+		if _, err := rNativeObserve(observer, device, deadline); err != nil {
+			return err
+		}
+	case "private_udp_nonce_tun_read_write":
+		_, planned := rNativePreparedConfig(c, in.Actor)
+		update := planned[0]
+		if err := device.UpdateRouteOptions(update); err != nil {
+			return err
+		}
+		if err := rNativeUDP(device.tunFile, device, c, in, true, deadline); err != nil {
+			return err
+		}
+	}
+	if err := device.Close(); err != nil {
+		return err
+	}
+	remaining, err := observer.RouteListFiltered(netlink.FAMILY_ALL, &netlink.Route{Table: o.IPRoute2TableIndex}, netlink.RT_FILTER_TABLE)
+	if err != nil || len(remaining) != 0 {
+		return errors.Join(errors.New("own table post-Close is not empty in this finite fresh case"), err)
+	}
+	return rNativeEmit(c, in, "actual_close_and_owned_postcheck", true)
+}
+
+func rNativeTwoPrefixUpdate(o Options) Options {
+	o = freezeRedirectOptions(o)
+	o.Inet4RouteAddress = []netip.Prefix{netip.MustParsePrefix("198.18.10.0/24"), netip.MustParsePrefix("198.18.20.0/24")}
+	return o
