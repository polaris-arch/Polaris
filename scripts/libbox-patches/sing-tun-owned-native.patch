+func (b *runtimeSnapshotFirewall) UpdateRouteAddressSetSnapshot(r *autoRedirect, _ *redirectOperation) (RouteAddressSetUpdateState, error) {
+	include, _, err := r.routeAddressSet()
+	if err != nil {
+		return RouteAddressSetUnknown, err
+	}
+	b.input = slices.Clone(include)
+	include[0] = netip.MustParsePrefix("203.0.113.0/24")
+	again, _, _ := r.routeAddressSet()
+	if !slices.Equal(again, b.input) {
+		return RouteAddressSetUnknown, errors.New("candidate getter aliases input")
+	}
+	if b.entered != nil {
+		close(b.entered)
+		<-b.resume
+	}
+	return b.state, b.err
+}
