+			ownershipWaitClosing(t, r.ownership)
+			go func() { closedB <- r.Close() }()
+			ownershipAssertWaiting(t, closedA)
+			ownershipAssertWaiting(t, closedB)
+			if lateRegistration {
+				monitor.snapshot()[0]() // registration Pending, monitor already snapshotted
+			}
+			close(resume)
+			if err := ownershipAwait(t, started); !errors.Is(err, errRedirectClosing) {
+				t.Fatalf("latched Start result = %v", err)
+			}
+			first, second := ownershipAwait(t, closedA), ownershipAwait(t, closedB)
+			if first != nil || first != second || callbackCalls.Load() != 0 || len(monitor.snapshot()) != 0 || len(ops.releaseAttempts()) != 2 {
+				t.Fatal("Close completed without exact NFT/callback drain")
+			}
+			wantUnregister := 0
+			if lateRegistration {
+				wantUnregister = 1
+			}
+			if monitor.count() != wantUnregister {
+				t.Fatal("late Pending callback registration was not finally unregistered")
+			}
+		})
+	}
+}
+
+func TestRedirectOwnershipNFTCallbackWriterDrainsAndSnapshotRejects(t *testing.T) {
+	scope := redirectNFTScope{redirectNamespaceIdentity{1, 908}, redirectNFTINet}
+	r := newOwnershipTestRedirect(t)
+	world := newOwnershipNFTFakeWorld(scope)
+	ops := &ownershipNFTFakeOps{world: world, owner: r.ownership}
+	monitor := &ownershipFakeNetworkMonitor{}
+	r.networkMonitor = monitor
+	entered, resume := make(chan struct{}), make(chan struct{})
+	ops.before = func(batch redirectNFTBatch) error {
+		if batch.transaction.sequence == 2 {
+			close(entered)
+			<-resume
+		}
+		return nil
+	}
+	callbackResult := make(chan error, 1)
+	r.ownershipBackend = ownershipFakeBackend{start: func(r *autoRedirect, op *redirectOperation) error {
+		members, err := ownershipNFTPlan(op, scope, "main")
+		if err != nil {
+			return err
+		}
+		if _, err := op.acquireNFTBatch(members, ops); err != nil {
+			return err
+		}
+		return r.registerNetworkCallback(func() {
+			writer, err := r.ownership.beginOperation(false, true)
+			if err != nil {
+				callbackResult <- err
+				return
+			}
+			defer writer.finish()
+			later, err := writer.nftChainIntent(members[1], "callback-child")
+			if err == nil {
+				_, err = writer.acquireNFTBatch([]redirectNFTIntent{later}, ops)
+			}
+			callbackResult <- err
+		}, members[1].id)
+	}}
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	callback := monitor.snapshot()[0]
+	callbackDone := make(chan struct{})
+	go func() { callback(); close(callbackDone) }()
+	ownershipAwait(t, entered)
+	closed := make(chan error, 1)
+	go func() { closed <- r.Close() }()
+	ownershipWaitClosing(t, r.ownership)
+	ownershipAssertWaiting(t, closed)
+	callback() // copied before unregister, denied before creating another writer
+	if len(ops.journal()) != 2 {
+		t.Fatal("snapshotted callback admitted a writer after Closing")
+	}
+	close(resume)
+	if err := ownershipAwait(t, callbackResult); err != nil {
+		t.Fatal(err)
+	}
+	ownershipAwait(t, callbackDone)
+	if err := ownershipAwait(t, closed); err != nil || len(monitor.snapshot()) != 0 || monitor.count() != 1 || len(ops.releaseAttempts()) != 3 {
+		t.Fatal("callback batch or registry escaped Close drain")
+	}
+}
+
+func TestRedirectOwnershipNFTRejectsHandleAliasesInAndAcrossBatches(t *testing.T) {
+	for _, existing := range []bool{false, true} {
+		t.Run(fmt.Sprintf("existing-handle=%t", existing), func(t *testing.T) {
+			scope := redirectNFTScope{redirectNamespaceIdentity{1, 909}, redirectNFTINet}
+			r := newOwnershipTestRedirect(t)
+			world := newOwnershipNFTFakeWorld(scope)
+			ops := &ownershipNFTFakeOps{world: world, owner: r.ownership}
+			r.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+				members, err := ownershipNFTPlan(op, scope, "main")
+				if err != nil {
+					return err
+				}
+				if existing {
+					identities, err := op.acquireNFTBatch(members, ops)
+					if err != nil {
+						return err
+					}
+					ops.forceHandle = identities[1].object.handle
+				} else {
+					ops.forceHandle = 777
+				}
+				later, err := op.nftChainIntent(members[1], "later")
+				if err != nil {
+					return err
+				}
+				if existing {
+					members = []redirectNFTIntent{later}
+				} else {
+					members = append(members, later)
+				}
+				_, err = op.acquireNFTBatch(members, ops)
+				return err
+			}}
+			if err := r.Start(); !errors.Is(err, errRedirectInvalidACK) || !errors.Is(err, errRedirectAmbiguous) {
+				t.Fatalf("aliased handle was confirmed: %v", err)
+			}
+			entries := ownershipEntries(r.ownership)
+			if len(entries) != 3 || entries[2].state != redirectAmbiguous || !existing && (entries[0].state != redirectAmbiguous || entries[1].state != redirectAmbiguous) {
+				t.Fatal("aliased handle produced partial ownership")
+			}
+		})
+	}
+}
