+func (w *cDockerIO) transact(parent *nftables.Table, plan func(*nftables.ConsistentSnapshot, *nftables.Conn) error) (nftables.TransactionReceipt, error) {
+	w.access.Lock()
+	defer w.access.Unlock()
+	capture := &nftBuilderCapture{}
+	conn, err := nftables.New(nftables.WithTestDial(capture.dial))
+	if err != nil {
+		return nftables.TransactionReceipt{}, err
+	}
+	defer conn.CloseLasting()
+	if err = plan(w.snapshot, conn); err != nil {
+		return nftables.TransactionReceipt{}, err
+	}
+	size, err := conn.PendingBytes()
+	if err != nil {
+		return nftables.TransactionReceipt{}, err
+	}
+	if size == 40 {
+		return nftables.TransactionReceipt{State: nftables.TransactionNotSent}, nil
+	}
+	if err = conn.Flush(); err != nil {
+		return nftables.TransactionReceipt{}, err
+	}
+	ns := w.r.namespaceLease.Identity()
+	receipt := nftables.TransactionReceipt{State: nftables.TransactionCommitted, Sent: true, Intent: nftables.TransactionIntent{Birth: w.r.ownership.birth.String(), Generation: w.snapshot.Generation, PortID: 42, NamespaceDevice: ns.Device, NamespaceInode: ns.Inode}}
+	batch := capture.batches[0]
+	w.batches = append(w.batches, batch)
+	var deleteHandles []uint64
+	for i, m := range batch {
+		intent := nftables.MessageIntent{Index: i, Header: m.Header}
+		intent.Header.Sequence = uint32(101 + i)
+		intent.Header.PID = 42
+		if i > 0 && i < len(batch)-1 {
+			intent.Family = parent.Family
+			intent.Table = parent.Name
+			attrs, e := netlink.UnmarshalAttributes(m.Data[4:])
+			if e != nil {
+				return receipt, e
+			}
+			for _, a := range attrs {
+				switch a.Type {
+				case unix.NFTA_RULE_CHAIN:
+					intent.Chain = strings.TrimRight(string(a.Data), "\x00")
+				case unix.NFTA_RULE_HANDLE:
+					intent.Handle = binary.BigEndian.Uint64(a.Data)
+				}
+			}
+			switch uint16(m.Header.Type) & 0xff {
+			case unix.NFT_MSG_NEWRULE:
+				w.nextHandle++
+				handle := make([]byte, 8)
+				binary.BigEndian.PutUint64(handle, w.nextHandle)
+				extra, _ := netlink.MarshalAttributes([]netlink.Attribute{{Type: unix.NFTA_RULE_HANDLE, Data: handle}})
+				echo := m
+				echo.Header = intent.Header
+				echo.Data = append(bytes.Clone(m.Data), extra...)
+				receipt.Replies = append(receipt.Replies, echo)
+			case unix.NFT_MSG_DELRULE:
+				deleteHandles = append(deleteHandles, intent.Handle)
+			default:
+				return receipt, errors.New("C fixture saw a non-rule shared mutation")
+			}
+		}
+		receipt.Intent.Messages = append(receipt.Intent.Messages, intent)
+	}
+	objects, err := receipt.ConfirmedObjects()
+	if err != nil {
+		return receipt, err
+	}
+	for _, handle := range deleteHandles {
+		for i, rule := range w.snapshot.Rules {
+			if rule.Handle == handle {
+				w.snapshot.Rules = append(w.snapshot.Rules[:i], w.snapshot.Rules[i+1:]...)
+				break
+			}
+		}
+	}
+	for _, rule := range objects.Rules {
+		rule.Table = w.snapshot.Tables[0]
+		rule.Chain = w.snapshot.Chains[0]
+		w.snapshot.Rules = append(w.snapshot.Rules, rule)
+	}
+	w.snapshot.Generation++
+	return receipt, nil
+}
