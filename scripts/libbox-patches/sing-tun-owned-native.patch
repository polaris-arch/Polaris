+		return errFW4Unresolved
+	}
+	for _, chain := range snapshot.Chains {
+		if chain.Table != nil && chain.Table.Name == "fw4" && chain.Table.Family == nftables.TableFamilyINet && (chain.Name == "input" || chain.Name == "forward") {
+			if chain.Handle == 0 || chains[chain.Name] != nil {
+				return errFW4Unresolved
+			}
+			chains[chain.Name] = chain
+		}
+	}
+	if len(chains) != 2 {
+		return errFW4Unresolved
+	}
+	for name, chain := range chains {
+		hook := nftables.ChainHookInput
+		if name == "forward" {
+			hook = nftables.ChainHookForward
+		}
+		if chain.Type != nftables.ChainTypeFilter || !dockerOptionalEqual(chain.Hooknum, hook) ||
+			!dockerOptionalEqual(chain.Priority, nftables.ChainPriorityFilter) || chain.Device != "" || chain.Policy == nil ||
+			(*chain.Policy != nftables.ChainPolicyAccept && *chain.Policy != nftables.ChainPolicyDrop) {
+			return errFW4Unresolved
+		}
+	}
+	seen := make(map[uint64]bool)
+	expected := make(map[string]bool)
+	for _, chain := range []string{"input", "forward"} {
+		for _, direction := range []string{"iifname", "oifname"} {
+			comment := fmt.Sprintf("!polaris-fw4:%s:1:%s:%s", f.birth, chain, direction)
+			expected[comment] = true
+		}
+	}
+	for _, rule := range owned {
+		comment, _ := userdata.GetString(rule.UserData, userdata.TypeComment)
+		if !expected[comment] || rule.Table == nil || rule.Table.Name != "fw4" || rule.Table.Family != nftables.TableFamilyINet || rule.Chain == nil {
+			return errFW4Unresolved
+		}
+		parts := strings.Split(comment, ":")
+		chain, direction := parts[len(parts)-2], parts[len(parts)-1]
+		key := expr.MetaKeyIIFNAME
+		if direction == "oifname" {
+			key = expr.MetaKeyOIFNAME
+		}
+		if rule.Handle == 0 || seen[rule.Handle] || rule.Chain.Name != chain || !fw4RuleMatches(rule, f.ifName, key, comment) {
+			return errFW4Unresolved
+		}
+		seen[rule.Handle] = true
+		delete(expected, comment)
+	}
+	if len(expected) != 0 {
+		return errFW4Unresolved
+	}
+	return nil
+}
+func fw4RuleMatches(rule *nftables.Rule, ifName string, key expr.MetaKey, comment string) bool {
+	// Position in a kernel dump is the current predecessor's handle, not a
+	// frozen insertion selector; fw4 rebuilds and A/B includes change it.
+	if rule == nil || rule.Flags != 0 || len(rule.Exprs) != 4 || !bytes.Equal(rule.UserData, userdata.AppendString(nil, userdata.TypeComment, comment)) {
+		return false
+	}
+	meta, ok := rule.Exprs[0].(*expr.Meta)
+	if !ok || meta.Key != key || meta.SourceRegister || meta.Register != 1 {
+		return false
+	}
+	cmp, ok := rule.Exprs[1].(*expr.Cmp)
+	if !ok || cmp.Op != expr.CmpOpEq || cmp.Register != 1 {
+		return false
+	}
+	// nft userspace may encode the terminating-NUL string or its zero-padded
+	// IFNAMSIZ representation. Both compare this exact interface, never a prefix.
+	short := append([]byte(ifName), 0)
+	if !bytes.Equal(cmp.Data, short) && !bytes.Equal(cmp.Data, nftablesIfname(ifName)) {
+		return false
+	}
+	if _, ok = rule.Exprs[2].(*expr.Counter); !ok {
+		return false
+	}
+	verdict, ok := rule.Exprs[3].(*expr.Verdict)
+	return ok && verdict.Kind == expr.VerdictAccept && verdict.Chain == ""
+}
