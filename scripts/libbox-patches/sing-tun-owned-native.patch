+func rNativeCanonicalJSON(data []byte) ([]byte, error) {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var value any
+	if err := decoder.Decode(&value); err != nil {
+		return nil, err
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return nil, errors.New("trailing JSON")
+	}
+	return json.Marshal(value)
+}
+func rNativeConfigDigest(data rNativeConfigData) (string, error) {
+	raw, err := json.Marshal(data)
+	if err != nil {
+		return "", err
+	}
+	canonical, err := rNativeCanonicalJSON(raw)
+	if err != nil {
+		return "", err
+	}
+	hash := sha256.Sum256(canonical)
+	return hex.EncodeToString(hash[:]), nil
+}
+func rNativeCaseIndex(c rNativeCase) int {
+	index := 0
+	for _, group := range rNativeClosedCases {
+		for _, sub := range group.sub {
+			if c.Top == group.top && c.Sub == sub {
+				return index
+			}
+			index++
+		}
+	}
+	return -1
+}
+func rNativeHex(value string, size int) bool {
+	if len(value) != size {
+		return false
+	}
+	for _, ch := range value {
+		if !(ch >= '0' && ch <= '9' || ch >= 'a' && ch <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+func rNativeValidateAssociation(a rNativeAssociation, c rNativeCase) error {
+	index := rNativeCaseIndex(c)
+	if a.Schema != "polaris-r-native-launch-metadata" || a.Version != 1 || a.Profile != "native-tun-rtnetlink-child-userns-v1" || a.CaseID != index {
+		return errors.New("G metadata schema/profile/case mismatch")
+	}
+	if index == 0 {
+		if a.Actor != "a" && a.Actor != "b" {
+			return errors.New("independent A/B actor missing")
+		}
+	} else if a.Actor != "single" {
+		return errors.New("extra actor")
+	}
+	for _, value := range []string{a.ProfileSHA256, a.SourceFilesSHA256, a.ModuleGraphSHA256, a.ELFSHA256, a.ConfigSHA256, a.PlanSHA256} {
+		if !rNativeHex(value, 64) {
+			return errors.New("metadata digest encoding invalid")
+		}
+	}
+	if !rNativeHex(a.SourceCommit, 40) || !rNativeHex(a.SourceTree, 40) || !rNativeHex(a.BatchNonce, 32) || !rNativeHex(a.CaseNonce, 32) {
+		return errors.New("metadata candidate/nonce encoding invalid")
+	}
+	expectedRoles := []rNativeFDRole{{3, "targetNetns"}, {4, "childUserns"}, {5, "privateMountns"}, {6, "privateProcDir"}, {7, "formalClaimsBaseDir"}, {8, "metadata"}}
+	if index == 17 {
+		expectedRoles = append(expectedRoles, rNativeFDRole{9, "providedPrivateTun"})
+	}
+	if index == 0 && a.Actor == "a" {
+		expectedRoles = append(expectedRoles, rNativeFDRole{10, "oneShotGToAReadPipe"})
+	}
+	if !slices.Equal(a.FDRoles, expectedRoles) || len(a.FDObservedIdentities) != len(expectedRoles) {
+		return errors.New("metadata FD graph mismatch")
+	}
+	for _, role := range expectedRoles {
+		identity, ok := a.FDObservedIdentities[role.Role]
+		if !ok || identity.Device == 0 || identity.Inode == 0 {
+			return errors.New("metadata observed FD identity absent")
+		}
+	}
+	if len(a.GuardianParentIdentities) != 5 {
+		return errors.New("guardian external identity closure mismatch")
+	}
+	for _, role := range []string{"netns", "userns", "mountns", "pidns", "ipcns"} {
+		id, ok := a.GuardianParentIdentities[role]
+		if !ok || id.Device == 0 || id.Inode == 0 {
+			return errors.New("guardian external identity missing")
+		}
+	}
+	if a.Budgets != (rNativeBudgets{15000, 1000, 262144, 8}) {
+		return errors.New("metadata budgets differ from fixed case")
+	}
+	constructor, updates := rNativePreparedConfig(c, a.Actor)
+	wantConstructor, err := json.Marshal(constructor)
+	if err != nil {
+		return err
+	}
+	wantConstructor, err = rNativeCanonicalJSON(wantConstructor)
+	if err != nil {
+		return err
+	}
+	actualConstructor, err := rNativeCanonicalJSON(a.CaseOptions.Constructor)
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(wantConstructor, actualConstructor) || len(a.CaseOptions.RouteUpdates) != len(updates) {
+		return errors.New("metadata full Options differ from actual builder")
+	}
+	for i, update := range updates {
+		want, err := json.Marshal(update)
+		if err != nil {
+			return err
+		}
+		want, err = rNativeCanonicalJSON(want)
+		if err != nil {
+			return err
+		}
+		actual, err := rNativeCanonicalJSON(a.CaseOptions.RouteUpdates[i])
+		if err != nil {
+			return err
+		}
+		if !bytes.Equal(want, actual) {
+			return errors.New("metadata full update Options differ from actual builder")
+		}
+	}
+	digest, err := rNativeConfigDigest(a.CaseOptions)
+	if err != nil || digest != a.ConfigSHA256 {
+		return errors.Join(errors.New("metadata actual config digest mismatch"), err)
+	}
+	return rNativeValidateTopology(a.Topology, index)
+}
+func rNativeValidateTopology(t rNativeTopology, index int) error {
+	if index >= 15 && index <= 17 {
+		if t.Persistent == nil {
+			return errors.New("persistent topology missing")
+		}
+		p := t.Persistent
+		wantName := fmt.Sprintf("rnt%02d", index)
+		wantDisposition := "closed_before_R_attach"
+		if index == 17 {
+			wantDisposition = "retained_on_FD9"
+		}
+		if p.Name != wantName || p.Kind != "tun" || p.LinkIndex <= 0 || p.MTU != 1500 || p.Up != (index == 17) || !slices.Equal(p.Addresses, []string{"198.18.0.1/24"}) || p.CreatorQueueDisposition != wantDisposition {
+			return errors.New("persistent topology mismatch")
+		}
+	} else if t.Persistent != nil {
+		return errors.New("unexpected persistent topology")
+	}
+	if index == 13 {
+		if t.ForeignLink == nil || t.ForeignLink.Name != "rnf0" || t.ForeignLink.Kind != "dummy" || t.ForeignLink.LinkIndex <= 0 || !slices.Equal(t.ForeignLink.Addresses, []string{"198.18.253.1/24", "fd00:729::1/64"}) {
+			return errors.New("foreign dummy topology mismatch")
+		}
+	} else if t.ForeignLink != nil {
+		return errors.New("extra foreign topology")
+	}
+	if index == 19 {
+		if t.Gateway == nil || *t.Gateway != (rNativeGateway{"198.18.0.2", "rnt19", "198.18.0.1/24", "actual_subject_connected_route_after_New"}) {
+			return errors.New("gateway topology mismatch")
+		}
+	} else if t.Gateway != nil {
+		return errors.New("extra gateway topology")
+	}
+	if index == 25 {
+		if t.IPv6Output == nil || t.IPv6Output.Policy != "actual_min_positive_minus_one" || len(t.IPv6Output.BeforePriorities) == 0 {
+			return errors.New("actual IPv6 priority observation absent")
+		}
+		minimum := 32766
+		for _, priority := range t.IPv6Output.BeforePriorities {
+			if priority < 0 {
+				return errors.New("invalid observed priority")
+			}
+			if priority > 0 && priority < minimum {
+				minimum = priority
+			}
+		}
+		if minimum <= 1 || t.IPv6Output.SelectedPriority != minimum-1 {
+			return errors.New("original IPv6 selection mismatch")
+		}
+	} else if t.IPv6Output != nil {
+		return errors.New("extra IPv6 priority topology")
+	}
+	if index == 17 {
+		if t.Provided == nil || t.Provided.FD != 9 || t.Provided.Name != "rnt17" || t.Provided.NamespaceObservation != "getdevnetns_supported" && t.Provided.NamespaceObservation != "explicit_fd_io_only" {
+			return errors.New("provided FD scope mismatch")
+		}
+	} else if t.Provided != nil {
+		return errors.New("extra provided FD")
+	}
+	if index == 0 {
+		if t.Actors == nil || *t.Actors != (rNativeActors{"rnt00", "rnt00b", 40000, 40100, 12000, "B_NEW_REFUSED\n", true}) {
+			return errors.New("A/B source/control topology mismatch")
+		}
+	} else if t.Actors != nil {
+		return errors.New("extra actor topology")
+	}
+	rp := rNativeRPFilter{}
+	if index == 16 {
+		rp = rNativeRPFilter{0, 0, 1, 2, 1, "/proc/sys/net/ipv4/conf/rnt16/rp_filter"}
+	}
+	if t.RPFilter != rp {
+		return errors.New("rp_filter branch mismatch")
+	}
+	return nil
+}
