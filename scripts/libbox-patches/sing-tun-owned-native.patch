+func rNativeBorrowed(c rNativeCase, in *rNativeLauncherInputs, o Options, deadline time.Time) error {
+	lease, err := newNetworkNamespaceLease(o.NetNs)
+	if err != nil {
+		return err
+	}
+	defer lease.Close()
+	api, err := openRouteNetlink(lease)
+	if err != nil {
+		return err
+	}
+	defer api.Close()
+	actual := api.(*realRouteNetlink)
+	beforeLink, err := api.LinkByIndex(in.PersistentLink.Attrs().Index)
+	if err != nil {
+		return err
+	}
+	beforeMTU, beforeUp := beforeLink.Attrs().MTU, beforeLink.Attrs().Flags&net.FlagUp != 0
+	beforeAddr, err := actual.Handle.AddrList(beforeLink, netlink.FAMILY_ALL)
+	if err != nil {
+		return err
+	}
+	if len(beforeAddr) == 0 {
+		return errors.New("actual persistent external address prerequisite absent")
+	}
+	persistent := in.Association.Topology.Persistent
+	if beforeLink.Attrs().Name != persistent.Name || beforeLink.Type() != persistent.Kind || beforeMTU != persistent.MTU || beforeUp != persistent.Up || !slices.Equal(rNativeAddressStrings(beforeAddr), persistent.Addresses) {
+		return errors.New("actual persistent before snapshot differs from G topology")
+	}
+	if err := rNativeEmit(c, in, "actual_persistent_before", struct {
+		Link                    netlink.LinkAttrs `json:"link"`
+		Addresses               []netlink.Addr    `json:"addresses"`
+		CreatorQueueDisposition string            `json:"creatorQueueDisposition"`
+	}{*beforeLink.Attrs(), beforeAddr, persistent.CreatorQueueDisposition}); err != nil {
+		return err
+	}
+	if c.Sub == "provided_fd_duplicate_only_close" {
+		o.FileDescriptor = int(in.ProvidedTun.Fd())
+	}
+	d, err := rNativeNew(o, in, nil, nil)
+	if err != nil {
+		return err
+	}
+	if !d.nativeOwnership.borrowed {
+		return errors.New("persistent/provided device was promoted to newly created")
+	}
+	if c.Sub == "provided_fd_duplicate_only_close" {
+		wantKnown := in.Association.Topology.Provided.NamespaceObservation == "getdevnetns_supported"
+		if d.nativeOwnership.fdNamespaceKnown != wantKnown {
+			return errors.New("actual provided FD namespace support differs from G observation")
+		}
+		if d.tunFd == int(in.ProvidedTun.Fd()) {
+			return errors.New("provided original FD was not duplicated")
+		}
+		flags, err := unix.FcntlInt(uintptr(d.tunFd), unix.F_GETFD, 0)
+		if err != nil || flags&unix.FD_CLOEXEC == 0 {
+			return errors.Join(errors.New("provided duplicate CLOEXEC missing"), err)
+		}
+		identity, err := d.ownedFDIdentity()
+		if err != nil || identity.name != o.Name || identity.flags&unix.IFF_TUN == 0 {
+			return errors.Join(errors.New("actual duplicate TUNGETIFF mismatch"), err)
+		}
+		if err := d.Close(); err != nil {
+			return err
+		}
+		// This invokes the original producer FD's actual I/O after tested Close;
+		// G must have supplied the finite endpoint route and private address.
+		if err := rNativeUDP(in.ProvidedTun, in.ProvidedTun, c, in, false, deadline); err != nil {
+			return err
+		}
+	} else {
+		if err := d.Start(); err != nil {
+			return err
+		}
+		if c.Sub == "borrowed_mtu_up_restored" {
+			if err := rNativeRPValue(in.RPFilter, "2"); err != nil {
+				return err
+			}
+			if err := rNativeEmit(c, in, "actual_rp_filter_start", 2); err != nil {
+				return err
+			}
+		}
+		if err := d.Close(); err != nil {
+			return err
+		}
+		if c.Sub == "borrowed_mtu_up_restored" {
+			if err := rNativeRPValue(in.RPFilter, "1"); err != nil {
+				return err
+			}
+			if err := rNativeEmit(c, in, "actual_rp_filter_close", 1); err != nil {
+				return err
+			}
+		}
+	}
+	afterLink, err := api.LinkByIndex(beforeLink.Attrs().Index)
+	if err != nil {
+		return err
+	}
+	afterAddr, err := actual.Handle.AddrList(afterLink, netlink.FAMILY_ALL)
+	if err != nil {
+		return err
+	}
+	if afterLink.Attrs().MTU != beforeMTU || (afterLink.Attrs().Flags&net.FlagUp != 0) != beforeUp || !reflect.DeepEqual(beforeAddr, afterAddr) {
+		return errors.New("borrowed MTU/up/external address snapshot changed")
+	}
+	return rNativeEmit(c, in, "actual_borrowed_snapshot_preserved", struct {
+		MTU              int
+		Up               bool
+		Addresses        []netlink.Addr
+		FDNamespaceKnown bool
+	}{beforeMTU, beforeUp, beforeAddr, d.nativeOwnership.fdNamespaceKnown})
+}
+
+func rNativeAddressStrings(addresses []netlink.Addr) []string {
+	result := make([]string, 0, len(addresses))
+	for _, address := range addresses {
+		if address.IPNet != nil {
+			result = append(result, address.IPNet.String())
+		}
+	}
+	slices.Sort(result)
+	return result
+}
