+type ownershipPhysicalKey struct {
+	domain redirectResourceDomain
+	key    string
+}
+type ownershipFakeWorld struct {
+	access    sync.Mutex
+	resources map[ownershipPhysicalKey]redirectBirth
+	acquired  []redirectResourceID
+	released  []redirectResourceID
+}
+
+func newOwnershipFakeWorld() *ownershipFakeWorld {
+	return &ownershipFakeWorld{resources: make(map[ownershipPhysicalKey]redirectBirth)}
+}
+func (w *ownershipFakeWorld) snapshot(birth redirectBirth) map[ownershipPhysicalKey]redirectBirth {
+	w.access.Lock()
+	defer w.access.Unlock()
+	result := make(map[ownershipPhysicalKey]redirectBirth)
+	for key, owner := range w.resources {
+		if owner == birth {
+			result[key] = owner
+		}
+	}
+	return result
+}
+func (w *ownershipFakeWorld) releases(birth redirectBirth) []redirectResourceID {
+	w.access.Lock()
+	defer w.access.Unlock()
+	return slices.DeleteFunc(slices.Clone(w.released), func(id redirectResourceID) bool { return id.birth != birth })
+}
+func (w *ownershipFakeWorld) assertPreserved(t *testing.T, birth redirectBirth, before map[ownershipPhysicalKey]redirectBirth) {
+	t.Helper()
+	if after := w.snapshot(birth); !reflect.DeepEqual(before, after) {
+		t.Fatalf("A changed: before=%v after=%v", before, after)
+	}
+	if released := w.releases(birth); len(released) != 0 {
+		t.Fatalf("deleted A: %v", released)
+	}
+}
+
+type ownershipFakeOps struct {
+	world         *ownershipFakeWorld
+	acquireMode   string
+	releaseMode   string
+	beforeAcquire func(redirectResourceID)
+	beforeRelease func(redirectResourceID)
+}
+
+func (f *ownershipFakeOps) Acquire(id redirectResourceID) redirectAcquireResult {
+	if f.beforeAcquire != nil {
+		f.beforeAcquire(id)
+	}
+	f.world.access.Lock()
+	f.world.acquired = append(f.world.acquired, id)
+	f.world.access.Unlock()
+	if f.acquireMode == "before" {
+		return redirectAcquireResult{redirectAcquireNotCommitted, ownershipTestFailure}
+	}
+	if f.acquireMode == "panic-before" {
+		panic("before acquisition")
+	}
+	key := ownershipPhysicalKey{id.domain, id.key}
+	f.world.access.Lock()
+	if _, exists := f.world.resources[key]; exists {
+		f.world.access.Unlock()
+		return redirectAcquireResult{redirectAcquireNotCommitted, syscall.EEXIST}
+	}
+	f.world.resources[key] = id.birth
+	f.world.access.Unlock()
+	switch f.acquireMode {
+	case "lost-ack":
+		return redirectAcquireResult{err: ownershipTestFailure}
+	case "panic-after":
+		panic("after acquisition")
+	case "invalid-zero":
+		return redirectAcquireResult{}
+	case "invalid-created-error":
+		return redirectAcquireResult{redirectAcquireCreated, ownershipTestFailure}
+	case "invalid-not-committed":
+		return redirectAcquireResult{status: redirectAcquireNotCommitted}
+	case "invalid-enum":
+		return redirectAcquireResult{status: 255}
+	}
+	return redirectAcquireResult{status: redirectAcquireCreated}
+}
+func (f *ownershipFakeOps) Release(id redirectResourceID) error {
+	if f.beforeRelease != nil {
+		f.beforeRelease(id)
+	}
+	f.world.access.Lock()
+	f.world.released = append(f.world.released, id)
+	f.world.access.Unlock()
+	if f.releaseMode == "error" {
+		return ownershipTestFailure
+	}
+	if f.releaseMode == "panic-before" {
+		panic("before release")
+	}
+	key := ownershipPhysicalKey{id.domain, id.key}
+	f.world.access.Lock()
+	if owner, exists := f.world.resources[key]; !exists || owner != id.birth {
+		f.world.access.Unlock()
+		return errors.New("fake forbids deletion of an unowned resource")
+	}
+	delete(f.world.resources, key)
+	f.world.access.Unlock()
+	if f.releaseMode == "panic-after" {
+		panic("after release")
+	}
+	return nil
+}
+
+func ownershipEntries(o *redirectOwnership) []redirectResource {
+	o.access.Lock()
+	defer o.access.Unlock()
+	result := make([]redirectResource, len(o.resources))
+	for i, entry := range o.resources {
+		result[i] = *entry
+	}
+	return result
+}
+func ownershipAwait[T any](t *testing.T, channel <-chan T) T {
+	t.Helper()
+	select {
+	case value := <-channel:
+		return value
+	case <-time.After(3 * time.Second):
+		t.Fatal("ownership operation did not complete")
+		var zero T
+		return zero
+	}
+}
+func ownershipWaitClosing(t *testing.T, o *redirectOwnership) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() {
+		o.access.Lock()
+		for !o.closing {
+			o.drain.Wait()
+		}
+		o.access.Unlock()
+		close(done)
+	}()
+	ownershipAwait(t, done)
+}
+func ownershipAssertWaiting(t *testing.T, result <-chan error) {
+	t.Helper()
+	select {
+	case err := <-result:
+		t.Fatalf("Close completed before drain: %v", err)
+	default:
+	}
+}
