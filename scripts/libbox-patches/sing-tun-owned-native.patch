+		return errors.New("missing held launcher inputs")
+	}
+	if inputs.Association == nil {
+		if err := rNativeVerifyAssociation(inputs, c); err != nil {
+			return err
+		}
+	}
+	if err := rNativeEmit(c, inputs, "pending", nil); err != nil {
+		return err
+	}
+	if err := rNativeVerifyAssociation(inputs, c); err != nil {
+		return err
+	}
+	if inputs == nil || len(inputs.Nonce) != 32 {
+		return errors.New("missing G case inputs/nonce")
+	}
+	for _, ch := range inputs.Nonce {
+		if !(ch >= '0' && ch <= '9' || ch >= 'a' && ch <= 'f') {
+			return errors.New("noncanonical nonce")
+		}
+	}
+	if err := rNativeCheckNamespace(inputs.ChildUserns, inputs.UserIdentity, unix.CLONE_NEWUSER, nil); err != nil {
+		return err
+	}
+	if err := rNativeCheckNamespace(inputs.Netns, inputs.NetIdentity, unix.CLONE_NEWNET, inputs.ChildUserns); err != nil {
+		return err
+	}
+	if err := rNativeCheckNamespace(inputs.Mountns, inputs.MountIdentity, unix.CLONE_NEWNS, inputs.ChildUserns); err != nil {
+		return err
+	}
+	if inputs.GuardianParentNet.Inode == 0 || inputs.GuardianParentMount.Inode == 0 || inputs.NetIdentity == inputs.GuardianParentNet || inputs.MountIdentity == inputs.GuardianParentMount || inputs.UserIdentity == inputs.Association.GuardianParentIdentities["userns"].native() {
+		return errors.New("guardian association lacks private namespace separation")
+	}
+	if inputs.Proc == nil || inputs.ClaimsBase == nil {
+		return errors.New("private proc/claims FD missing")
+	}
+	var fs unix.Statfs_t
+	if err := unix.Fstatfs(int(inputs.Proc.Fd()), &fs); err != nil || fs.Type != unix.PROC_SUPER_MAGIC {
+		return errors.Join(errors.New("private proc FD is not procfs"), err)
+	}
+	var heldProc, pathProc unix.Stat_t
+	if err := unix.Fstat(int(inputs.Proc.Fd()), &heldProc); err != nil {
+		return err
+	}
+	if err := unix.Stat("/proc", &pathProc); err != nil {
+		return err
+	}
+	if heldProc.Dev != pathProc.Dev || heldProc.Ino != pathProc.Ino {
+		return errors.New("production /proc path differs from held private proc")
+	}
+	statusFD, err := unix.Openat(int(inputs.Proc.Fd()), "self/status", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	statusFile := os.NewFile(uintptr(statusFD), "actual private process status")
+	status, readErr := io.ReadAll(io.LimitReader(statusFile, 32769))
+	closeErr := statusFile.Close()
+	if readErr != nil || closeErr != nil || len(status) > 32768 {
+		return errors.Join(errors.New("actual capabilities observation failed"), readErr, closeErr)
+	}
+	var capEff uint64
+	foundCaps := false
+	for _, line := range strings.Split(string(status), "\n") {
+		if strings.HasPrefix(line, "CapEff:") {
+			capEff, err = strconv.ParseUint(strings.TrimSpace(strings.TrimPrefix(line, "CapEff:")), 16, 64)
+			if err != nil {
+				return err
+			}
+			foundCaps = true
+		}
+	}
+	allowed := uint64(1)<<unix.CAP_NET_ADMIN | uint64(1)<<unix.CAP_NET_RAW | uint64(1)<<unix.CAP_SYS_ADMIN
+	if !foundCaps || capEff&(uint64(1)<<unix.CAP_NET_ADMIN) == 0 || capEff&^allowed != 0 {
+		return errors.New("actual child capability set outside finite R profile")
+	}
+	for _, item := range []struct {
+		path string
+		want networkNamespaceIdentity
+		kind int
+	}{{"thread-self/ns/net", inputs.NetIdentity, unix.CLONE_NEWNET}, {"thread-self/ns/mnt", inputs.MountIdentity, unix.CLONE_NEWNS}, {"thread-self/ns/user", inputs.UserIdentity, unix.CLONE_NEWUSER}} {
+		fd, err := unix.Openat(int(inputs.Proc.Fd()), item.path, unix.O_RDONLY|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return err
+		}
+		file := os.NewFile(uintptr(fd), item.path)
+		err = rNativeCheckNamespace(file, item.want, item.kind, nil)
+		closeErr := file.Close()
+		if err != nil || closeErr != nil {
+			return errors.Join(err, closeErr)
+		}
+	}
+	// PID/IPC comparisons use only actual private proc observations. The parent
+	// values remain external guardian associations, never held parent FDs.
+	for _, item := range []struct {
+		path, parent string
+		kind         int
+	}{{"thread-self/ns/pid", "pidns", unix.CLONE_NEWPID}, {"thread-self/ns/ipc", "ipcns", unix.CLONE_NEWIPC}} {
+		fd, err := unix.Openat(int(inputs.Proc.Fd()), item.path, unix.O_RDONLY|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return err
+		}
+		file := os.NewFile(uintptr(fd), item.path)
+		identity, identityErr := rNativeFDIdentity(file)
+		if identityErr == nil && identity == inputs.Association.GuardianParentIdentities[item.parent].native() {
+			identityErr = errors.New("private PID/IPC namespace equals external parent association")
+		}
+		if identityErr == nil {
+			identityErr = rNativeCheckNamespace(file, identity, item.kind, inputs.ChildUserns)
+		}
+		if err := errors.Join(identityErr, file.Close()); err != nil {
+			return err
+		}
+	}
+	// Only case16 has the precisely admitted private leaf write branch.
+	for _, name := range []string{"all", "default"} {
+		fd, err := unix.Openat(int(inputs.Proc.Fd()), "sys/net/ipv4/conf/"+name+"/rp_filter", unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return err
+		}
+		file := os.NewFile(uintptr(fd), "rp_filter")
+		content, readErr := io.ReadAll(io.LimitReader(file, 16))
+		closeErr := file.Close()
+		if readErr != nil || closeErr != nil || strings.TrimSpace(string(content)) != "0" {
+			return errors.Join(errors.New("G private rp_filter no-write baseline unavailable"), readErr, closeErr)
+		}
+	}
+	if c.Sub == "borrowed_mtu_up_restored" {
+		if c.Options.Name != "rnt16" {
+			return errors.New("rp_filter write branch name mismatch")
+		}
+		fd, err := unix.Openat(int(inputs.Proc.Fd()), "sys/net/ipv4/conf/rnt16/rp_filter", unix.O_RDWR|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if err != nil {
+			return err
+		}
+		file := os.NewFile(uintptr(fd), "rnt16 original private rp_filter")
+		if err := rNativeRPValue(file, "1"); err != nil {
+			file.Close()
+			return err
+		}
+		inputs.RPFilter = file
+	}
+	store, err := openRedirectClaimStore(redirectClaimDirectory)
+	if err != nil {
+		return err
+	}
+	retainProbe := false
+	defer func() {
+		if !retainProbe {
+			store.close()
+		}
+	}()
+	actual, err := rNativeFDIdentity(store.base())
+	if err != nil {
+		return err
+	}
+	expected, err := rNativeFDIdentity(inputs.ClaimsBase)
+	if err != nil || actual != expected {
+		return errors.Join(errors.New("formal claims base differs from held G input"), err)
+	}
+	if err := store.validate(); err != nil {
+		return err
+	}
+	// Test actual UID write rights with a bounded EXCL private probe, never an L
+	// resource-name algorithm. Exact inode verification precedes its unlink.
+	probeName := ".r-native-probe-" + inputs.Nonce
+	fd, err := unix.Openat(int(store.base().Fd()), probeName, unix.O_RDWR|unix.O_CREAT|unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0600)
+	if err != nil {
+		return err
+	}
+	probe := os.NewFile(uintptr(fd), "original private claims write probe")
+	var held, linked unix.Stat_t
+	err = unix.Fstat(fd, &held)
+	if err == nil {
+		err = unix.Fstatat(int(store.base().Fd()), probeName, &linked, unix.AT_SYMLINK_NOFOLLOW)
+	}
+	if err == nil && (held.Dev != linked.Dev || held.Ino != linked.Ino || held.Nlink != 1 || held.Uid != uint32(os.Geteuid()) || held.Mode&07777 != 0600) {
+		err = errors.New("write probe inode/owner mismatch; original custody retained")
+	}
+	if err == nil {
+		err = unix.Unlinkat(int(store.base().Fd()), probeName, 0)
+	}
+	if err != nil {
+		// This single-case process keeps the original FD/store, including on a
+		// substituted entry or failed unlink. Only G disposes its private domain.
+		retainProbe = true
+		rNativeProbeCustody = &rNativeHeldProbe{store, probe, probeName}
+		return err
+	}
+	if err := probe.Close(); err != nil {
+		return err
+	}
+	if controlPath != "/dev/net/tun" {
+		return errors.New("actual production TUN control path outside finite R profile")
+	}
+	fd, err = unix.Open("/dev/net/tun", unix.O_RDWR|unix.O_NONBLOCK|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	var stat unix.Stat_t
+	err = unix.Fstat(fd, &stat)
+	if err == nil && (stat.Mode&unix.S_IFMT != unix.S_IFCHR || unix.Major(stat.Rdev) != 10 || unix.Minor(stat.Rdev) != 200) {
+		err = errors.New("G mapped device is not /dev/net/tun")
+	}
+	return errors.Join(err, unix.Close(fd))
+}
