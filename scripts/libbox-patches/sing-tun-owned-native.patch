+// Actor source uses the original public callee and preserves returned errors.
+// No actor method replaces the coordinator, N transport, C seams or fw4 Cmd.
+type cNativePublicActor struct {
+	admission cNativeAdmission
+	identity  cNativeIdentity
+	options   AutoRedirectOptions
