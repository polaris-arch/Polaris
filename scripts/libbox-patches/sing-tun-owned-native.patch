+func (c *nftBuilderCapture) dial(sent []netlink.Message) ([]netlink.Message, error) {
+	if len(sent) != 0 {
+		if c.failure != nil {
+			return nil, c.failure
+		}
+		copyMessages := append([]netlink.Message(nil), sent...)
+		for i := range copyMessages {
+			copyMessages[i].Data = append([]byte(nil), sent[i].Data...)
+		}
+		c.batches = append(c.batches, copyMessages)
+		for _, m := range sent {
+			if m.Header.Type == unix.NFNL_MSG_BATCH_BEGIN || m.Header.Type == unix.NFNL_MSG_BATCH_END {
+				continue
+			}
+			c.replies = append(c.replies, netlink.Message{Header: netlink.Header{Type: netlink.Error, Sequence: m.Header.Sequence, PID: m.Header.PID}, Data: make([]byte, 4)})
+		}
+	}
+	if len(c.replies) == 0 {
+		return nil, io.EOF
+	}
+	reply := c.replies[0]
+	c.replies = c.replies[1:]
+	return []netlink.Message{reply}, nil
+}
+func TestActualNFTBuilderRetainsCompleteGrammar(t *testing.T) {
+	capture := &nftBuilderCapture{}
