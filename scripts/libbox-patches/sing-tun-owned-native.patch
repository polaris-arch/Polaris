+// Metadata supplies the expected association. These comparisons consume an
+// independent real handle before subject New; it supplies no fixture mutations.
+func rNativeVerifyTopologyBeforeNew(in *rNativeLauncherInputs, c rNativeCase, o Options, deadline time.Time) error {
+	topology := in.Association.Topology
+	if topology.ForeignLink == nil && topology.IPv6Output == nil {
+		return nil
+	}
+	lease, err := newNetworkNamespaceLease(o.NetNs)
+	if err != nil {
+		return err
+	}
+	defer lease.Close()
+	api, err := openRouteNetlink(lease)
+	if err != nil {
+		return err
+	}
+	defer api.Close()
+	if foreign := topology.ForeignLink; foreign != nil {
+		link, err := api.LinkByIndex(foreign.LinkIndex)
+		if err != nil {
+			return err
+		}
+		addresses, err := api.(*realRouteNetlink).Handle.AddrList(link, netlink.FAMILY_ALL)
+		if err != nil {
+			return err
+		}
+		want := slices.Clone(foreign.Addresses)
+		slices.Sort(want)
+		if link.Attrs().Name != foreign.Name || link.Type() != foreign.Kind || !slices.Equal(rNativeAddressStrings(addresses), want) {
+			return errors.New("actual foreign dummy link/address mismatch")
+		}
+		if err := rNativeEmit(c, in, "actual_foreign_before", struct {
+			Link      netlink.LinkAttrs `json:"link"`
+			Addresses []netlink.Addr    `json:"addresses"`
+		}{*link.Attrs(), addresses}); err != nil {
+			return err
+		}
+	}
+	if output := topology.IPv6Output; output != nil {
+		rules, err := api.RuleList(unix.AF_INET6)
+		if err != nil {
+			return err
+		}
+		priorities := make([]int, 0, len(rules))
+		for _, rule := range rules {
+			priorities = append(priorities, rule.Priority)
+		}
+		want := slices.Clone(output.BeforePriorities)
+		slices.Sort(want)
+		slices.Sort(priorities)
+		if !slices.Equal(priorities, want) {
+			return errors.New("actual before IPv6 priorities differ from G capture")
+		}
+		dump, err := rNativeObserveDump(unix.RTM_GETRULE, unix.AF_INET6, minTime(deadline, time.Now().Add(time.Second)))
+		if err != nil {
+			return err
+		}
+		return rNativeEmit(c, in, "actual_ipv6_priority_before", struct {
+			Priorities []int          `json:"priorities"`
+			Selected   int            `json:"selectedPriority"`
+			Raw        rNativeRawDump `json:"raw"`
+		}{priorities, output.SelectedPriority, dump})
+	}
+	return nil
+}
