+func runtimeUDPPacket() nfqueue.Attribute {
+	payload := make([]byte, 28)
+	payload[0], payload[9] = 0x45, 17
+	binary.BigEndian.PutUint16(payload[2:4], uint16(len(payload)))
+	copy(payload[12:16], []byte{10, 0, 0, 1})
+	copy(payload[16:20], []byte{10, 0, 0, 2})
+	binary.BigEndian.PutUint16(payload[20:22], 1234)
+	binary.BigEndian.PutUint16(payload[22:24], 5678)
+	binary.BigEndian.PutUint16(payload[24:26], 8)
+	packetID := uint32(1)
+	return nfqueue.Attribute{PacketID: &packetID, Payload: &payload}
+}
