+func (w *cDockerIO) read(family nftables.TableFamily) (*nftables.ConsistentSnapshot, error) {
+	w.access.Lock()
+	defer w.access.Unlock()
+	if family == nftables.TableFamilyINet {
+		return &nftables.ConsistentSnapshot{Generation: w.snapshot.Generation}, nil
+	}
+	copySnapshot := *w.snapshot
+	copySnapshot.Tables = append([]*nftables.Table(nil), w.snapshot.Tables...)
+	copySnapshot.Chains = append([]*nftables.Chain(nil), w.snapshot.Chains...)
+	copySnapshot.Rules = append([]*nftables.Rule(nil), w.snapshot.Rules...)
+	select {
+	case w.reads <- struct{}{}:
+	default:
+	}
+	return &copySnapshot, nil
+}
