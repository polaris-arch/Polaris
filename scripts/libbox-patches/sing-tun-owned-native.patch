+func cFW4Snapshot(f *redirectFW4Runtime) *nftables.ConsistentSnapshot {
+	table := &nftables.Table{Name: "fw4", Family: nftables.TableFamilyINet, Handle: 101}
+	s := &nftables.ConsistentSnapshot{Generation: 8, Tables: []*nftables.Table{table}}
+	for index, chainName := range []string{"input", "forward"} {
+		policy := nftables.ChainPolicyAccept
+		hook := nftables.ChainHookInput
+		if chainName == "forward" {
+			hook = nftables.ChainHookForward
+		}
+		chain := &nftables.Chain{Name: chainName, Table: table, Handle: uint64(201 + index), Type: nftables.ChainTypeFilter, Hooknum: hook, Priority: nftables.ChainPriorityFilter, Policy: &policy}
+		s.Chains = append(s.Chains, chain)
+		for direction, key := range map[string]expr.MetaKey{"iifname": expr.MetaKeyIIFNAME, "oifname": expr.MetaKeyOIFNAME} {
+			comment := fmt.Sprintf("!polaris-fw4:%s:1:%s:%s", f.birth, chainName, direction)
+			rule := nftablesDockerCompatibilityRule(table, chain, f.ifName, key, comment)
+			rule.Handle = uint64(301 + len(s.Rules))
+			s.Rules = append(s.Rules, rule)
+		}
+	}
+	return s
+}
