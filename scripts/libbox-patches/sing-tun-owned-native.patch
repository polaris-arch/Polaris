+				bridge := &ownershipNFTIPConstBridge{queue: queue, set: set, descriptor: descriptor}
+				provided := *descriptor
+				elements := []nftables.SetElement{{Key: []byte{192, 0, 2, 1}}, {Key: []byte{192, 0, 2, 1}}, {Key: []byte{192, 0, 2, 2}}}
+				switch mode {
+				case "anonymous":
+					provided.ID, provided.Anonymous = 0, true
+				case "interval":
+					provided.Interval = true
+				case "dynamic":
+					provided.Dynamic = true
+				case "element-metadata":
+					elements[0].IntervalEnd = true
+				}
+				var addErr error
+				if mode == "anonymous" {
+					_, addErr = nftablesCreateIPConst(bridge, descriptor.Table, 0, descriptor.Name, nftables.TableFamilyIPv4, []netip.Addr{netip.MustParseAddr("192.0.2.1")})
+				} else {
+					addErr = bridge.AddSet(&provided, elements)
+				}
+				if err := addErr; err != nil {
+					if queue.Flush() != err {
+						t.Fatal("invalid AddSet flushed prior table")
+					}
+					return err
+				}
+				elements[0].Key[0] = 10 // queue holds immutable typed bytes
+				return bridge.Flush()
+			}}
+			err := r.Start()
+			if mode == "positive" {
+				if err != nil || len(ops.batches) != 1 || len(ops.batches[0].members) != 4 {
