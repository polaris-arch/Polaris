+func cNativeFW4PureReceipt(index int) cNativeReceipt {
+	c := cNativeFW4Cases[index]
+	a := cNativePureAdmission(c)
+	sha := fmt.Sprintf("%064x", 1)
+	f := &cNativeFW4Evidence{LockRawSHA: sha, FileRawSHA: sha, WaitRawSHA: sha, SemanticRawSHA: sha, FileCreated: true, IncludeOriginal: fw4FileIdentity{Inode: 1}, OriginalContentSHA: sha, SemanticGeneration: 3, ExactSemanticRules: 8, SemanticRulesByRole: map[string]int{"A": 4, "B": 4}}
+	f.Journal = fw4Journal{Protocol: fw4Protocol, Birth: fmt.Sprintf("%032x", 101), Phase: "committed", ScriptSHA256: fw4ScriptSHA, LayoutSHA256: fw4LayoutSHA, FileCreated: true, File: f.IncludeOriginal, IncludeSHA256: sha}
+	f.Commands = []fw4CommandFact{{Revision: 1, Started: true, Waited: true, PID: 301, Exit: 0, StartedUnix: int64(50 * time.Second), WaitedUnix: int64(51 * time.Second), OutputSHA256: sha}}
+	switch index {
+	case 2, 3:
+		f.RefusalStage = "lockCoordinator"
+		f.CoordinatorErrno = int(unix.EWOULDBLOCK)
+		f.HolderAlive = true
+		f.HolderPhase = "pending"
+		if index == 3 {
+			f.HolderPhase = "unknown"
+		}
+	case 4:
+		f.RefusalStage = "checkOtherJournals"
+		f.CheckOtherJournalsReached = true
+		f.HolderActualWait = true
+	case 10, 11:
+		f.Journal.Phase = "unknown"
+		f.ActivationRole = "B"
+		f.ActivationBirth = f.Journal.Birth
+		f.ActivationRevision = 1
+		f.OriginalPID = 302
+		f.AncestorPID = a.Actors["B"].PID
+		f.PreselectionUnix = int64(99 * time.Second)
+		f.PIDObservedUnix = int64(101 * time.Second)
+		f.ActivationUnix = int64(102 * time.Second)
+		f.PublicReturnUnix = int64(141 * time.Second)
+		command := fw4CommandFact{Revision: 1, Started: true, Waited: true, CallerTimeout: true, PID: 302, Exit: 0, StartedUnix: int64(100 * time.Second), WaitedUnix: int64(140 * time.Second), OutputSHA256: sha}
+		if index == 10 {
+			f.Commands = []fw4CommandFact{command}
+		} else {
+			command.Revision = 2
+			f.Commands = append(f.Commands, command)
+			f.ActivationRevision = 2
+			f.FileUnlinked = true
+			f.Journal.FileUnlinked = true
+		}
+	case 12:
+		f.Journal.Phase = "unknown"
+		f.FileUnlinked = true
+		f.Journal.FileUnlinked = true
+		f.ReplacementPreserved = true
+		f.Commands = append(f.Commands, fw4CommandFact{Revision: 2, Started: true, Waited: true, PID: 302, Exit: 1, Error: "synthetic parser error", StartedUnix: int64(100 * time.Second), WaitedUnix: int64(101 * time.Second), OutputSHA256: sha})
+	}
+	f.Journal.Commands = slices.Clone(f.Commands)
+	return cNativeReceipt{Case: c, Admission: a, Windows: []cNativeWindow{{Name: "FW4_evidence", FW4: f}}}
+}
