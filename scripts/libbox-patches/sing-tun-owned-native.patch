+func rNativeForeignAfterStart(c rNativeCase, in *rNativeLauncherInputs, d *NativeTun, api routeNetlink, deadline time.Time) error {
+	if len(d.nativeOwnership.routes.entries) == 0 {
+		return errors.New("owned route prerequisite absent")
+	}
+	original := cloneRoute(d.nativeOwnership.routes.entries[0].spec)
+	if c.Sub == "absent_owned_unknown" {
+		if err := api.RouteDel(&original); err != nil {
+			return err
+		}
+		err := d.Close()
+		if !errors.Is(err, errRedirectAmbiguous) {
+			return fmt.Errorf("absence did not retain original custody: %v", err)
+		}
+		return rNativeEmit(c, in, "expected_unknown_retained_no_retry", err.Error())
+	}
+	foreign := cloneRoute(original)
+	foreign.Priority += 7
+	switch c.Sub {
+	case "wrong_family_preserved":
+		foreign.Family = unix.AF_INET6
+		foreign.Dst = prefixToIPNet(netip.MustParsePrefix("fd00:728::/64"))
+		foreign.Gw = nil
+	case "wrong_gateway_preserved":
+		foreign.Gw = net.ParseIP("198.18.0.2")
+		foreign.Flags |= unix.RTNH_F_ONLINK
+	case "wrong_link_preserved":
+		foreign.LinkIndex = in.ForeignLink.Attrs().Index
+		foreign.Gw = nil
+	}
+	if err := api.RouteAdd(&foreign); err != nil {
+		return err
+	}
+	if err := d.Close(); err != nil {
+		return err
+	}
+	if err := validateOwnedRouteForDelete(api, foreign); err != nil {
+		return err
+	}
+	if err := rNativeEmit(c, in, "foreign_full_spec_preserved_after_close", foreign); err != nil {
+		return err
+	}
+	// Retire only the fixture's original successful EXCL acquisition, never a
+	// table scan or any unknown R ledger. This is distinct from tested Close.
+	return api.RouteDel(&foreign)
+}
