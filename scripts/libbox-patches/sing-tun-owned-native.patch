+func rNativeFDIdentity(file *os.File) (networkNamespaceIdentity, error) {
+	if file == nil {
+		return networkNamespaceIdentity{}, errors.New("missing held FD")
+	}
+	var stat unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &stat); err != nil {
+		return networkNamespaceIdentity{}, err
+	}
+	return networkNamespaceIdentity{uint64(stat.Dev), stat.Ino}, nil
+}
+
+func rNativeCheckNamespace(file *os.File, want networkNamespaceIdentity, kind int, user *os.File) error {
+	identity, err := rNativeFDIdentity(file)
+	if err != nil {
+		return err
+	}
+	if want.Inode == 0 || identity != want {
+		return errors.New("namespace FD identity mismatch")
+	}
+	actualKind, err := unix.IoctlRetInt(int(file.Fd()), unix.NS_GET_NSTYPE)
+	if err != nil || actualKind != kind {
+		return errors.Join(errors.New("namespace FD type mismatch"), err)
+	}
+	if user != nil {
+		owner, err := unix.IoctlRetInt(int(file.Fd()), unix.NS_GET_USERNS)
+		if err != nil {
+			return err
+		}
+		defer unix.Close(owner)
+		var a, b unix.Stat_t
+		if err := unix.Fstat(owner, &a); err != nil {
+			return err
+		}
+		if err := unix.Fstat(int(user.Fd()), &b); err != nil {
+			return err
+		}
+		if a.Dev != b.Dev || a.Ino != b.Ino {
+			return errors.New("namespace is not owned by held child userns")
+		}
+	}
+	return nil
+}
