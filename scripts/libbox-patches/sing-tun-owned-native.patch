+				err = os.Remove(allocator)
+				if err == nil {
+					err = unix.Mkfifo(allocator, 0444)
+				}
+			case "marker-symlink", "allocator-symlink":
+				path := marker
+				if fault == "allocator-symlink" {
+					path = allocator
+				}
+				err = os.Rename(path, path+".original")
+				if err == nil {
+					err = os.Symlink(path+".original", path)
+				}
+			case "parent-symlink":
+				parent := filepath.Dir(directory)
+				link := filepath.Join(t.TempDir(), "parent")
+				err = os.Symlink(parent, link)
+				directory = filepath.Join(link, "claims")
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if store, err := openRedirectClaimStoreOwned(directory, uint32(os.Geteuid()), false); err == nil {
+				_ = store.close()
