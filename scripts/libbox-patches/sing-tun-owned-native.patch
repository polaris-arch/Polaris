+			seen[c.path()] = true
+			paths = append(paths, c.path())
+			tops[c.Top] = true
+		}
+		if len(seen) != 27 || len(tops) != 10 {
+			t.Fatalf("closure %d/%d", len(tops), len(seen))
+		}
+		slices.Sort(paths)
+		sha, err := cNativeHash(paths)
+		// Independently derived from the immutable v2 proposal's expected paths.
+		if err != nil || sha != "4073ca1bc81dbc70b876f76b225a76ef0172092205445d2ad80ec081a1f6171f" {
+			t.Fatal("exact frozen selectors changed")
+		}
+	})
+	t.Run("complete_fixed_options_and_claims", func(t *testing.T) {
+		var all [][]redirectConflictKey
+		for _, role := range []string{"A", "B", "H"} {
+			o, err := cNativeOptions(role, false, nil)
