+func newActualClaimsFixture(t *testing.T) string {
+	t.Helper()
+	// MkdirTemp returns this one original root directly; testing.TempDir would
+	// add its own inaccessible 0700 ancestor above the returned 001 directory.
+	path, err := os.MkdirTemp("", "polaris-claims-file-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var held, linked unix.Stat_t
+	if err = unix.Fstat(fd, &held); err != nil {
+		_ = unix.Close(fd)
+		t.Fatal(err)
+	}
+	if err = unix.Lstat(path, &linked); err != nil {
+		_ = unix.Close(fd)
+		t.Fatal(err)
+	}
+	if held.Mode&unix.S_IFMT != unix.S_IFDIR || held.Mode&07777 != 0700 || held.Uid != uint32(os.Geteuid()) || held.Dev != linked.Dev || held.Ino != linked.Ino {
+		_ = unix.Close(fd)
+		t.Fatal("new fixture root lost original owned inode")
+	}
+	t.Cleanup(func() {
+		defer unix.Close(fd)
+		var current unix.Stat_t
+		if err := unix.Lstat(path, &current); err != nil {
+			t.Error(err)
+			return
+		}
+		if current.Dev != held.Dev || current.Ino != held.Ino || current.Mode&unix.S_IFMT != unix.S_IFDIR {
+			t.Error("fixture root replaced; refuse pathname cleanup")
+			return
+		}
+		if err := os.RemoveAll(path); err != nil {
+			t.Error(err)
+		}
+	})
