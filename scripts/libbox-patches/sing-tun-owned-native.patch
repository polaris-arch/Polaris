+			if o.TunOptions.NetNs != "" || o.TunOptions.AutoRedirectMarkMode || o.TunOptions.AutoRoute || o.DisableNFTables || o.CustomRedirectPort != nil || o.NetworkMonitor != nil || o.AndroidVPNService {
+				t.Fatal("nondefault actor config")
+			}
+			all = append(all, cNativeClaimKeys(o))
+		}
+		for i := range all {
+			for j := i + 1; j < len(all); j++ {
+				for _, key := range all[i] {
+					if slices.Contains(all[j], key) {
+						t.Fatal("unintended claim conflict")
+					}
+				}
+			}
+		}
+		o, _ := cNativeOptions("B", true, nil)
+		for _, key := range cNativeClaimKeys(o) {
+			if slices.Contains(all[0], key) && key.Domain != "queue" {
+				t.Fatal("conflict changed nonqueue key")
+			}
+		}
+	})
+	t.Run("Unfrozen_before_constructor", func(t *testing.T) {
+		if _, err := cNativeAdmit(context.Background(), cNativeDockerCases[0]); !errors.Is(err, errCNativeUnfrozen) {
+			t.Fatalf("guard: %v", err)
+		}
+	})
+	t.Run("receipt_missing_raw_window_rejected", func(t *testing.T) {
+		if err := cNativeValidateReceipt(cNativeReceipt{Case: cNativeDockerCases[0]}); err == nil {
+			t.Fatal("empty receipt accepted")
+		}
+	})
+	t.Run("every_Unfrozen_binding_and_actor_identity", func(t *testing.T) {
+		c := cNativeDockerCases[0]
+		a := cNativePureAdmission(c)
+		if err := cNativeValidateAdmission(a, c); err != nil {
+			t.Fatal(err)
+		}
+		for _, key := range cNativeRequiredBindings {
+			old := a.Bindings[key]
+			delete(a.Bindings, key)
+			if err := cNativeValidateAdmission(a, c); err == nil {
+				t.Fatalf("missing %s accepted", key)
+			}
+			a.Bindings[key] = old
+		}
+		b := a.Actors["B"]
+		b.PID = a.Actors["A"].PID
+		a.Actors["B"] = b
+		if err := cNativeValidateAdmission(a, c); err == nil {
+			t.Fatal("same process accepted as independent")
+		}
+		a = cNativePureAdmission(c)
+		b = a.Actors["B"]
+		b.ConfigSHA = a.Actors["A"].ConfigSHA
+		a.Actors["B"] = b
+		if err := cNativeValidateAdmission(a, c); err == nil {
+			t.Fatal("wrong full configuration accepted")
+		}
