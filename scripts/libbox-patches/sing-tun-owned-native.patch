+					if err != nil {
+						return err
+					}
+					set, err = op.nftSetIntent(table, "helper", redirectNFTIPv6)
+					if err != nil {
+						return err
+					}
+					queue := &redirectNFTCreateQueue{operation: op, ops: ops}
+					if err := queue.add(rule, chain, table); err != nil {
+						return err
+					}
+					nftTable := &nftables.Table{Name: table.address.table, Family: nftables.TableFamilyINet}
+					bridge := &ownershipNFTIPConstBridge{queue: queue, set: set, descriptor: &nftables.Set{Table: nftTable, ID: 77, Name: set.address.set, KeyType: nftables.TypeIP6Addr, Constant: true}}
+					addresses := make([]netip.Addr, count)
+					for n := range addresses {
+						addresses[n] = netip.AddrFrom16([16]byte{0x20, 1, 0x0d, 0xb8, 0, 0, 0, 0, 0, 0, 0, 0, byte(n >> 8), byte(n), 0, 1})
+					}
+					_, err = nftablesCreateIPConst(bridge, nftTable, 77, set.address.set, nftables.TableFamilyIPv6, addresses)
+					if err != nil && queue.Flush() != err {
+						t.Fatal("failed helper queue was replayed")
+					}
+					return err
+				}}
+				err := r.Start()
+				if fault.batch == 0 && err != nil || fault.batch != 0 && err == nil {
+					t.Fatalf("helper result = %v", err)
+				}
+				wantBatches := 1
+				if count == 1001 && fault.batch != 1 {
+					wantBatches = 2
+				}
+				if len(ops.batches) != wantBatches || len(ops.batches[0].members) != 1004 {
+					t.Fatal("first helper Flush did not journal all buffered table/chain/rule/set plus 1000 elements")
+				}
+				kinds := map[redirectNFTKind]int{}
+				for _, member := range ops.batches[0].members {
+					kinds[member.address.kind]++
+				}
+				if kinds[redirectNFTTable] != 1 || kinds[redirectNFTChain] != 1 || kinds[redirectNFTRule] != 1 || kinds[redirectNFTSet] != 1 || kinds[redirectNFTElement] != 1000 {
+					t.Fatal("incomplete helper journal")
+				}
+				if wantBatches == 2 {
+					second := ops.batches[1]
+					if len(second.members) != 1 || len(second.prerequisites) != 2 || second.prerequisites[set.id].object.address != set.address || second.prerequisites[table.id].object.address != table.address {
+						t.Fatal("second helper Flush lost complete prior set/table receipts")
+					}
+				}
+				if fault.batch == 1 && fault.mode != "abort" {
+					for _, entry := range ownershipEntries(r.ownership) {
+						if entry.state != redirectAmbiguous {
+							t.Fatal("early helper partial/wrong ACK granted ownership to a subset")
+						}
+					}
+					if len(ops.releases) != 0 {
+						t.Fatal("unknown first helper batch was deleted")
+					}
+				}
+				if fault.batch == 2 && fault.mode != "abort" {
+					states := map[redirectResourceID]redirectResourceState{}
+					for _, entry := range ownershipEntries(r.ownership) {
+						states[entry.id] = entry.state
+					}
+					if states[set.id] != redirectOwned || states[table.id] != redirectOwned || states[ops.batches[1].members[0].id] != redirectAmbiguous {
+						t.Fatal("late helper ambiguity erased early parent ownership")
+					}
+				}
+				first, second := r.Close(), r.Close()
+				if first != second || fault.batch != 0 && fault.mode != "abort" && !errors.Is(first, errRedirectAmbiguous) {
+					t.Fatal("helper unknown deletion retried or Close result changed")
+				}
+				if !reflect.DeepEqual(before, ops.foreignSnapshot(r.ownership.birth)) {
+					t.Fatal("helper failure touched legacy")
+				}
+			})
+		}
+	}
