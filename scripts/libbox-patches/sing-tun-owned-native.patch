index 0000000..14cd74d
--- /dev/null
+++ b/redirect_iptables_command_linux_test.go
@@ -0,0 +1,281 @@
+//go:build linux
+
+package tun
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/ranges"
+)
+
+func TestICommandActualWaitSuccessAndFrozenIO(t *testing.T) {
+	runner := new(iptablesCommandRunner)
+	args := []string{"-c", `printf '%s:' "$1"; /bin/cat`, "fixture", "one arg"}
+	result := runner.run(context.Background(), "/bin/sh", args, []byte("stdin"))
+	if !result.started || result.err != nil || result.output != "one arg:stdin" {
+		t.Fatal(result)
+	}
+	if result = runner.run(context.Background(), "/bin/sh", []string{"-c", "exit 0"}, nil); result.err != nil || !result.started {
+		t.Fatal("confirmed original Wait did not allow the next command", result)
+	}
+}
+
+func TestICommandOnlyFailureBeforeStartHasNoStartedMutation(t *testing.T) {
+	runner := new(iptablesCommandRunner)
+	result := runner.run(context.Background(), filepath.Join(t.TempDir(), "missing"), nil, nil)
+	if result.started || result.err == nil || errors.Is(result.err, errRedirectAmbiguous) {
+		t.Fatal(result)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if result = runner.run(ctx, "/bin/sh", []string{"-c", "exit 0"}, nil); result.started || !errors.Is(result.err, context.Canceled) || errors.Is(result.err, errRedirectAmbiguous) {
+		t.Fatal(result)
+	}
+	if result = runner.run(context.Background(), "/bin/sh", []string{"-c", "exit 0"}, nil); result.err != nil {
+		t.Fatal("pre-Start failure sealed a clean runner", result)
+	}
+}
+
+func TestICommandNonzeroCannotClaimNoMutationOrRetry(t *testing.T) {
+	runner := new(iptablesCommandRunner)
+	result := runner.run(context.Background(), "/bin/sh", []string{"-c", "printf failed >&2; exit 4"}, nil)
+	var exit *exec.ExitError
+	if !result.started || !errors.Is(result.err, errRedirectAmbiguous) || !errors.As(result.err, &exit) || exit.ExitCode() != 4 || result.output != "failed" {
+		t.Fatal(result)
+	}
+	if next := runner.run(context.Background(), "/bin/sh", []string{"-c", "exit 0"}, nil); next.started || !errors.Is(next.err, errRedirectAmbiguous) {
+		t.Fatal("started failure admitted a replacement command", next)
+	}
+}
+
+func TestICommandCancelRetainsOriginalCmdUntilActualWait(t *testing.T) {
+	for _, mode := range []string{"cancel", "budget"} {
+		t.Run(mode, func(t *testing.T) {
+			entered, allowWait := make(chan *exec.Cmd, 1), make(chan struct{})
+			var release sync.Once
+			runner := &iptablesCommandRunner{wait: func(command *exec.Cmd) error {
+				entered <- command
+				<-allowWait
+				return command.Wait()
+			}}
+			if mode == "budget" {
+				runner.budget = 80 * time.Millisecond
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			returned := make(chan iptablesCommandResult, 1)
+			// A finite harmless process settles itself. The production cancel
+			// path must retain responsibility without signaling a possible PID.
+			go func() { returned <- runner.run(ctx, "/bin/sleep", []string{"0.2"}, nil) }()
+			command := <-entered
+			t.Cleanup(func() {
+				cancel()
+				release.Do(func() { close(allowWait) })
+				runner.access.Lock()
+				custody := runner.unconfirmed
+				runner.access.Unlock()
+				if custody != nil {
+					select {
+					case <-custody.done:
+					case <-time.After(3 * time.Second):
+						t.Error("actual command Wait did not settle")
+					}
+				}
+			})
+			if blocked := runner.run(context.Background(), "/bin/true", nil, nil); blocked.started || !errors.Is(blocked.err, errRedirectAmbiguous) {
+				t.Fatal("concurrent mutation passed outstanding original Wait", blocked)
+			}
+			if mode == "cancel" {
+				cancel()
+			}
+			var result iptablesCommandResult
+			select {
+			case result = <-returned:
+			case <-time.After(3 * time.Second):
+				t.Fatal("bounded command did not return")
+			}
+			if !result.started || !errors.Is(result.err, errRedirectAmbiguous) {
+				t.Fatal(result)
+			}
+			runner.access.Lock()
+			custody := runner.unconfirmed
+			runner.access.Unlock()
+			if custody == nil || custody.command != command {
+				t.Fatal("cancel dropped or replaced the original Cmd")
+			}
+			select {
+			case <-custody.done:
+				t.Fatal("cancel was treated as native Wait completion")
+			default:
+			}
+			release.Do(func() { close(allowWait) })
+			select {
+			case <-custody.done:
+			case <-time.After(3 * time.Second):
+				t.Fatal("original native Wait did not return")
+			}
+			if custody.result.err != nil || !custody.result.nativeExit {
+				t.Fatal("finite fixture did not complete its original actual Wait0", custody.result)
+			}
+			if next := runner.run(context.Background(), "/bin/true", nil, nil); next.started || !errors.Is(next.err, errRedirectAmbiguous) {
+				t.Fatal("late completion cleared the unknown network boundary", next)
+			}
+		})
+	}
+}
+
+func TestICommandOutputIsBounded(t *testing.T) {
+	runner := new(iptablesCommandRunner)
+	result := runner.run(context.Background(), "/bin/cat", nil, []byte(strings.Repeat("x", 96<<10)))
+	if result.err != nil || len(result.output) != 64<<10 {
+		t.Fatal(result.err, len(result.output))
+	}
+}
+
+func TestICommandLateSuccessfulWaitCannotClearCanceledMutation(t *testing.T) {
+	actualWait, publish := make(chan struct{}), make(chan struct{})
+	runner := &iptablesCommandRunner{wait: func(command *exec.Cmd) error {
+		err := command.Wait()
+		close(actualWait)
+		<-publish
+		return err
+	}}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result := make(chan iptablesCommandResult, 1)
+	go func() { result <- runner.run(ctx, "/bin/true", nil, nil) }()
+	<-actualWait
+	cancel()
+	returned := <-result
+	if !returned.started || !errors.Is(returned.err, errRedirectAmbiguous) {
+		t.Fatal(returned)
+	}
+	runner.access.Lock()
+	custody := runner.unconfirmed
+	runner.access.Unlock()
+	if custody == nil {
+		t.Fatal("missing canceled command custody")
+	}
+	close(publish)
+	<-custody.done
+	if custody.result.err != nil {
+		t.Fatal("the actual original child did not exit successfully", custody.result)
+	}
+	if next := runner.run(context.Background(), "/bin/true", nil, nil); next.started || !errors.Is(next.err, errRedirectAmbiguous) {
+		t.Fatal("late success cleared cancellation", next)
+	}
+}
+
+func TestICommandMissingOriginalWaitCannotMintCreated(t *testing.T) {
+	var original *exec.Cmd
+	runner := &iptablesCommandRunner{wait: func(command *exec.Cmd) error {
+		original = command
+		return nil // deliberately malformed stand-in, not the actual Cmd.Wait
+	}}
+	result := runner.run(context.Background(), "/bin/true", nil, nil)
+	if original != nil {
+		// The fixture itself retains the independent original waiter and reaps
+		// this harmless process. Production never retries a lost Wait this way.
+		if err := original.Wait(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if !result.started || result.nativeExit || !errors.Is(result.err, errRedirectInvalidACK) || iptablesAcquireResult(result).status != redirectAcquireUnknown {
+		t.Fatal("a nil callback result stood in for original native exit", result)
+	}
+	if next := runner.run(context.Background(), "/bin/true", nil, nil); next.started || !errors.Is(next.err, errRedirectAmbiguous) {
+		t.Fatal("missing original Wait admitted another mutation", next)
+	}
+}
+
+// This executes the existing production builder against a harmless recording
+// executable. It checks grammar preservation only, not xtables parsing, kernel
+// ACK or acceptance of the native backend/restore implementation.
+func TestIExistingBuilderCompleteGrammarUsesActualCommandArgv(t *testing.T) {
+	dir := t.TempDir()
+	trace, binary := filepath.Join(dir, "argv"), filepath.Join(dir, "record")
+	script := "#!/bin/sh\nprintf '%s\\000' \"$@\" >> '" + trace + "'\nprintf '\\n' >> '" + trace + "'\n"
+	if err := os.WriteFile(binary, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	r := newOwnershipTestRedirect(t)
+	r.tunOptions = &Options{
+		Name: "tun-fixture", IncludeInterface: []string{"lo", "eth0", "eth1"}, ExcludeInterface: []string{"skip0"},
+		IncludeMACAddress:        []net.HardwareAddr{{0x02, 0, 0, 0, 0, 1}, {0x02, 0, 0, 0, 0, 2}},
+		ExcludeMACAddress:        []net.HardwareAddr{{0x02, 0, 0, 0, 0, 3}},
+		IncludeUID:               []ranges.Range[uint32]{{Start: 1000, End: 1001}, {Start: 2000, End: 2000}},
+		ExcludeUID:               []ranges.Range[uint32]{{Start: 3000, End: 3001}},
+		Inet4Address:             []netip.Prefix{netip.MustParsePrefix("172.19.0.1/30")},
+		Inet6Address:             []netip.Prefix{netip.MustParsePrefix("fd00::1/126")},
+		Inet4RouteAddress:        []netip.Prefix{netip.MustParsePrefix("10.0.0.0/8"), netip.MustParsePrefix("172.16.0.0/12")},
+		Inet6RouteAddress:        []netip.Prefix{netip.MustParsePrefix("2001:db8::/32"), netip.MustParsePrefix("fd00::/8")},
+		Inet4RouteExcludeAddress: []netip.Prefix{netip.MustParsePrefix("10.9.0.0/16")},
+		Inet6RouteExcludeAddress: []netip.Prefix{netip.MustParsePrefix("fd09::/16")},
+		Inet4LoopbackAddress:     []netip.Addr{netip.MustParseAddr("10.0.0.1")},
+		Inet6LoopbackAddress:     []netip.Addr{netip.MustParseAddr("fd00::10")},
+		AutoRedirectInputMark:    0x2023, AutoRedirectOutputMark: 0x2024,
+		AutoRedirectResetMark: 0x2025, AutoRedirectTProxyMark: 0x2026,
+	}
+	r.customRedirectPort = 23456
+	r.localAddresses = []netip.Prefix{netip.MustParsePrefix("127.0.0.0/8"), netip.MustParsePrefix("192.0.2.0/24"), netip.MustParsePrefix("2001:db8:1::/64")}
+	runner := new(iptablesCommandRunner)
+	for index, family := range []*iptablesFamily{{path: binary}, {path: binary, isIPv6: true, tproxy: true}, {path: binary, isIPv6: true}} {
+		version := uint8(4)
+		if family.isIPv6 {
+			version = 6
+		}
+		plan, err := newIPTablesFamilyPlan(redirectNamespaceIdentity{1, 2}, r.ownership.birth, version, uint64(index+1))
+		if err != nil {
+			t.Fatal(err)
+		}
+		family.plan = plan
+		if err := r.setupIPTablesForFamily(family); err != nil {
+			t.Fatal(err)
+		}
+		plan.sealed = true
+		for _, intent := range plan.private {
+			action, args := "-N", []string(nil)
+			if intent.rule != nil {
+				action, args = "-A", intent.rule.args
+			}
+			result := runner.run(context.Background(), binary, iptablesCommandArgs(intent.chain.scope.table, action, intent.chain.name, args), nil)
+			if result.err != nil {
+				t.Fatal(result)
+			}
+		}
+		for _, hook := range plan.hooks {
+			result := runner.run(context.Background(), binary, iptablesCommandArgs(hook.chain.scope.table, "-I", hook.chain.name, hook.args), nil)
+			if result.err != nil {
+				t.Fatal(result)
+			}
+		}
+	}
+	data, err := os.ReadFile(trace)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var all []string
+	for _, command := range strings.Split(strings.TrimSuffix(string(data), "\n"), "\n") {
+		args := strings.Split(strings.TrimSuffix(command, "\x00"), "\x00")
+		if len(args) < 5 || args[0] != "-w" {
+			t.Fatal("original argv did not reach the command executable", args)
+		}
+		all = append(all, args...)
+	}
+	for _, token := range []string{"NFQUEUE", "CONNMARK", "MARK", "REDIRECT", "DNAT", "TPROXY", "REJECT", "--mac-source", "02:00:00:00:00:01", "02:00:00:00:00:03", "--uid-owner", "1000-1001", "3000-3001", "--dport", "53", "icmpv6", "--icmpv6-type", "eth0", "skip0", "10.9.0.0/16", "fd09::/16", "--queue-bypass", "--nfmask", "--ctmask", "--tcp-flags"} {
+		if !slices.Contains(all, token) {
+			t.Error("production grammar capability missing", token)
+		}
+	}
+}
diff --git a/redirect_iptables_plan_linux.go b/redirect_iptables_plan_linux.go
new file mode 100644
index 0000000..5322ca2
--- /dev/null
+++ b/redirect_iptables_plan_linux.go
@@ -0,0 +1,322 @@
+//go:build linux
+
+package tun
+
+import (
+	"crypto/sha256"
+	"encoding/base32"
+	"errors"
+	"fmt"
+	"net/netip"
+	"slices"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// The existing production grammar emits a whole private generation before any
+// command runs. A plan is an intent, not an acquisition receipt. Only a later
+// journaled command can acquire a chain, rule, or public binding.
+type iptablesPrivateIntent struct {
+	chain redirectIPTablesChainIdentity
+	rule  *redirectIPTablesRuleIdentity // nil means create this private chain
+	jumps []redirectIPTablesChainIdentity
+}
+
+type iptablesFamilyPlan struct {
+	namespace  redirectNamespaceIdentity
+	birth      redirectBirth
+	family     uint8
+	generation uint64
+	sealed     bool
+	roles      map[string]redirectIPTablesChainIdentity
+	chains     map[redirectIPTablesChainIdentity]bool
+	private    []iptablesPrivateIntent
+	hooks      []redirectIPTablesRuleIdentity // original backwards -I order
+	ruleSerial uint64
+}
+
+type iptablesPreparedFamily struct {
+	path        string
+	restorePath string
+	isIPv6      bool
+	tproxy      bool
+	unreachable bool // optional StrictRoute graph for the disabled family
+}
+
+type iptablesGenerationPlan struct {
+	families []*iptablesFamilyPlan
+	locals   []netip.Prefix
+}
+
+// The snapshot getter is consumed once, before any command. The view borrows no
+// live cache or mutex: callbacks build a replacement generation, never flush a
+// chain while another generation still has public references to it.
+func buildIPTablesGeneration(r *autoRedirect, namespace redirectNamespaceIdentity, generation uint64, locals []netip.Prefix, families []iptablesPreparedFamily) (*iptablesGenerationPlan, error) {
+	if r == nil || r.ownership == nil || r.tunOptions == nil || len(families) == 0 {
+		return nil, errors.New("missing iptables generation configuration")
+	}
+	options := freezeRedirectOptions(*r.tunOptions)
+	if r.routeAddressSet != nil {
+		include, exclude, err := r.routeAddressSet()
+		if err != nil {
+			return nil, err
+		}
+		for index, prefixes := range [][]netip.Prefix{include, exclude} {
+			for _, prefix := range prefixes {
+				if !validIPTablesPlanPrefix(prefix) {
+					return nil, errors.New("invalid iptables route-set prefix")
+				}
+				if prefix.Addr().Is4() {
+					if index == 0 {
+						options.Inet4RouteAddress = append(options.Inet4RouteAddress, prefix.Masked())
+					} else {
+						options.Inet4RouteExcludeAddress = append(options.Inet4RouteExcludeAddress, prefix.Masked())
+					}
+				} else if index == 0 {
+					options.Inet6RouteAddress = append(options.Inet6RouteAddress, prefix.Masked())
+				} else {
+					options.Inet6RouteExcludeAddress = append(options.Inet6RouteExcludeAddress, prefix.Masked())
+				}
+			}
+		}
+	}
+	for _, group := range []struct {
+		family4  bool
+		prefixes []netip.Prefix
+	}{
+		{true, options.Inet4Address}, {false, options.Inet6Address},
+		{true, options.Inet4RouteAddress}, {false, options.Inet6RouteAddress},
+		{true, options.Inet4RouteExcludeAddress}, {false, options.Inet6RouteExcludeAddress},
+	} {
+		for _, prefix := range group.prefixes {
+			if !validIPTablesPlanPrefix(prefix) || prefix.Addr().Is4() != group.family4 {
+				return nil, errors.New("iptables option prefix has an invalid family")
+			}
+		}
+	}
+	for _, prefix := range locals {
+		if !validIPTablesPlanPrefix(prefix) {
+			return nil, errors.New("invalid iptables local-address prefix")
+		}
+	}
+	port := r.redirectPort()
+	if port == 0 {
+		return nil, errors.New("missing admitted redirect listener port")
+	}
+	view := &autoRedirect{
+		tunOptions: &options, tableName: r.tableName, customRedirectPort: int(port),
+		localAddresses: slices.Clone(locals), enableIPv4: r.enableIPv4, enableIPv6: r.enableIPv6,
+		androidVPNService: r.androidVPNService,
+	}
+	result := &iptablesGenerationPlan{locals: slices.Clone(locals)}
+	seen := make(map[bool]bool)
+	for _, prepared := range families {
+		if prepared.path == "" || prepared.restorePath == "" || seen[prepared.isIPv6] {
+			return nil, errors.New("missing or duplicate iptables family executables")
+		}
+		seen[prepared.isIPv6] = true
+		familyID := uint8(4)
+		if prepared.isIPv6 {
+			familyID = 6
+		}
+		plan, err := newIPTablesFamilyPlan(namespace, r.ownership.birth, familyID, generation)
+		if err != nil {
+			return nil, err
+		}
+		family := &iptablesFamily{path: prepared.path, isIPv6: prepared.isIPv6, tproxy: prepared.tproxy, plan: plan}
+		if prepared.unreachable {
+			err = view.buildIPTablesUnreachable(family)
+		} else {
+			err = view.setupIPTablesForFamily(family)
+		}
+		if err != nil {
+			return nil, err
+		}
+		plan.sealed = true
+		result.families = append(result.families, plan)
+	}
+	return result, nil
+}
+
+func validIPTablesPlanPrefix(prefix netip.Prefix) bool {
+	return prefix.IsValid() && !prefix.Addr().Is4In6() && prefix.Addr().Zone() == ""
+}
+
+func newIPTablesFamilyPlan(namespace redirectNamespaceIdentity, birth redirectBirth, family uint8, generation uint64) (*iptablesFamilyPlan, error) {
+	if namespace.device == 0 || namespace.inode == 0 || birth == (redirectBirth{}) || (family != 4 && family != 6) || generation == 0 {
+		return nil, errors.New("missing iptables generation identity")
+	}
+	return &iptablesFamilyPlan{
+		namespace: namespace, birth: birth, family: family, generation: generation,
+		roles: make(map[string]redirectIPTablesChainIdentity), chains: make(map[redirectIPTablesChainIdentity]bool),
+	}, nil
+}
+
+func (p *iptablesFamilyPlan) scope(table string) redirectIPTablesScope {
+	return redirectIPTablesScope{p.namespace, p.family, table}
+}
+
+func (f *iptablesFamily) planChain(table, role string) (string, error) {
+	if f.plan == nil || f.plan.sealed || !f.plan.scope(table).valid() || !validIPTablesPlanToken(role) {
+		return "", errors.New("invalid private iptables chain intent")
+	}
+	p := f.plan
+	if (p.family == 6) != f.isIPv6 {
+		return "", errors.New("iptables executable family differs from its plan")
+	}
+	key := table + "/" + role
+	if _, exists := p.roles[key]; exists {
+		return "", errors.New("duplicate private iptables chain role")
+	}
+	digest := sha256.Sum256([]byte(fmt.Sprintf("%d/%d/%s/%d/%d/%s", p.namespace.device, p.namespace.inode, p.birth, p.family, p.generation, key)))
+	identity := redirectIPTablesChainIdentity{p.scope(table), "po" + base32.StdEncoding.WithPadding(base32.NoPadding).EncodeToString(digest[:16])}
+	if p.chains[identity] {
+		return "", errors.New("private iptables chain identity collision")
+	}
+	p.roles[key], p.chains[identity] = identity, true
+	p.private = append(p.private, iptablesPrivateIntent{chain: identity})
+	return identity.name, nil
+}
+
+func validIPTablesPlanToken(value string) bool {
+	return value != "" && utf8.ValidString(value) && !strings.ContainsFunc(value, unicode.IsControl)
+}
+
+// This accepts the complete existing builder's targets, rather than the narrow
+// fake ownership grammar. References must point to this plan's exact private
+// chains in the same family/table; built-in parents are never owned resources.
+func (p *iptablesFamilyPlan) freezeRule(chain redirectIPTablesChainIdentity, args []string) (redirectIPTablesRuleIdentity, []redirectIPTablesChainIdentity, error) {
+	if p.sealed || !chain.scope.valid() || chain.scope.namespace != p.namespace || chain.scope.family != p.family || len(args) == 0 {
+		return redirectIPTablesRuleIdentity{}, nil, errors.New("invalid iptables rule intent")
+	}
+	var jumps []redirectIPTablesChainIdentity
+	var targets int
+	for index, arg := range args {
+		if !validIPTablesPlanToken(arg) {
+			return redirectIPTablesRuleIdentity{}, nil, errors.New("invalid iptables argument")
+		}
+		switch arg {
+		case "-A", "-I", "-D", "-F", "-X", "-N", "-P", "-t", "--table", "--comment":
+			return redirectIPTablesRuleIdentity{}, nil, errors.New("rule intent contains a command or foreign comment")
+		case "-j", "-g":
+			targets++
+			if index+1 == len(args) {
+				return redirectIPTablesRuleIdentity{}, nil, errors.New("missing iptables rule target")
+			}
+			target := args[index+1]
+			identity := redirectIPTablesChainIdentity{chain.scope, target}
+			if p.chains[identity] {
+				jumps = append(jumps, identity)
+				continue
+			}
+			if arg == "-g" {
+				return redirectIPTablesRuleIdentity{}, nil, errors.New("goto target is not an owned private chain")
+			}
+			switch target {
+			case "ACCEPT", "RETURN", "REJECT", "NFQUEUE", "CONNMARK", "MARK", "REDIRECT", "DNAT", "TPROXY", "MASQUERADE", "TCPMSS":
+			default:
+				return redirectIPTablesRuleIdentity{}, nil, errors.New("jump target is not part of the production grammar")
+			}
+		}
+	}
+	if targets != 1 {
+		return redirectIPTablesRuleIdentity{}, nil, errors.New("iptables rule must have exactly one target")
+	}
+	p.ruleSerial++
+	comment := "polaris-owner:" + p.birth.String() + ":" + strconv.FormatUint(p.generation, 10) + ":" + strconv.FormatUint(p.ruleSerial, 10)
+	frozen := slices.Concat([]string{"-m", "comment", "--comment", comment}, args)
+	return redirectIPTablesRuleIdentity{chain, frozen}, jumps, nil
+}
+
+func (f *iptablesFamily) planRule(table, name string, args []string) error {
+	if f.plan == nil {
+		return errors.New("missing iptables generation plan")
+	}
+	p := f.plan
+	chain := redirectIPTablesChainIdentity{p.scope(table), name}
+	if !p.chains[chain] {
+		return errors.New("rule source is not this generation's private chain")
+	}
+	rule, jumps, err := p.freezeRule(chain, args)
+	if err != nil {
+		return err
+	}
+	p.private = append(p.private, iptablesPrivateIntent{chain, &rule, jumps})
+	return nil
+}
+
+func (f *iptablesFamily) planHook(table, parent string, args []string) error {
+	if f.plan == nil || !f.plan.scope(table).supportsHook(parent) {
+		return errors.New("invalid iptables public hook")
+	}
+	p := f.plan
+	rule, jumps, err := p.freezeRule(redirectIPTablesChainIdentity{p.scope(table), parent}, args)
+	if err != nil {
+		return err
+	}
+	if len(jumps) != 1 {
+		return errors.New("public hook must reference this generation's private chain")
+	}
+	p.hooks = append(p.hooks, rule)
+	return nil
+}
+
+func (p *iptablesFamilyPlan) tableHooks(table string) []redirectIPTablesRuleIdentity {
+	var hooks []redirectIPTablesRuleIdentity
+	for _, hook := range p.hooks {
+		if hook.chain.scope.table == table {
+			hooks = append(hooks, hook.clone())
+		}
+	}
+	return hooks
+}
+
+func iptablesCommandArgs(table, action, chain string, args []string) []string {
+	// The child takes xtables' own lock. No parent-side xtables flock is held.
+	return slices.Concat([]string{"-w", "2", "-t", table, action, chain}, args)
+}
+
+// Quote arguments for xtables-restore's quoted-token grammar, not a shell. No
+// stdin command can be introduced through a newline or another table block.
+func iptablesRestoreToken(value string) (string, error) {
+	if !validIPTablesPlanToken(value) {
+		return "", errors.New("invalid iptables-restore token")
+	}
+	if !strings.ContainsAny(value, " \t\"\\") {
+		return value, nil
+	}
+	return "\"" + strings.NewReplacer("\\", "\\\\", "\"", "\\\"").Replace(value) + "\"", nil
+}
+
+// One table's whole hookset is switched by one original restore Cmd. There are
+// no colon declarations, policies, flushes, snapshots, or borrowed rules.
+func iptablesHookTransaction(scope redirectIPTablesScope, old, next []redirectIPTablesRuleIdentity) ([]byte, error) {
+	if !scope.valid() || len(old)+len(next) == 0 {
+		return nil, errors.New("empty or invalid iptables binding transaction")
+	}
+	var input strings.Builder
+	input.WriteString("*" + scope.table + "\n")
+	for _, group := range []struct {
+		action string
+		rules  []redirectIPTablesRuleIdentity
+	}{{"-D", old}, {"-I", next}} {
+		for _, rule := range group.rules {
+			if rule.chain.scope != scope || !scope.supportsHook(rule.chain.name) || len(rule.args) == 0 {
+				return nil, errors.New("iptables binding mixes scopes or private chains")
+			}
+			input.WriteString(group.action + " " + rule.chain.name)
+			for _, arg := range rule.args {
+				quoted, err := iptablesRestoreToken(arg)
+				if err != nil {
+					return nil, err
+				}
+				input.WriteString(" " + quoted)
+			}
+			input.WriteByte('\n')
+		}
+	}
+	input.WriteString("COMMIT\n")
+	return []byte(input.String()), nil
+}
