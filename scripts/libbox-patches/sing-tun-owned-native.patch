+// Raw facts come from G's independently frozen observation adapter. They are
+// not receipt ownership from a successful fw4 exit: complete single-GENID four
+// rule specs (without duplicates) remain a separate semantic requirement.
+type cNativeFW4Evidence struct {
+	SemanticRulesByRole                                     map[string]int
+	RefusalStage                                            string
+	CoordinatorErrno                                        int
+	CheckOtherJournalsReached                               bool
+	HolderPhase                                             string
+	HolderAlive, HolderActualWait, JournalCrafted           bool
+	IncludeOriginal, IncludeAfter                           fw4FileIdentity
+	OriginalContentSHA, AfterContentSHA                     string
+	FileCreated, FileUnlinked, ReplacementPreserved         bool
+	Journal                                                 fw4Journal
+	Commands                                                []fw4CommandFact
+	PublicReturnUnix                                        int64
+	ActivationRole, ActivationBirth                         string
+	ActivationRevision                                      uint64
+	PreselectionUnix, PIDObservedUnix, ActivationUnix       int64
+	OriginalPID, AncestorPID                                int
+	SemanticGeneration                                      uint32
+	ExactSemanticRules, DuplicateSemanticRules              int
+	SemanticRawSHA, LockRawSHA, FileRawSHA, WaitRawSHA      string
+	ReloadAttemptsAfterUnknown, UnlinkAttemptsAfterUnlinked int
+	BadScriptExecuted                                       bool
+}
+
+func (r *cNativeRun) fw4() error {
+	if err := r.start("A", false); err != nil {
+		return err
+	}
+	for _, s := range []string{"A_committed", "A_before"} {
+		if err := r.step(s); err != nil {
+			return err
+		}
+	}
+	scenario := r.c.Scenario
+	switch scenario {
+	case "fw4-live-Pending", "fw4-live-Unknown":
+		phase := "Pending"
+		if scenario == "fw4-live-Unknown" {
+			phase = "Unknown"
+		}
+		if err := r.call("H", "Construct", false); err != nil {
+			return err
+		}
+		// G arms H's birth/revision and observes its real original Cmd PID. A
+		// B-only delay script cannot establish this holder window.
+		if err := r.produce("preselect_H_revision1_" + phase); err != nil {
+			return err
+		}
+		if err := cNativeG.CallConcurrent(r.ctx, r.a, r.actors["H"], "Start"); err != nil {
+			return err
+		}
+		if err := r.produce("confirm_H_actual_PID_activation"); err != nil {
+			return err
+		}
+		if err := r.step("H_live_" + phase); err != nil {
+			return err
+		}
+		if err := r.start("B", true); err != nil {
+			return err
+		}
+		for _, s := range []string{"B_lockCoordinator_refusal", "checkOtherJournals_not_reached", "A_after"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+	case "fw4-orphan":
+		if err := r.start("H", false); err != nil {
+			return err
+		}
+		if err := r.step("H_committed"); err != nil {
+			return err
+		}
+		if err := r.produce("terminate_actual_H_without_retirement"); err != nil {
+			return err
+		}
+		if err := r.actors["H"].Wait(r.ctx); err != nil {
+			return err
+		}
+		for _, s := range []string{"H_actual_process_Wait", "coordinator_available"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+		if err := r.start("B", true); err != nil {
+			return err
+		}
+		if err := r.step("B_checkOtherJournals_orphan_refusal"); err != nil {
+			return err
+		}
+		if err := r.step("A_after"); err != nil {
+			return err
+		}
+	case "fw4-crafted-Pending", "fw4-crafted-Unknown":
+		phase := "Pending"
+		if scenario == "fw4-crafted-Unknown" {
+			phase = "Unknown"
+		}
+		if err := r.produce("producer_" + phase + "_journal"); err != nil {
+			return err
+		}
+		for _, s := range []string{"producer_" + phase + "_journal", "coordinator_available"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+		if err := r.start("B", true); err != nil {
+			return err
+		}
+		if err := r.step("B_checkOtherJournals_" + phase + "_refusal"); err != nil {
+			return err
+		}
+		if err := r.step("A_after"); err != nil {
+			return err
+		}
+	case "fw4-script":
+		if err := r.produce("B_only_readonly_wrong_script_PATH"); err != nil {
+			return err
+		}
+		if err := r.step("B_wrong_script_PATH"); err != nil {
+			return err
+		}
+		if err := r.start("B", true); err != nil {
+			return err
+		}
+		for _, s := range []string{"B_script_SHA_refusal", "bad_script_not_executed", "A_after"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+	case "fw4-acquire-timeout":
+		if err := r.call("B", "Construct", false); err != nil {
+			return err
+		}
+		if err := r.produce("preselect_B_revision1_acquire"); err != nil {
+			return err
+		}
+		if err := r.step("B_revision1_preselected"); err != nil {
+			return err
+		}
+		if err := cNativeG.CallConcurrent(r.ctx, r.a, r.actors["B"], "Start"); err != nil {
+			return err
+		}
+		if err := r.step("B_original_Cmd_started"); err != nil {
+			return err
+		}
+		if err := r.produce("confirm_B_actual_PID_activation"); err != nil {
+			return err
+		}
+		for _, s := range []string{"B_actual_PID_activation", "B_internal_timeout_Unknown", "B_original_late_Wait"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+		if err := r.join("B", "Start", true); err != nil {
+			return err
+		}
+		for _, s := range []string{"B_public_Start_returned_after_Wait", "B_no_retire_attempt", "A_after"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+	default:
+		if err := r.start("B", false); err != nil {
+			return err
+		}
+		if err := r.step("B_committed"); err != nil {
+			return err
+		}
+		switch scenario {
+		case "fw4-pair":
+			for _, s := range []string{"independent_includes_rendered", "complete_semantic_GENID", "A_after"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+		case "fw4-retire":
+			if err := r.call("B", "Close", false); err != nil {
+				return err
+			}
+			for _, s := range []string{"B_file_unlinked", "B_original_Wait0", "complete_semantic_GENID", "A_after"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+		case "fw4-inode", "fw4-content", "fw4-disposal":
+			name := "producer_B_changed_content"
+			if scenario == "fw4-inode" {
+				name = "producer_B_new_inode"
+			}
+			if err := r.produce(name); err != nil {
+				return err
+			}
+			if err := r.step(name); err != nil {
+				return err
+			}
+			if err := r.call("B", "Close", true); err != nil {
+				return err
+			}
+			if err := r.step("B_Unknown"); err != nil {
+				return err
+			}
+			if err := r.call("B", "Close", true); err != nil {
+				return err
+			}
+			if err := r.step("B_no_retry"); err != nil {
+				return err
+			}
+			if err := r.step("A_after"); err != nil {
+				return err
+			}
+			if scenario == "fw4-disposal" {
+				// Freeze the Unknown/file/Wait evidence before the independent G
+				// guardian disposal envelope destroys this guest's observation view.
+				if err := r.window("FW4_evidence"); err != nil {
+					return err
+				}
+				if err := r.step("guardian_disposal_separate"); err != nil {
+					return err
+				}
+				return nil
+			}
+		case "fw4-retire-timeout":
+			if err := r.produce("preselect_B_revision2_retire"); err != nil {
+				return err
+			}
+			if err := r.step("B_revision2_preselected"); err != nil {
+				return err
+			}
+			if err := cNativeG.CallConcurrent(r.ctx, r.a, r.actors["B"], "Close"); err != nil {
+				return err
+			}
+			for _, s := range []string{"B_file_unlinked", "B_original_Cmd_started"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+			if err := r.produce("confirm_B_actual_PID_activation"); err != nil {
+				return err
+			}
+			for _, s := range []string{"B_actual_PID_activation", "B_internal_timeout_Unknown", "B_original_late_Wait"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+			if err := r.join("B", "Close", true); err != nil {
+				return err
+			}
+			for _, s := range []string{"B_public_Close_returned_after_Wait"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+			if err := r.produce("disarm_B_activation_before_any_A_command"); err != nil {
+				return err
+			}
+			if err := r.call("B", "Close", true); err != nil {
+				return err
+			}
+			if err := r.step("B_no_retry"); err != nil {
+				return err
+			}
+			if err := r.step("A_after"); err != nil {
+				return err
+			}
+		case "fw4-unlinked-failure":
+			if err := r.produce("private_invalid_nft_include_after_Committed"); err != nil {
+				return err
+			}
+			if err := r.step("producer_invalid_include"); err != nil {
+				return err
+			}
+			if err := r.call("B", "Close", true); err != nil {
+				return err
+			}
+			for _, s := range []string{"B_file_unlinked", "B_original_Wait_failure", "B_Unknown"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+			if err := r.produce("B_path_replacement_after_original_unlink"); err != nil {
+				return err
+			}
+			if err := r.call("B", "Close", true); err != nil {
+				return err
+			}
+			for _, s := range []string{"B_no_retry", "replacement_preserved", "A_after"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+		case "fw4-final":
+			if err := r.call("B", "Close", false); err != nil {
+				return err
+			}
+			for _, s := range []string{"B_closed", "A_after"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+			if err := r.call("A", "Close", false); err != nil {
+				return err
+			}
+			for _, s := range []string{"A_normal_retired", "baseline_restored"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+		default:
+			return errors.New("unimplemented fw4 scenario")
+		}
+	}
+	return r.window("FW4_evidence")
+}
