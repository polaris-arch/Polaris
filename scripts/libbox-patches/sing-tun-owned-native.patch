+func TestRedirectOwnershipIPTablesZeroPrefixNativeIdentity(t *testing.T) {
+	for _, family := range []uint8{4, 6} {
+		for _, fields := range [][]string{{"-s"}, {"-d"}, {"-s", "-d"}} {
+			for _, reference := range []bool{false, true} {
+				for _, hostPrefix := range []bool{false, true} {
+					for _, explicitFirst := range []bool{false, true} {
+						t.Run(fmt.Sprintf("family=%d/fields=%v/reference=%t/host=%t/explicit-first=%t", family, fields, reference, hostPrefix, explicitFirst), func(t *testing.T) {
+							scope := redirectIPTablesScope{redirectNamespaceIdentity{1, 803}, family, iptablesTableMangle}
+							world := newOwnershipIPTablesFakeWorld(scope)
+							r := newOwnershipTestRedirect(t)
+							before := world.except(r.ownership.birth)
+							ops := &ownershipIPTablesFakeOps{world: world, birth: r.ownership.birth, failAt: -1}
+							prefix := "0.0.0.0/0"
+							if family == 6 {
+								prefix = "::/0"
+							}
+							if hostPrefix {
+								prefix = "0.0.0.0/32"
+								if family == 6 {
+									prefix = "::/128"
+								}
+							}
+							omitted := []string{"-p", "tcp"}
+							explicit := slices.Clone(omitted)
+							for _, field := range fields {
+								explicit = append(explicit, field, prefix)
+							}
+							if !reference {
+								omitted = append(omitted, "-j", "ACCEPT")
+								explicit = append(explicit, "-j", "ACCEPT")
+							}
+							first, second := omitted, explicit
+							if explicitFirst {
+								first, second = second, first
+							}
+							var firstID, secondID redirectResourceID
+							var secondErr error
+							r.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+								chain, err := op.acquireIPTablesChain(scope, "same-chain", ops)
+								if err != nil {
+									return err
+								}
+								acquire := func(args []string) (redirectResourceID, error) {
+									if reference {
+										return op.acquireIPTablesReference(chain, "PREROUTING", "same-rule", args, ops)
+									}
+									return op.acquireIPTablesRule(chain, "same-rule", args, ops)
+								}
+								firstID, err = acquire(first)
+								if err != nil {
+									return err
+								}
+								secondID, secondErr = acquire(second)
+								return secondErr
+							}}
+							startErr := r.Start()
+							if hostPrefix {
+								if startErr != nil || secondErr != nil || firstID == secondID || ops.acquires.Load() != 3 || len(ownershipEntries(r.ownership)) != 3 {
+									t.Fatal("unspecified host prefix was merged with an omitted address match")
+								}
+							} else if startErr == nil || secondErr == nil || firstID != secondID || ops.acquires.Load() != 2 || len(ownershipEntries(r.ownership)) != 2 {
+								t.Fatal("/0 alias was not rejected by the ledger before a second AddRule")
+							}
+							if err := r.Close(); err != nil {
+								t.Fatal(err)
+							}
+							prefixRules := 0
+							for _, deleted := range world.deletedRules {
+								matchedFields := 0
+								for _, field := range fields {
+									if index := slices.Index(deleted.args, field); index >= 0 {
+										if !hostPrefix || index+1 >= len(deleted.args) || deleted.args[index+1] != prefix {
+											t.Fatal("release argv contains an uncanonical address match")
+										}
+										matchedFields++
+									}
+								}
+								if matchedFields != 0 {
+									if matchedFields != len(fields) {
+										t.Fatal("release argv lost a host address match")
+									}
+									prefixRules++
+								}
+							}
+							if hostPrefix && (len(world.deletedRules) != 2 || prefixRules != 1) || !hostPrefix && len(world.deletedRules) != 1 {
+								t.Fatal("unexpected release count for the canonical physical identities")
+							}
+							world.assertPreserved(t, r.ownership.birth, before)
+						})
+					}
+				}
+			}
+		}
+	}
+}
diff --git a/redirect_ownership_linux.go b/redirect_ownership_linux.go
new file mode 100644
index 0000000..90340bf
--- /dev/null
+++ b/redirect_ownership_linux.go
@@ -0,0 +1,612 @@
+package tun
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"slices"
+	"sync"
+)
+
+var (
+	errRedirectClosing        = errors.New("auto_redirect is closing")
+	errRedirectAlreadyStarted = errors.New("auto_redirect Start is single-use")
+	errRedirectNotStarted     = errors.New("auto_redirect has not started")
+	errRedirectAmbiguous      = errors.New("auto_redirect resource ownership is ambiguous")
+	errRedirectInvalidACK     = errors.New("invalid auto_redirect resource acknowledgement")
+	errRedirectEffectPanic    = errors.New("auto_redirect resource operation panicked")
+	errRedirectDependency     = errors.New("auto_redirect resource has an unresolved dependent")
+)
+
+type redirectBirth [16]byte
+
+func (b redirectBirth) String() string { return hex.EncodeToString(b[:]) }
+
+type redirectResourceDomain uint8
+
+const (
+	redirectListener redirectResourceDomain = iota + 1
+	redirectNFQueue
+	redirectMonitor
+	redirectCallback
+	redirectIPTables
+	redirectNFTables
+	redirectNetlink
+	redirectFile
+	redirectReload
+	redirectNamespace
+	redirectClaim
+	redirectTun
+	redirectReadOnlyProbe // original read-only Cmd/Wait custody, never kernel ownership
+)
+
+type redirectResourceID struct {
+	birth  redirectBirth
+	domain redirectResourceDomain
+	key    string
+}
+
+type redirectResourceState uint8
+
+const (
+	redirectPending redirectResourceState = iota
+	redirectOwned
+	redirectAmbiguous
+	redirectReleased
+)
+
+type redirectAcquireStatus uint8
+
+const (
+	redirectAcquireUnknown redirectAcquireStatus = iota
+	redirectAcquireCreated
+	redirectAcquireNotCommitted
+)
+
+// NotCommitted requires backend proof that no resource was acquired. An error
+// alone, including a lost ACK, does not provide that proof.
+type redirectAcquireResult struct {
+	status redirectAcquireStatus
+	err    error
+}
+
+// Each adapter captures the actual acquired object and frozen release spec.
+// Release must never discover ownership by name or current configuration.
+type redirectResourceOps interface {
+	Acquire(redirectResourceID) redirectAcquireResult
+	Release(redirectResourceID) error
+}
+
+type redirectOwnershipBackend interface {
+	Start(*autoRedirect, *redirectOperation) error
+	UpdateRouteAddressSet(*autoRedirect, *redirectOperation) error
+}
+
+type redirectResource struct {
+	id           redirectResourceID
+	state        redirectResourceState
+	err          error
+	ops          redirectResourceOps
+	requires     []redirectResourceID
+	releasing    bool
+	bindingScope *redirectIPTablesScope
+	transferring bool
+}
+
+type redirectOwnership struct {
+	birth  redirectBirth
+	effect sync.Mutex // admitted writers only; never held while waiting for drain
+
+	access            sync.Mutex
+	drain             *sync.Cond
+	startAttempted    bool
+	running           bool
+	closing           bool
+	operations        int
+	callbacks         int
+	closeDone         chan struct{}
+	closeErr          error
+	failures          error
+	resources         []*redirectResource
+	nftTransaction    uint64 // guarded by access; correlation only, never object identity
+	prerequisites     []redirectResourceID
+	mutationGuard     func() error
+	serviceAnchors    []redirectResourceID
+	namespaceIdentity networkNamespaceIdentity
+}
+
+func newRedirectOwnership() (*redirectOwnership, error) {
+	o := &redirectOwnership{closeDone: make(chan struct{})}
+	if _, err := rand.Read(o.birth[:]); err != nil {
+		return nil, fmt.Errorf("create auto_redirect birth: %w", err)
+	}
+	o.drain = sync.NewCond(&o.access)
+	return o, nil
+}
+
+type redirectOperation struct {
+	owner      *redirectOwnership
+	callback   bool
+	ended      bool // guarded by owner.access
+	effectHeld bool // guarded by owner.access; managed only by withEffect
+}
+
+// withEffect serializes an already admitted control-plane writer. Closing may
+// seal admission while this writer waits; Close still waits for its real return.
+func (p *redirectOperation) withEffect(block func() error) error {
+	p.owner.effect.Lock()
+	defer p.owner.effect.Unlock()
+	p.owner.access.Lock()
+	if p.ended {
+		p.owner.access.Unlock()
+		return errRedirectInvalidACK
+	}
+	p.effectHeld = true
+	guard := p.owner.mutationGuard
+	p.owner.access.Unlock()
+	defer func() {
+		p.owner.access.Lock()
+		p.effectHeld = false
+		p.owner.access.Unlock()
+	}()
+	if guard != nil {
+		if err := invokeRedirectMutationGuard(guard); err != nil {
+			p.owner.requestClose()
+			return errors.Join(errRedirectAmbiguous, err)
+		}
+	}
+	return block()
+}
+
+func redirectRequiresMutationGuard(domain redirectResourceDomain) bool {
+	return domain == redirectIPTables || domain == redirectNFTables || domain == redirectNetlink || domain == redirectFile || domain == redirectReload || domain == redirectTun
+}
+
+// requestClose is safe inside an admitted callback. It seals synchronously and
+// delegates joining to the coordinator, which never waits on its own callback.
+func (o *redirectOwnership) requestClose() {
+	o.access.Lock()
+	start := o.sealCloseLocked()
+	o.access.Unlock()
+	if start {
+		go o.closeSealed()
+	}
+}
+
+// Called with access held, including ambiguous transaction settlement. There
+// must be no admission window between recording Unknown and sealing Closing.
+func (o *redirectOwnership) sealCloseLocked() bool {
+	if o.closing {
+		return false
+	}
+	o.closing = true
+	o.running = false
+	o.drain.Broadcast()
+	return true
+}
+
+func (o *redirectOwnership) beginStart() (*redirectOperation, error) {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if o.closing {
+		return nil, errRedirectClosing
+	}
+	if o.startAttempted {
+		return nil, errRedirectAlreadyStarted
+	}
+	o.startAttempted = true
+	o.operations++
+	return &redirectOperation{owner: o}, nil
+}
+
+func (o *redirectOwnership) beginOperation(callback, requireRunning bool) (*redirectOperation, error) {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if o.closing {
+		return nil, errRedirectClosing
+	}
+	if !o.startAttempted || requireRunning && !o.running {
+		return nil, errRedirectNotStarted
+	}
+	if callback {
+		o.callbacks++
+	} else {
+		o.operations++
+	}
+	return &redirectOperation{owner: o, callback: callback}, nil
+}
+
+func (o *redirectOwnership) finishStart(err error) error {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if err == nil {
+		if o.closing {
+			return errRedirectClosing
+		}
+		o.running = true
+	}
+	return err
+}
+
+func (p *redirectOperation) finish() {
+	o := p.owner
+	o.access.Lock()
+	defer o.access.Unlock()
+	if p.ended {
+		return
+	}
+	p.ended = true
+	if p.callback {
+		o.callbacks--
+	} else {
+		o.operations--
+	}
+	o.drain.Broadcast()
+}
+
+func (o *redirectOwnership) recordPanic(value any) error {
+	err := fmt.Errorf("%w: %v", errRedirectEffectPanic, value)
+	o.recordFailure(err)
+	o.requestClose()
+	return err
+}
+
+func (o *redirectOwnership) recordFailure(err error) {
+	o.access.Lock()
+	o.failures = errors.Join(o.failures, err)
+	o.access.Unlock()
+}
+
+// acquire belongs to an already admitted operation. Close must drain that
+// operation even if the effect completes after Closing, including registration.
+func (p *redirectOperation) acquire(domain redirectResourceDomain, key string, ops redirectResourceOps, requires ...redirectResourceID) (redirectResourceID, error) {
+	return p.acquireIntent(domain, key, ops, nil, requires)
+}
+
+func (p *redirectOperation) acquireIntent(domain redirectResourceDomain, key string, ops redirectResourceOps, bindingScope *redirectIPTablesScope, requires []redirectResourceID) (redirectResourceID, error) {
+	o := p.owner
+	id := redirectResourceID{o.birth, domain, key}
+	o.access.Lock()
+	if p.ended || domain < redirectListener || domain > redirectReadOnlyProbe || key == "" || ops == nil {
+		o.access.Unlock()
+		return id, errors.New("invalid auto_redirect resource intent")
+	}
+	if domain == redirectReadOnlyProbe && !p.effectHeld {
+		o.access.Unlock()
+		return id, errRedirectInvalidACK
+	}
+	if bindingScope != nil {
+		if !p.effectHeld || domain != redirectIPTables || !o.validBindingScopeLocked(*bindingScope) {
+			o.access.Unlock()
+			return id, errRedirectInvalidACK
+		}
+		for _, existing := range o.resources {
+			if existing.state != redirectReleased && existing.bindingScope != nil && *existing.bindingScope == *bindingScope {
+				o.access.Unlock()
+				return id, errors.New("iptables binding hookset is already active")
+			}
+		}
+		requires = o.bindingAnchorsLocked(requires, nil)
+		if err := o.validateBindingDependenciesLocked(requires, nil, id); err != nil {
+			o.access.Unlock()
+			return id, err
+		}
+	}
+	for _, dependency := range o.prerequisites {
+		if dependency != id && !slices.Contains(requires, dependency) {
+			requires = append(slices.Clone(requires), dependency)
+		}
+	}
+	for _, entry := range o.resources {
+		if entry.id == id {
+			o.access.Unlock()
+			return id, errors.New("duplicate auto_redirect resource intent")
+		}
+	}
+	for _, dependency := range requires {
+		if !slices.ContainsFunc(o.resources, func(entry *redirectResource) bool {
+			return entry.id == dependency && entry.state == redirectOwned && !entry.releasing && !entry.transferring
+		}) {
+			o.access.Unlock()
+			return id, errors.New("auto_redirect resource prerequisite is not owned")
+		}
+	}
+	entry := &redirectResource{id: id, state: redirectPending, ops: ops, requires: slices.Clone(requires)}
+	if bindingScope != nil {
+		scope := *bindingScope
+		entry.bindingScope = &scope
+	}
+	o.resources = append(o.resources, entry)
+	o.operations++
+	guard := o.mutationGuard
+	o.access.Unlock()
+
+	var result redirectAcquireResult
+	if guard != nil && redirectRequiresMutationGuard(domain) {
+		if guardErr := invokeRedirectMutationGuard(guard); guardErr != nil {
+			result.err = errors.Join(errRedirectAmbiguous, guardErr)
+		} else {
+			result = invokeRedirectAcquire(ops, id)
+		}
+	} else {
+		result = invokeRedirectAcquire(ops, id)
+	}
+	o.access.Lock()
+	defer func() {
+		startClose := entry.state == redirectAmbiguous && o.sealCloseLocked()
+		o.operations--
+		o.drain.Broadcast()
+		o.access.Unlock()
+		if startClose {
+			go o.closeSealed()
+		}
+	}()
+	switch {
+	case result.status == redirectAcquireCreated && result.err == nil:
+		entry.state = redirectOwned
+	case result.status == redirectAcquireNotCommitted && result.err != nil &&
+		!errors.Is(result.err, errRedirectEffectPanic) && !errors.Is(result.err, errRedirectInvalidACK) && !errors.Is(result.err, errRedirectAmbiguous):
+		entry.state = redirectReleased
+	default:
+		entry.state = redirectAmbiguous
+		if result.status != redirectAcquireUnknown || result.err == nil {
+			result.err = errors.Join(errRedirectInvalidACK, result.err)
+		}
+		result.err = errors.Join(errRedirectAmbiguous, result.err)
+	}
+	entry.err = result.err
+	return id, result.err
+}
+
+func invokeRedirectAcquire(ops redirectResourceOps, id redirectResourceID) (result redirectAcquireResult) {
+	defer func() {
+		if value := recover(); value != nil {
+			result = redirectAcquireResult{err: fmt.Errorf("%w: %v", errRedirectEffectPanic, value)}
+		}
+	}()
+	return ops.Acquire(id)
+}
+
+func invokeRedirectMutationGuard(guard func() error) (err error) {
+	defer func() {
+		if value := recover(); value != nil {
+			err = fmt.Errorf("%w: %v", errRedirectEffectPanic, value)
+		}
+	}()
+	return guard()
+}
+
+func invokeRedirectRelease(ops redirectResourceOps, id redirectResourceID) (err error) {
+	defer func() {
+		if value := recover(); value != nil {
+			err = fmt.Errorf("%w: %v", errRedirectEffectPanic, value)
+		}
+	}()
+	return ops.Release(id)
+}
+
+func (o *redirectOwnership) releaseResources(callbacksOnly bool) {
+	// A live update may append a referent after its original hook. Revisit only
+	// still-Owned blockers after their dependents retire; Ambiguous effects are
+	// never retried. Every progress pass consumes at least one Owned receipt.
+	for {
+		o.access.Lock()
+		entries := slices.Clone(o.resources)
+		o.access.Unlock()
+		progressed := false
+		for index := len(entries) - 1; index >= 0; index-- {
+			entry := entries[index]
+			o.access.Lock()
+			if entry.state != redirectOwned || entry.releasing || entry.transferring || callbacksOnly && entry.id.domain != redirectCallback {
+				o.access.Unlock()
+				continue
+			}
+			o.access.Unlock()
+			_ = o.releaseOwnedResource(entry)
+			o.access.Lock()
+			progressed = progressed || entry.state != redirectOwned
+			o.access.Unlock()
+		}
+		if !progressed {
+			return
+		}
+	}
+}
+
+func (o *redirectOwnership) markServiceAnchors(ids []redirectResourceID) error {
+	o.access.Lock()
+	defer o.access.Unlock()
+	for _, id := range ids {
+		if id.birth != o.birth || id.domain != redirectNetlink || !slices.ContainsFunc(o.resources, func(entry *redirectResource) bool {
+			return entry.id == id && entry.state == redirectOwned && !entry.releasing
+		}) {
+			return errors.New("route service anchor is not a same-birth owned netlink resource")
+		}
+	}
+	for _, id := range ids {
+		if !slices.Contains(o.serviceAnchors, id) {
+			o.serviceAnchors = append(o.serviceAnchors, id)
+		}
+	}
+	return nil
+}
+
+// Called with access held. Acquisition only refers to older Owned entries, so
+// the dependency graph is finite; visited also bounds repeated parent paths.
+func (o *redirectOwnership) dependsOnResource(entry *redirectResource, target redirectResourceID) bool {
+	if entry.id == target {
+		return true
+	}
+	pending := slices.Clone(entry.requires)
+	visited := make(map[redirectResourceID]bool)
+	for len(pending) != 0 {
+		id := pending[len(pending)-1]
+		pending = pending[:len(pending)-1]
+		if id == target {
+			return true
+		}
+		if visited[id] {
+			continue
+		}
+		visited[id] = true
+		for _, parent := range o.resources {
+			if parent.id == id {
+				pending = append(pending, parent.requires...)
+				break
+			}
+		}
+	}
+	return false
+}
+
+func (o *redirectOwnership) hasClosingReference(entry *redirectResource) bool {
+	if !o.closing || entry.id.domain != redirectNetlink {
+		return false
+	}
+	for _, anchor := range o.serviceAnchors {
+		if !o.dependsOnResource(entry, anchor) {
+			continue
+		}
+		for _, holder := range o.resources {
+			domain := holder.id.domain
+			if holder.state != redirectReleased && (domain == redirectNFTables || domain == redirectIPTables || domain == redirectFile || domain == redirectReload) && o.dependsOnResource(holder, anchor) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// release retires a same-birth receipt during an admitted, serialized update.
+// It does not take the effect lock recursively. A retired key remains historical;
+// a replacement gets a new generation key, never a reused resource identity.
+func (p *redirectOperation) release(id redirectResourceID) error {
+	o := p.owner
+	o.access.Lock()
+	if p.ended || id.birth != o.birth {
+		o.access.Unlock()
+		return errRedirectInvalidACK
+	}
+	var entry *redirectResource
+	for _, candidate := range o.resources {
+		if candidate.id == id {
+			entry = candidate
+			break
+		}
+	}
+	o.access.Unlock()
+	if entry == nil {
+		return errRedirectInvalidACK
+	}
+	return o.releaseOwnedResource(entry)
+}
+
+func (o *redirectOwnership) releaseOwnedResource(entry *redirectResource) error {
+	o.access.Lock()
+	if entry.state == redirectReleased {
+		o.access.Unlock()
+		return nil
+	}
+	if entry.transferring {
+		o.access.Unlock()
+		return errRedirectDependency
+	}
+	if entry.state != redirectOwned || entry.releasing {
+		err := errors.Join(errRedirectAmbiguous, entry.err)
+		o.access.Unlock()
+		return err
+	}
+	if o.hasClosingReference(entry) || slices.ContainsFunc(o.resources, func(dependent *redirectResource) bool {
+		return dependent.state != redirectReleased && slices.Contains(dependent.requires, entry.id)
+	}) {
+		entry.err = errRedirectDependency
+		o.access.Unlock()
+		return errRedirectDependency
+	}
+	entry.releasing = true
+	o.operations++
+	guard := o.mutationGuard
+	o.access.Unlock()
+	var err error
+	if guard != nil && redirectRequiresMutationGuard(entry.id.domain) {
+		if err = invokeRedirectMutationGuard(guard); err == nil {
+			err = invokeRedirectRelease(entry.ops, entry.id)
+		}
+	} else {
+		err = invokeRedirectRelease(entry.ops, entry.id)
+	}
+	o.access.Lock()
+	entry.releasing = false
+	if err == nil {
+		entry.state = redirectReleased
+		entry.err = nil
+	} else {
+		entry.state = redirectAmbiguous
+		entry.err = errors.Join(errRedirectAmbiguous, err)
+	}
+	o.operations--
+	o.drain.Broadcast()
+	result := entry.err
+	o.access.Unlock()
+	if err != nil {
+		o.requestClose()
+	}
+	return result
+}
+
+type redirectResourceFuncs struct {
+	acquire func(redirectResourceID) redirectAcquireResult
+	release func(redirectResourceID) error
+}
+
+func (f redirectResourceFuncs) Acquire(id redirectResourceID) redirectAcquireResult {
+	return f.acquire(id)
+}
+func (f redirectResourceFuncs) Release(id redirectResourceID) error { return f.release(id) }
+
+func (o *redirectOwnership) close() error {
+	o.requestClose()
+	<-o.closeDone
+	o.access.Lock()
+	defer o.access.Unlock()
+	return o.closeErr
+}
+
+func (o *redirectOwnership) closeSealed() (err error) {
+	// Each effect panic is recovered at its boundary. Keep completion notification
+	// unconditional too: a concurrent Close must never wait on an abandoned channel.
+	defer func() {
+		if value := recover(); value != nil {
+			err = errors.Join(err, o.recordPanic(value))
+		}
+		o.access.Lock()
+		for o.operations != 0 || o.callbacks != 0 {
+			o.drain.Wait()
+		}
+		err = errors.Join(err, o.failures)
+		for _, entry := range o.resources {
+			if entry.state == redirectPending {
+				entry.state = redirectAmbiguous
+				entry.err = errRedirectAmbiguous
+			}
+			if entry.state != redirectReleased {
+				err = errors.Join(err, entry.err)
+			}
+		}
+		o.closeErr = err
+		close(o.closeDone)
+		o.access.Unlock()
+	}()
+
+	o.releaseResources(true)
+	o.access.Lock()
+	for o.operations != 0 || o.callbacks != 0 {
+		o.drain.Wait()
+	}
+	o.access.Unlock()
+	// A callback registration already Pending at Closing may now be Owned. The
+	// final reverse pass includes it and cannot leave a late registration behind.
+	o.releaseResources(false)
+	return nil
+}
