+func cNativeActorChild(t *testing.T, fw4 bool) {
+	t.Helper()
+	ctx := context.Background()
+	// G must select the exact case and role in its separately frozen assembly;
+	// no FD/environment parsing or guessed default role lives in C.
+	if cNativeG == nil {
+		t.Fatal(errCNativeUnfrozen)
+	}
+	if cNativeG.ActorSelection == nil || cNativeG.VerifyActorSelection == nil {
+		t.Fatal(errCNativeUnfrozen)
+	}
+	selection, err := cNativeG.ActorSelection(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var c cNativeCase
+	for _, candidate := range cNativeAllCases() {
+		if candidate.path() == selection.Case {
+			c = candidate
+			break
+		}
+	}
+	if c.Top == "" || slices.ContainsFunc(cNativeFW4Cases, func(v cNativeCase) bool { return v.path() == c.path() }) != fw4 {
+		t.Fatal("wrong actor exact case/family")
+	}
+	a, err := cNativeAdmit(ctx, c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cNativeG.VerifyActorSelection(ctx, a, selection); err != nil {
+		t.Fatal(err)
+	}
+	actor, err := cNativeAssembleActor(a, c, selection)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cNativeG.ServeActor(ctx, a, actor); err != nil {
+		t.Fatal(err)
+	}
+}
