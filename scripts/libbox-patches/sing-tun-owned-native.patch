+func rNativeEarlyForeign(c rNativeCase, in *rNativeLauncherInputs, o Options, deadline time.Time) error {
+	lease, err := newNetworkNamespaceLease(o.NetNs)
+	if err != nil {
+		return err
+	}
+	defer lease.Close()
+	api, err := openRouteNetlink(lease)
+	if err != nil {
+		return err
+	}
+	defer api.Close()
+	var route netlink.Route
+	var rule *netlink.Rule
+	if c.Sub == "foreign_priority_early_refusal" {
+		rule = netlink.NewRule()
+		rule.Family = unix.AF_INET
+		rule.Priority = o.IPRoute2RuleIndex
+		rule.Table = 254
+		rule = cloneRule(rule)
+		if err := api.RuleAdd(rule); err != nil {
+			return err
+		}
+	} else {
+		lo, err := api.LinkByName("lo")
+		if err != nil {
+			return err
+		}
+		route = normalizeOwnedRoute(netlink.Route{Family: unix.AF_INET, Dst: prefixToIPNet(netip.MustParsePrefix("198.18.250.0/24")), Table: o.IPRoute2TableIndex, LinkIndex: lo.Attrs().Index})
+		if err := api.RouteAdd(&route); err != nil {
+			return err
+		}
+	}
+	openedTun := 0
+	device, err := newOwnedNativeTun(o, nativeTunDependencies{claimDirectory: redirectClaimDirectory, openHandle: openRouteNetlink, openTun: func(name string, gso, multi, exclusive bool) (int, bool, error) {
+		openedTun++
+		return openOwnedTun(name, gso, multi, exclusive)
+	}})
+	if device != nil || !errors.Is(err, unix.EEXIST) || openedTun != 0 {
+		return fmt.Errorf("early refusal wrong source: component=%v error=%v TUNcalls=%d", device, err, openedTun)
+	}
+	// The refused constructor has internally closed and returned nil. There is
+	// no B Start/Dispose/Close/callback here or in its evidence.
+	if rule != nil {
+		if err := validateOwnedRuleForDelete(api, rule, func(r *netlink.Rule) bool { return reflect.DeepEqual(r, rule) }); err != nil {
+			return err
+		}
+		if err := api.RuleDel(rule); err != nil {
+			return err
+		}
+	} else {
+		if err := validateOwnedRouteForDelete(api, route); err != nil {
+			return err
+		}
+		if err := api.RouteDel(&route); err != nil {
+			return err
+		}
+	}
+	return rNativeEmit(c, in, "allocator_preflight_eexist_before_tun", struct {
+		ReturnedNil  bool
+		TUNCalls     int
+		BStartCalled bool
+	}{true, openedTun, false})
+}
