+package tun
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+)
+
+// A binding is the complete own public hookset for one family/table. Only the
+// typed acquisition path records this role; private chains/rules cannot cast it.
+type redirectIPTablesBinding struct {
+	resource redirectResourceID
+	scope    redirectIPTablesScope
+}
+
+type redirectIPTablesBindingTransferIntent struct {
+	scope redirectIPTablesScope
+	old   []redirectResourceID
+	next  redirectResourceID
+}
+
+type redirectIPTablesBindingTransferACK struct {
+	scope redirectIPTablesScope
+	old   []redirectResourceID
+	next  redirectResourceID
+}
+
+type redirectIPTablesBindingTransferResult struct {
+	status redirectAcquireStatus
+	ack    *redirectIPTablesBindingTransferACK
+	err    error
+}
+
+// ACK correlation cannot prove a native transaction. The adapter must obtain
+// it only from actual Wait0 of the original frozen single-table restore Cmd.
+type redirectIPTablesBindingOps interface {
+	redirectResourceOps
+	Transfer(redirectIPTablesBindingTransferIntent) redirectIPTablesBindingTransferResult
+}
+
+// The factory performs no effects. Acquire starts only after common Pending;
+// Release only consumes custody of the same actually-Waited read-only Cmd.
+type redirectIPTablesReadonlyProbeBackend interface {
+	ReadonlyIPTablesProbe(redirectIPTablesReadonlyProbeIntent) (redirectResourceOps, error)
+}
+
+type redirectIPTablesReadonlyProbeIntent struct {
+	scope   redirectIPTablesScope
+	binary  string
+	context context.Context
+}
+
+func (i redirectIPTablesReadonlyProbeIntent) arguments() []string {
+	return []string{"-w", "2", "-t", iptablesTableNAT, "-S"}
+}
+
+func (o *redirectOwnership) validBindingScopeLocked(scope redirectIPTablesScope) bool {
+	return scope.valid() && o.mutationGuard != nil &&
+		scope.namespace == (redirectNamespaceIdentity{o.namespaceIdentity.Device, o.namespaceIdentity.Inode})
+}
+
+func (o *redirectOwnership) resourceLocked(id redirectResourceID) *redirectResource {
+	for _, entry := range o.resources {
+		if entry.id == id {
+			return entry
+		}
+	}
+	return nil
+}
+
+func appendRedirectRequirements(ids []redirectResourceID, more ...redirectResourceID) []redirectResourceID {
+	for _, id := range more {
+		if !slices.Contains(ids, id) {
+			ids = append(ids, id)
+		}
+	}
+	return ids
+}
+
+// Caller holds access. R's route-selection claim can be below the old graph,
+// outside serviceAnchors; preserve it when the binding moves to the new graph.
+func (o *redirectOwnership) bindingAnchorsLocked(requires []redirectResourceID, old []*redirectResource) []redirectResourceID {
+	result := appendRedirectRequirements(nil, requires...)
+	result = appendRedirectRequirements(result, o.prerequisites...)
+	for _, entry := range o.resources {
+		if entry.state == redirectOwned && (entry.id.domain == redirectListener || entry.id.domain == redirectNFQueue || entry.id.domain == redirectNamespace || entry.id.domain == redirectClaim) {
+			result = appendRedirectRequirements(result, entry.id)
+		}
+	}
+	for _, id := range o.serviceAnchors {
+		if entry := o.resourceLocked(id); entry != nil && entry.state == redirectOwned {
+			result = appendRedirectRequirements(result, id)
+		}
+	}
+	var pending []redirectResourceID
+	for _, entry := range old {
+		pending = append(pending, entry.requires...)
+	}
+	visited := make(map[redirectResourceID]bool)
+	for len(pending) != 0 {
+		id := pending[len(pending)-1]
+		pending = pending[:len(pending)-1]
+		if visited[id] {
+			continue
+		}
+		visited[id] = true
+		entry := o.resourceLocked(id)
+		if entry == nil {
+			continue
+		}
+		domain := id.domain
+		if entry.state == redirectOwned && (domain == redirectListener || domain == redirectNFQueue || domain == redirectNetlink || domain == redirectClaim || domain == redirectNamespace) {
+			result = appendRedirectRequirements(result, id)
+		}
+		pending = append(pending, entry.requires...)
+	}
+	return result
+}
+
+func (o *redirectOwnership) validateBindingDependenciesLocked(requires, old []redirectResourceID, next redirectResourceID) error {
+	visited := make(map[redirectResourceID]uint8)
+	var visit func(redirectResourceID) error
+	visit = func(id redirectResourceID) error {
+		if id == next || id.birth != o.birth || slices.Contains(old, id) || visited[id] == 1 {
+			return errors.New("invalid iptables binding dependency cycle or identity")
+		}
+		if visited[id] == 2 {
+			return nil
+		}
+		entry := o.resourceLocked(id)
+		if entry == nil || entry.state != redirectOwned || entry.releasing || entry.transferring {
+			return errors.New("iptables binding prerequisite is not owned")
+		}
+		visited[id] = 1
+		for _, dependency := range entry.requires {
+			if err := visit(dependency); err != nil {
+				return err
+			}
+		}
+		visited[id] = 2
+		return nil
+	}
+	for _, id := range requires {
+		if err := visit(id); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (p *redirectOperation) acquireIPTablesBinding(scope redirectIPTablesScope, key string, ops redirectIPTablesBindingOps, requires ...redirectResourceID) (redirectIPTablesBinding, error) {
+	id, err := p.acquireIntent(redirectIPTables, key, ops, &scope, slices.Clone(requires))
+	return redirectIPTablesBinding{id, scope}, err
+}
+
+// Caller already holds this operation's effect gate. This is the one atomic
+// ledger handoff for an adapter's exact same-table transaction, never a delete
+// closure substitution or a generic state-edit interface.
+func (p *redirectOperation) replaceIPTablesBindings(old []redirectIPTablesBinding, key string, ops redirectIPTablesBindingOps, nextRequires []redirectResourceID) (redirectIPTablesBinding, error) {
+	old = slices.Clone(old)
+	nextRequires = slices.Clone(nextRequires)
+	o := p.owner
+	id := redirectResourceID{o.birth, redirectIPTables, key}
+	var scope redirectIPTablesScope
+	if len(old) != 0 {
+		scope = old[0].scope
+	}
+	next := redirectIPTablesBinding{id, scope}
+	o.access.Lock()
+	if p.ended || !p.effectHeld || len(old) == 0 || key == "" || ops == nil || !o.validBindingScopeLocked(scope) || o.resourceLocked(id) != nil {
+		o.access.Unlock()
+		return next, errRedirectInvalidACK
+	}
+	oldIDs := make([]redirectResourceID, 0, len(old))
+	oldEntries := make([]*redirectResource, 0, len(old))
+	for _, binding := range old {
+		entry := o.resourceLocked(binding.resource)
+		if binding.resource.birth != o.birth || binding.scope != scope || slices.Contains(oldIDs, binding.resource) || entry == nil || entry.bindingScope == nil || *entry.bindingScope != scope || entry.state != redirectOwned || entry.releasing || entry.transferring {
+			o.access.Unlock()
+			return next, errRedirectInvalidACK
+		}
+		oldIDs = append(oldIDs, binding.resource)
+		oldEntries = append(oldEntries, entry)
+	}
+	for _, entry := range o.resources {
+		if entry.state == redirectReleased {
+			continue
+		}
+		if entry.bindingScope != nil && *entry.bindingScope == scope && !slices.Contains(oldIDs, entry.id) {
+			o.access.Unlock()
+			return next, errors.New("iptables transfer omitted part of its own hookset")
+		}
+		if slices.Contains(oldIDs, entry.id) {
+			continue
+		}
+		for _, oldID := range oldIDs {
+			if o.dependsOnResource(entry, oldID) {
+				o.access.Unlock()
+				return next, errRedirectDependency
+			}
+		}
+	}
+	effectiveRequires := o.bindingAnchorsLocked(nextRequires, oldEntries)
+	if err := o.validateBindingDependenciesLocked(effectiveRequires, oldIDs, id); err != nil {
+		o.access.Unlock()
+		return next, err
+	}
+	for _, entry := range oldEntries {
+		if err := o.validateBindingDependenciesLocked(entry.requires, nil, entry.id); err != nil {
+			o.access.Unlock()
+			return next, err
+		}
+	}
+	pendingRequires := appendRedirectRequirements(slices.Clone(effectiveRequires), oldIDs...)
+	for _, entry := range oldEntries {
+		pendingRequires = appendRedirectRequirements(pendingRequires, entry.requires...)
+	}
+	frozenScope := scope
+	entry := &redirectResource{id: id, state: redirectPending, ops: ops, requires: pendingRequires, bindingScope: &frozenScope}
+	o.resources = append(o.resources, entry)
+	for _, oldEntry := range oldEntries {
+		oldEntry.transferring = true
+	}
+	o.operations++
+	guard := o.mutationGuard
+	o.access.Unlock()
+
+	intent := redirectIPTablesBindingTransferIntent{scope, oldIDs, id}
+	var result redirectIPTablesBindingTransferResult
+	if err := invokeRedirectMutationGuard(guard); err != nil {
+		result.err = errors.Join(errRedirectAmbiguous, err)
+	} else {
+		result = invokeRedirectBindingTransfer(ops, intent)
+	}
+	validACK := result.ack != nil && result.ack.scope == scope && result.ack.next == id && slices.Equal(result.ack.old, oldIDs)
+	o.access.Lock()
+	startClose := false
+	switch {
+	case result.status == redirectAcquireCreated && result.err == nil && validACK:
+		for _, oldEntry := range oldEntries {
+			oldEntry.state, oldEntry.err = redirectReleased, nil
+		}
+		entry.state, entry.requires = redirectOwned, slices.Clone(effectiveRequires)
+	case result.status == redirectAcquireNotCommitted && result.err != nil && result.ack == nil && !errors.Is(result.err, errRedirectEffectPanic) && !errors.Is(result.err, errRedirectInvalidACK) && !errors.Is(result.err, errRedirectAmbiguous):
+		entry.state = redirectReleased
+	default:
+		if result.status != redirectAcquireUnknown || result.err == nil || result.ack != nil {
+			result.err = errors.Join(errRedirectInvalidACK, result.err)
+		}
+		result.err = errors.Join(errRedirectAmbiguous, result.err)
+		entry.state = redirectAmbiguous
+		for _, oldEntry := range oldEntries {
+			oldEntry.state, oldEntry.err = redirectAmbiguous, result.err
+		}
+		startClose = o.sealCloseLocked()
+	}
+	entry.err = result.err
+	for _, oldEntry := range oldEntries {
+		oldEntry.transferring = false
+	}
+	o.operations--
+	o.drain.Broadcast()
+	o.access.Unlock()
+	if startClose {
+		go o.closeSealed()
+	}
+	return next, result.err
+}
+
+func invokeRedirectBindingTransfer(ops redirectIPTablesBindingOps, intent redirectIPTablesBindingTransferIntent) (result redirectIPTablesBindingTransferResult) {
+	defer func() {
+		if value := recover(); value != nil {
+			result = redirectIPTablesBindingTransferResult{err: fmt.Errorf("%w: %v", errRedirectEffectPanic, value)}
+		}
+	}()
+	intent.old = slices.Clone(intent.old)
+	result = ops.Transfer(intent)
+	if result.ack != nil {
+		ack := *result.ack
+		ack.old = slices.Clone(ack.old)
+		result.ack = &ack
+	}
+	return result
+}
+
+func (r *autoRedirect) readonlyIPTablesProbe(op *redirectOperation, firewall redirectFirewallBackend) error {
+	backend, ok := firewall.(redirectIPTablesReadonlyProbeBackend)
+	if !ok {
+		return ErrAutoRedirectOwnershipUnsupported
+	}
+	if r.namespaceLease == nil || r.conflictClaims == nil {
+		return errRedirectInvalidACK
+	}
+	r.ownership.access.Lock()
+	validOperation := op != nil && op.owner == r.ownership && !op.ended && op.effectHeld
+	r.ownership.access.Unlock()
+	if !validOperation {
+		return errRedirectInvalidACK
+	}
+	if err := r.conflictClaims.Validate(); err != nil {
+		r.ownership.requestClose()
+		return errors.Join(errRedirectAmbiguous, err)
+	}
+	actual := r.namespaceLease.Identity()
+	intent := redirectIPTablesReadonlyProbeIntent{
+		scope:   redirectIPTablesScope{redirectNamespaceIdentity{actual.Device, actual.Inode}, 4, iptablesTableNAT},
+		binary:  r.iptablesPath,
+		context: r.ctx,
+	}
+	ops, err := backend.ReadonlyIPTablesProbe(intent)
+	if err != nil {
+		return err
+	}
+	id, err := op.acquire(redirectReadOnlyProbe, "iptables-capability/4/nat", ops)
+	if err != nil {
+		return err
+	}
+	return op.release(id)
+}
