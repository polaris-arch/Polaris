+func newIProductionFixture(t *testing.T, bothFamilies bool) *testIProductionFixture {
+	t.Helper()
+	f := &testIProductionFixture{r: newOwnershipTestRedirect(t)}
+	r, owner := f.r, f.r.ownership
+	r.tunOptions.Name = "tun-offline-fixture"
+	r.tunOptions.Inet4Address = []netip.Prefix{netip.MustParsePrefix("172.19.0.1/30")}
+	r.customRedirectPort, r.enableIPv4 = 23456, true
+	f.finder = &testIInterfaceFinder{locals: []netip.Prefix{netip.MustParsePrefix("127.0.0.0/8")}}
+	r.interfaceFinder = f.finder
+	r.namespaceLease = testINamespaceLease(t)
+	identity := r.namespaceLease.Identity()
+	owner.namespaceIdentity = identity
+	owner.mutationGuard = func() error { return nil }
+	directory := t.TempDir()
+	f.restore, f.fault = filepath.Join(directory, "harmless-restore"), filepath.Join(directory, "fail-filter")
+	f.privateFault = filepath.Join(directory, "fail-private-delete")
+	privateBinary := filepath.Join(directory, "harmless-private")
+	privateScript := "#!/bin/sh\nif [ -f '" + f.privateFault + "' ]; then\ncase \"$5\" in -D|-X) exit 4;; esac\nfi\nexit 0\n"
+	if err := os.WriteFile(privateBinary, []byte(privateScript), 0700); err != nil {
+		t.Fatal(err)
+	}
+	// This process only consumes stdin. A selected actual nonzero native exit
+	// exercises the adapter's ambiguity boundary without touching any network.
+	script := "#!/bin/sh\nIFS= read -r table || exit 1\n/bin/cat >/dev/null || exit 1\n" +
+		"[ \"$table\" != '*filter' ] || [ ! -f '" + f.fault + "' ] || exit 4\nexit 0\n"
+	if err := os.WriteFile(f.restore, []byte(script), 0700); err != nil {
+		t.Fatal(err)
+	}
+	f.backend = &iptablesProductionBackend{
+		ctx: r.ctx, birth: owner.birth, namespace: r.namespaceLease, runner: new(iptablesCommandRunner),
+		programs: []iptablesPreparedFamily{{path: privateBinary, restorePath: f.restore}},
+	}
+	if bothFamilies {
+		r.tunOptions.Inet6Address = []netip.Prefix{netip.MustParsePrefix("fd00::1/126")}
+		r.enableIPv6 = true
+		f.finder.locals = append(f.finder.locals, netip.MustParsePrefix("::1/128"))
+		f.backend.programs = append(f.backend.programs, iptablesPreparedFamily{path: privateBinary, restorePath: f.restore, isIPv6: true, tproxy: true})
+	}
+	f.backend.runner.wait = func(command *exec.Cmd) error {
+		observation := testICommandObservation{slices.Clone(command.Args[1:]), testICommandInput(t, command)}
+		f.access.Lock()
+		f.commands = append(f.commands, observation)
+		f.access.Unlock()
+		if f.beforeWait != nil {
+			f.beforeWait(command, observation)
+		}
+		err := command.Wait()
+		if f.afterWait != nil {
+			f.afterWait(command, observation, err)
+		}
+		return err
+	}
+	r.ownershipBackend = testIOwnershipIAdapter{f}
+	op, err := owner.beginStart()
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = op.withEffect(func() error {
+		for _, domain := range []redirectResourceDomain{redirectNamespace, redirectClaim, redirectListener, redirectNFQueue, redirectNetlink} {
+			id, acquireErr := op.acquire(domain, "offline-anchor", redirectResourceFuncs{
+				acquire: func(redirectResourceID) redirectAcquireResult {
+					return redirectAcquireResult{status: redirectAcquireCreated}
+				},
+				release: func(redirectResourceID) error { f.releases.Add(1); return nil },
+			}, f.anchors...)
+			if acquireErr != nil {
+				return acquireErr
+			}
+			f.anchors = append(f.anchors, id)
+		}
+		owner.access.Lock()
+		owner.prerequisites = slices.Clone(f.anchors[:2])
+		owner.access.Unlock()
+		if markErr := owner.markServiceAnchors(f.anchors[4:]); markErr != nil {
+			return markErr
+		}
+		return f.backend.Start(r, op, f.anchors)
+	})
+	err = owner.finishStart(err)
+	op.finish()
+	if err != nil {
+		t.Fatal("actual adapter Start failed", err)
+	}
+	t.Cleanup(func() { _ = owner.close() })
+	return f
+}
