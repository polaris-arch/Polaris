+		return redirectAcquireResult{status: redirectAcquireCreated}
+	}, release: func(redirectResourceID) error { return e.stopDockerMonitor() }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	op.finish()
+	done := make(chan error, 1)
+	go func() { done <- r.Close() }()
+	ownershipAwait(t, closing)
+	if _, err = r.ownership.beginOperation(true, false); !errors.Is(err, errRedirectClosing) {
+		t.Fatal("monitor still admits a Closing callback")
+	}
+	if err = e.dockerRetirementAdmission(r); !errors.Is(err, errRedirectDependency) {
+		t.Fatal("own deletion admitted before loop join")
+	}
+	select {
+	case <-done:
+		t.Fatal("socket/Monitor.Close mistaken for loop join")
+	default:
+	}
+	// A queued foreign event is drained after sealing without opening NFT IO.
+	table := &nftables.Table{Name: "filter", Family: nftables.TableFamilyIPv4}
+	events <- &nftables.MonitorEvents{Changes: []*nftables.MonitorEvent{{Data: table}}}
+	close(events)
+	if err = ownershipAwait(t, done); err != nil {
+		t.Fatal(err)
+	}
+	if !e.dockerMonitorDrained() || e.dockerRetirementAdmission(r) != nil {
+		t.Fatal("joined monitor did not allow retirement")
+	}
+	failed := &redirectEnvironmentRuntime{monitorStarted: true, monitorDone: make(chan struct{}), monitorConn: cMonitorCloser{func() error { return unix.EIO }}, monitor: cMonitorCloser{func() error { return nil }}}
+	if err = failed.stopDockerMonitor(); !errors.Is(err, unix.EIO) || failed.dockerMonitorDrained() {
+		t.Fatal("failed socket close invented join")
+	}
+	if err = failed.dockerRetirementAdmission(r); !errors.Is(err, errRedirectDependency) {
+		t.Fatal("delete admitted after failed close")
+	}
+}
