+// These are definite rejected single CREATE|EXCL requests, not transport
+// timeout/lost ACK errors. EEXIST/EBUSY never confer a release right.
+func routeAcquireResult(err error) redirectAcquireResult {
+	if err == nil {
+		return redirectAcquireResult{status: redirectAcquireCreated}
+	}
+	for _, rejected := range []error{unix.EEXIST, unix.EBUSY, unix.EINVAL, unix.EPERM, unix.EACCES, unix.ENODEV, unix.ENOENT, unix.EOPNOTSUPP} {
+		if errors.Is(err, rejected) {
+			return redirectAcquireResult{redirectAcquireNotCommitted, err}
+		}
+	}
+	return redirectAcquireResult{err: err}
+}
