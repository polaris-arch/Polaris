+	{"TestCNativeFW4IndependentIncludes", "B_normal_retire_preserves_A", "fw4-retire", 100 * time.Second, []string{"A_committed", "A_before", "B_committed", "B_file_unlinked", "B_original_Wait0", "complete_semantic_GENID", "A_after"}, "", false},
+	{"TestCNativeFW4Barriers", "live_Pending_holder_coordinator_refusal", "fw4-live-Pending", 120 * time.Second, []string{"A_committed", "A_before", "H_live_Pending", "B_lockCoordinator_refusal", "checkOtherJournals_not_reached", "A_after"}, "Start", false},
