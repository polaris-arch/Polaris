+	r.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+		var err error
+		anchor, err = op.acquire(redirectNetlink, "route-service", owned(func() error { return nil }))
+		if err != nil {
+			return err
+		}
+		child, err = op.acquire(redirectNetlink, "route-generation-1", owned(func() error { childReleases.Add(1); return nil }), anchor)
+		if err != nil {
+			return err
+		}
+		hook, err = op.acquire(redirectNFTables, "reachable-hook", owned(func() error { return nil }), anchor)
+		return err
+	}}
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	op, err := r.ownership.beginOperation(false, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = op.withEffect(func() error {
+		foreign := child
+		foreign.birth[0] ^= 1
+		if err := op.release(foreign); !errors.Is(err, errRedirectInvalidACK) {
+			return errors.New("foreign retirement accepted")
+		}
+		if err := op.release(anchor); !errors.Is(err, errRedirectDependency) {
+			return errors.New("live anchor retirement accepted")
+		}
+		if err := op.release(child); err != nil {
+			return err
+		}
+		if err := op.release(child); err != nil {
+			return err
+		}
+		if childReleases.Load() != 1 {
+			return errors.New("child release repeated")
+		}
+		if err := op.release(anchor); !errors.Is(err, errRedirectDependency) {
+			return errors.New("hook dependency disappeared")
+		}
+		if err := op.release(hook); err != nil {
+			return err
+		}
+		return op.release(anchor)
+	})
+	op.finish()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = r.Close(); err != nil {
+		t.Fatal(err)
+	}
