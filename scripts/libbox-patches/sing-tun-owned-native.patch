+)
+
+// Independent physical tuples, not the implementation's string key/hash.
+type ownershipNFTPhysicalAddress struct {
+	device, inode uint64
+	family        redirectNFTFamily
+	kind          redirectNFTKind
+	table, chain  string
+}
+
+func ownershipNFTPhysical(a redirectNFTAddress) ownershipNFTPhysicalAddress {
+	return ownershipNFTPhysicalAddress{a.scope.namespace.device, a.scope.namespace.inode, a.scope.family, a.kind, a.table, a.chain}
+}
+
+type ownershipNFTFakeWorld struct {
+	access       sync.Mutex
+	objects      map[ownershipNFTPhysicalAddress]redirectNFTIdentity
+	nextCreation uint64
+	deleted      []redirectNFTIdentity
+}
+
+func newOwnershipNFTFakeWorld(scope redirectNFTScope) *ownershipNFTFakeWorld {
+	table := redirectNFTObjectIdentity{address: redirectNFTAddress{scope: scope, kind: redirectNFTTable, table: "sing-box"}, spec: redirectNFTSpec{version: 1, kind: redirectNFTTable}, handle: 700, incarnation: 1}
+	chain := redirectNFTObjectIdentity{address: redirectNFTAddress{scope: scope, kind: redirectNFTChain, table: "sing-box", chain: "prerouting"}, spec: redirectNFTSpec{version: 1, kind: redirectNFTChain}, handle: 700, incarnation: 2}
+	return &ownershipNFTFakeWorld{objects: map[ownershipNFTPhysicalAddress]redirectNFTIdentity{
+		ownershipNFTPhysical(table.address): {object: table},
+		ownershipNFTPhysical(chain.address): {object: chain, parent: table},
+	}, nextCreation: 100}
+}
+
+func (w *ownershipNFTFakeWorld) snapshot(except redirectBirth) map[ownershipNFTPhysicalAddress]redirectNFTIdentity {
+	w.access.Lock()
+	defer w.access.Unlock()
+	result := maps.Clone(w.objects)
+	for address, identity := range result {
+		if identity.object.stamp.birth == except {
+			delete(result, address)
+		}
+	}
+	return result
+}
+
+func (w *ownershipNFTFakeWorld) assertPreserved(t *testing.T, except redirectBirth, before map[ownershipNFTPhysicalAddress]redirectNFTIdentity) {
+	t.Helper()
+	if after := w.snapshot(except); !reflect.DeepEqual(before, after) {
+		t.Fatalf("foreign nft state changed: before=%v after=%v", before, after)
+	}
+}
+
+type ownershipNFTFakeOps struct {
+	access      sync.Mutex
+	world       *ownershipNFTFakeWorld
+	owner       *redirectOwnership
+	mode        string
+	failMember  int
+	releaseMode string
+	releaseKind redirectNFTKind
+	mutateInput bool
+	forceHandle uint64
+	before      func(redirectNFTBatch) error
+	batches     []redirectNFTBatch
+	releases    []redirectNFTIdentity
+}
+
+func (f *ownershipNFTFakeOps) journal() []redirectNFTBatch {
+	f.access.Lock()
+	defer f.access.Unlock()
+	return slices.Clone(f.batches)
+}
+
+func (f *ownershipNFTFakeOps) releaseAttempts() []redirectNFTIdentity {
+	f.access.Lock()
+	defer f.access.Unlock()
+	return slices.Clone(f.releases)
+}
+
+func (f *ownershipNFTFakeOps) SubmitCreateBatch(batch redirectNFTBatch) redirectNFTBatchResult {
+	f.access.Lock()
+	f.batches = append(f.batches, batch.clone())
+	f.access.Unlock()
+	result := redirectNFTBatchResult{transaction: batch.transaction}
+	abort := func(err error) redirectNFTBatchResult {
+		return redirectNFTBatchResult{transaction: batch.transaction, status: redirectAcquireNotCommitted, err: err}
+	}
+	// Every buffered member, including tables preceding a helper's current
+	// logical call, must already be Pending and in the same parent-first order.
+	wanted := make([]redirectResourceID, len(batch.members))
+	for index, member := range batch.members {
+		wanted[index] = member.id
+	}
+	var recorded []redirectResourceID
+	for _, entry := range ownershipEntries(f.owner) {
+		if slices.Contains(wanted, entry.id) {
+			if entry.state != redirectPending {
+				result.status, result.err = redirectAcquireNotCommitted, errors.New("submit before all members Pending")
+				return result
+			}
+			recorded = append(recorded, entry.id)
+		}
+	}
+	if !slices.Equal(recorded, wanted) || batch.transaction.birth != f.owner.birth || batch.transaction.sequence == 0 {
+		result.status, result.err = redirectAcquireNotCommitted, errors.New("unaccounted nft queue")
+		return result
+	}
+	if f.before != nil {
+		if err := f.before(batch); err != nil {
+			result.status, result.err = redirectAcquireNotCommitted, err
+			return result
+		}
+	}
+	if f.mode == "panic-before" {
+		panic("nft submit before apply")
+	}
+	f.world.access.Lock()
+	defer f.world.access.Unlock()
+	shadow := maps.Clone(f.world.objects)
+	for _, prerequisite := range batch.prerequisites {
+		if shadow[ownershipNFTPhysical(prerequisite.object.address)] != prerequisite {
+			result.status, result.err = redirectAcquireNotCommitted, errors.New("replaced nft prerequisite")
+			return result
+		}
+		if prerequisite.parent != (redirectNFTObjectIdentity{}) && shadow[ownershipNFTPhysical(prerequisite.parent.address)].object != prerequisite.parent {
+			result.status, result.err = redirectAcquireNotCommitted, errors.New("replaced prerequisite parent")
+			return result
+		}
+	}
+	for index, member := range batch.members {
+		if f.mode == "abort" && index == f.failMember {
+			return abort(ownershipTestFailure)
+		}
+		address := ownershipNFTPhysical(member.address)
+		if _, exists := shadow[address]; exists {
+			return abort(syscall.EEXIST)
+		}
+		f.world.nextCreation++
+		identity := redirectNFTIdentity{object: redirectNFTObjectIdentity{member.id, member.address, member.stamp, member.spec, f.world.nextCreation, f.world.nextCreation}}
+		if member.address.kind == redirectNFTChain {
+			parentAddress := address
+			parentAddress.kind, parentAddress.chain = redirectNFTTable, ""
+			parent, exists := shadow[parentAddress]
+			if !exists || parent.object.id != member.parent || parent.object.stamp.birth != batch.transaction.birth {
+				return abort(errors.New("foreign or missing nft parent"))
+			}
+			identity.parent = parent.object
+		}
+		shadow[address] = identity
+		result.receipts = append(result.receipts, identity)
+		if f.mode == "partial-apply" && index == 0 {
+			f.world.objects = shadow // deliberately violate atomic adapter contract
+			result.status = redirectAcquireCreated
+			return result
+		}
+	}
+	f.world.objects = shadow
+	result.status = redirectAcquireCreated
+	if f.forceHandle != 0 {
+		for index := range result.receipts {
+			if result.receipts[index].object.address.kind == redirectNFTChain {
+				result.receipts[index].object.handle = f.forceHandle
+			}
+		}
+	}
+	if f.mutateInput {
+		batch.members[0].id.key = "backend-mutated"
+		for _, member := range batch.members {
+			if len(member.requires) != 0 {
+				member.requires[0].key = "backend-mutated-prerequisite"
+			}
+		}
+		clear(batch.prerequisites)
+	}
+	switch f.mode {
+	case "lost-ack":
+		result.status, result.receipts, result.err = redirectAcquireUnknown, nil, ownershipTestFailure
+	case "panic-after":
+		panic("nft submit after apply")
+	case "committed-error":
+		result.err = ownershipTestFailure
+	case "missing-member":
+		result.receipts = result.receipts[:len(result.receipts)-1]
+	case "extra-member":
+		result.receipts = append(result.receipts, result.receipts[0])
+	case "duplicate-member":
+		result.receipts[1] = result.receipts[0]
+	case "wrong-transaction":
+		result.transaction.sequence--
+	case "wrong-birth":
+		result.receipts[0].object.stamp.birth[0] ^= 1
+	case "wrong-namespace":
+		result.receipts[0].object.address.scope.namespace.inode++
+	case "wrong-family":
+		result.receipts[0].object.address.scope.family = 255
+	case "wrong-spec":
+		result.receipts[0].object.spec.version++
+	case "wrong-id":
+		result.receipts[0].object.id.key += "/wrong"
+	case "zero-handle":
+		result.receipts[0].object.handle = 0
+	case "zero-incarnation":
+		result.receipts[0].object.incarnation = 0
+	case "wrong-parent":
+		result.receipts[1].parent.incarnation++
+	case "table-with-parent":
+		result.receipts[0].parent = result.receipts[0].object
+	case "invalid-enum":
+		result.status = 255
+	case "invalid-abort":
+		result.status, result.err = redirectAcquireNotCommitted, ownershipTestFailure
+	case "reordered-receipts":
+		slices.Reverse(result.receipts)
+	}
+	return result
+}
