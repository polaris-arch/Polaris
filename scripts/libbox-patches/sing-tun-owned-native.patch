+func TestActualNFTSnapshotNetworkUsesConfirmedBindingBeforeConsumerPublication(t *testing.T) {
+	base := &runtimeFirewallTransport{}
+	r := newRuntimeProductionRedirect(t, filepath.Join(t.TempDir(), "claims"), base)
+	monitor := &ownershipFakeNetworkMonitor{}
+	r.networkMonitor = monitor
+	live := []netip.Prefix{netip.MustParsePrefix("192.0.2.0/24")}
+	getterCalls := 0
+	r.routeAddressSet = func() ([]netip.Prefix, []netip.Prefix, error) { getterCalls++; return slices.Clone(live), nil, nil }
+	n := &redirectNFTRuntime{bindingsConfirmed: true, includeAddresses: slices.Clone(live)}
+	backend := &nftSnapshotPhaseFirewall{runtimeFirewallTransport: base, nft: n, entered: make(chan struct{}), resume: make(chan struct{}), cleanupErr: unix.EBUSY}
+	r.productionDependencies.firewall = func(*autoRedirect) (redirectFirewallBackend, error) { return backend, nil }
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	var err error
+	n.localAddresses, err = r.collectNFTLocalAddresses()
+	if err != nil {
+		t.Fatal(err)
+	}
+	getterCalls = 0
+	candidate := []netip.Prefix{netip.MustParsePrefix("198.51.100.0/24")}
+	type outcome struct {
+		result RouteAddressSetUpdateResult
+		err    error
+	}
+	updated := make(chan outcome, 1)
+	go func() {
+		result, err := r.UpdateRouteAddressSetSnapshot(17, candidate, nil)
+		updated <- outcome{result, err}
+	}()
+	ownershipAwait(t, backend.entered)
+	// Network admission while the candidate is pending waits for the same effect
+	// gate. Consumer publication intentionally stays at A after the call returns.
+	networkDone := make(chan struct{})
+	go func() { monitor.snapshot()[0](); close(networkDone) }()
+	close(backend.resume)
+	got := ownershipAwait(t, updated)
+	ownershipAwait(t, networkDone)
+	if got.result.Generation != 17 || got.result.State != RouteAddressSetCommitted || !errors.Is(got.err, unix.EBUSY) {
+		t.Fatalf("post-binding cleanup erased commit: %+v %v", got.result, got.err)
+	}
+	if getterCalls != 0 || !slices.Equal(live, []netip.Prefix{netip.MustParsePrefix("192.0.2.0/24")}) || !slices.Equal(n.includeAddresses, candidate) || n.generation != 0 {
+		t.Fatal("network consumed ambient A/pending candidate or rewrote confirmed B before consumer publication")
+	}
+	if err = r.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
