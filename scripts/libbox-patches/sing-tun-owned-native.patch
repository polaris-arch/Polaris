+func TestRedirectOwnershipIPTablesCloseWaitsForSubmittedReference(t *testing.T) {
+	scope := redirectIPTablesScope{redirectNamespaceIdentity{1, 777}, 6, iptablesTableNAT}
+	world := newOwnershipIPTablesFakeWorld(scope)
+	r := newOwnershipTestRedirect(t)
+	entered := make(chan struct{})
+	resume := make(chan struct{})
+	ops := &ownershipIPTablesFakeOps{world: world, birth: r.ownership.birth, failAt: -1}
+	ops.before = func() {
+		if ops.acquires.Load() == 3 {
+			close(entered)
+			<-resume
+		}
+	}
+	r.ownershipBackend = ownershipIPTablesFixture(r, scope, ops)
+	startDone := make(chan error, 1)
+	go func() { startDone <- r.Start() }()
+	ownershipAwait(t, entered)
+	closeDone := make(chan error, 1)
+	go func() { closeDone <- r.Close() }()
+	ownershipWaitClosing(t, r.ownership)
+	ownershipAssertWaiting(t, closeDone)
+	close(resume)
+	if err := ownershipAwait(t, closeDone); err != nil {
+		t.Fatal(err)
+	}
+	if err := ownershipAwait(t, startDone); !errors.Is(err, errRedirectClosing) {
+		t.Fatalf("Start=%v", err)
+	}
+	if len(world.deletedRules) != 2 || len(world.deletedChains) != 1 {
+		t.Fatal("late reference survived Close")
+	}
