+	}
+	marker, err := fw4ReadFD(f.coordinatorFD)
+	if err != nil || !bytes.Equal(marker, f.coordinatorBytes) {
+		return errFW4Unresolved
+	}
+	for _, check := range []struct {
+		dir, fd  int
+		name     string
+		identity fw4FileIdentity
+	}{{f.dirFD, f.coordinatorFD, ".polaris-fw4-coordinate-v1", f.coordinatorIdentity}, {f.nativeDirFD, f.nativeLockFD, "fw4.lock", f.nativeLockIdentity}} {
+		if err := fw4ValidateLink(check.dir, check.fd, check.name, check.identity); err != nil {
+			return err
+		}
+	}
+	if f.scriptPath != "" {
+		raw, err := fw4TrustedRead(f.scriptPath)
+		if err != nil || fw4Hash(raw) != f.scriptSHA {
+			return errFW4Unresolved
+		}
+		raw, err = fw4TrustedRead("/usr/share/firewall4/templates/ruleset.uc")
+		if err != nil || fw4Hash(raw) != f.layoutSHA {
+			return errFW4Unresolved
+		}
+		raw, err = fw4TrustedRead("/etc/openwrt_release")
+		if err != nil || fw4Hash(raw) != f.platformSHA {
+			return errFW4Unresolved
+		}
+	}
+	return nil
+}
