+type ownershipFakeRegistry[T any] struct {
+	access          sync.Mutex
+	callbacks       list.List[T]
+	registerEntered chan struct{}
+	registerResume  chan struct{}
+	unregistered    int
+}
+
+func (m *ownershipFakeRegistry[T]) register(callback T) *list.Element[T] {
+	m.access.Lock()
+	element := m.callbacks.PushBack(callback)
+	m.access.Unlock()
+	if m.registerEntered != nil {
+		close(m.registerEntered)
+		<-m.registerResume
+	}
+	return element
+}
+func (m *ownershipFakeRegistry[T]) unregister(element *list.Element[T]) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	m.callbacks.Remove(element)
+	m.unregistered++
+}
+func (m *ownershipFakeRegistry[T]) snapshot() []T {
+	m.access.Lock()
+	defer m.access.Unlock()
+	return m.callbacks.Array()
+}
+func (m *ownershipFakeRegistry[T]) count() int {
+	m.access.Lock()
+	defer m.access.Unlock()
+	return m.unregistered
+}
+
