+func TestIProductionReadonlyProbeNonzeroAndRealLostWaitStayUnknown(t *testing.T) {
+	for _, mode := range []string{"nonzero", "ECHILD"} {
+		t.Run(mode, func(t *testing.T) {
+			owner, err := newRedirectOwnership()
+			if err != nil {
+				t.Fatal(err)
+			}
+			namespace := testINamespaceLease(t)
+			op, err := owner.beginStart()
+			if err != nil {
+				t.Fatal(err)
+			}
+			releases := 0
+			anchor, err := op.acquire(redirectNamespace, "fixture-probe-namespace", redirectResourceFuncs{
+				acquire: func(redirectResourceID) redirectAcquireResult {
+					return redirectAcquireResult{status: redirectAcquireCreated}
+				},
+				release: func(redirectResourceID) error { releases++; return nil },
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			owner.access.Lock()
+			owner.prerequisites = []redirectResourceID{anchor}
+			owner.access.Unlock()
+			binary := "/bin/true"
+			if mode == "nonzero" {
+				binary = filepath.Join(t.TempDir(), "fixture-readonly")
+				if err = os.WriteFile(binary, []byte("#!/bin/sh\nprintf 'fixture capability missing'\nexit 4\n"), 0700); err != nil {
+					t.Fatal(err)
+				}
+			}
+			b, intent := testIProbeBackend(t, owner, namespace, binary)
+			ops, err := b.ReadonlyIPTablesProbe(intent)
+			if err != nil {
+				t.Fatal(err)
+			}
+			probe := ops.(*iptablesReadonlyProbeOps)
+			if mode == "ECHILD" {
+				probe.runner.wait = func(command *exec.Cmd) error {
+					// External reaping precedes the original Cmd's real ECHILD;
+					// no unreaped fixture child is intentionally left behind.
+					var status unix.WaitStatus
+					for {
+						_, err := unix.Wait4(command.Process.Pid, &status, 0, nil)
+						if errors.Is(err, unix.EINTR) {
+							continue
+						}
+						if err != nil {
+							return err
+						}
+						break
+					}
+					return command.Wait()
+				}
+			}
+			acquireErr := op.withEffect(func() error {
+				_, err := op.acquire(redirectReadOnlyProbe, "fixture-capability", ops)
+				return err
+			})
+			_ = owner.finishStart(acquireErr)
+			op.finish()
+			if !errors.Is(acquireErr, errRedirectAmbiguous) {
+				t.Fatal("non-Wait0 process result admitted the capability", acquireErr)
+			}
+			if mode == "ECHILD" && (!errors.Is(acquireErr, unix.ECHILD) || probe.result.nativeExit) {
+				t.Fatal("original ECHILD was erased", acquireErr, probe.result)
+			}
+			if err = owner.close(); !errors.Is(err, errRedirectAmbiguous) || releases != 0 {
+				t.Fatal("failed probe released its process/namespace responsibility", err, releases)
+			}
+			entries := ownershipEntries(owner)
+			if len(entries) != 2 || entries[0].state != redirectOwned || entries[1].state != redirectAmbiguous || probe.runner.unconfirmed == nil {
+				t.Fatal("failed probe lost its original Cmd/anchor", entries)
+			}
+		})
+	}
+}
