+func cloneRoute(route netlink.Route) netlink.Route {
+	cloneNet := func(value *net.IPNet) *net.IPNet {
+		if value == nil {
+			return nil
+		}
+		ip := value.IP.To4()
+		if ip == nil {
+			ip = value.IP.To16()
+		}
+		return &net.IPNet{IP: slices.Clone(ip), Mask: slices.Clone(value.Mask)}
+	}
+	route.Dst = cloneNet(route.Dst)
+	route.Src = cloneNet(route.Src)
+	if len(route.Gw) != 0 {
+		if ipv4 := route.Gw.To4(); ipv4 != nil {
+			route.Gw = slices.Clone(ipv4)
+		} else {
+			route.Gw = slices.Clone(route.Gw.To16())
+		}
+	}
+	return route
+}
+
+func cloneRule(rule *netlink.Rule) *netlink.Rule {
+	result := *rule
+	if rule.Dport != nil {
+		value := *rule.Dport
+		result.Dport = &value
+	}
+	if rule.Sport != nil {
+		value := *rule.Sport
+		result.Sport = &value
+	}
+	if rule.UIDRange != nil {
+		value := *rule.UIDRange
+		result.UIDRange = &value
+	}
+	// NOP must be explicit on deletion too: RuleDel otherwise emits UNSPEC and
+	// can match another rule at the same priority.
+	if result.Type == 0 {
+		switch {
+		case result.Table >= 0:
+			result.Type = unix.FR_ACT_TO_TBL
+		case result.Goto >= 0:
+			result.Type = unix.FR_ACT_GOTO
+		default:
+			result.Type = unix.FR_ACT_NOP
+		}
+	}
+	return &result
+}
+
+func normalizeOwnedRoute(route netlink.Route) netlink.Route {
+	route = cloneRoute(route)
+	if route.Family == 0 && route.Dst != nil {
+		if route.Dst.IP.To4() != nil {
+			route.Family = unix.AF_INET
+		} else {
+			route.Family = unix.AF_INET6
+		}
+	}
+	if route.Type == 0 {
+		route.Type = unix.RTN_UNICAST
+	}
+	if route.Protocol == 0 {
+		route.Protocol = unix.RTPROT_BOOT
+	}
+	if route.Dst != nil {
+		route.Dst.IP = route.Dst.IP.Mask(route.Dst.Mask)
+	}
+	// Send an explicit nonzero metric. Omitting it on RTM_DELROUTE is a
+	// wildcard in fib deletion and could select a foreign metric after removal
+	// of our original route. These private tables have no pre-existing routes.
+	if route.Priority == 0 {
+		route.Priority = 1
+		if route.Family == unix.AF_INET6 {
+			route.Priority = 1024
+		}
+	}
+	return route
+}
+
+// Kernel default-route dumps may omit RTA_DST. Canonicalize observation only,
+// with an explicit IP family; keep every other selector and the original
+// acquire/delete request. A dump cannot create an ownership receipt.
+func observedOwnedRoute(route netlink.Route) netlink.Route {
+	route = cloneRoute(route)
+	if route.Family != unix.AF_INET && route.Family != unix.AF_INET6 {
+		return route
+	}
+	bits := 128
+	if route.Family == unix.AF_INET {
+		bits = 32
+	}
+	if route.Dst == nil {
+		route.Dst = &net.IPNet{IP: make(net.IP, bits/8), Mask: net.CIDRMask(0, bits)}
+	} else if ones, size := route.Dst.Mask.Size(); ones == 0 && size == bits &&
+		((bits == 32 && route.Dst.IP.To4() != nil) || (bits == 128 && route.Dst.IP.To4() == nil && route.Dst.IP.To16() != nil)) {
+		route.Dst = &net.IPNet{IP: make(net.IP, bits/8), Mask: net.CIDRMask(0, bits)}
+	}
+	return route
+}
+
+// ErrRouteUpdateUnconfirmed means a failed update cannot leave the previous
+// options describing the effective graph. Further writers are sealed; callers
+// must withdraw dependents and join their stack/queues before NativeTun.Close.
+var ErrRouteUpdateUnconfirmed = errors.New("route update changed resources before failing")
+
+func gatewayOnlyRouteChange(previous, next netlink.Route) bool {
+	if previous.Gw.Equal(next.Gw) {
+		return false
+	}
+	previous.Gw, next.Gw = nil, nil
+	return reflect.DeepEqual(previous, next)
+}
+
+type ownedRoute struct {
+	id   redirectResourceID
+	spec netlink.Route
+}
+
+// Cache entries are only our successful EXCL acquisitions. A dump can reject a
+// conflicting table; it never adds objects to this set or grants delete rights.
+type ownedRouteSet struct {
+	api      routeNetlink
+	entries  []ownedRoute
+	serial   uint64
+	revision uint64 // successful acquire/retire steps, guarded by the effect gate
+	unknown  error
+}
+
+func (s *ownedRouteSet) reconcile(op *redirectOperation, desired []netlink.Route, requires ...redirectResourceID) (err error) {
+	if s.unknown != nil {
+		return s.unknown
+	}
+	before := s.revision
+	defer func() {
+		if err != nil && (s.revision != before || errors.Is(err, errRedirectAmbiguous)) {
+			s.unknown = errors.Join(ErrRouteUpdateUnconfirmed, errRedirectAmbiguous, err)
+			err = s.unknown
+		}
+	}()
+	frozen := make([]netlink.Route, len(desired))
+	for index, route := range desired {
+		frozen[index] = normalizeOwnedRoute(route)
+	}
+	// Distinct aliases may be added first. A gateway-only change of the same
+	// alias must retire our exact old receipt before CREATE|EXCL: Linux rejects
+	// that CREATE while the old prefix/TOS/metric alias is still present.
+	for _, route := range frozen {
+		if slices.ContainsFunc(s.entries, func(entry ownedRoute) bool { return reflect.DeepEqual(entry.spec, route) }) {
+			continue
+		}
+		for index := len(s.entries) - 1; index >= 0; index-- {
+			entry := s.entries[index]
+			if !gatewayOnlyRouteChange(entry.spec, route) {
+				continue
+			}
+			if err := op.release(entry.id); err != nil {
+				return err
+			}
+			s.entries = slices.Delete(s.entries, index, index+1)
+			s.revision++
+		}
+		s.serial++
+		spec := cloneRoute(route)
+		id, err := op.acquire(redirectNetlink, fmt.Sprintf("route-%d-%d", spec.Table, s.serial), redirectResourceFuncs{
+			acquire: func(redirectResourceID) redirectAcquireResult {
+				attempt := cloneRoute(spec)
+				return routeAcquireResult(s.api.RouteAdd(&attempt))
+			},
+			release: func(redirectResourceID) error {
+				if err := validateOwnedRouteForDelete(s.api, spec); err != nil {
+					return err
+				}
+				deletion := cloneRoute(spec)
+				return s.api.RouteDel(&deletion)
+			},
+		}, requires...)
+		if err != nil {
+			if errors.Is(err, errRedirectAmbiguous) {
+				s.unknown = err
+			}
+			return err
+		}
+		s.entries = append(s.entries, ownedRoute{id, cloneRoute(spec)})
+		s.revision++
+	}
+	for index := len(s.entries) - 1; index >= 0; index-- {
+		entry := s.entries[index]
+		if slices.ContainsFunc(frozen, func(route netlink.Route) bool { return reflect.DeepEqual(entry.spec, route) }) {
+			continue
+		}
+		if err := op.release(entry.id); err != nil {
+			s.unknown = errors.Join(errRedirectAmbiguous, err)
+			return s.unknown
+		}
+		s.entries = slices.Delete(s.entries, index, index+1)
+		s.revision++
+	}
+	return nil
+}
+
+func acquireOwnedRule(op *redirectOperation, api routeNetlink, key string, rule *netlink.Rule, allowed func(*netlink.Rule) bool, requires ...redirectResourceID) (redirectResourceID, error) {
+	spec := cloneRule(rule)
+	return op.acquire(redirectNetlink, key, redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			return routeAcquireResult(api.RuleAdd(cloneRule(spec)))
+		},
+		release: func(redirectResourceID) error {
+			if err := validateOwnedRuleForDelete(api, spec, allowed); err != nil {
+				return err
+			}
+			return api.RuleDel(cloneRule(spec))
+		},
+	}, requires...)
+}
+
+// Observation can invalidate a retained acquire receipt; it never grants one.
+// The claim covers cooperating writers between this read and mutation. There
+// is no incarnation CAS against noncooperating identical replacement.
+func validateOwnedRouteForDelete(api routeNetlink, spec netlink.Route) error {
+	routes, err := api.RouteListFiltered(spec.Family, &netlink.Route{Table: spec.Table}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		return err
+	}
+	count := 0
+	for _, route := range routes {
+		if reflect.DeepEqual(observedOwnedRoute(route), observedOwnedRoute(spec)) {
+			count++
+		}
+	}
+	if count != 1 {
+		return fmt.Errorf("owned route is absent or duplicated: %w", errRedirectAmbiguous)
+	}
+	return nil
+}
+
+func observedRule(rule netlink.Rule) *netlink.Rule {
+	if rule.Type != unix.FR_ACT_TO_TBL && rule.Table == 0 {
+		rule.Table = -1
+	}
+	return cloneRule(&rule)
+}
+
+func validateOwnedRuleForDelete(api routeNetlink, spec *netlink.Rule, allowed func(*netlink.Rule) bool) error {
+	rules, err := api.RuleList(spec.Family)
+	if err != nil {
+		return err
+	}
+	count := 0
+	for _, rule := range rules {
+		if rule.Family != spec.Family || rule.Priority != spec.Priority {
+			continue
+		}
+		observed := observedRule(rule)
+		if !allowed(observed) {
+			return fmt.Errorf("foreign rule entered the owned priority: %w", errRedirectAmbiguous)
+		}
+		if reflect.DeepEqual(observed, spec) {
+			count++
+		}
+	}
+	if count != 1 {
+		return fmt.Errorf("owned rule is absent or duplicated: %w", errRedirectAmbiguous)
+	}
+	return nil
+}
+
+func routeTableOccupiedOn(api routeNetlink, table int) (bool, error) {
+	routes, err := api.RouteListFiltered(netlink.FAMILY_ALL, &netlink.Route{Table: table}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		return false, err
+	}
+	if len(routes) != 0 {
+		return true, nil
+	}
+	rules, err := api.RuleList(netlink.FAMILY_ALL)
+	if err != nil {
+		return false, err
+	}
+	return slices.ContainsFunc(rules, func(rule netlink.Rule) bool { return rule.Table == table }), nil
+}
+
+func rejectOccupiedPriorities(api routeNetlink, priorities []int) error {
+	rules, err := api.RuleList(netlink.FAMILY_ALL)
+	if err != nil {
+		return err
+	}
+	for _, rule := range rules {
+		if slices.Contains(priorities, rule.Priority) {
+			return fmt.Errorf("rule priority %d already exists: %w", rule.Priority, unix.EEXIST)
+		}
+	}
+	return nil
+}
+
+func priorityClaimKeys(priorities []int) []redirectConflictKey {
+	keys := make([]redirectConflictKey, 0, len(priorities))
+	for _, priority := range priorities {
+		keys = append(keys, redirectConflictKey{"rule-priority", strconv.Itoa(priority)})
+	}
+	return keys
+}
+
+// The cooperative claim is revalidated at every actual mutation, including
+// reverse release. A changed journal/inode does not authorize compensating
+// deletes. All calls are serialized by this birth's effect/drain protocol.
+type claimedRouteNetlink struct {
+	routeNetlink
+	validate func() error
+}
+
+func (h *claimedRouteNetlink) mutation(block func() error) error {
+	if err := h.validate(); err != nil {
+		return errors.Join(errRedirectAmbiguous, err)
+	}
+	return block()
+}
+
+func (h *claimedRouteNetlink) RouteAdd(route *netlink.Route) error {
+	return h.mutation(func() error { return h.routeNetlink.RouteAdd(route) })
+}
+func (h *claimedRouteNetlink) RouteDel(route *netlink.Route) error {
+	return h.mutation(func() error { return h.routeNetlink.RouteDel(route) })
+}
+func (h *claimedRouteNetlink) RuleAdd(rule *netlink.Rule) error {
+	return h.mutation(func() error { return h.routeNetlink.RuleAdd(rule) })
+}
+func (h *claimedRouteNetlink) RuleDel(rule *netlink.Rule) error {
+	return h.mutation(func() error { return h.routeNetlink.RuleDel(rule) })
+}
+func (h *claimedRouteNetlink) AddrAdd(link netlink.Link, addr *netlink.Addr) error {
+	return h.mutation(func() error { return h.routeNetlink.AddrAdd(link, addr) })
+}
+func (h *claimedRouteNetlink) AddrDel(link netlink.Link, addr *netlink.Addr) error {
+	return h.mutation(func() error { return h.routeNetlink.AddrDel(link, addr) })
+}
+func (h *claimedRouteNetlink) LinkSetMTU(link netlink.Link, mtu int) error {
+	return h.mutation(func() error { return h.routeNetlink.LinkSetMTU(link, mtu) })
+}
+func (h *claimedRouteNetlink) LinkSetUp(link netlink.Link) error {
+	return h.mutation(func() error { return h.routeNetlink.LinkSetUp(link) })
+}
+func (h *claimedRouteNetlink) LinkSetDown(link netlink.Link) error {
+	return h.mutation(func() error { return h.routeNetlink.LinkSetDown(link) })
+}
