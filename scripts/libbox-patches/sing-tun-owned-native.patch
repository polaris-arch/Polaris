+
+func (a *cNativePublicActor) Identity() cNativeIdentity {
+	a.access.Lock()
+	defer a.access.Unlock()
+	return a.identity
+}
+func (a *cNativePublicActor) Construct(ctx context.Context) error {
+	a.access.Lock()
+	defer a.access.Unlock()
+	if a.public != nil {
+		return errors.New("actor constructor already called")
+	}
+	if err := a.check(ctx); err != nil {
+		return err
+	}
+	value, err := NewAutoRedirect(a.options)
+	if err != nil {
+		return err
+	}
+	r, ok := value.(*autoRedirect)
+	if !ok {
+		return errors.New("default public autoRedirect type changed")
+	}
+	if r.ownershipBackend != nil || r.productionDependencies != nil {
+		return errors.New("non-default production dependency")
+	}
+	a.identity.Birth = r.ownership.birth.String()
+	a.public, a.r = value, r
+	return nil
+}
+func (a *cNativePublicActor) check(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	var selected *cNativeCase
+	for _, c := range cNativeAllCases() {
+		if c.path() == a.admission.Case {
+			v := c
+			selected = &v
+			break
+		}
+	}
+	if selected == nil {
+		return errCNativeUnfrozen
+	}
+	current, err := cNativeAdmit(ctx, *selected)
+	if err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(current, a.admission) {
+		return errors.New("G admission changed during actor lifetime")
+	}
+	return cNativeValidateAdmission(a.admission, *selected)
+}
+func (a *cNativePublicActor) Start(ctx context.Context) error {
+	if err := a.check(ctx); err != nil {
+		return err
+	}
+	a.access.Lock()
+	public := a.public
+	a.access.Unlock()
+	if public == nil {
+		return errors.New("actor not constructed")
+	}
+	// Synchronous original call: F4 error defer Close can wait for original Cmd.
+	return public.Start()
+}
+func (a *cNativePublicActor) Close(ctx context.Context) error {
+	// Close may run alongside Start. The production ledger owns their drain;
+	// the immutable public pointer was installed before transport published it.
+	if err := a.check(ctx); err != nil {
+		return err
+	}
+	a.access.Lock()
+	public := a.public
+	a.access.Unlock()
+	if public == nil {
+		return errors.New("actor not constructed")
+	}
+	return public.Close()
+}
+func (a *cNativePublicActor) HoldOrdering(ctx context.Context) error {
+	if err := a.check(ctx); err != nil {
+		return err
+	}
+	a.access.Lock()
+	defer a.access.Unlock()
+	if a.r == nil || a.ordering != nil {
+		return errors.New("invalid ordering operation")
+	}
+	op, err := a.r.ownership.beginOperation(false, true)
+	if err == nil {
+		a.ordering = op
+	}
+	return err
+}
+func (a *cNativePublicActor) ReleaseOrdering(context.Context) error {
+	a.access.Lock()
+	defer a.access.Unlock()
+	if a.ordering == nil {
+		return errors.New("no ordering operation")
+	}
+	a.ordering.finish()
+	a.ordering = nil
+	return nil
+}
+func (a *cNativePublicActor) Observe(ctx context.Context) (cNativeActorObservation, error) {
+	if err := a.check(ctx); err != nil {
+		return cNativeActorObservation{}, err
+	}
+	a.access.Lock()
+	defer a.access.Unlock()
+	if a.r == nil {
+		return cNativeActorObservation{}, errors.New("actor not constructed")
+	}
+	r := a.r
+	op, err := r.ownership.beginOperation(false, true)
+	if err != nil {
+		return cNativeActorObservation{}, err
+	}
+	defer op.finish()
+	result := cNativeActorObservation{Identity: a.identity, Docker: make(map[string]cNativeDockerObservation)}
+	err = op.withEffect(func() error {
+		o := r.ownership
+		o.access.Lock()
+		result.Running, result.Closing, result.Operations, result.Callbacks = o.running, o.closing, o.operations, o.callbacks
+		if o.failures != nil {
+			result.Error = o.failures.Error()
+		}
+		for _, resource := range o.resources {
+			v := cNativeResourceObservation{Birth: resource.id.birth.String(), Domain: uint8(resource.id.domain), Key: resource.id.key, State: uint8(resource.state)}
+			if resource.err != nil {
+				v.Error = resource.err.Error()
+			}
+			for _, dependency := range resource.requires {
+				v.Requires = append(v.Requires, fmt.Sprintf("%s/%d/%s", dependency.birth.String(), dependency.domain, dependency.key))
+			}
+			result.Resources = append(result.Resources, v)
+		}
+		o.access.Unlock()
+		result.LedgerSHA, err = cNativeHash(result.Resources)
+		if err != nil {
+			return err
+		}
+		coordinator, ok := r.ownershipBackend.(*redirectProductionCoordinator)
+		if !ok {
+			return errors.New("not default production coordinator")
+		}
+		n, ok := coordinator.firewall.(*redirectNFTRuntime)
+		if !ok {
+			return errors.New("not actual N runtime")
+		}
+		n.access.Lock()
+		result.NFTReceipts = slices.Clone(n.receipts)
+		for _, receipt := range n.receipts {
+			message := ""
+			if receipt.Err != nil {
+				message = receipt.Err.Error()
+			}
+			result.NFTReceiptErrors = append(result.NFTReceiptErrors, message)
+		}
+		result.NFTOwnerDomain = fmt.Sprintf("%s/%d/%s", n.domainID.birth.String(), n.domainID.domain, n.domainID.key)
+		n.access.Unlock()
+		e, ok := coordinator.environment.(*redirectEnvironmentRuntime)
+		if !ok {
+			return errors.New("not actual C runtime")
+		}
+		var snapshots []*nftables.ConsistentSnapshot
+		if err := r.runInNamespace(func() error {
+			for _, family := range []nftables.TableFamily{nftables.TableFamilyIPv4, nftables.TableFamilyIPv6, nftables.TableFamilyINet} {
+				s, readErr := e.readNFTSnapshot(r, family)
+				if readErr != nil {
+					return readErr
+				}
+				snapshots = append(snapshots, s)
+			}
+			return nil
+		}); err != nil {
+			return err
+		}
+		result.NFTSHA, err = cNativeHash(snapshots)
+		if err != nil {
+			return err
+		}
+		for family, group := range e.docker {
+			var snapshot *nftables.ConsistentSnapshot
+			for _, s := range snapshots {
+				for _, table := range s.Tables {
+					if table.Family == family {
+						snapshot = s
+						break
+					}
+				}
+				if snapshot != nil {
+					break
+				}
+			}
+			if snapshot == nil {
+				return errors.New("complete Docker family snapshot missing")
+			}
+			matches, err := group.matchesObservation(snapshot)
+			if err != nil {
+				return err
+			}
+			if !matches {
+				return errRedirectAmbiguous
+			}
+			parentSHA, err := cNativeHash([]any{group.parent, group.chain})
+			if err != nil {
+				return err
+			}
+			rulesSHA, err := cNativeHash(group.rules)
+			if err != nil {
+				return err
+			}
+			v := cNativeDockerObservation{ParentSHA: parentSHA, RulesSHA: rulesSHA, Parent: group.parent, Chain: group.chain, Rules: slices.Clone(group.rules), Generation: group.generation, Acquired: group.acquired, Retired: group.retired}
+			for _, rule := range group.rules {
+				v.Handles = append(v.Handles, rule.Handle)
+			}
+			result.Docker[fmt.Sprint(family)] = v
+		}
+		if e.fw4 != nil {
+			e.fw4.access.Lock()
+			j := e.fw4.journal
+			j.Commands = slices.Clone(j.Commands)
+			e.fw4.access.Unlock()
+			result.FW4 = &j
+		}
+		if r.redirectServer != nil {
+			fd, err := r.redirectServer.ListenerFileDescriptor()
+			if err != nil {
+				return err
+			}
+			var st unix.Stat_t
+			statErr := unix.Fstat(fd, &st)
+			closeErr := unix.Close(fd)
+			if err := errors.Join(statErr, closeErr); err != nil {
+				return err
+			}
+			result.ListenerDevice, result.ListenerInode = uint64(st.Dev), st.Ino
+		}
+		return nil
+	})
+	return result, err
+}
+
+type cNativeNonceResult struct {
+	Role, Family, Nonce, RawSHA string
+	Positive, Matched           bool
+	At                          int64
+}
+type cNativeAllowedFlow struct {
+	Network             uint8
+	Source, Destination netip.AddrPort
+	Nonce               []byte
+}
+type cNativeHandler struct {
+	flows                                  []cNativeAllowedFlow // immutable, G bound; no destination guessing
+	deadline                               time.Duration
+	access                                 sync.Mutex
+	results                                []error
+	packetsRemaining, connectionsRemaining int
+}
+
+func (h *cNativeHandler) JudgeFlow(network uint8, source, destination netip.AddrPort, _ []byte) FlowVerdict {
+	h.access.Lock()
+	defer h.access.Unlock()
+	if h.packetsRemaining <= 0 {
+		return FlowVerdict{Action: ActionDrop}
+	}
+	h.packetsRemaining--
+	for _, flow := range h.flows {
+		if flow.Network == network && flow.Source == source && flow.Destination == destination {
+			return FlowVerdict{Action: ActionAccept}
+		}
+	}
+	return FlowVerdict{Action: ActionDrop}
+}
+func (h *cNativeHandler) NewConnectionEx(ctx context.Context, conn net.Conn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	h.access.Lock()
+	admitted := h.connectionsRemaining > 0
+	if admitted {
+		h.connectionsRemaining--
+	}
+	h.access.Unlock()
+	var allowed *cNativeAllowedFlow
+	for index := range h.flows {
+		flow := &h.flows[index]
+		if flow.Source == source.AddrPort() && flow.Destination == destination.AddrPort() {
+			allowed = flow
+			break
+		}
+	}
+	err := errors.New("connection outside frozen nonce tuple")
+	if admitted && allowed != nil && h.deadline > 0 && h.deadline <= 5*time.Second && len(allowed.Nonce) >= 32 && len(allowed.Nonce) <= 256 {
+		deadline := time.Now().Add(h.deadline)
+		if d, ok := ctx.Deadline(); ok && d.Before(deadline) {
+			deadline = d
+		}
+		err = conn.SetDeadline(deadline)
+		if err == nil {
+			data := make([]byte, len(allowed.Nonce))
+			_, err = io.ReadFull(conn, data)
+			if err == nil && !bytes.Equal(data, allowed.Nonce) {
+				err = errors.New("nonce mismatch")
+			}
+			if err == nil {
+				n, writeErr := conn.Write(data)
+				err = writeErr
+				if n != len(data) && err == nil {
+					err = io.ErrShortWrite
+				}
+			}
+		}
+	}
+	err = errors.Join(err, conn.Close())
+	h.access.Lock()
+	if len(h.results) < 8 {
+		h.results = append(h.results, err)
+	}
+	h.access.Unlock()
+	if onClose != nil {
+		onClose(err)
+	}
+}
+
+type cNativeCall struct {
+	Role, Method, Error string
+	Started, Returned   int64
+	Identity            cNativeIdentity
+}
+type cNativeReceipt struct {
+	Case                                             cNativeCase
+	Admission                                        cNativeAdmission
+	Calls                                            []cNativeCall
+	Windows                                          []cNativeWindow
+	Witnesses                                        []cNativeWitness
+	ActualFailure, Functional, Envelope, Restoration string
+	Errors                                           []string
+}
+type cNativeRun struct {
+	ctx          context.Context
+	a            cNativeAdmission
+	c            cNativeCase
+	receipt      cNativeReceipt
+	actors       map[string]cNativeActor
+	activeWindow bool
+}
+
+func (r *cNativeRun) witness(name string) error {
+	w, err := cNativeG.Witness(r.ctx, r.a, name)
+	if err != nil {
+		return err
+	}
+	if w.Name != name {
+		return errors.New("wrong actual witness")
+	}
+	r.receipt.Witnesses = append(r.receipt.Witnesses, w)
+	return nil
+}
+func (r *cNativeRun) window(name string) error {
+	w, err := cNativeG.Observe(r.ctx, r.a, name)
+	if err != nil {
+		return err
+	}
+	if w.Name != name {
+		return errors.New("wrong actual window")
+	}
+	r.receipt.Windows = append(r.receipt.Windows, w)
+	return nil
+}
+func (r *cNativeRun) produce(name string) error { return cNativeG.Produce(r.ctx, r.a, name) }
+func (r *cNativeRun) call(role, method string, expectError bool) error {
+	actor := r.actors[role]
+	if actor == nil {
+		return errors.New("missing independent actor")
+	}
+	call := cNativeCall{Role: role, Method: method, Started: time.Now().UnixNano()}
+	var err error
+	switch method {
+	case "Construct":
+		err = actor.Construct(r.ctx)
+	case "Start":
+		err = actor.Start(r.ctx)
+	case "Close":
+		err = actor.Close(r.ctx)
+	default:
+		return errors.New("non-public actor method")
+	}
+	call.Returned = time.Now().UnixNano()
+	call.Identity = actor.Identity()
+	if err != nil {
+		call.Error = err.Error()
+	}
+	r.receipt.Calls = append(r.receipt.Calls, call)
+	if expectError && err == nil {
+		return errors.New("expected original callee error missing")
+	}
+	if !expectError {
+		return err
+	}
+	return nil
+}
+func (r *cNativeRun) join(role, method string, expectError bool) error {
+	call, err := cNativeG.JoinCall(r.ctx, r.a, r.actors[role], method)
+	if err != nil {
+		return err
+	} // transport/identity/Wait failure is never a callee result.
+	if call.Role != role || call.Method != method {
+		return errors.New("wrong original concurrent call fact")
+	}
+	r.receipt.Calls = append(r.receipt.Calls, call)
+	if expectError && call.Error == "" {
+		return errors.New("expected original concurrent callee error missing")
+	}
+	if !expectError && call.Error != "" {
+		return errors.New(call.Error)
+	}
+	return nil
+}
+func (r *cNativeRun) step(name string) error {
+	if err := r.witness(name); err != nil {
+		return err
+	}
+	if name == "A_before" || name == "A_during" || name == "A_after" || name == "A_new_parent_stable" {
+		return r.window(name)
+	}
+	if !r.activeWindow && slices.Contains([]string{"B_constructed", "B_committed", "B_claim_refusal", "B_pair_before_failure", "B_lockCoordinator_refusal", "B_checkOtherJournals_orphan_refusal", "B_checkOtherJournals_Pending_refusal", "B_checkOtherJournals_Unknown_refusal", "B_script_SHA_refusal", "B_internal_timeout_Unknown"}, name) {
+		// Short failed-Start windows require G's original raw observation from
+		// inside that window. A later snapshot cannot backfill this evidence.
+		r.activeWindow = true
+		return r.window("B_active")
+	}
+	return nil
+}
+func (r *cNativeRun) start(role string, expectError bool) error {
+	if err := r.call(role, "Construct", false); err != nil {
+		return err
+	}
+	return r.call(role, "Start", expectError)
+}
+func (r *cNativeRun) docker() error {
+	if err := r.start("A", false); err != nil {
+		return err
+	}
+	if err := r.step("A_committed"); err != nil {
+		return err
+	}
+	if err := r.step("A_before"); err != nil {
+		return err
+	}
+	if r.c.Scenario == "unstarted" {
+		if err := r.call("B", "Construct", false); err != nil {
+			return err
+		}
+		if err := r.step("B_constructed"); err != nil {
+			return err
+		}
+		if err := r.call("B", "Close", false); err != nil {
+			return err
+		}
+		if err := r.step("B_unstarted_closed"); err != nil {
+			return err
+		}
+		return r.step("A_after")
+	}
+	if r.c.Scenario == "claim" {
+		if err := r.start("B", true); err != nil {
+			return err
+		}
+		for _, s := range []string{"B_claim_refusal", "B_no_prepare", "A_after"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if r.c.Scenario == "partial" {
+		if err := r.produce("inet_fw4_sentinel_after_A_before_B"); err != nil {
+			return err
+		}
+		if err := r.step("producer_inet_fw4_sentinel"); err != nil {
+			return err
+		}
+		if err := r.start("B", true); err != nil {
+			return err
+		}
+		for _, s := range []string{"B_pair_before_failure", "B_start_error", "B_own_pair_withdrawn", "A_after"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := r.start("B", false); err != nil {
+		return err
+	}
+	if err := r.step("B_committed"); err != nil {
+		return err
+	}
+	switch r.c.Scenario {
+	case "pair":
+		if err := r.step("B_pair"); err != nil {
+			return err
+		}
+		if err := r.step("A_during"); err != nil {
+			return err
+		}
+	case "parent-appear", "parent-rebuild":
+		name := "producer_parent_appears"
+		if r.c.Scenario == "parent-rebuild" {
+			name = "producer_parent_rebuild"
+		}
+		if err := r.produce(name); err != nil {
+			return err
+		}
+		for _, s := range []string{name, "actual_event_consumed", "A_new_parent_stable"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+		if r.c.Scenario == "parent-rebuild" {
+			for _, s := range []string{"B_new_parent_pair", "no_old_handle_reuse"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+		} else {
+			if err := r.step("B_pair"); err != nil {
+				return err
+			}
+		}
+	case "delete", "replace":
+		name := "producer_B_exact_DEL"
+		if r.c.Scenario == "replace" {
+			name = "producer_B_exact_REPLACE"
+		}
+		if err := r.produce(name); err != nil {
+			return err
+		}
+		for _, s := range []string{name, "actual_event_consumed"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+		if r.c.Scenario == "replace" {
+			for _, s := range []string{"B_sealed_Unknown", "B_no_compensation"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+			if err := r.call("B", "Close", true); err != nil {
+				return err
+			}
+			return r.step("A_after")
+		}
+		if err := r.step("B_pair_repaired"); err != nil {
+			return err
+		}
+	case "drain", "late":
+		b := r.actors["B"]
+		if err := b.HoldOrdering(r.ctx); err != nil {
+			return err
+		}
+		held := true
+		defer func() {
+			if held {
+				_ = b.ReleaseOrdering(r.ctx)
+			}
+		}()
+		if err := r.step("ordering_operation_admitted"); err != nil {
+			return err
+		}
+		if r.c.Scenario == "drain" {
+			if err := r.produce("real_B_callback_before_close"); err != nil {
+				return err
+			}
+			if err := r.step("actual_callback_admitted"); err != nil {
+				return err
+			}
+		}
+		if err := cNativeG.CallConcurrent(r.ctx, r.a, b, "Close"); err != nil {
+			return err
+		}
+		if err := r.step("B_closing"); err != nil {
+			return err
+		}
+		if r.c.Scenario == "late" {
+			if err := r.produce("real_B_event_after_seal"); err != nil {
+				return err
+			}
+			for _, s := range []string{"late_event_actually_consumed", "late_callback_refused"} {
+				if err := r.step(s); err != nil {
+					return err
+				}
+			}
+		}
+		if err := b.ReleaseOrdering(r.ctx); err != nil {
+			return err
+		}
+		held = false
+		if r.c.Scenario == "drain" {
+			if err := r.step("callback_returned"); err != nil {
+				return err
+			}
+		}
+		if err := r.join("B", "Close", false); err != nil {
+			return err
+		}
+		for _, s := range []string{"monitor_loop_joined", "B_exact_remove_after_join", "A_after"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+		return nil
+	case "retire":
+		if err := r.step("B_pair"); err != nil {
+			return err
+		}
+	case "insert":
+		for _, s := range []string{"own_INSERT_actually_consumed", "bounded_no_repeat_mutation"} {
+			if err := r.step(s); err != nil {
+				return err
+			}
+		}
+	default:
+		return errors.New("unimplemented Docker scenario")
+	}
+	if err := r.call("B", "Close", false); err != nil {
+		return err
+	}
+	if r.c.Scenario == "pair" || r.c.Scenario == "retire" || r.c.Scenario == "insert" {
+		if err := r.step("B_closed"); err != nil {
+			return err
+		}
+	}
+	if r.c.Scenario == "retire" {
+		if err := r.step("foreign_parent_preserved"); err != nil {
+			return err
+		}
+	}
+	return r.step("A_after")
+}
+
+func cNativeAllCases() []cNativeCase {
+	return append(slices.Clone(cNativeDockerCases), cNativeFW4Cases...)
+}
+func cNativeRunTop(t *testing.T, top string) {
+	t.Helper()
+	for _, c := range cNativeAllCases() {
+		if c.Top != top {
+			continue
+		}
+		t.Run(c.Sub, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), c.Budget)
+			defer cancel()
+			a, err := cNativeAdmit(ctx, c)
+			if err != nil {
+				t.Fatal(err)
+			} // NOT skip/functional PASS.
+			r := cNativeRun{ctx: ctx, a: a, c: c, actors: make(map[string]cNativeActor), receipt: cNativeReceipt{Case: c, Admission: a, Functional: "NotReady", Envelope: "Unmeasured", Restoration: "Unmeasured"}}
+			for _, role := range []string{"A", "B", "H"} {
+				actor, err := cNativeG.Actor(ctx, a, role, c.Scenario == "claim" && role == "B")
+				if err != nil {
+					t.Fatal(err)
+				}
+				if actor.Identity().PID != a.Actors[role].PID {
+					t.Fatal("wrong independent actor PID")
+				}
+				r.actors[role] = actor
+			}
+			// G owns actual Wait and guardian disposal. A remains alive through the
+			// last preservation window. Unknown is not silently repaired here.
+			if slices.ContainsFunc(cNativeDockerCases, func(v cNativeCase) bool { return v.path() == c.path() }) {
+				err = r.docker()
+			} else {
+				err = r.fw4()
+			}
+			if err != nil {
+				r.receipt.ActualFailure = err.Error()
+				r.receipt.Errors = append(r.receipt.Errors, err.Error())
+			}
+			if err == nil {
+				err = cNativeValidateReceipt(r.receipt)
+			}
+			if err == nil {
+				err = cNativeG.VerifyReceipt(ctx, r.receipt)
+			}
+			if err == nil {
+				r.receipt.Functional = "Verified"
+			}
+			publishErr := cNativeG.Publish(ctx, r.receipt)
+			if err = errors.Join(err, publishErr); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
