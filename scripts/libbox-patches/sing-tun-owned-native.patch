+//go:build linux
+
+package tun
+
+import (
+	"errors"
+	"math/rand"
+	"slices"
+	"strconv"
+
+	"github.com/sagernet/netlink"
+	"golang.org/x/sys/unix"
+)
+
+func init() {
+	registerRedirectRouteBackend(func(r *autoRedirect) (redirectRouteBackend, error) {
+		directory := redirectClaimDirectory
+		if r.productionDependencies != nil {
+			directory = r.productionDependencies.claimDirectory
+		}
+		return &realRedirectRoutes{claimDirectory: directory, openHandle: openRouteNetlink}, nil
+	})
+}
+
+type realRedirectRoutes struct {
+	claimDirectory     string
+	withClaimAllocator func(string, func(*redirectClaimAllocator) error) error
+	openHandle         func(*networkNamespaceLease) (routeNetlink, error)
+	api                routeNetlink
+	claims             *redirectClaims
+	claimID            redirectResourceID
+	handleID           redirectResourceID
+	routes             ownedRouteSet
+	rules              ownedRuleSet
+	prepared           bool
+}
+
+func (b *realRedirectRoutes) validate() error {
+	if b.claims == nil || b.api == nil {
+		return errRedirectAmbiguous
+	}
+	return b.claims.Validate()
+}
+
+// Prepare runs inside the common Start effect lock, before any listener or
+// queue. This nested admitted operation only journals the lasting socket and
+// conflict claims; no route/rule acquisition occurs until Start.
+func (b *realRedirectRoutes) Prepare(r *autoRedirect) error {
+	if b.prepared || r.namespaceLease == nil {
+		return errors.New("redirect route preparation is single-use and requires a namespace lease")
+	}
+	op, err := r.ownership.beginOperation(false, false)
+	if err != nil {
+		return err
+	}
+	defer op.finish()
+	b.handleID, err = op.acquire(redirectNetlink, "route-socket", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			api, err := b.openHandle(r.namespaceLease)
+			b.api = api
+			if err != nil {
+				if api == nil {
+					return redirectAcquireResult{redirectAcquireNotCommitted, err}
+				}
+				return redirectAcquireResult{err: err}
+			}
+			if api == nil {
+				return redirectAcquireResult{err: errRedirectInvalidACK}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error {
+			err := b.api.Close()
+			if err == nil {
+				b.api = nil
+			}
+			return err
+		},
+	})
+	if err != nil {
+		return err
+	}
+	b.claimID, err = op.acquire(redirectClaim, "route-conflicts", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			withAllocator := b.withClaimAllocator
+			if withAllocator == nil {
+				withAllocator = withRedirectClaimAllocator
+			}
+			var table, tproxyTable int
+			err := withAllocator(b.claimDirectory, func(allocator *redirectClaimAllocator) error {
+				if err := rejectOccupiedPriorities(b.api, []int{redirectRouteRulePriority}); err != nil {
+					return err
+				}
+				var err error
+				table, err = chooseClaimedRouteTable(b.api, r.tunOptions.IPRoute2TableIndex)
+				if err != nil {
+					return err
+				}
+				keys := []redirectConflictKey{{"route-table", strconv.Itoa(table)}, {"rule-priority", strconv.Itoa(redirectRouteRulePriority)}}
+				if !r.useNFTables && len(r.tunOptions.Inet6Address) > 0 {
+					tproxyTable, err = chooseClaimedRouteTable(b.api, r.tunOptions.IPRoute2TableIndex, table)
+					if err != nil {
+						return err
+					}
+					keys = append(keys, redirectConflictKey{"route-table", strconv.Itoa(tproxyTable)})
+				}
+				b.claims, err = acquireRedirectClaimsInAllocator(allocator, r.namespaceLease.Identity(), r.ownership.birth, keys)
+				return err
+			})
+			if err == nil {
+				if b.claims == nil {
+					return redirectAcquireResult{err: errRedirectInvalidACK}
+				}
+				err = b.claims.Validate()
+			}
+			if err != nil {
+				if b.claims != nil {
+					return redirectAcquireResult{err: errors.Join(errRedirectAmbiguous, err)}
+				}
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			r.redirectRouteTableIndex = table
+			r.tproxyRouteTableIndex = tproxyTable
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return b.claims.Release() },
+	}, b.handleID)
+	if err != nil {
+		return err
+	}
+	b.routes.api = &claimedRouteNetlink{routeNetlink: b.api, validate: b.validate}
+	b.rules.api = b.routes.api
+	b.prepared = true
+	return nil
+}
+
+func chooseClaimedRouteTable(api routeNetlink, excluded ...int) (int, error) {
+	for attempt := 0; attempt < 128; attempt++ {
+		table := int(rand.Uint32() & 0x7fffffff)
+		if table <= 255 || slices.Contains(excluded, table) {
+			continue
+		}
+		occupied, err := routeTableOccupiedOn(api, table)
+		if err != nil {
+			return 0, err
+		}
+		if !occupied {
+			return table, nil
+		}
+	}
+	return 0, errors.New("no unoccupied route table found within allocation budget")
+}
+
+func (b *realRedirectRoutes) Start(r *autoRedirect, op *redirectOperation, _ []redirectResourceID) ([]redirectResourceID, error) {
+	if !b.prepared {
+		return nil, errors.New("redirect routes are not prepared")
+	}
+	if err := b.UpdateNetwork(r, op); err != nil {
+		return nil, err
+	}
+	var rules []*netlink.Rule
+	for _, family := range []int{unix.AF_INET, unix.AF_INET6} {
+		if family == unix.AF_INET && !r.enableIPv4 || family == unix.AF_INET6 && !r.enableIPv6 {
+			continue
+		}
+		rule := netlink.NewRule()
+		rule.Priority = redirectRouteRulePriority
+		rule.Table = r.redirectRouteTableIndex
+		rule.Family = family
+		rules = append(rules, rule)
+	}
+	if r.tproxyEnabled() {
+		rules = append(rules, r.tproxyRouteRule())
+	}
+	if err := b.rules.reconcile(op, rules, b.claimID, b.handleID); err != nil {
+		return nil, err
+	}
+	r.redirectRoutesActive = true
+	// Firewall rules refer to the table service, not individual interface routes.
+	// These stable prerequisites prevent socket/claim retirement while hooks
+	// remain, and permit updates to retire only our per-route receipts.
+	return []redirectResourceID{b.claimID, b.handleID}, nil
+}
+
+func (b *realRedirectRoutes) UpdateNetwork(r *autoRedirect, op *redirectOperation) error {
+	if err := b.validate(); err != nil {
+		return err
+	}
+	if err := r.interfaceFinder.Update(); err != nil {
+		return err
+	}
+	var desired []netlink.Route
+	for _, iface := range r.currentRedirectInterfaces() {
+		ipv4, ipv6 := redirectRouteAddressFamilies(iface)
+		for _, family := range []int{unix.AF_INET, unix.AF_INET6} {
+			if family == unix.AF_INET && (!r.enableIPv4 || !ipv4) || family == unix.AF_INET6 && (!r.enableIPv6 || !ipv6) {
+				continue
+			}
+			route := newRedirectRoute(r.redirectRouteTableIndex, redirectRouteKey{iface.Index, family})
+			// A distinct metric allows CREATE|EXCL for each interface, instead of
+			// APPEND which can acquire an existing prefix alias without exclusivity.
+			route.Priority = iface.Index
+			desired = append(desired, route)
+		}
+	}
+	if r.tproxyEnabled() {
+		loopback, err := b.api.LinkByName("lo")
+		if err != nil {
+			return err
+		}
+		desired = append(desired, netlink.Route{LinkIndex: loopback.Attrs().Index, Dst: defaultDestination(unix.AF_INET6), Table: r.tproxyRouteTableIndex, Type: unix.RTN_LOCAL, Scope: netlink.SCOPE_HOST})
+	}
+	return b.routes.reconcile(op, desired, b.claimID, b.handleID)
+}
