+	}
+	return FlowVerdict{}
+}
+func (h runtimeHandler) NewConnectionEx(_ context.Context, conn net.Conn, _, _ M.Socksaddr, _ N.CloseHandlerFunc) {
+	if h.connection != nil {
+		h.connection(conn)
+	} else {
+		_ = conn.Close()
+	}
+}
