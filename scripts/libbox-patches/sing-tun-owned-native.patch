+// Count 1000 remains the compatibility boundary, while the exact library
+// serializer enforces a tighter encoded-byte budget when necessary. Interval
+// start/end pairs stay in one transaction, including an unbounded last range.
+func nftablesElementChunk(writer nftablesIPConstWriter, set *nftables.Set, elements []nftables.SetElement) (int, error) {
+	count := min(1000, len(elements))
+	concrete, real := writer.(*nftables.Conn)
+	if !real {
+		return count, nil
+	}
+	pending, err := concrete.PendingBytes()
+	if err != nil {
+		return 0, err
+	}
+	for count > 0 {
+		if set.Interval && count < len(elements) && !elements[count-1].IntervalEnd && elements[count].IntervalEnd {
+			count--
+		}
+		if count == 0 {
+			break
+		}
+		encoded, err := nftables.SetElementBytes(set, elements[:count])
+		if err != nil {
+			count--
+			continue
+		}
+		if pending+encoded <= 128<<10 {
+			return count, nil
+		}
+		count--
+	}
+	return 0, errors.New("nft buffered intents or one interval exceed the encoded transaction budget")
+}
