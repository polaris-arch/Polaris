+	firewall := &runtimeFirewallTransport{}
+	r := newRuntimeProductionRedirect(t, directory, firewall)
+	r.tunOptions.AutoRedirectMarkMode = true
+	routes := &runtimeRouteServiceTransport{releases: &releases, claimDirectory: directory, claimRequired: true}
+	r.productionDependencies.routes = func(*autoRedirect) (redirectRouteBackend, error) { return routes, nil }
+	// R Prepare uses the admitted metadata operation, ahead of listener/queue.
+	// Its returned table/priority claims remain actual firewall prerequisites.
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	r.ownership.access.Lock()
+	if len(r.ownership.serviceAnchors) != 1 || r.ownership.serviceAnchors[0] != routes.anchor {
+		t.Error("metadata claim treated as Netlink anchor")
+	}
+	var holder *redirectResource
+	for _, entry := range r.ownership.resources {
+		if entry.id == firewall.resourceID {
+			holder = entry
+		}
+	}
+	if holder == nil || !slices.Contains(holder.requires, routes.claim) {
+		t.Error("route claim removed from firewall dependencies")
+	}
+	r.ownership.access.Unlock()
+	if err := r.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRedirectProductionDisposeConstructionBeforeStart(t *testing.T) {
+	backend := &runtimeFirewallTransport{}
+	r := newRuntimeProductionRedirect(t, filepath.Join(t.TempDir(), "claims"), backend)
+	if err := r.DisposeConstruction(); err != nil {
+		t.Fatal(err)
+	}
+	if r.namespaceLease != nil || backend.queue.closeCount.Load() != 0 {
+		t.Fatal("unstarted disposal reached unacquired resources")
+	}
+	if err := r.Start(); !errors.Is(err, errRedirectClosing) {
+		t.Fatal(err)
+	}
+}
