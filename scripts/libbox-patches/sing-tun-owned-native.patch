+package tun
+
+import (
+	"crypto/sha256"
+	"errors"
+	"net/netip"
+	"slices"
+)
+
+type redirectNFTVerdict uint8
+
+const (
+	redirectNFTAccept redirectNFTVerdict = iota + 1
+	redirectNFTDrop
+	redirectNFTReturn
+)
+
+// Comparable, immutable values. Elements have no durable kernel handle; their
+// canonical key and fake creation version supply the conditional oracle proof.
+type redirectNFTContent struct {
+	family      redirectNFTFamily
+	address     netip.Addr
+	source      netip.Prefix
+	destination netip.Prefix
+	verdict     redirectNFTVerdict
+	lookup      redirectResourceID // optional destination-address set lookup, no inversion
+}
+
+func supportedNFTKind(kind redirectNFTKind) bool {
+	return kind >= redirectNFTTable && kind <= redirectNFTRule
+}
+
+func validNFTAddress(family redirectNFTFamily, address netip.Addr) bool {
+	return (family == redirectNFTIPv4 || family == redirectNFTIPv6) && address.IsValid() &&
+		address.Zone() == "" && !address.Is4In6() && address.Is4() == (family == redirectNFTIPv4)
+}
+
+func canonicalNFTPrefix(family redirectNFTFamily, prefix netip.Prefix) (netip.Prefix, error) {
+	if prefix == (netip.Prefix{}) {
+		return prefix, nil
+	}
+	if !prefix.IsValid() || !validNFTAddress(family, prefix.Addr()) {
+		return netip.Prefix{}, errors.New("invalid finite nft prefix")
+	}
+	if prefix.Bits() == 0 {
+		return netip.Prefix{}, nil
+	}
+	return prefix.Masked(), nil
+}
+
+func validNFTContent(address redirectNFTAddress, spec redirectNFTSpec) bool {
+	if spec.version != 1 || spec.kind != address.kind {
+		return false
+	}
+	c := spec.content
+	switch address.kind {
+	case redirectNFTTable, redirectNFTChain:
+		return c == (redirectNFTContent{})
+	case redirectNFTSet, redirectNFTElement:
+		if c.family != redirectNFTIPv4 && c.family != redirectNFTIPv6 || address.scope.family != redirectNFTINet && address.scope.family != c.family {
+			return false
+		}
+		want := redirectNFTContent{family: c.family}
+		if address.kind == redirectNFTElement {
+			if !validNFTAddress(c.family, address.element) {
+				return false
+			}
+			want.address = address.element
+		}
+		return c == want
+	case redirectNFTRule:
+		if c.family != redirectNFTIPv4 && c.family != redirectNFTIPv6 || address.scope.family != redirectNFTINet && address.scope.family != c.family ||
+			c.address.IsValid() || c.verdict < redirectNFTAccept || c.verdict > redirectNFTReturn {
+			return false
+		}
+		source, sourceErr := canonicalNFTPrefix(c.family, c.source)
+		destination, destinationErr := canonicalNFTPrefix(c.family, c.destination)
+		return sourceErr == nil && destinationErr == nil && source == c.source && destination == c.destination
+	}
+	return false
+}
+
+func (a redirectNFTAddress) parentAddress() redirectNFTAddress {
+	parent := redirectNFTAddress{scope: a.scope, kind: redirectNFTTable, table: a.table}
+	switch a.kind {
+	case redirectNFTElement:
+		parent.kind, parent.set = redirectNFTSet, a.set
+	case redirectNFTRule:
+		parent.kind, parent.chain = redirectNFTChain, a.chain
+	}
+	return parent
+}
+
+func (p *redirectOperation) validNFTContentIntent(i redirectNFTIntent) bool {
+	a := i.address
+	if a.table == "" || i.parent != (redirectResourceID{p.owner.birth, redirectNFTables, a.parentAddress().key()}) || !slices.Contains(i.requires, i.parent) {
+		return false
+	}
+	switch a.kind {
+	case redirectNFTSet:
+		a.set = ""
+		return i.address.chain == "" && !i.address.element.IsValid() && i.address.ruleRole == "" && i.address.set == redirectNFTPrivateName(p.owner.birth, a, i.role)
+	case redirectNFTElement:
+		return a.chain == "" && a.set != "" && a.ruleRole == ""
+	case redirectNFTRule:
+		return a.chain != "" && a.set == "" && !a.element.IsValid() && a.ruleRole == i.role &&
+			(i.spec.content.lookup == (redirectResourceID{}) || slices.Contains(i.requires, i.spec.content.lookup))
+	}
+	return false
+}
+
+func (p *redirectOperation) newNFTContentIntent(address redirectNFTAddress, role string, parent redirectResourceID, content redirectNFTContent, dependencies []redirectResourceID) (redirectNFTIntent, error) {
+	id := redirectResourceID{p.owner.birth, redirectNFTables, address.key()}
+	intent := redirectNFTIntent{id, address, redirectNFTStamp{1, p.owner.birth, sha256.Sum256([]byte(id.key))}, redirectNFTSpec{1, address.kind, content}, role, parent, slices.Clone(dependencies)}
+	if !p.validNFTIntent(intent) {
+		return redirectNFTIntent{}, errors.New("invalid finite nft intent")
+	}
+	return intent, nil
+}
+
+func (p *redirectOperation) nftSetIntent(table redirectNFTIntent, role string, family redirectNFTFamily) (redirectNFTIntent, error) {
+	if !p.validNFTIntent(table) || table.address.kind != redirectNFTTable {
+		return redirectNFTIntent{}, errors.New("finite set needs this birth's table")
+	}
+	address := redirectNFTAddress{scope: table.address.scope, kind: redirectNFTSet, table: table.address.table}
+	address.set = redirectNFTPrivateName(p.owner.birth, address, role)
+	return p.newNFTContentIntent(address, role, table.id, redirectNFTContent{family: family}, []redirectResourceID{table.id})
+}
+
+func (p *redirectOperation) nftElementIntents(set redirectNFTIntent, addresses []netip.Addr) ([]redirectNFTIntent, error) {
+	if !p.validNFTIntent(set) || set.address.kind != redirectNFTSet {
+		return nil, errors.New("finite elements need this birth's named set")
+	}
+	addresses = slices.Clone(addresses)
+	for _, address := range addresses {
+		if !validNFTAddress(set.spec.content.family, address) {
+			return nil, errors.New("finite element family/key is invalid")
+		}
+	}
+	slices.SortFunc(addresses, netip.Addr.Compare)
+	addresses = slices.Compact(addresses)
+	elements := make([]redirectNFTIntent, 0, len(addresses))
+	for _, key := range addresses {
+		address := redirectNFTAddress{scope: set.address.scope, kind: redirectNFTElement, table: set.address.table, set: set.address.set, element: key}
+		intent, err := p.newNFTContentIntent(address, "element", set.id, redirectNFTContent{family: set.spec.content.family, address: key}, []redirectResourceID{set.parent, set.id})
+		if err != nil {
+			return nil, err
+		}
+		elements = append(elements, intent)
+	}
+	return elements, nil
+}
+
+func (p *redirectOperation) nftRuleIntent(chain redirectNFTIntent, role string, content redirectNFTContent, set *redirectNFTIntent, elements []redirectNFTIntent) (redirectNFTIntent, error) {
+	if !p.validNFTIntent(chain) || chain.address.kind != redirectNFTChain || content.lookup != (redirectResourceID{}) {
+		return redirectNFTIntent{}, errors.New("finite rule needs this birth's chain and typed lookup")
+	}
+	var err error
+	content.source, err = canonicalNFTPrefix(content.family, content.source)
+	if err != nil {
+		return redirectNFTIntent{}, err
+	}
+	content.destination, err = canonicalNFTPrefix(content.family, content.destination)
+	if err != nil {
+		return redirectNFTIntent{}, err
+	}
+	requires := []redirectResourceID{chain.parent, chain.id}
+	if set != nil {
+		if !p.validNFTIntent(*set) || set.address.kind != redirectNFTSet || set.address.scope != chain.address.scope ||
+			set.address.table != chain.address.table || set.spec.content.family != content.family {
+			return redirectNFTIntent{}, errors.New("foreign or incompatible finite lookup set")
+		}
+		content.lookup = set.id
+		requires = append(requires, set.id)
+	} else if len(elements) != 0 {
+		return redirectNFTIntent{}, errors.New("elements without a lookup set")
+	}
+	for _, element := range elements {
+		if !p.validNFTIntent(element) || element.address.kind != redirectNFTElement || element.parent != set.id || element.spec.content.family != content.family || slices.Contains(requires, element.id) {
+			return redirectNFTIntent{}, errors.New("invalid or duplicate finite lookup element")
+		}
+		requires = append(requires, element.id)
+	}
+	address := redirectNFTAddress{scope: chain.address.scope, kind: redirectNFTRule, table: chain.address.table, chain: chain.address.chain, ruleRole: role}
+	return p.newNFTContentIntent(address, role, chain.id, content, requires)
+}
+
+func validNFTReceiptHandle(object redirectNFTObjectIdentity) bool {
+	if object.address.kind == redirectNFTElement {
+		return object.handle == 0
+	}
+	return object.handle != 0
+}
+
+// Caller holds the ledger lock. A rule binds every known element of its lookup
+// set. A Pending/Ambiguous plan is retained before its receipt; it must also
+// block another writer from appending to that set, even without an identity.
+func validateNFTContentDependencies(members []redirectNFTIntent, existing map[redirectResourceID]*redirectResource) error {
+	objects := make(map[redirectResourceID]redirectNFTObjectIdentity)
+	for id, entry := range existing {
+		if binding, typed := entry.ops.(*redirectNFTBinding); typed && entry.state != redirectReleased {
+			objects[id] = redirectNFTObjectIdentity{id: id, address: binding.intent.address, spec: binding.intent.spec}
+		}
+	}
+	for _, member := range members {
+		objects[member.id] = redirectNFTObjectIdentity{id: member.id, address: member.address, spec: member.spec}
+	}
+	for _, member := range members {
+		if member.address.kind == redirectNFTElement {
+			parent := objects[member.parent]
+			if parent.address.kind != redirectNFTSet || parent.spec.content.family != member.spec.content.family {
+				return errors.New("incompatible finite element parent")
+			}
+			for _, entry := range existing {
+				if binding, typed := entry.ops.(*redirectNFTBinding); typed && entry.state != redirectReleased && (binding.intent.spec.content.lookup == member.parent || (entry.state == redirectPending || entry.state == redirectAmbiguous) && binding.intent.parent == member.parent) {
+					return ErrAutoRedirectOwnershipUnsupported
+				}
+			}
+		}
+		lookup := member.spec.content.lookup
+		if lookup == (redirectResourceID{}) {
+			continue
+		}
+		set := objects[lookup]
+		if set.address.kind != redirectNFTSet || set.address.scope != member.address.scope || set.address.table != member.address.table || set.spec.content.family != member.spec.content.family {
+			return errors.New("incompatible finite rule lookup")
+		}
+		for id, object := range objects {
+			if object.address.kind == redirectNFTElement && object.address.parentAddress() == set.address && !slices.Contains(member.requires, id) {
+				return errors.New("finite rule omitted a known lookup element")
+			}
+		}
+	}
+	return nil
+}
+
+// One admitted writer owns this queue. No hidden helper queue, partial flush,
+// replay, or concurrent use is permitted; an error permanently stops the queue.
+type redirectNFTCreateQueue struct {
+	operation *redirectOperation
+	ops       redirectNFTOwnershipOps
+	members   []redirectNFTIntent
+	err       error
+}
+
+func (q *redirectNFTCreateQueue) add(members ...redirectNFTIntent) error {
+	if q.err != nil {
+		return q.err
+	}
+	seen := make(map[redirectResourceID]bool, len(q.members)+len(members))
+	for _, member := range q.members {
+		seen[member.id] = true
+	}
+	for _, member := range members {
+		if !supportedNFTKind(member.address.kind) {
+			q.err = ErrAutoRedirectOwnershipUnsupported
+			return q.err
+		}
+		if !q.operation.validNFTIntent(member) || seen[member.id] {
+			q.err = errors.New("invalid or duplicate buffered nft intent")
+			return q.err
+		}
+		seen[member.id] = true
+	}
+	for _, member := range members {
+		q.members = append(q.members, member.clone())
+	}
+	return nil
+}
+
+func (q *redirectNFTCreateQueue) Flush() error {
+	if q.err != nil {
+		return q.err
+	}
+	if len(q.members) == 0 {
+		return nil
+	}
+	members := q.members
+	q.members = nil // errors cannot re-submit an uncertain queue
+	_, q.err = q.operation.acquireNFTBatch(members, q.ops)
+	return q.err
+}
