+// Custody is published before the first acquire. Failed New and failed Close
+// cannot abandon a live fd, namespace, or cooperative claim to a finalizer.
+// This is local responsibility retention, not a global NoOwner assertion.
+var nativeTunCustody sync.Map // redirectBirth -> *NativeTun
+
+type nativeTunDependencies struct {
+	claimDirectory     string
+	withClaimAllocator func(string, func(*redirectClaimAllocator) error) error
+	openHandle         func(*networkNamespaceLease) (routeNetlink, error)
+	openTun            func(string, bool, bool, bool) (int, bool, error)
+	identityOfFD       func(int) (nativeTunFDIdentity, error)
+	configureOffload   func(*NativeTun) error
+	configureRPFilter  func(*NativeTun) error
+}
+
+type nativeTunOwnership struct {
+	owner            *redirectOwnership
+	lease            *networkNamespaceLease
+	api              routeNetlink
+	claims           *redirectClaims
+	link             netlink.Link // frozen index/name, never reacquired by name for release
+	borrowed         bool
+	started          bool  // guarded by owner.effect
+	sealed           error // failed partial update; no implicit TUN retirement
+	priority6        int
+	queueSerial      uint64
+	fdNamespaceKnown bool
+	routes           ownedRouteSet
+	rules            ownedRuleSet
+	operation        *redirectOperation // only while the effect lock is held
+	dependency       nativeTunDependencies
+}
