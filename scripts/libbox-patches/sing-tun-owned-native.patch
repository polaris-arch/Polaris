+func cNativeValidateFW4(r cNativeReceipt) error {
+	if !slices.ContainsFunc(cNativeFW4Cases, func(c cNativeCase) bool { return c.path() == r.Case.path() }) {
+		return nil
+	}
+	var f *cNativeFW4Evidence
+	for _, w := range r.Windows {
+		if w.Name == "FW4_evidence" {
+			if f != nil {
+				return errors.New("duplicate fw4 evidence")
+			}
+			f = w.FW4
+		}
+	}
+	if f == nil {
+		return errors.New("actual fw4 window unestablished: NotReady")
+	}
+	if !cNativeSHA(f.LockRawSHA) || !cNativeSHA(f.FileRawSHA) || !cNativeSHA(f.WaitRawSHA) {
+		return errors.New("missing actual lock/file/Wait raw facts")
+	}
+	s := r.Case.Scenario
+	if s == "fw4-live-Pending" || s == "fw4-live-Unknown" {
+		phase := "pending"
+		if s == "fw4-live-Unknown" {
+			phase = "unknown"
+		}
+		if f.RefusalStage != "lockCoordinator" || f.CheckOtherJournalsReached || !f.HolderAlive || f.HolderActualWait || f.JournalCrafted || f.HolderPhase != phase || (f.CoordinatorErrno != int(unix.EWOULDBLOCK) && f.CoordinatorErrno != int(unix.EAGAIN)) {
+			return errors.New("live holder refusal layer not established")
+		}
+		return nil
+	}
+	if s == "fw4-orphan" || s == "fw4-crafted-Pending" || s == "fw4-crafted-Unknown" {
+		if f.RefusalStage != "checkOtherJournals" || !f.CheckOtherJournalsReached || f.HolderAlive {
+			return errors.New("callee journal barrier not reached")
+		}
+		if s == "fw4-orphan" {
+			if !f.HolderActualWait || f.JournalCrafted {
+				return errors.New("actual orphan Wait missing")
+			}
+		} else {
+			phase := "pending"
+			if s == "fw4-crafted-Unknown" {
+				phase = "unknown"
+			}
+			if !f.JournalCrafted || f.HolderPhase != phase {
+				return errors.New("crafted journal is not live holder evidence")
+			}
+		}
+		return nil
+	}
+	if s == "fw4-script" {
+		if f.RefusalStage != "scriptContract" || f.BadScriptExecuted {
+			return errors.New("wrong script was not refused at contract")
+		}
+		return nil
+	}
+	if !f.FileCreated || f.IncludeOriginal.Inode == 0 || !cNativeSHA(f.OriginalContentSHA) || f.Journal.Protocol != fw4Protocol || f.Journal.ScriptSHA256 != fw4ScriptSHA || f.Journal.LayoutSHA256 != fw4LayoutSHA {
+		return errors.New("original fw4 file/platform identity missing")
+	}
+	if f.Journal.FileCreated != f.FileCreated || f.Journal.FileUnlinked != f.FileUnlinked || f.Journal.File != f.IncludeOriginal || f.Journal.IncludeSHA256 != f.OriginalContentSHA || !reflect.DeepEqual(f.Commands, f.Journal.Commands) {
+		return errors.New("separate file/command facts do not match original journal")
+	}
+	if f.ReloadAttemptsAfterUnknown != 0 || f.UnlinkAttemptsAfterUnlinked != 0 {
+		return errors.New("retry or compensating reload after Unknown/unlink")
+	}
+	if s == "fw4-inode" {
+		if f.IncludeAfter.Inode == f.IncludeOriginal.Inode || f.Journal.Phase != "unknown" {
+			return errors.New("stale inode Unknown missing")
+		}
+		return nil
+	}
+	if s == "fw4-content" || s == "fw4-disposal" {
+		if f.AfterContentSHA == f.OriginalContentSHA || !cNativeSHA(f.AfterContentSHA) || f.Journal.Phase != "unknown" {
+			return errors.New("changed content Unknown missing")
+		}
+		return nil
+	}
+	if s == "fw4-acquire-timeout" || s == "fw4-retire-timeout" {
+		revision := uint64(1)
+		if s == "fw4-retire-timeout" {
+			revision = 2
+		}
+		if f.ActivationRole != "B" || f.ActivationBirth != f.Journal.Birth || f.ActivationRevision != revision || f.OriginalPID <= 0 || f.AncestorPID != r.Admission.Actors["B"].PID || f.PreselectionUnix <= 0 || f.PIDObservedUnix < f.PreselectionUnix || f.ActivationUnix < f.PIDObservedUnix {
+			return errors.New("activation is not bound to actual B birth/revision/PID ancestry")
+		}
+		var command *fw4CommandFact
+		for i := range f.Commands {
+			v := &f.Commands[i]
+			if v.Revision == revision {
+				if command != nil {
+					return errors.New("duplicate original command Wait")
+				}
+				command = v
+			}
+		}
+		if command == nil || !command.Started || !command.Waited || !command.CallerTimeout || command.PID != f.OriginalPID || command.WaitedUnix <= command.StartedUnix || command.WaitedUnix-command.StartedUnix < int64(30*time.Second) || f.PublicReturnUnix < command.WaitedUnix || f.Journal.Phase != "unknown" {
+			return errors.New("timeout caller/Close did not retain actual original Wait custody")
+		}
+		if f.PreselectionUnix > command.StartedUnix || f.PIDObservedUnix < command.StartedUnix || f.ActivationUnix >= command.StartedUnix+int64(30*time.Second) || !cNativeSHA(command.OutputSHA256) {
+			return errors.New("activation/actual PID/output timing not established")
+		}
+		if s == "fw4-acquire-timeout" {
+			if f.FileUnlinked || len(f.Commands) != 1 {
+				return errors.New("late acquisition Wait was incorrectly retired or greened")
+			}
+		} else {
+			if !f.FileUnlinked || len(f.Commands) != 2 {
+				return errors.New("retire fixture did not first acquire Committed")
+			}
+			first := f.Commands[0]
+			if first.Revision != 1 || !first.Waited || first.Exit != 0 || first.CallerTimeout {
+				return errors.New("retire fixture startup was not normal")
+			}
+		}
+		return nil // late exit0 remains Unknown, never semantic ownership.
+	}
+	if s == "fw4-unlinked-failure" {
+		if !f.FileUnlinked || !f.ReplacementPreserved || f.Journal.Phase != "unknown" || len(f.Commands) != 2 {
+			return errors.New("unlink/reload failure custody missing")
+		}
+		last := f.Commands[1]
+		if !last.Waited || last.Exit == 0 && last.Error == "" {
+			return errors.New("real original reload failure missing")
+		}
+		return nil
+	}
+	wantA, wantB := 4, 0
+	if s == "fw4-pair" {
+		wantB = 4
+	}
+	if s == "fw4-final" {
+		wantA = 0
+	}
+	if f.SemanticGeneration == 0 || f.ExactSemanticRules != wantA+wantB || f.SemanticRulesByRole["A"] != wantA || f.SemanticRulesByRole["B"] != wantB || len(f.SemanticRulesByRole) != 2 || f.DuplicateSemanticRules != 0 || !cNativeSHA(f.SemanticRawSHA) {
+		return errors.New("fw4 exit0 is not complete exact single-GENID semantic proof")
+	}
+	return nil
+}
