+func TestCActualDockerSerializerAndExactRetirement(t *testing.T) {
+	g, s := cDockerFixture()
+	capture := &nftBuilderCapture{}
+	conn, err := nftables.New(nftables.WithTestDial(capture.dial))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.CloseLasting()
+	if err = g.queueAcquire(s, conn, "c-test-tun", []string{"birth-output", "birth-input"}); err != nil {
+		t.Fatal(err)
+	}
+	if err = conn.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if len(capture.batches) != 1 || len(capture.batches[0]) != 4 {
+		t.Fatal("incomplete actual serializer batch")
+	}
+	for _, m := range capture.batches[0][1:3] {
+		if uint16(m.Header.Type) != unix.NFNL_SUBSYS_NFTABLES<<8|unix.NFT_MSG_NEWRULE || m.Header.Flags != netlink.Request|netlink.Acknowledge|netlink.Create|unix.NLM_F_ECHO {
+			t.Fatal("create became replacement/parent mutation")
+		}
+		attrs, err := netlink.UnmarshalAttributes(m.Data[4:])
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, a := range attrs {
+			if a.Type == unix.NFTA_RULE_HANDLE {
+				t.Fatal("borrowed old handle used for create")
+			}
+		}
+	}
+	foreign := nftablesDockerCompatibilityRule(g.parent, g.chain, "c-test-tun", expr.MetaKeyIIFNAME, "own-0")
+	foreign.Handle = 99
+	s.Rules = append(s.Rules, foreign)
+	planned, err := g.queueRetirement(s, conn)
+	if err != nil || !planned {
+		t.Fatal(err)
+	}
+	if err = conn.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if len(capture.batches[1]) != 4 {
+		t.Fatal("retirement touched extra shared objects")
+	}
+	expectedHandles := map[uint64]bool{21: true, 22: true}
+	for _, m := range capture.batches[1][1:3] {
+		if uint16(m.Header.Type) != unix.NFNL_SUBSYS_NFTABLES<<8|unix.NFT_MSG_DELRULE {
+			t.Fatal("retired a shared parent")
+		}
+		attrs, err := netlink.UnmarshalAttributes(m.Data[4:])
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, a := range attrs {
+			if a.Type == unix.NFTA_RULE_HANDLE {
+				handle := binary.BigEndian.Uint64(a.Data)
+				if !expectedHandles[handle] {
+					t.Fatal("foreign handle was serialized for deletion")
+				}
+				delete(expectedHandles, handle)
+			}
+		}
+	}
+	if len(expectedHandles) != 0 {
+		t.Fatal("exact own handles missing from retirement")
+	}
+	// A changed parent handle proves the original parent was withdrawn; its
+	// handles cannot be reused in the replacement parent.
+	s.Tables[0].Handle++
+	if gone, err := g.parentGone(s); err != nil || !gone {
+		t.Fatal("parent rebuild did not withdraw old group")
+	}
+	capture.batches = nil
+	if _, err = g.queueRetirement(s, conn); err == nil {
+		t.Fatal("replacement parent accepted old delete handles")
+	}
+	if size, err := conn.PendingBytes(); err != nil || size != 40 {
+		t.Fatal("rejected parent serialized delete")
+	}
+}
