+func TestIProductionReadonlyProbeIsPureThenCommonPendingAndCachedWait0(t *testing.T) {
+	owner, err := newRedirectOwnership()
+	if err != nil {
+		t.Fatal(err)
+	}
+	namespace := testINamespaceLease(t)
+	op, err := owner.beginStart()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer op.finish()
+	b, intent := testIProbeBackend(t, owner, namespace, "/bin/true")
+	ops, err := b.ReadonlyIPTablesProbe(intent)
+	if err != nil || len(ownershipEntries(owner)) != 0 {
+		t.Fatal("pure factory acquired a process or ledger slot", err)
+	}
+	var waits atomic.Int32
+	probe := ops.(*iptablesReadonlyProbeOps)
+	probe.runner.wait = func(command *exec.Cmd) error {
+		entries := ownershipEntries(owner)
+		if len(entries) != 1 || entries[0].state != redirectPending || entries[0].id.domain != redirectReadOnlyProbe {
+			t.Error("readonly command started before its common process journal")
+		}
+		waits.Add(1)
+		return command.Wait()
+	}
+	var id redirectResourceID
+	err = op.withEffect(func() error {
+		var acquireErr error
+		id, acquireErr = op.acquire(redirectReadOnlyProbe, "fixture-actual-probe", ops)
+		return acquireErr
+	})
+	if err != nil || waits.Load() != 1 {
+		t.Fatal("original native Wait0 did not acquire the process receipt", err)
+	}
+	if err = op.release(id); err != nil || waits.Load() != 1 {
+		t.Fatal("probe cleanup ran another command or Wait", err, waits.Load())
+	}
+	if entry := ownershipEntries(owner)[0]; entry.state != redirectReleased {
+		t.Fatal("cached same-Cmd Wait0 was not consumed", entry)
+	}
+}
