+)
+
+// Injection is at the same Handle/ioctl/command APIs used by production, not at
+// a second ownership engine. No test opens a netlink socket or runs a command.
+type rNetlinkAPI struct {
+	links            map[string]netlink.Link
+	routes           []netlink.Route
+	rules            []netlink.Rule
+	deletedRoutes    []netlink.Route
+	deletedRules     []netlink.Rule
+	deletedAddresses []string
+	addRouteErr      error
+	addRouteErrAt    int
+	routeAdds        int
+	routeDelErrAt    int
+	routeDels        int
+	beforeRouteAdd   func(int)
+	defaultDumpNil   bool
+	addRuleErrAt     int
+	ruleAdds         int
+	addrExisting     bool
+	closed           int
+	opened           int
+	newExclusive     []bool
+	queueFDs         []int
+}
+
+func newRNetlinkAPI() *rNetlinkAPI {
+	return &rNetlinkAPI{links: map[string]netlink.Link{"lo": &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Index: 1, Name: "lo", MTU: 65536, Flags: net.FlagUp}}}}
+}
+
+func rClaimDirectory(t *testing.T) string { return filepath.Join(t.TempDir(), "claims") }
+
+// Reuse L's actual store/flock/EXCL implementation. Only the provisioned owner
+// policy is replaced for this private non-root fixture, never the file protocol.
+func rWithClaimAllocator(t *testing.T, directory string, block func(*redirectClaimAllocator) error) error {
+	t.Helper()
+	store, err := openTestRedirectClaimStore(t, directory)
+	if err != nil {
+		return err
+	}
+	defer store.close()
+	return store.withAllocator(func() error {
+		allocator := &redirectClaimAllocator{store: store, active: true}
+		defer func() { allocator.active = false }()
+		return block(allocator)
+	})
+}
+func (a *rNetlinkAPI) Close() error { a.closed++; return nil }
+func (a *rNetlinkAPI) LinkByName(name string) (netlink.Link, error) {
+	if link := a.links[name]; link != nil {
+		return link, nil
+	}
+	return nil, netlink.LinkNotFoundError{}
+}
+func (a *rNetlinkAPI) LinkByIndex(index int) (netlink.Link, error) {
+	for _, link := range a.links {
+		if link.Attrs().Index == index {
+			return link, nil
+		}
+	}
+	return nil, netlink.LinkNotFoundError{}
+}
+func (a *rNetlinkAPI) LinkSetMTU(link netlink.Link, mtu int) error { return nil }
+func (a *rNetlinkAPI) LinkSetUp(link netlink.Link) error           { return nil }
+func (a *rNetlinkAPI) LinkSetDown(link netlink.Link) error         { return nil }
+func (a *rNetlinkAPI) AddrAdd(link netlink.Link, address *netlink.Addr) error {
+	if a.addrExisting {
+		return unix.EEXIST
+	}
+	return nil
+}
+func (a *rNetlinkAPI) AddrDel(link netlink.Link, address *netlink.Addr) error {
+	a.deletedAddresses = append(a.deletedAddresses, address.String())
+	return nil
+}
+func (a *rNetlinkAPI) RouteAdd(route *netlink.Route) error {
+	a.routeAdds++
+	if a.beforeRouteAdd != nil {
+		a.beforeRouteAdd(a.routeAdds)
+	}
+	if a.addRouteErrAt != 0 && a.routeAdds == a.addRouteErrAt {
+		return unix.EBUSY
+	}
+	if a.addRouteErr != nil {
+		return a.addRouteErr
+	}
+	// Linux IPv4 EXCL rejects an existing prefix/TOS/priority alias before
+	// comparing its gateway. This fixture must not make gateway changes pass
+	// by unconditionally appending the requested route.
+	if slices.ContainsFunc(a.routes, func(existing netlink.Route) bool {
+		x, y := observedOwnedRoute(existing), observedOwnedRoute(*route)
+		return x.Family == y.Family && x.Table == y.Table && x.Tos == y.Tos && x.Priority == y.Priority && reflect.DeepEqual(x.Dst, y.Dst)
+	}) {
+		return unix.EEXIST
+	}
+	a.routes = append(a.routes, cloneRoute(*route))
+	return nil
+}
+func (a *rNetlinkAPI) RouteDel(route *netlink.Route) error {
+	a.routeDels++
+	if a.routeDelErrAt == a.routeDels {
+		return unix.ETIMEDOUT
+	}
+	a.deletedRoutes = append(a.deletedRoutes, cloneRoute(*route))
+	a.routes = slices.DeleteFunc(a.routes, func(current netlink.Route) bool {
+		return reflect.DeepEqual(observedOwnedRoute(current), observedOwnedRoute(*route))
+	})
+	return nil
+}
+func (a *rNetlinkAPI) RouteListFiltered(family int, filter *netlink.Route, mask uint64) ([]netlink.Route, error) {
+	result := slices.DeleteFunc(slices.Clone(a.routes), func(route netlink.Route) bool { return route.Table != filter.Table })
+	if a.defaultDumpNil {
+		for index := range result {
+			if dst := result[index].Dst; dst != nil {
+				if ones, _ := dst.Mask.Size(); ones == 0 {
+					result[index].Dst = nil
+				}
+			}
+		}
+	}
+	return result, nil
+}
+func (a *rNetlinkAPI) RuleAdd(rule *netlink.Rule) error {
+	a.ruleAdds++
+	if a.addRuleErrAt != 0 && a.ruleAdds == a.addRuleErrAt {
+		return unix.EBUSY
+	}
+	a.rules = append(a.rules, *cloneRule(rule))
+	return nil
+}
+func (a *rNetlinkAPI) RuleDel(rule *netlink.Rule) error {
+	a.deletedRules = append(a.deletedRules, *cloneRule(rule))
+	a.rules = slices.DeleteFunc(a.rules, func(current netlink.Rule) bool { return reflect.DeepEqual(current, *rule) })
+	return nil
+}
+func (a *rNetlinkAPI) RuleList(family int) ([]netlink.Rule, error) { return slices.Clone(a.rules), nil }
+
+func rNativeOptions(name string, table, priority int) Options {
+	return Options{Name: name, MTU: 1500, AutoRoute: true, DNSMode: DNSModeDisabled, IPRoute2TableIndex: table, IPRoute2RuleIndex: priority,
+		Inet4Address: []netip.Prefix{netip.MustParsePrefix("172.30.0.1/30")}, Inet4RouteAddress: []netip.Prefix{netip.MustParsePrefix("10.0.0.0/8")}}
+}
+
+func rNativeDependencies(t *testing.T, api *rNetlinkAPI, directory, name string) nativeTunDependencies {
+	t.Helper()
+	currentName := name
+	return nativeTunDependencies{
+		claimDirectory: directory,
+		withClaimAllocator: func(directory string, block func(*redirectClaimAllocator) error) error {
+			return rWithClaimAllocator(t, directory, block)
+		},
+		openHandle: func(*networkNamespaceLease) (routeNetlink, error) { return api, nil },
+		openTun: func(name string, _, multiQueue, exclusive bool) (int, bool, error) {
+			api.opened++
+			api.newExclusive = append(api.newExclusive, exclusive)
+			currentName = name
+			if api.links[name] == nil {
+				api.links[name] = &netlink.Tuntap{LinkAttrs: netlink.LinkAttrs{Index: 10 + len(api.links), Name: name, MTU: 1400}}
+			}
+			file, err := os.CreateTemp(t.TempDir(), "owned-queue")
+			if err != nil {
+				return -1, false, err
+			}
+			fd, err := unix.FcntlInt(file.Fd(), unix.F_DUPFD_CLOEXEC, 0)
+			_ = file.Close()
+			api.queueFDs = append(api.queueFDs, fd)
+			return fd, multiQueue, err
+		},
+		identityOfFD: func(int) (nativeTunFDIdentity, error) {
+			return nativeTunFDIdentity{currentName, unix.IFF_TUN | unix.IFF_NO_PI}, nil
+		},
+		configureOffload:  func(*NativeTun) error { return nil },
+		configureRPFilter: func(*NativeTun) error { return nil },
+	}
+}
+
+func rNewNative(t *testing.T, options Options, api *rNetlinkAPI, directory string) *NativeTun {
+	t.Helper()
+	device, err := newOwnedNativeTun(options, rNativeDependencies(t, api, directory, options.Name))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return device.(*NativeTun)
+}
+
+func TestRNativeTunNeverStartedCloseAndConflictingNewPreserveA(t *testing.T) {
+	api, directory := newRNetlinkAPI(), rClaimDirectory(t)
+	a := rNewNative(t, rNativeOptions("tun-a", 1001, 9000), api, directory)
+	if err := a.Start(); err != nil {
+		t.Fatal(err)
+	}
+	beforeRules, beforeRoutes := slices.Clone(api.rules), slices.Clone(api.routes)
+	_, err := newOwnedNativeTun(rNativeOptions("tun-b", 1002, 9000), rNativeDependencies(t, api, directory, "tun-b"))
+	if err == nil || api.opened != 1 {
+		t.Fatal("same-priority B was not rejected before TUN acquisition", err, api.opened)
+	}
+	if !reflect.DeepEqual(beforeRules, api.rules) || !reflect.DeepEqual(beforeRoutes, api.routes) || len(api.deletedRules) != 0 {
+		t.Fatal("rejected B touched A")
+	}
+	// A different nonconflicting New succeeds, but no Start/PostStart occurred.
+	b := rNewNative(t, rNativeOptions("tun-c", 1003, 10000), api, directory)
+	if err := b.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if len(api.deletedRules) != 0 || !reflect.DeepEqual(beforeRules, api.rules) || !reflect.DeepEqual(beforeRoutes, api.routes) {
+		t.Fatal("never-started B swept A's rules/routes")
+	}
+	if err := a.Close(); err != nil {
+		t.Fatal(err)
+	}
+	for _, rule := range api.deletedRules {
+		if rule.Table < 0 && rule.Type == 0 {
+			t.Fatal("priority-only deletion", rule)
+		}
+	}
+}
