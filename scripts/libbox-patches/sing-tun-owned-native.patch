+
+func TestRNativeT0Construction(t *testing.T) { rNativeRunGroup(t) }
+func TestRNativeT4Selectors(t *testing.T)    { rNativeRunGroup(t) }
+func TestRNativeT4Borrowed(t *testing.T)     { rNativeRunGroup(t) }
+func TestRNativeT4Update(t *testing.T)       { rNativeRunGroup(t) }
+func TestRNativeT5OrdinaryTun(t *testing.T)  { rNativeRunGroup(t) }
+
+func rNativeRunGroup(t *testing.T) {
+	p, err := rNativeDecodeProfile(rNativeProfileBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range p.Cases {
+		if c.Top != t.Name() {
+			continue
+		}
+		t.Run(c.Sub, func(t *testing.T) {
+			// This check precedes even launcher FD consumption and native reads.
+			if err := rNativeAdmission(os.Getenv("POLARIS_NO_KERNEL_RUN"), os.Getenv("POLARIS_R_NATIVE_RUN"), nil); err != nil {
+				t.Fatal(err)
+			}
+			if err := rNativeValidateSelector(flag.Lookup("test.run").Value.String(), c); err != nil {
+				t.Fatal(err)
+			}
+			inputs, bindErr := rNativeLauncherBinding(c)
+			if bindErr != nil {
+				t.Fatal(bindErr)
+			} // NotReady is not skip/function PASS.
+			deadline := time.Now().Add(time.Duration(c.DeadlineMillis) * time.Millisecond)
+			if err := rNativeCaseInputs(inputs, c); err != nil {
+				t.Fatal(err)
+			}
+			if err := rNativeVerifyEnvironment(inputs, c); err != nil {
+				t.Fatal(errors.Join(err, rNativeEmitTerminal(c, inputs, err)))
+			}
+			if inputs.RPFilter != nil {
+				defer inputs.RPFilter.Close()
+			}
+			err := rNativeRunCase(t, c, inputs, deadline)
+			terminalErr := rNativeEmitTerminal(c, inputs, err)
+			if err != nil || terminalErr != nil {
+				t.Fatal(errors.Join(err, terminalErr))
+			}
+		})
+	}
+}
+
+func rNativeCaseInputs(in *rNativeLauncherInputs, c rNativeCase) error {
+	if in == nil {
+		return errRNativeGSeamPending
+	}
+	if c.Sub == "same_ns_running_a_failed_b_old_callback" && (in.Actor != "a" && in.Actor != "b" || in.Actor == "a" && in.ActorControl == nil) {
+		return errors.New("G_SEAM_PENDING: independent A/B role/control codec absent")
+	}
+	if slices.Contains(c.Requirements, "g_actual_persistent_tun") && (in.PersistentLink == nil || in.PersistentLink.Attrs().Name != c.Options.Name) {
+		return errors.New("G_SEAM_PENDING: actual private persistent TUN source absent")
+	}
+	if c.Sub == "provided_fd_duplicate_only_close" && in.ProvidedTun == nil {
+		return errors.New("G_SEAM_PENDING: actual FD9 source absent")
+	}
+	if c.Sub == "include_exclude_gateway_success" && in.Gateway != netip.MustParseAddr("198.18.0.2") {
+		return errors.New("G_SEAM_PENDING: actual private gateway topology absent")
+	}
+	if c.Sub == "wrong_link_preserved" && in.ForeignLink == nil {
+		return errors.New("G_SEAM_PENDING: actual foreign private link topology absent")
+	}
+	return nil
+}
+
+func rNativeFixtureOptions(c rNativeCase, namespacePath string) Options {
+	o := Options{Name: c.Options.Name, NetNs: namespacePath, MTU: c.Options.MTU, DNSMode: DNSModeDisabled, GSO: false, MultiQueue: c.Options.MultiQueue, AutoRoute: c.Options.AutoRoute, StrictRoute: c.Options.Strict, AutoRedirectMarkMode: c.Options.Marked, IPRoute2TableIndex: c.Options.Table, IPRoute2RuleIndex: c.Options.RulePriority, IPRoute2AutoRedirectFallbackRuleIndex: c.Options.FallbackPriority, AutoRedirectInputMark: 0x210001, AutoRedirectOutputMark: 0x210002}
+	if c.Options.Family == 6 {
+		o.Inet6Address = []netip.Prefix{netip.MustParsePrefix("fd00:727::1/64")}
+	} else {
+		o.Inet4Address = []netip.Prefix{netip.MustParsePrefix("198.18.0.1/24")}
+	}
+	return freezeRedirectOptions(o)
+}
+
+func rNativeNew(o Options, in *rNativeLauncherInputs, facts *[]rNativeAPIFact, beforeAdd func() error) (*NativeTun, error) {
+	var actual Tun
+	var err error
+	if facts == nil && beforeAdd == nil {
+		actual, err = New(o) // required unchanged public production-entry positive
+	} else {
+		actual, err = newOwnedNativeTun(o, nativeTunDependencies{claimDirectory: redirectClaimDirectory, openTun: openOwnedTun, openHandle: func(lease *networkNamespaceLease) (routeNetlink, error) {
+			api, err := openRouteNetlink(lease)
+			if api == nil {
+				return nil, err
+			}
+			return &rNativeRecordedAPI{routeNetlink: api, facts: facts, beforeAdd: beforeAdd}, err
+		}})
+	}
+	if err != nil {
+		if actual != nil {
+			return nil, errors.New("failed New unexpectedly returned a component")
+		}
+		return nil, err
+	}
+	device, ok := actual.(*NativeTun)
+	if !ok || device.nativeOwnership == nil {
+		return nil, errors.New("production New did not produce tracked NativeTun")
+	}
+	if o.FileDescriptor == 0 {
+		if err := rNativeAssertBirthScope(device, in); err != nil {
+			return device, err
+		}
+	}
+	return device, nil
+}
+
+type rNativeObservation struct {
+	Routes             []netlink.Route
+	Rules              []netlink.Rule
+	AcquiredRouteSpecs []netlink.Route
+	AcquiredRuleSpecs  []*netlink.Rule
+	Link               *netlink.LinkAttrs
+	Addresses          []netlink.Addr
+	Raw                []rNativeRawDump
+}
+
+func rNativeObserve(api routeNetlink, device *NativeTun, deadline time.Time) (rNativeObservation, error) {
+	var result rNativeObservation
+	routes, err := api.RouteListFiltered(netlink.FAMILY_ALL, &netlink.Route{Table: device.options.IPRoute2TableIndex}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		return result, err
+	}
+	result.Routes = routes
+	rules, err := api.RuleList(netlink.FAMILY_ALL)
+	if err != nil {
+		return result, err
+	}
+	result.Rules = slices.DeleteFunc(rules, func(r netlink.Rule) bool {
+		return r.Priority < device.options.IPRoute2RuleIndex || r.Priority > device.options.IPRoute2RuleIndex+10 && r.Priority != device.options.IPRoute2AutoRedirectFallbackRuleIndex && r.Priority != device.nativeOwnership.priority6
+	})
+	link, err := api.LinkByIndex(device.nativeOwnership.link.Attrs().Index)
+	if err != nil {
+		return result, err
+	}
+	attrs := *link.Attrs()
+	result.Link = &attrs
+	actual, ok := api.(*realRouteNetlink)
+	if !ok {
+		return result, errors.New("observer is not independent real handle")
+	}
+	result.Addresses, err = actual.Handle.AddrList(link, netlink.FAMILY_ALL)
+	if err != nil {
+		return result, err
+	}
+	for _, request := range []uint16{unix.RTM_GETROUTE, unix.RTM_GETRULE, unix.RTM_GETADDR, unix.RTM_GETLINK} {
+		dump, err := rNativeObserveDump(request, unix.AF_UNSPEC, minTime(deadline, time.Now().Add(time.Second)))
+		if err != nil {
+			return result, err
+		}
+		result.Raw = append(result.Raw, dump)
+	}
+	for _, entry := range device.nativeOwnership.routes.entries {
+		if err := validateOwnedRouteForDelete(api, entry.spec); err != nil {
+			return result, err
+		}
+		result.AcquiredRouteSpecs = append(result.AcquiredRouteSpecs, cloneRoute(entry.spec))
+	}
+	for _, entry := range device.nativeOwnership.rules.entries {
+		if err := validateOwnedRuleForDelete(api, entry.spec, func(rule *netlink.Rule) bool { return reflect.DeepEqual(rule, entry.spec) }); err != nil {
+			return result, err
+		}
+		result.AcquiredRuleSpecs = append(result.AcquiredRuleSpecs, cloneRule(entry.spec))
+	}
+	return result, nil
+}
+
+func minTime(a, b time.Time) time.Time {
+	if a.Before(b) {
+		return a
+	}
+	return b
+}
+
+type rNativeEvidence struct {
+	Schema             string            `json:"schema"`
+	Version            int               `json:"version"`
+	Kind               string            `json:"kind"`
+	Phase              string            `json:"phase"`
+	CaseID             int               `json:"caseID"`
+	CaseName           string            `json:"caseName"`
+	Actor              string            `json:"actor"`
+	BatchNonce         string            `json:"batchNonce"`
+	CaseNonce          string            `json:"caseNonce"`
+	Candidate          map[string]string `json:"candidate"`
+	Sequence           int               `json:"sequence"`
+	EncodedBytes       int               `json:"encodedBytes"`
+	PacketCount        int               `json:"packetCount"`
+	SubjectCleanup     string            `json:"subjectCleanup"`
+	TestAssertions     string            `json:"testAssertions"`
+	RCalleeCoverage    string            `json:"rCalleeCoverage"`
+	ConsumerCoverage   string            `json:"consumerCoverage"`
+	FixtureDisposal    string            `json:"fixtureDisposal"`
+	GuardianSettlement string            `json:"guardianSettlement"`
+	HostUnchanged      string            `json:"hostUnchanged"`
+	AggregateResult    string            `json:"aggregateResult"`
+	Value              any               `json:"value"`
+}
+
+var rNativeEvidencePhases = []string{"pending", "actual_case_return", "failed_case_return", "actual_packet", "actual_new_without_start_close", "actual_start", "actual_dispose_and_double_close", "actual_gateway_connected_route", "explicit_seam_partial_seal", "actual_close_and_owned_postcheck", "allocator_preflight_eexist_before_tun", "expected_unknown_retained_no_retry", "foreign_full_spec_preserved_after_close", "actual_persistent_before", "actual_rp_filter_start", "actual_rp_filter_close", "actual_borrowed_snapshot_preserved", "actual_foreign_before", "actual_ipv6_priority_before", "receiver_actual_close_and_join", "actual_update_return_then_close_join", "independent_b_allocator_priority_refusal", "independent_a_running_before_b", "independent_a_preserved_after_b_no_b_callback"}
+
+func rNativeEmit(c rNativeCase, in *rNativeLauncherInputs, phase string, value any) error {
+	if in == nil || in.TerminalEmitted || (in.EvidenceSequence == 0) != (phase == "pending") {
+		return errors.New("pending/phase/terminal order invalid")
+	}
+	if !slices.Contains(rNativeEvidencePhases, phase) {
+		return errors.New("evidence phase outside frozen source closure")
+	}
+	if in.Association == nil {
+		return errors.New("actual metadata capture missing for evidence")
+	}
+	a := in.Association
+	kind := "phase"
+	assertions := "Pending"
+	cleanup := "NotObserved"
+	if phase == "pending" {
+		kind = "pending"
+	}
+	if phase == "actual_case_return" {
+		kind = "terminal"
+		assertions = "PASS"
+		cleanup = "ReleasedOwnLedger"
+		if rNativeCaseIndex(c) == 14 {
+			cleanup = "UnknownOriginalCustody"
+		}
+		if in.Actor == "b" {
+			cleanup = "ConstructorClosedBeforeTUN"
+		}
+	}
+	if phase == "failed_case_return" {
+		kind = "terminal"
+		assertions = "FAIL"
+		cleanup = "UnknownOriginalCustody"
+	}
+	consumer := "NotInScope"
+	if rNativeCaseIndex(c) == 0 {
+		consumer = "NotReady"
+	}
+	record := rNativeEvidence{Schema: "polaris-r-native-case-evidence", Version: 1, Kind: kind, Phase: phase, CaseID: a.CaseID, CaseName: c.Top + "/" + c.Sub, Actor: a.Actor, BatchNonce: a.BatchNonce, CaseNonce: a.CaseNonce, Candidate: map[string]string{"profileSha256": a.ProfileSHA256, "sourceCommit": a.SourceCommit, "sourceTree": a.SourceTree, "sourceFilesSha256": a.SourceFilesSHA256, "moduleGraphSha256": a.ModuleGraphSHA256, "elfSha256": a.ELFSHA256, "configSha256": a.ConfigSHA256, "planSha256": a.PlanSHA256}, Sequence: in.EvidenceSequence + 1, PacketCount: in.PacketCount, SubjectCleanup: cleanup, TestAssertions: assertions, RCalleeCoverage: "actual_R_API_only", ConsumerCoverage: consumer, FixtureDisposal: "GuardianPending", GuardianSettlement: "GuardianPending", HostUnchanged: "GuardianPending", AggregateResult: "NotReady", Value: value}
+	data, total, err := rNativeEncodeEvidence(record, in.EvidenceBytes, c.MaxEvidenceBytes)
+	if err != nil {
+		return err
+	}
+	n, err := fmt.Fprintln(os.Stdout, "R_NATIVE_EVIDENCE "+string(data))
+	if err != nil || n != len(data)+len("R_NATIVE_EVIDENCE ")+1 {
+		return errors.Join(errors.New("evidence write incomplete"), err)
+	}
+	in.EvidenceBytes = total
+	in.EvidenceSequence++
+	in.TerminalEmitted = kind == "terminal"
+	return nil
+}
+
+// encodedBytes includes every complete framed newline, including previous
+// records, raw dump bytes and raw packets. This pure codec does no I/O.
+func rNativeEncodeEvidence(record rNativeEvidence, previous, maximum int) ([]byte, int, error) {
+	if previous < 0 || maximum <= 0 || previous > maximum {
+		return nil, 0, errors.New("invalid cumulative evidence budget")
+	}
+	for attempt := 0; attempt < 6; attempt++ {
+		data, err := json.Marshal(record)
+		if err != nil {
+			return nil, 0, err
+		}
+		total := previous + len(data) + len("R_NATIVE_EVIDENCE ") + 1
+		if record.EncodedBytes == total {
+			if total > maximum {
+				return nil, 0, errors.New("total encoded case evidence bound exceeded")
+			}
+			return data, total, nil
+		}
+		record.EncodedBytes = total
+	}
+	return nil, 0, errors.New("evidence encoded count did not settle")
+}
+
+func rNativeEmitTerminal(c rNativeCase, in *rNativeLauncherInputs, err error) error {
+	if err != nil {
+		return rNativeEmit(c, in, "failed_case_return", err.Error())
+	}
+	return rNativeEmit(c, in, "actual_case_return", nil)
+}
+func rNativePacket(c rNativeCase, in *rNativeLauncherInputs, direction string, packet []byte) error {
+	if len(packet) == 0 || len(packet) > 2048 {
+		return errors.New("packet length outside closed budget")
+	}
+	in.PacketCount++
+	if in.PacketCount > c.MaxPackets {
+		return errors.New("total actual packet budget exceeded")
+	}
+	return rNativeEmit(c, in, "actual_packet", struct {
+		Direction string `json:"direction"`
+		Length    int    `json:"length"`
+		Raw       []byte `json:"raw"`
+	}{direction, len(packet), slices.Clone(packet)})
+}
