+func TestRedirectOwnershipNFTUnconfirmedPlanBlocksSetWriter(t *testing.T) {
+	for _, mode := range []string{"pending-rule", "ambiguous-rule", "ambiguous-element"} {
+		t.Run(mode, func(t *testing.T) {
+			scope := redirectNFTScope{redirectNamespaceIdentity{3, 916}, redirectNFTINet}
+			r := newOwnershipTestRedirect(t)
+			ops := newOwnershipNFTContentOps(r.ownership, scope)
+			entered, resume := make(chan struct{}), make(chan struct{})
+			adapter := ownershipNFTBatchFunctions{release: ops.ReleaseExact, submit: func(batch redirectNFTBatch) redirectNFTBatchResult {
+				if mode == "pending-rule" && batch.transaction.sequence == 2 {
+					close(entered)
+					<-resume
+				}
+				return ops.SubmitCreateBatch(batch)
+			}}
+			if mode != "pending-rule" {
+				ops.failBatch, ops.mode = 2, "lost-ack"
+			}
+			var writer *redirectOperation
+			var set redirectNFTIntent
+			r.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+				members, err := ownershipNFTContentPlan(op, scope, []netip.Addr{netip.MustParseAddr("2001:db8::1")})
+				if err != nil {
+					return err
+				}
+				writer, set = op, members[2]
+				if _, err := op.acquireNFTBatch(members[1:], adapter); err != nil {
+					return err
+				}
+				unconfirmed := members[:1]
+				if mode == "ambiguous-element" {
+					unconfirmed, err = op.nftElementIntents(set, []netip.Addr{netip.MustParseAddr("2001:db8::2")})
+					if err != nil {
+						return err
+					}
+				}
+				_, original := op.acquireNFTBatch(unconfirmed, adapter)
+				if mode != "pending-rule" {
+					later, err := op.nftElementIntents(set, []netip.Addr{netip.MustParseAddr("2001:db8::3")})
+					if err != nil {
+						return err
+					}
+					if _, err = op.acquireNFTBatch(later, adapter); !errors.Is(err, ErrAutoRedirectOwnershipUnsupported) {
+						t.Fatalf("writer bypassed unconfirmed plan: %v", err)
+					}
+				}
+				return original
+			}}
+			if mode == "pending-rule" {
+				started := make(chan error, 1)
+				go func() { started <- r.Start() }()
+				ownershipAwait(t, entered)
+				later, err := writer.nftElementIntents(set, []netip.Addr{netip.MustParseAddr("2001:db8::3")})
+				if err != nil {
+					t.Fatal(err)
+				}
+				_, blocked := writer.acquireNFTBatch(later, adapter)
+				close(resume)
+				if !errors.Is(blocked, ErrAutoRedirectOwnershipUnsupported) {
+					t.Fatalf("writer bypassed Pending rule: %v", blocked)
+				}
+				if err := ownershipAwait(t, started); err != nil {
+					t.Fatal(err)
+				}
+				if err := r.Close(); err != nil {
+					t.Fatal(err)
+				}
+			} else if err := r.Start(); !errors.Is(err, errRedirectAmbiguous) {
+				t.Fatal(err)
+			}
+			if len(ops.batches) != 2 {
+				t.Fatal("unconfirmed content accepted another batch")
+			}
+		})
+	}
