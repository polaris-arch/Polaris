+type cNativeActorSelection struct {
+	Case, Role, FlowConfigSHA      string
+	Flows                          []cNativeAllowedFlow
+	HandlerDeadline                time.Duration
+	PacketBudget, ConnectionBudget int
+}
+
+func cNativeAssembleActor(a cNativeAdmission, c cNativeCase, s cNativeActorSelection) (*cNativePublicActor, error) {
+	if err := cNativeValidateAdmission(a, c); err != nil {
+		return nil, err
+	}
+	identity, ok := a.Actors[s.Role]
+	if !ok || s.Case != c.path() || len(s.Flows) == 0 || len(s.Flows) > 8 || s.HandlerDeadline <= 0 || s.HandlerDeadline > 5*time.Second || s.PacketBudget <= 0 || s.PacketBudget > 64 || s.ConnectionBudget <= 0 || s.ConnectionBudget > 8 {
+		return nil, errCNativeUnfrozen
+	}
+	flowSHA, err := cNativeHash(s.Flows)
+	if err != nil || flowSHA != s.FlowConfigSHA {
+		return nil, errCNativeUnfrozen
+	}
+	flows := slices.Clone(s.Flows)
+	for i, f := range flows {
+		if !f.Source.IsValid() || !f.Destination.IsValid() || len(f.Nonce) < 32 || len(f.Nonce) > 256 || !bytes.Equal(f.Nonce, []byte(a.Nonce)) {
+			return nil, errCNativeUnfrozen
+		}
+		flows[i].Nonce = slices.Clone(f.Nonce)
+	}
+	options, err := cNativeOptions(s.Role, s.Role == "B" && c.Scenario == "claim", &cNativeHandler{flows: flows, deadline: s.HandlerDeadline, packetsRemaining: s.PacketBudget, connectionsRemaining: s.ConnectionBudget})
+	if err != nil {
+		return nil, err
+	}
+	return &cNativePublicActor{admission: a, identity: identity, options: options}, nil
+}
