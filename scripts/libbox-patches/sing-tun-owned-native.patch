+				nativeTunCustody.Range(func(_, value any) bool {
+					native := value.(*NativeTun)
+					if native.options.Name == name {
+						owner, claims = native.nativeOwnership.owner, native.nativeOwnership.claims
+						return false
+					}
+					return true
+				})
+			} else {
+				owner, _ = newRedirectOwnership()
+				lease, err := newNetworkNamespaceLease("")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer lease.Close()
+				r := &autoRedirect{ownership: owner, namespaceLease: lease, tunOptions: &Options{Name: "claim-publication-redirect", IPRoute2TableIndex: 2022}, useNFTables: true}
+				b := &realRedirectRoutes{claimDirectory: directory, withClaimAllocator: brokenAllocator, openHandle: func(*networkNamespaceLease) (routeNetlink, error) { return api, nil }}
+				op, err := owner.beginStart()
+				if err != nil {
+					t.Fatal(err)
+				}
+				err = b.Prepare(r)
+				if !errors.Is(err, errRedirectAmbiguous) || b.prepared || r.redirectRouteTableIndex != 0 {
+					t.Fatal("failed claim publication advanced redirect admission", err, b.prepared, r.redirectRouteTableIndex)
+				}
+				_ = owner.finishStart(err)
+				op.finish()
+				claims = b.claims
+			}
+			if owner == nil || claims == nil || len(claims.files) == 0 || claims.released {
+				t.Fatal("lost the original EXCL claim custody", owner, claims)
+			}
+			defer closeTestRedirectClaims(t, claims) // private fixture FD disposal only
+			owner.access.Lock()
+			ambiguous := slices.ContainsFunc(owner.resources, func(entry *redirectResource) bool {
+				return entry.id.domain == redirectClaim && entry.state == redirectAmbiguous
+			})
+			owner.access.Unlock()
+			if !ambiguous || api.opened != 0 || len(api.routes) != 0 || len(api.rules) != 0 || len(api.deletedRoutes) != 0 || len(api.deletedRules) != 0 {
+				t.Fatal("unknown claims authorized network acquisition or cleanup", ambiguous)
+			}
+			for _, entry := range claims.files {
+				var stat unix.Stat_t
+				if err := unix.Fstat(int(entry.file.Fd()), &stat); err != nil || stat.Ino != entry.inode {
+					t.Fatal("original claim FD was abandoned", err)
+				}
+			}
+			if err := owner.close(); !errors.Is(err, errRedirectAmbiguous) || claims.released {
+				t.Fatal("Close released uncertain construction claims", err)
+			}
+			if err := owner.close(); !errors.Is(err, errRedirectAmbiguous) || claims.released {
+				t.Fatal("repeat Close retried uncertain claim retirement", err)
+			}
+		})
+	}
+}
