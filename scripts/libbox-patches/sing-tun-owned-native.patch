+func (b *redirectNFTRuntime) Prepare(r *autoRedirect) error {
+	if r.tableName == "" || len(r.tableName) > 180 {
+		return errors.New("invalid private nft table name")
+	}
+	if strings.ContainsRune(r.tableName, 0) {
+		return errors.New("private nft table name contains NUL")
+	}
+	return nil
+}
+
+// The journal is called by the actual fork after serialization and sequence
+// assignment, but before the single send. It cannot rewrite the frozen queue.
+// nftJournal avoids overloading the backend's pure Prepare configuration method.
+type nftJournal struct{ runtime *redirectNFTRuntime }
+
+func (j nftJournal) Prepare(intent nftables.TransactionIntent) error {
+	b := j.runtime
+	b.access.Lock()
+	defer b.access.Unlock()
+	if b.sealed || b.unknown {
+		return errors.Join(errRedirectClosing, nftables.ErrUncertain)
+	}
+	if intent.Birth != b.birth || intent.PortID == 0 || len(intent.Messages) < 3 {
+		return errRedirectInvalidACK
+	}
+	for i, m := range intent.Messages {
+		if i == 0 || i == len(intent.Messages)-1 {
+			continue
+		}
+		if b.table != nil && m.Table == b.table.Name && m.Family == b.table.Family {
+			continue
+		}
+		// Shared transactions are a temporary exact parent capability. They never
+		// acquire or delete a parent, set or foreign permission domain.
+		if b.sharedParent == nil || m.Table != b.sharedParent.Name || m.Family != b.sharedParent.Family {
+			return errors.New("nft transaction is outside its frozen permission domain")
+		}
+		if intent.Generation == 0 || intent.Generation != b.sharedGeneration {
+			return errors.New("shared nft mutation requires its complete observed GENID")
+		}
+		op := uint16(m.Header.Type) & 0xff
+		if op != 6 && op != 8 {
+			return errors.New("shared nft transaction may only add/replace or delete individual rules")
+		}
+		if op == 8 && m.Handle == 0 {
+			return errors.New("shared nft rule delete requires a receipted handle")
+		}
+	}
+	b.pending = append(b.pending, intent)
+	return nil
+}
+func (j nftJournal) Complete(receipt nftables.TransactionReceipt) {
+	b := j.runtime
+	b.access.Lock()
+	defer b.access.Unlock()
+	b.receipts = append(b.receipts, receipt)
+	if receipt.State == nftables.TransactionUnknown {
+		b.unknown = true
+	}
+}
+
+func (b *redirectNFTRuntime) Start(r *autoRedirect, op *redirectOperation, requires []redirectResourceID) error {
+	socketID, err := op.acquire(redirectNFTables, "lasting-owner-socket", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			err := r.namespaceLease.WithFD(func(fd int) error {
+				var e error
+				b.conn, e = nftables.New(nftables.WithNetNSFd(fd), nftables.AsOwnedTransactions(b.birth, nftJournal{b}))
+				return e
+			})
+			if err != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { return b.retireSocket() },
+	})
+	if err != nil {
+		return err
+	}
+	b.table = &nftables.Table{Name: r.tableName + "_" + b.birth, Family: nftables.TableFamilyINet, Flags: nftables.TableFlagOwner, UserData: []byte(b.birth)}
+	b.domainID, err = op.acquire(redirectNFTables, "owned-nft-permission-domain", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			b.conn.CreateTable(b.table)
+			if err := b.conn.Flush(); err != nil {
+				return nftAcquireResult(b.conn.LastTransaction(), err)
+			}
+			receipt := b.conn.LastTransaction()
+			objects, e := receipt.ConfirmedObjects()
+			if e != nil || len(objects.Tables) != 1 {
+				return redirectAcquireResult{err: errors.Join(errRedirectInvalidACK, e)}
+			}
+			t := objects.Tables[0]
+			if t.Name != b.table.Name || t.Family != b.table.Family || t.Handle == 0 || t.Flags != nftables.TableFlagOwner || t.Owner != receipt.Intent.PortID || !bytes.Equal(t.UserData, []byte(b.birth)) {
+				return redirectAcquireResult{err: errRedirectInvalidACK}
+			}
+			b.table = t
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		// The common gate seals/drains every member writer and releases all shared
+		// dependents before this permission domain. Closing this exact OWNER socket
+		// synchronously retires its non-PERSIST tables; no foreign parent is named.
+		release: func(redirectResourceID) error { return b.retireSocket() },
+	}, append(slices.Clone(requires), socketID)...)
+	if err != nil {
+		return err
+	}
+	local, err := r.collectNFTLocalAddresses()
+	if err != nil {
+		return err
+	}
+	include, exclude, err := b.routePrefixes(r)
+	if err != nil {
+		return err
+	}
+	b.generation++
+	planned, err := b.fillAddressSets(r, local, include, exclude)
+	if err != nil {
+		return err
+	}
+	b.plannedSets = planned
+	defer func() { b.plannedSets = nil }()
+	if err = r.buildNFTables(b.conn, b.table); err != nil {
+		return err
+	}
+	b.sets = planned
+	b.bindingsConfirmed = true
+	b.localAddresses = slices.Clone(local)
+	b.includeAddresses = slices.Clone(include)
+	b.excludeAddresses = slices.Clone(exclude)
+	r.localAddresses = slices.Clone(local)
+	return nil
+}
+
+func nftAcquireResult(receipt nftables.TransactionReceipt, err error) redirectAcquireResult {
+	if receipt.State == nftables.TransactionNotSent || receipt.State == nftables.TransactionAborted {
+		return redirectAcquireResult{redirectAcquireNotCommitted, err}
+	}
+	return redirectAcquireResult{err: err}
+}
+func (b *redirectNFTRuntime) retireSocket() error {
+	b.access.Lock()
+	if b.retired {
+		b.access.Unlock()
+		return nil
+	}
+	b.sealed = true
+	b.access.Unlock()
+	if b.conn == nil {
+		return nil
+	}
+	err := b.conn.CloseLasting()
+	if err == nil {
+		b.access.Lock()
+		b.retired = true
+		b.access.Unlock()
+	}
+	return err
+}
+
+func (r *autoRedirect) nftRuntime() (*redirectNFTRuntime, error) {
+	coordinator, ok := r.ownershipBackend.(*redirectProductionCoordinator)
+	if !ok {
+		return nil, ErrAutoRedirectOwnershipUnsupported
+	}
+	runtime, ok := coordinator.firewall.(*redirectNFTRuntime)
+	if !ok || runtime.conn == nil {
+		return nil, ErrAutoRedirectOwnershipUnsupported
+	}
+	return runtime, nil
+}
+func (r *autoRedirect) nftAddressSet(key string) (*nftables.Set, error) {
+	b, err := r.nftRuntime()
+	if err != nil {
+		return nil, err
+	}
+	sets := b.sets
+	if b.plannedSets != nil {
+		sets = b.plannedSets
+	}
+	set := sets[key]
+	if set == nil {
+		return nil, fmt.Errorf("missing frozen nft address set %s", key)
+	}
+	return set, nil
+}
+func (r *autoRedirect) collectNFTLocalAddresses() ([]netip.Prefix, error) {
+	if err := r.interfaceFinder.Update(); err != nil {
+		return nil, err
+	}
+	return common.FlatMap(r.interfaceFinder.Interfaces(), func(it control.Interface) []netip.Prefix {
+		return common.Filter(it.Addresses, func(p netip.Prefix) bool { return it.Name == "lo" || p.Addr().IsGlobalUnicast() })
+	}), nil
+}
+func (b *redirectNFTRuntime) routePrefixes(r *autoRedirect) ([]netip.Prefix, []netip.Prefix, error) {
+	include := append(slices.Clone(r.tunOptions.Inet4RouteAddress), r.tunOptions.Inet6RouteAddress...)
+	exclude := append(slices.Clone(r.tunOptions.Inet4RouteExcludeAddress), r.tunOptions.Inet6RouteExcludeAddress...)
+	if r.routeAddressSet != nil {
+		a, z, err := r.routeAddressSet()
+		if err != nil {
+			return nil, nil, err
+		}
+		include = append(include, a...)
+		exclude = append(exclude, z...)
+	}
+	return include, exclude, nil
+}
+
+func (b *redirectNFTRuntime) fillAddressSets(r *autoRedirect, local, include, exclude []netip.Prefix) (map[string]*nftables.Set, error) {
+	planned := make(map[string]*nftables.Set)
+	for _, family := range []nftables.TableFamily{nftables.TableFamilyIPv4, nftables.TableFamilyIPv6} {
+		if family == nftables.TableFamilyIPv4 && !r.enableIPv4 || family == nftables.TableFamilyIPv6 && !r.enableIPv6 {
+			continue
+		}
+		suffix := "4"
+		if family == nftables.TableFamilyIPv6 {
+			suffix = "6"
+		}
+		for _, def := range []struct {
+			kind     string
+			prefixes []netip.Prefix
+			all      bool
+		}{{"local", local, false}, {"include", include, true}, {"exclude", exclude, false}} {
+			key := def.kind + suffix
+			name := fmt.Sprintf("%s_g%d", key, b.generation)
+			prefixes := common.Filter(def.prefixes, func(p netip.Prefix) bool { return p.Addr().Is4() == (family == nftables.TableFamilyIPv4) })
+			// IDs are transaction-local only. Named lookup uses its stable name after
+			// helper Flushes; the durable identity is the kernel handle in receipts.
+			set, err := nftablesCreateIPSet(b.conn, b.table, uint32(100+len(planned)), name, family, nil, prefixes, def.all, false)
+			if err != nil {
+				b.conn.DiscardPending()
+				return nil, err
+			}
+			planned[key] = set
+		}
+	}
+	// Empty sets still need an actual create commit before binding lookups.
+	if err := b.conn.Flush(); err != nil {
+		return nil, err
+	}
+	return planned, nil
+}
+
+func (b *redirectNFTRuntime) UpdateNetwork(r *autoRedirect, op *redirectOperation) error {
+	local, err := r.collectNFTLocalAddresses()
+	if err != nil {
+		return err
+	}
+	return b.updateSets(r, local, b.includeAddresses, b.excludeAddresses)
+}
+func (b *redirectNFTRuntime) UpdateRouteAddressSet(r *autoRedirect, op *redirectOperation) error {
+	_, err := b.UpdateRouteAddressSetSnapshot(r, op)
+	return err
+}
+func (b *redirectNFTRuntime) UpdateRouteAddressSetSnapshot(r *autoRedirect, op *redirectOperation) (RouteAddressSetUpdateState, error) {
+	include, exclude, err := b.routePrefixes(r)
+	if err != nil {
+		return RouteAddressSetUnchanged, err
+	}
+	return b.updateSetsSnapshot(r, b.localAddresses, include, exclude)
+}
+func (b *redirectNFTRuntime) updateSets(r *autoRedirect, local, include, exclude []netip.Prefix) error {
+	_, err := b.updateSetsSnapshot(r, local, include, exclude)
+	return err
+}
+func (b *redirectNFTRuntime) updateSetsSnapshot(r *autoRedirect, local, include, exclude []netip.Prefix) (RouteAddressSetUpdateState, error) {
+	b.access.Lock()
+	blocked := b.sealed || b.unknown
+	b.access.Unlock()
+	if blocked {
+		return RouteAddressSetUnknown, nftables.ErrUncertain
+	}
+	// Equality only confirms a no-op when it matches bindings from a complete
+	// Start/switch receipt and no later uncertain binding has invalidated them.
+	if !b.bindingsConfirmed {
+		return RouteAddressSetUnknown, nftables.ErrUncertain
+	}
+	if slices.Equal(local, b.localAddresses) && slices.Equal(include, b.includeAddresses) && slices.Equal(exclude, b.excludeAddresses) {
+		return RouteAddressSetCommitted, nil
+	}
+	b.generation++
+	next, err := b.fillAddressSets(r, local, include, exclude)
+	if err != nil {
+		return RouteAddressSetUnchanged, b.failUpdate(r, err)
+	}
+	// Observe after all early batches. Each lookup replacement targets the exact
+	// current own-table handle in a consistent observation and conditional batch.
+	observed, err := b.conn.ReadConsistentTable(b.table)
+	if err != nil {
+		return RouteAddressSetUnchanged, b.failUpdate(r, err)
+	}
+	if err = b.checkObservedTable(observed); err != nil {
+		return RouteAddressSetUnchanged, b.failUpdate(r, err)
+	}
+	changed := 0
+	for _, rule := range observed.Rules {
+		if rule.Table == nil || rule.Table.Name != b.table.Name {
+			continue
+		}
+		replaced := false
+		for i, e := range rule.Exprs {
+			lookup, ok := e.(*expr.Lookup)
+			if !ok {
+				continue
+			}
+			for key, old := range b.sets {
+				if lookup.SetName == old.Name {
+					copy := *lookup
+					copy.SetID = 0
+					copy.SetName = next[key].Name
+					rule.Exprs[i] = &copy
+					replaced = true
+					break
+				}
+			}
+		}
+		if replaced {
+			b.conn.ReplaceRule(rule)
+			changed++
+		}
+	}
+	if changed == 0 {
+		b.conn.DiscardPending()
+		return RouteAddressSetUnchanged, errors.New("no confirmed own nft lookups to switch")
+	}
+	if _, err = b.conn.PendingBytes(); err != nil {
+		b.conn.DiscardPending()
+		return RouteAddressSetUnchanged, err
+	}
+	if err = b.conn.UseGeneration(observed.Generation); err != nil {
+		b.conn.DiscardPending()
+		return RouteAddressSetUnchanged, err
+	}
+	old := b.sets
+	before := b.conn.LastTransaction()
+	err = b.conn.Flush()
+	state, err := nftAddressBindingState(before, b.conn.LastTransaction(), observed.Generation, err)
+	return b.finishAddressBinding(r, next, local, include, exclude, state, err, func() error {
+		for _, set := range old {
+			b.conn.DelSet(set)
+		}
+		return b.conn.Flush()
+	})
+}
+
+// Flush's fixed owned implementation records every attempted send. An unchanged
+// receipt on an error is its pre-send rejection path; a stale successful receipt
+// cannot be used to confirm this binding. Never infer rollback from a recv errno.
+func nftAddressBindingState(before, receipt nftables.TransactionReceipt, generation uint32, err error) (RouteAddressSetUpdateState, error) {
+	same := len(before.Intent.Messages) > 0 && len(receipt.Intent.Messages) > 0 && before.Intent.Birth == receipt.Intent.Birth && before.Intent.PortID == receipt.Intent.PortID && before.Intent.Messages[0].Header.Sequence == receipt.Intent.Messages[0].Header.Sequence
+	if same {
+		if err != nil {
+			return RouteAddressSetUnchanged, err
+		}
+		return RouteAddressSetUnknown, errRedirectInvalidACK
+	}
+	if generation == 0 || receipt.Intent.Generation != generation || receipt.Intent.Birth == "" || receipt.Intent.Birth != before.Intent.Birth || receipt.Intent.PortID == 0 || receipt.Intent.PortID != before.Intent.PortID {
+		return RouteAddressSetUnknown, errors.Join(err, errRedirectInvalidACK)
+	}
+	switch receipt.State {
+	case nftables.TransactionNotSent, nftables.TransactionAborted:
+		if err != nil {
+			return RouteAddressSetUnchanged, err
+		}
+	case nftables.TransactionCommitted:
+		if err == nil {
+			return RouteAddressSetCommitted, nil
+		}
+	case nftables.TransactionUnknown:
+		return RouteAddressSetUnknown, errors.Join(err, nftables.ErrUncertain)
+	}
+	return RouteAddressSetUnknown, errors.Join(err, errRedirectInvalidACK)
+}
+
+// This phase boundary is also used by the finite receipt seam. The binding
+// receipt is historical: a later cleanup error must not erase Committed.
+func (b *redirectNFTRuntime) finishAddressBinding(r *autoRedirect, next map[string]*nftables.Set, local, include, exclude []netip.Prefix, state RouteAddressSetUpdateState, err error, retireOld func() error) (RouteAddressSetUpdateState, error) {
+	if state == RouteAddressSetUnknown {
+		err = errors.Join(err, nftables.ErrUncertain)
+	}
+	if state != RouteAddressSetCommitted {
+		return state, b.failUpdate(r, err)
+	}
+	// Publish only the confirmed binding transaction. Early fill success, a
+	// successful member ACK or a generation failure cannot publish this cache.
+	b.sets = next
+	b.bindingsConfirmed = true
+	b.localAddresses = slices.Clone(local)
+	b.includeAddresses = slices.Clone(include)
+	b.excludeAddresses = slices.Clone(exclude)
+	r.localAddresses = slices.Clone(local)
+	if err = retireOld(); err != nil {
+		return RouteAddressSetCommitted, b.failUpdate(r, err)
+	}
+	return RouteAddressSetCommitted, nil
+}
+func (b *redirectNFTRuntime) checkObservedTable(s *nftables.ConsistentSnapshot) error {
+	for _, t := range s.Tables {
+		if t.Name == b.table.Name && t.Family == b.table.Family {
+			if t.Handle == b.table.Handle && t.Owner == b.table.Owner && t.Flags == nftables.TableFlagOwner && bytes.Equal(t.UserData, []byte(b.birth)) {
+				return nil
+			}
+			return errRedirectAmbiguous
+		}
+	}
+	return errRedirectAmbiguous
+}
+func (b *redirectNFTRuntime) failUpdate(r *autoRedirect, err error) error {
+	b.access.Lock()
+	if errors.Is(err, nftables.ErrUncertain) {
+		b.unknown = true
+	}
+	unknown := b.unknown
+	b.access.Unlock()
+	if unknown {
+		r.ownership.requestClose()
+	}
+	return err
+}
+
+// C obtains the actual transaction capability and permission-domain dependency.
+// Its own ledger resource must depend on this ID so that shared references are
+// withdrawn before the owner socket can retire the private permission domain.
+func (r *autoRedirect) nftPermissionDomain() (redirectResourceID, error) {
+	b, e := r.nftRuntime()
+	if e != nil {
+		return redirectResourceID{}, e
+	}
+	return b.domainID, nil
+}
+func (r *autoRedirect) withSharedNFTTransaction(parent *nftables.Table, plan func(*nftables.ConsistentSnapshot, *nftables.Conn) error) (nftables.TransactionReceipt, error) {
+	b, err := r.nftRuntime()
+	if err != nil {
+		return nftables.TransactionReceipt{}, err
+	}
+	if parent == nil || parent.Name == "" || parent.Name == b.table.Name {
+		return nftables.TransactionReceipt{}, errors.New("invalid shared nft parent capability")
+	}
+	observed, err := b.conn.ReadConsistentTable(parent)
+	if err != nil {
+		return nftables.TransactionReceipt{}, err
+	}
+	b.access.Lock()
+	if b.sharedParent != nil || b.sealed || b.unknown {
+		b.access.Unlock()
+		return nftables.TransactionReceipt{}, nftables.ErrUncertain
+	}
+	b.sharedParent = &nftables.Table{Name: parent.Name, Family: parent.Family}
+	b.sharedGeneration = observed.Generation
+	b.access.Unlock()
+	defer func() { b.access.Lock(); b.sharedParent = nil; b.sharedGeneration = 0; b.access.Unlock() }()
+	if err = plan(observed, b.conn); err != nil {
+		b.conn.DiscardPending()
+		return nftables.TransactionReceipt{}, err
+	}
+	if size, e := b.conn.PendingBytes(); e != nil {
+		b.conn.DiscardPending()
+		return nftables.TransactionReceipt{}, e
+	} else if size == 40 {
+		b.conn.DiscardPending()
+		return nftables.TransactionReceipt{State: nftables.TransactionNotSent}, nil
+	}
+	if err = b.conn.UseGeneration(observed.Generation); err != nil {
+		b.conn.DiscardPending()
+		return nftables.TransactionReceipt{}, err
+	}
+	err = b.conn.Flush()
+	return b.conn.LastTransaction(), err
+}
