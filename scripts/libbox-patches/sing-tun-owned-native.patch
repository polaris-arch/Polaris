+func rAwaitOwner(t *testing.T, owner *redirectOwnership, predicate func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		owner.access.Lock()
+		ready := predicate()
+		owner.access.Unlock()
+		if ready {
+			return
+		}
+		runtime.Gosched()
+	}
+	t.Fatal("actual lifecycle transition did not arrive")
