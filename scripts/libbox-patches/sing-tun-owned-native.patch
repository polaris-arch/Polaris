+	flags, err := unix.FcntlInt(first.allocator.Fd(), unix.F_GETFL, 0)
+	if err != nil || flags&unix.O_ACCMODE != unix.O_RDONLY {
+		t.Fatalf("allocator flags=%x err=%v", flags, err)
+	}
+	err = first.withAllocator(func() error {
+		called := false
+		err := second.withAllocator(func() error { called = true; return nil })
+		if called || !errors.Is(err, errRedirectClaimConflict) {
+			t.Fatalf("contended allocator admitted callback: %v", err)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = second.withAllocator(func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(directory, redirectClaimAllocatorName)
+	if err = os.Rename(path, path+".old"); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(path, nil, 0444); err != nil {
+		t.Fatal(err)
+	}
+	called := false
+	if err = first.withAllocator(func() error { called = true; return nil }); err == nil || called {
+		t.Fatal("old allocator inode accepted")
+	}
+}
