+func TestRedirectOwnershipIPTablesNamesAndExactNamespaceFamilyRelease(t *testing.T) {
+	scope := redirectIPTablesScope{redirectNamespaceIdentity{1, 900}, 4, iptablesTableNAT}
+	world := newOwnershipIPTablesFakeWorld(scope)
+	r := newOwnershipTestRedirect(t)
+	ops := &ownershipIPTablesFakeOps{world: world, birth: r.ownership.birth, failAt: -1}
+	var acquired redirectIPTablesChainIdentity
