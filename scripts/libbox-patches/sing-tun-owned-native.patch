new file mode 100644
index 0000000..e5a6055
--- /dev/null
+++ b/tun_dns_owner_linux.go
@@ -0,0 +1,119 @@
+//go:build linux
+
+package tun
+
+import (
+	"errors"
+	"fmt"
+	"net/netip"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing/common"
+)
+
+// Run waits for this exact command. No detached worker can issue domain/dns
+// writes after Close has drained the admitted Start operation.
+type tunResolveCommand func(path string, arguments ...string) ([]byte, error)
+
+func runTunResolveCommand(path string, arguments ...string) ([]byte, error) {
+	command := exec.Command(path, arguments...)
+	command.Env = append(os.Environ(), "LC_ALL=C")
+	return command.Output()
+}
+
+func (t *NativeTun) setOwnedSearchDomain() error {
+	path, err := exec.LookPath("resolvectl")
+	if err != nil {
+		return nil // retain the existing optional systemd-resolved capability
+	}
+	return t.acquireOwnedSearchDomain(path, runTunResolveCommand)
+}
+
+func (t *NativeTun) acquireOwnedSearchDomain(path string, run tunResolveCommand) error {
+	n := t.nativeOwnership
+	addresses, err := t.options.DNSServerAddress()
+	if err != nil {
+		return err
+	}
+	if len(addresses) == 0 {
+		return nil
+	}
+	index := strconv.Itoa(n.link.Attrs().Index)
+	var previous [3][]string
+	commands := []string{"domain", "default-route", "dns"}
+	if n.borrowed {
+		// A persistent borrowed link may already have resolver configuration.
+		// Preserve it before the first write; an unknown/query format never
+		// authorizes an unconditional revert of somebody else's configuration.
+		for position, command := range commands {
+			output, err := run(path, command, index)
+			if err != nil {
+				return err
+			}
+			previous[position], err = parseTunResolveValues(output, n.link.Attrs().Index)
+			if err != nil {
+				return err
+			}
+		}
+	}
+	_, err = n.operation.acquire(redirectNetlink, "tun-resolved-configuration", redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			if err := t.validateNativeLink(); err != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			plans := [][]string{{"domain", index, "~."}, {"default-route", index, "true"}, append([]string{"dns", index}, common.Map(addresses, netip.Addr.String)...)}
+			for _, plan := range plans {
+				if _, err := run(path, plan...); err != nil {
+					// The command actually exited, but earlier writes or this
+					// daemon transaction may have taken effect. Retain Unknown.
+					return redirectAcquireResult{err: err}
+				}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error {
+			if err := t.validateNativeLink(); err != nil {
+				return err
+			}
+			return n.lease.Run(func() error {
+				if !n.borrowed {
+					_, err := run(path, "revert", index)
+					return err
+				}
+				for position, command := range commands {
+					values := previous[position]
+					if len(values) == 0 {
+						values = []string{""} // explicit reset, not query
+					}
+					if _, err := run(path, append([]string{command, index}, values...)...); err != nil {
+						return err
+					}
+				}
+				return nil
+			})
+		},
+	})
+	return err
+}
+
+func parseTunResolveValues(output []byte, index int) ([]string, error) {
+	if len(output) > 4096 {
+		return nil, errors.New("resolver configuration query exceeded its parsing bound")
+	}
+	line := strings.TrimSpace(string(output))
+	if strings.ContainsAny(line, "\n\r") || !strings.HasPrefix(line, fmt.Sprintf("Link %d (", index)) {
+		return nil, errors.New("resolver configuration query did not identify the frozen link")
+	}
+	separator := strings.Index(line, "): ")
+	if separator < 0 {
+		// Empty values are printed with a trailing colon and no value.
+		if strings.HasSuffix(line, "):") {
+			return nil, nil
+		}
+		return nil, errors.New("resolver configuration query format is unknown")
+	}
+	return strings.Fields(line[separator+3:]), nil
+}
