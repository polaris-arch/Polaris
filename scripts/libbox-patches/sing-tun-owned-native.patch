+//go:build linux
+
+package tun
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+)
+
+// These types consume the frozen L/I ABI. The sole common implementation is a
+// separate dependency; this file does not supply a second binding state machine.
+type iptablesProductionBackend struct {
+	ctx        context.Context
+	birth      redirectBirth
+	runtime    *autoRedirect // observation source; factory acquires no lease
+	namespace  *networkNamespaceLease
+	programs   []iptablesPreparedFamily
+	runner     *iptablesCommandRunner
+	anchors    []redirectResourceID
+	generation uint64
+	current    map[redirectIPTablesScope]*iptablesLiveTable
+	private    []*iptablesPrivateGeneration
+}
+
+type iptablesLiveTable struct {
+	program iptablesPreparedFamily
+	hooks   []redirectIPTablesRuleIdentity
+	binding redirectIPTablesBinding
+}
+
+func init() {
+	registerRedirectFirewallBackend("iptables", func(r *autoRedirect) (redirectFirewallBackend, error) {
+		if r == nil || r.ownership == nil || r.ctx == nil {
+			return nil, errors.New("missing iptables runtime owner")
+		}
+		return &iptablesProductionBackend{ctx: r.ctx, birth: r.ownership.birth, runtime: r, runner: new(iptablesCommandRunner)}, nil
+	})
+}
+
+// Resolve matching command/restore programs without spawning a process. Version
+// strings do not grant ownership. The actual native parser/lock/COMMIT matrix is
+// verified separately for legacy and nft; neither backend is silently selected
+// in place of the other when an executable is missing.
+func prepareIPTablesProgram(ipv6 bool) (iptablesPreparedFamily, error) {
+	binary, err := findIPTablesBinary(ipv6)
+	if err != nil {
+		return iptablesPreparedFamily{}, err
+	}
+	binary, err = filepath.Abs(binary)
+	if err != nil {
+		return iptablesPreparedFamily{}, err
+	}
+	restore, err := exec.LookPath(filepath.Base(binary) + "-restore")
+	if err != nil {
+		return iptablesPreparedFamily{}, fmt.Errorf("matching iptables restore is required: %w", err)
+	}
+	restore, err = filepath.Abs(restore)
+	if err != nil {
+		return iptablesPreparedFamily{}, err
+	}
+	commandTarget, err := filepath.EvalSymlinks(binary)
+	if err != nil {
+		return iptablesPreparedFamily{}, err
+	}
+	restoreTarget, err := filepath.EvalSymlinks(restore)
+	if err != nil {
+		return iptablesPreparedFamily{}, err
+	}
+	backend := func(path string) string {
+		name := filepath.Base(path)
+		if strings.Contains(name, "nft") {
+			return "nft"
+		}
+		if strings.Contains(name, "legacy") {
+			return "legacy"
+		}
+		return "standalone"
+	}
+	if backend(commandTarget) != backend(restoreTarget) {
+		return iptablesPreparedFamily{}, errors.New("iptables and restore select different backend programs")
+	}
+	return iptablesPreparedFamily{path: binary, restorePath: restore, isIPv6: ipv6}, nil
+}
+
+func (b *iptablesProductionBackend) Prepare(r *autoRedirect) error {
+	if b.namespace != nil || r == nil || r.namespaceLease == nil || r.ownership.birth != b.birth {
+		return errors.New("invalid or repeated iptables preparation")
+	}
+	b.namespace = r.namespaceLease
+	for _, family := range []struct {
+		ipv6    bool
+		enabled bool
+	}{{false, len(r.tunOptions.Inet4Address) != 0}, {true, len(r.tunOptions.Inet6Address) != 0}} {
+		if !family.enabled {
+			continue
+		}
+		program, err := prepareIPTablesProgram(family.ipv6)
+		if err != nil {
+			return err
+		}
+		program.tproxy = family.ipv6 && (!r.androidVPNService || r.customRedirectTransparent)
+		b.programs = append(b.programs, program)
+		if family.ipv6 {
+			r.ip6tablesPath = program.path
+		} else {
+			r.iptablesPath = program.path
+		}
+	}
+	if len(b.programs) == 0 {
+		return errors.New("iptables has no configured address family")
+	}
+	if r.tunOptions.StrictRoute && len(b.programs) == 1 {
+		program, err := prepareIPTablesProgram(!b.programs[0].isIPv6)
+		if err != nil {
+			// This is the existing optional disabled-family StrictRoute warning.
+			// Required enabled families and their full graphs never use this path.
+			r.logger.Warn("strict route is not available for the disabled address family: ", err)
+		} else {
+			program.unreachable = true
+			b.programs = append(b.programs, program)
+		}
+	}
+	return nil
+}
+
+type iptablesReadonlyProbeOps struct {
+	access    sync.Mutex
+	called    bool
+	id        redirectResourceID
+	ctx       context.Context
+	binary    string
+	args      []string
+	namespace *networkNamespaceLease
+	runner    *iptablesCommandRunner
+	result    iptablesCommandResult
+	birth     redirectBirth
+}
+
+func (b *iptablesProductionBackend) ReadonlyIPTablesProbe(intent redirectIPTablesReadonlyProbeIntent) (redirectResourceOps, error) {
+	if intent.context == nil || !intent.scope.valid() || intent.scope.table != iptablesTableNAT {
+		return nil, errors.New("invalid iptables readonly probe scope")
+	}
+	lease, programs := b.namespace, b.programs
+	if lease == nil {
+		// Common initializes capability before Prepare. Its lease/claims are
+		// already journaled; capture that original object and selected programs
+		// without spawning, acquiring a second lease or publishing a generation.
+		if b.runtime == nil || b.runtime.ownership == nil || b.runtime.ownership.birth != b.birth || b.runtime.namespaceLease == nil {
+			return nil, errors.New("readonly probe has no journaled runtime namespace")
+		}
+		lease = b.runtime.namespaceLease
+		program, err := prepareIPTablesProgram(intent.scope.family == 6)
+		if err != nil {
+			return nil, err
+		}
+		programs = []iptablesPreparedFamily{program}
+	}
+	namespace := lease.Identity()
+	if intent.scope.namespace != (redirectNamespaceIdentity{namespace.Device, namespace.Inode}) ||
+		!slices.ContainsFunc(programs, func(program iptablesPreparedFamily) bool {
+			return !program.unreachable && program.isIPv6 == (intent.scope.family == 6) && program.path == intent.binary
+		}) {
+		return nil, errors.New("probe does not select the prepared pinned iptables family")
+	}
+	args := intent.arguments()
+	if !slices.Equal(args, []string{"-w", "2", "-t", iptablesTableNAT, "-S"}) {
+		return nil, errors.New("readonly probe intent changed its fixed command")
+	}
+	return &iptablesReadonlyProbeOps{
+		ctx: intent.context, binary: intent.binary, args: slices.Clone(args), namespace: lease,
+		runner: new(iptablesCommandRunner), birth: b.birth,
+	}, nil
+}
+
+func (o *iptablesReadonlyProbeOps) Acquire(id redirectResourceID) redirectAcquireResult {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if o.called || id.birth != o.birth || id.domain != redirectReadOnlyProbe {
+		return redirectAcquireResult{err: errRedirectInvalidACK}
+	}
+	o.called, o.id = true, id
+	o.result = o.runner.runInNamespace(o.namespace, o.ctx, o.binary, o.args, nil)
+	return iptablesAcquireResult(o.result)
+}
+
+func (o *iptablesReadonlyProbeOps) Release(id redirectResourceID) error {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if !o.called || id != o.id || o.result.err != nil || !o.result.nativeExit || o.result.scopeError {
+		return errors.Join(errRedirectAmbiguous, o.result.err)
+	}
+	return nil // cached original Wait0; never a second Run/Wait or network delete
+}
+
+type iptablesBindingOps struct {
+	access    sync.Mutex
+	attempted bool
+	accepted  bool
+	retired   bool
+	backend   *iptablesProductionBackend
+	scope     redirectIPTablesScope
+	id        redirectResourceID
+	oldIDs    []redirectResourceID
+	old       []redirectIPTablesRuleIdentity
+	next      []redirectIPTablesRuleIdentity
+	program   iptablesPreparedFamily
+	input     []byte
+}
+
+func cloneIPTablesHookset(hooks []redirectIPTablesRuleIdentity) []redirectIPTablesRuleIdentity {
+	result := make([]redirectIPTablesRuleIdentity, len(hooks))
+	for index, hook := range hooks {
+		result[index] = hook.clone()
+	}
+	return result
+}
+
+func (b *iptablesProductionBackend) bindingOps(scope redirectIPTablesScope, key string, program iptablesPreparedFamily, old *iptablesLiveTable, next []redirectIPTablesRuleIdentity) (*iptablesBindingOps, error) {
+	var prior []redirectIPTablesRuleIdentity
+	var oldIDs []redirectResourceID
+	if old != nil {
+		if old.binding.scope != scope || old.program != program {
+			return nil, errors.New("old hookset differs from its retained scope or program")
+		}
+		prior, oldIDs = cloneIPTablesHookset(old.hooks), []redirectResourceID{old.binding.resource}
+	}
+	frozen := cloneIPTablesHookset(next)
+	input, err := iptablesHookTransaction(scope, prior, frozen)
+	if err != nil {
+		return nil, err
+	}
+	return &iptablesBindingOps{
+		backend: b, scope: scope, id: redirectResourceID{b.birth, redirectIPTables, key},
+		oldIDs: oldIDs, old: prior, next: frozen, program: program, input: slices.Clone(input),
+	}, nil
+}
+
+func (o *iptablesBindingOps) run(input []byte, ctx context.Context) iptablesCommandResult {
+	return o.backend.runner.runInNamespace(o.backend.namespace, ctx, o.program.restorePath, []string{"--noflush", "--wait", "2"}, input)
+}
+
+func (o *iptablesBindingOps) Acquire(id redirectResourceID) redirectAcquireResult {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if o.attempted || id != o.id || len(o.oldIDs) != 0 {
+		return redirectAcquireResult{err: errRedirectInvalidACK}
+	}
+	o.attempted = true
+	result := iptablesAcquireResult(o.run(o.input, o.backend.ctx))
+	o.accepted = result.status == redirectAcquireCreated && result.err == nil
+	return result
+}
+
+func (o *iptablesBindingOps) Transfer(intent redirectIPTablesBindingTransferIntent) redirectIPTablesBindingTransferResult {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if o.attempted || intent.scope != o.scope || intent.next != o.id || !slices.Equal(intent.old, o.oldIDs) || len(o.oldIDs) == 0 {
+		return redirectIPTablesBindingTransferResult{err: errRedirectInvalidACK}
+	}
+	o.attempted = true
+	result := iptablesAcquireResult(o.run(o.input, o.backend.ctx))
+	o.accepted = result.status == redirectAcquireCreated && result.err == nil
+	response := redirectIPTablesBindingTransferResult{status: result.status, err: result.err}
+	if result.status == redirectAcquireCreated && result.err == nil {
+		response.ack = &redirectIPTablesBindingTransferACK{scope: o.scope, old: slices.Clone(intent.old), next: intent.next}
+	}
+	return response
+}
+
+func (o *iptablesBindingOps) Release(id redirectResourceID) error {
+	o.access.Lock()
+	defer o.access.Unlock()
+	if !o.accepted || o.retired || id != o.id {
+		return errRedirectInvalidACK
+	}
+	o.retired = true // an unknown delete is never replayed
+	input, err := iptablesHookTransaction(o.scope, o.next, nil)
+	if err != nil {
+		return err
+	}
+	return o.run(input, context.Background()).err
+}
+
+func (b *iptablesProductionBackend) nextPlan(r *autoRedirect) (*iptablesGenerationPlan, error) {
+	if b.namespace == nil || r.namespaceLease != b.namespace || r.ownership.birth != b.birth || b.generation == ^uint64(0) {
+		return nil, errors.New("iptables retained birth/namespace is unavailable")
+	}
+	locals, err := r.findLocalAddresses()
+	if err != nil {
+		return nil, err
+	}
+	b.generation++ // identities never reuse an attempted generation
+	namespace := b.namespace.Identity()
+	return buildIPTablesGeneration(r, redirectNamespaceIdentity{namespace.Device, namespace.Inode}, b.generation, locals, b.programs)
+}
+
+func (b *iptablesProductionBackend) Start(r *autoRedirect, op *redirectOperation, requires []redirectResourceID) error {
+	if b.current != nil {
+		return errRedirectAlreadyStarted
+	}
+	// L automatically includes its current netlink service anchors in each typed
+	// binding. Ephemeral route receipts must not become stale update prerequisites.
+	b.anchors = slices.DeleteFunc(slices.Clone(requires), func(id redirectResourceID) bool { return id.domain == redirectNetlink })
+	_, err := b.install(r, op, false)
+	return err
+}
+
+func (b *iptablesProductionBackend) UpdateNetwork(r *autoRedirect, op *redirectOperation) error {
+	_, err := b.install(r, op, true)
+	return err
+}
+
+func (b *iptablesProductionBackend) UpdateRouteAddressSet(r *autoRedirect, op *redirectOperation) error {
+	_, err := b.UpdateRouteAddressSetSnapshot(r, op)
+	return err
+}
+
+func (b *iptablesProductionBackend) UpdateRouteAddressSetSnapshot(r *autoRedirect, op *redirectOperation) (RouteAddressSetUpdateState, error) {
+	return b.install(r, op, true)
+}
+
+func retireIPTablesGenerations(op *redirectOperation, generations []*iptablesPrivateGeneration) error {
+	for _, generation := range slices.Backward(generations) {
+		if err := retireIPTablesPrivateGeneration(op, generation); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (b *iptablesProductionBackend) install(r *autoRedirect, op *redirectOperation, update bool) (state RouteAddressSetUpdateState, err error) {
+	state = RouteAddressSetUnchanged
+	if r == nil || r.ownership == nil || op == nil || op.owner != r.ownership || (update && b.current == nil) {
+		return RouteAddressSetUnchanged, errRedirectNotStarted
+	}
+	r.ownership.access.Lock()
+	validOperation := !op.ended && op.effectHeld
+	r.ownership.access.Unlock()
+	if !validOperation {
+		return RouteAddressSetUnchanged, errRedirectInvalidACK
+	}
+	defer func() {
+		// Network callbacks and the legacy update entry also call this adapter.
+		// A partially switched graph must seal admission before any caller can
+		// enqueue another generation; the snapshot wrapper is not the sole gate.
+		if state == RouteAddressSetUnknown {
+			r.ownership.requestClose()
+		}
+	}()
+	plan, err := b.nextPlan(r)
+	if err != nil {
+		return RouteAddressSetUnchanged, err
+	}
+	var nextPrivate []*iptablesPrivateGeneration
+	for index, family := range plan.families {
+		generation, acquireErr := acquireIPTablesPrivateGeneration(b.ctx, op, family, b.programs[index].path, b.runner, b.namespace, b.anchors)
+		if generation != nil {
+			nextPrivate = append(nextPrivate, generation)
+		}
+		if acquireErr != nil {
+			if errors.Is(acquireErr, errRedirectAmbiguous) || errors.Is(acquireErr, errRedirectEffectPanic) {
+				return RouteAddressSetUnknown, acquireErr
+			}
+			if cleanupErr := retireIPTablesGenerations(op, nextPrivate); cleanupErr != nil {
+				return RouteAddressSetUnknown, errors.Join(acquireErr, cleanupErr)
+			}
+			return RouteAddressSetUnchanged, acquireErr
+		}
+	}
+	// No public reference is emitted until both families' complete private graphs
+	// exist. Each table then has one frozen whole-hookset command and typed ACK.
+	previousPrivate := b.private
+	if b.current == nil {
+		b.current = make(map[redirectIPTablesScope]*iptablesLiveTable)
+	}
+	switched := false
+	for index, family := range plan.families {
+		program, generation := b.programs[index], nextPrivate[index]
+		for _, table := range []string{iptablesTableFilter, iptablesTableNAT, iptablesTableMangle} {
+			hooks := family.tableHooks(table)
+			if len(hooks) == 0 {
+				continue
+			}
+			scope := family.scope(table)
+			old := b.current[scope]
+			if update && old == nil {
+				return RouteAddressSetUnknown, errors.Join(errRedirectAmbiguous, errors.New("existing iptables table binding is missing"))
+			}
+			key := fmt.Sprintf("iptables-binding/%d/%d/%d/%s/%d", scope.namespace.device, scope.namespace.inode, scope.family, table, b.generation)
+			ops, buildErr := b.bindingOps(scope, key, program, old, hooks)
+			if buildErr != nil {
+				return RouteAddressSetUnknown, errors.Join(errRedirectAmbiguous, buildErr)
+			}
+			requires := slices.Concat(b.anchors, generation.byTable[table])
+			var binding redirectIPTablesBinding
+			var bindErr error
+			if old == nil {
+				binding, bindErr = op.acquireIPTablesBinding(scope, key, ops, requires...)
+			} else {
+				binding, bindErr = op.replaceIPTablesBindings([]redirectIPTablesBinding{old.binding}, key, ops, requires)
+			}
+			if bindErr != nil {
+				if switched || errors.Is(bindErr, errRedirectAmbiguous) || errors.Is(bindErr, errRedirectEffectPanic) || errors.Is(bindErr, errRedirectInvalidACK) {
+					return RouteAddressSetUnknown, errors.Join(errRedirectAmbiguous, bindErr)
+				}
+				if cleanupErr := retireIPTablesGenerations(op, nextPrivate); cleanupErr != nil {
+					return RouteAddressSetUnknown, errors.Join(bindErr, cleanupErr)
+				}
+				return RouteAddressSetUnchanged, bindErr
+			}
+			// Physical per-table facts are retained even if a later table fails.
+			// This is private bookkeeping, not publication of a complete B cache.
+			b.current[scope] = &iptablesLiveTable{program, cloneIPTablesHookset(hooks), binding}
+			switched = true
+		}
+	}
+	b.private = nextPrivate
+	r.ownership.access.Lock()
+	if !r.ownership.closing {
+		r.localAddresses = slices.Clone(plan.locals)
+	}
+	r.ownership.access.Unlock()
+	if err = retireIPTablesGenerations(op, previousPrivate); err != nil {
+		// Every binding already confirms B. Tail failure is not a rollback to A.
+		return RouteAddressSetCommitted, err
+	}
+	return RouteAddressSetCommitted, nil
+}
