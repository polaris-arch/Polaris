+func TestRedirectOwnershipIPTablesEachCommitPreservesAAndLegacy(t *testing.T) {
+	for _, namespace := range []redirectNamespaceIdentity{{1, 100}, {2, 100}} {
+		for _, family := range []uint8{4, 6} {
+			for _, table := range []string{iptablesTableNAT, iptablesTableMangle, iptablesTableFilter} {
+				for stage := range 3 {
+					for _, mode := range []string{"before", "lost-ack", "panic-after", "invalid-ack"} {
+						t.Run(fmt.Sprintf("ns=%v/family=%d/table=%s/stage=%d/%s", namespace, family, table, stage, mode), func(t *testing.T) {
+							scope := redirectIPTablesScope{namespace, family, table}
+							world := newOwnershipIPTablesFakeWorld(scope)
+							a := newOwnershipTestRedirect(t)
+							aOps := &ownershipIPTablesFakeOps{world: world, birth: a.ownership.birth, failAt: -1}
+							a.ownershipBackend = ownershipIPTablesFixture(a, scope, aOps)
+							if err := a.Start(); err != nil {
+								t.Fatal(err)
+							}
+							t.Cleanup(func() { _ = a.Close() })
+							b := newOwnershipTestRedirect(t)
+							before := world.except(b.ownership.birth)
+							var missingPending atomic.Bool
+							bOps := &ownershipIPTablesFakeOps{world: world, birth: b.ownership.birth, failAt: stage, mode: mode, before: func() {
+								entries := ownershipEntries(b.ownership)
+								if len(entries) == 0 || entries[len(entries)-1].state != redirectPending || entries[len(entries)-1].id.domain != redirectIPTables {
+									missingPending.Store(true)
+								}
+							}}
+							b.ownershipBackend = ownershipIPTablesFixture(b, scope, bOps)
+							err := b.Start()
+							if mode == "panic-after" {
+								if !errors.Is(err, errRedirectEffectPanic) {
+									t.Fatalf("Start=%v", err)
+								}
+							} else if !errors.Is(err, ownershipTestFailure) {
+								t.Fatalf("Start=%v", err)
+							}
+							if missingPending.Load() {
+								t.Fatal("commit occurred without Pending")
+							}
+							closeErr := b.Close()
+							if (mode != "before") != errors.Is(closeErr, errRedirectAmbiguous) {
+								t.Fatalf("Close=%v", closeErr)
+							}
+							world.assertPreserved(t, b.ownership.birth, before)
+							entries := ownershipEntries(b.ownership)
+							if mode != "before" && entries[stage].state != redirectAmbiguous {
+								t.Fatal("submitted error lost ambiguity")
+							}
+							if mode != "before" && stage > 0 && entries[0].state != redirectOwned {
+								t.Fatal("residual rule lost prerequisite chain")
+							}
+						})
+					}
+				}
+			}
+		}
+	}
+}
