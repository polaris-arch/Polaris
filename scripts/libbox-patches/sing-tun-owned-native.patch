+// This is a raw default RTM_NEWROUTE payload without RTA_DST, decoded with
+// the pinned dependency's actual rtnetlink header/attribute callees. The
+// selected-field fixture follows its RouteList decoder; it is not a kernel ACK.
+func rDefaultWireObservation(t *testing.T, spec netlink.Route) netlink.Route {
+	t.Helper()
+	integer := func(value int) []byte {
+		data := make([]byte, 4)
+		binary.NativeEndian.PutUint32(data, uint32(value))
+		return data
+	}
+	attrs := []rawnetlink.Attribute{{Type: unix.RTA_TABLE, Data: integer(spec.Table)},
+		{Type: unix.RTA_OIF, Data: integer(spec.LinkIndex)}, {Type: unix.RTA_PRIORITY, Data: integer(spec.Priority)}}
+	if len(spec.Gw) != 0 {
+		attrs = append(attrs, rawnetlink.Attribute{Type: unix.RTA_GATEWAY, Data: spec.Gw})
+	}
+	encoded, err := rawnetlink.MarshalAttributes(attrs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	header := make([]byte, unix.SizeofRtMsg)
+	header[0], header[3], header[5], header[6], header[7] = byte(spec.Family), byte(spec.Tos), byte(spec.Protocol), byte(spec.Scope), byte(spec.Type)
+	binary.NativeEndian.PutUint32(header[8:], uint32(spec.Flags))
+	data := append(header, encoded...)
+	message := nl.DeserializeRtMsg(data)
+	attributes, err := nl.ParseRouteAttr(data[message.Len():])
+	if err != nil {
+		t.Fatal(err)
+	}
+	observed := netlink.Route{Family: int(message.Family), Table: int(message.Table), Type: int(message.Type),
+		Scope: netlink.Scope(message.Scope), Protocol: netlink.RouteProtocol(message.Protocol), Tos: int(message.Tos), Flags: int(message.Flags)}
+	for _, attr := range attributes {
+		switch attr.Attr.Type {
+		case unix.RTA_TABLE:
+			observed.Table = int(binary.NativeEndian.Uint32(attr.Value))
+		case unix.RTA_OIF:
+			observed.LinkIndex = int(binary.NativeEndian.Uint32(attr.Value))
+		case unix.RTA_PRIORITY:
+			observed.Priority = int(binary.NativeEndian.Uint32(attr.Value))
+		case unix.RTA_GATEWAY:
+			observed.Gw = slices.Clone(attr.Value)
+		default:
+			t.Fatal("fixture unexpectedly includes another selector", attr.Attr.Type)
+		}
+	}
+	if observed.Dst != nil {
+		t.Fatal("missing RTA_DST was replaced with a fabricated destination")
+	}
+	return observed
+}
