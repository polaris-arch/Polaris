+func (b *runtimeRouteServiceTransport) Prepare(r *autoRedirect) error {
+	if r.nfqueueHandler != nil || r.redirectServer != nil || r.namespaceLease == nil || r.cooperativeClaimDirectory() != b.claimDirectory {
+		return errors.New("route prepare omitted namespace/claims or ran after listener")
+	}
+	op, err := r.ownership.beginOperation(false, false)
+	if err != nil {
+		return err
+	}
+	defer op.finish()
+	if b.claimRequired {
+		b.claim, err = op.acquire(redirectClaim, "route-service-conflicts", redirectResourceFuncs{acquire: func(redirectResourceID) redirectAcquireResult {
+			b.claims, err = r.ownershipBackend.(*redirectProductionCoordinator).acquireClaims(b.claimDirectory, r.namespaceLease.Identity(), r.ownership.birth, []redirectConflictKey{{"route-table", "50000"}})
+			if err != nil {
+				return redirectAcquireResult{redirectAcquireNotCommitted, err}
+			}
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		}, release: func(redirectResourceID) error { return b.claims.Release() }})
+		if err != nil {
+			return err
+		}
+	}
+	var requires []redirectResourceID
+	if b.claim != (redirectResourceID{}) {
+		requires = append(requires, b.claim)
+	}
+	b.anchor, err = op.acquire(redirectNetlink, "route-service-anchor", b.owned("anchor"), requires...)
+	return err
+}
+func (b *runtimeRouteServiceTransport) owned(label string) redirectResourceOps {
+	return redirectResourceFuncs{
+		acquire: func(redirectResourceID) redirectAcquireResult {
+			return redirectAcquireResult{status: redirectAcquireCreated}
+		},
+		release: func(redirectResourceID) error { *b.releases = append(*b.releases, label); return nil },
+	}
