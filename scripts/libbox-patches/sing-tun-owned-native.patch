+// Only a newly EXCL-created fixture inode may have its mode made exact. Never
+// chmod an existing deployment, an arbitrary pathname or a parent of TempDir.
+func publishNewClaimsFixtureFile(t *testing.T, file *os.File, path string, mode uint32) {
+	t.Helper()
+	var held, linked unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &held); err != nil {
+		t.Fatal(err)
+	}
+	if err := unix.Lstat(path, &linked); err != nil {
+		t.Fatal(err)
+	}
+	if held.Mode&unix.S_IFMT != unix.S_IFREG || held.Uid != uint32(os.Geteuid()) || held.Nlink != 1 || held.Dev != linked.Dev || held.Ino != linked.Ino {
+		t.Fatal("new fixture file lost original owned inode")
+	}
+	if err := unix.Fchmod(int(file.Fd()), mode); err != nil {
+		t.Fatal(err)
+	}
+}
