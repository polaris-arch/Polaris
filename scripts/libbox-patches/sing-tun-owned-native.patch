+func rNativeVerifyAssociation(in *rNativeLauncherInputs, c rNativeCase) error {
+	if in == nil || in.Metadata == nil || in.Proc == nil {
+		return errors.New("held metadata/proc FD missing")
+	}
+	fd := int(in.Metadata.Fd())
+	var before, after unix.Stat_t
+	if err := unix.Fstat(fd, &before); err != nil {
+		return err
+	}
+	flags, err := unix.FcntlInt(uintptr(fd), unix.F_GETFL, 0)
+	if err != nil {
+		return err
+	}
+	if before.Mode&unix.S_IFMT != unix.S_IFREG || before.Size <= 0 || before.Size > 65536 || flags&unix.O_ACCMODE != unix.O_RDONLY {
+		return errors.New("metadata must be bounded readonly regular FD")
+	}
+	data := make([]byte, before.Size)
+	if _, err := in.Metadata.ReadAt(data, 0); err != nil {
+		return err
+	}
+	if err := unix.Fstat(fd, &after); err != nil {
+		return err
+	}
+	if before.Dev != after.Dev || before.Ino != after.Ino || before.Size != after.Size || before.Mtim != after.Mtim || before.Ctim != after.Ctim {
+		return errors.New("metadata changed during capture")
+	}
+	association, err := rNativeDecodeMetadata(data, c)
+	if err != nil {
+		return err
+	}
+	files := map[string]*os.File{"targetNetns": in.Netns, "childUserns": in.ChildUserns, "privateMountns": in.Mountns, "privateProcDir": in.Proc, "formalClaimsBaseDir": in.ClaimsBase, "metadata": in.Metadata, "providedPrivateTun": in.ProvidedTun, "oneShotGToAReadPipe": in.ActorControl}
+	for _, role := range association.FDRoles {
+		if role.Role == "providedPrivateTun" && in.ProvidedTun == nil {
+			in.ProvidedTun = os.NewFile(9, "G original private TUN")
+			files[role.Role] = in.ProvidedTun
+		}
+		if role.Role == "oneShotGToAReadPipe" && in.ActorControl == nil {
+			in.ActorControl = os.NewFile(10, "G bounded A control")
+			files[role.Role] = in.ActorControl
+		}
+		file := files[role.Role]
+		if file == nil || int(file.Fd()) != role.FD {
+			return errors.New("actual inherited FD slot mismatch")
+		}
+		actual, err := rNativeFDIdentity(file)
+		if err != nil {
+			return err
+		}
+		if actual != association.FDObservedIdentities[role.Role].native() {
+			return errors.New("actual inherited FD inode mismatch")
+		}
+	}
+	in.Association = &association
+	in.Nonce = association.CaseNonce
+	in.Actor = association.Actor
+	in.NetIdentity = association.FDObservedIdentities["targetNetns"].native()
+	in.UserIdentity = association.FDObservedIdentities["childUserns"].native()
+	in.MountIdentity = association.FDObservedIdentities["privateMountns"].native()
+	in.GuardianParentNet = association.GuardianParentIdentities["netns"].native()
+	in.GuardianParentMount = association.GuardianParentIdentities["mountns"].native()
+	if p := association.Topology.Persistent; p != nil {
+		in.PersistentLink = &netlink.Tuntap{LinkAttrs: netlink.LinkAttrs{Index: p.LinkIndex, Name: p.Name, MTU: p.MTU}}
+	}
+	if f := association.Topology.ForeignLink; f != nil {
+		in.ForeignLink = &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Index: f.LinkIndex, Name: f.Name}}
+	}
+	if g := association.Topology.Gateway; g != nil {
+		in.Gateway = netip.MustParseAddr(g.Address)
+	}
+	exeFD, err := unix.Openat(int(in.Proc.Fd()), "self/exe", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return err
+	}
+	exe := os.NewFile(uintptr(exeFD), "actual test executable")
+	defer exe.Close()
+	var stat unix.Stat_t
+	if err := unix.Fstat(exeFD, &stat); err != nil {
+		return err
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Size <= 0 || stat.Size > 268435456 {
+		return errors.New("actual executable type/length unsupported")
+	}
+	hash := sha256.New()
+	n, err := io.Copy(hash, io.LimitReader(exe, stat.Size+1))
+	if err != nil || n != stat.Size {
+		return errors.Join(errors.New("actual executable capture incomplete"), err)
+	}
+	if hex.EncodeToString(hash.Sum(nil)) != association.ELFSHA256 {
+		return errors.New("actual executable digest differs from G")
+	}
+	return nil
+}
