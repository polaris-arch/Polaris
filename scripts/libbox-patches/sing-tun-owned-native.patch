+// Opt-in child of the file-only real-UID gate. No namespace switch, TUN,
+// network syscall, external executable, sysctl write or production /run write.
+func TestRedirectClaimsActualUIDHelper(t *testing.T) {
+	mode := os.Getenv("POLARIS_CLAIMS_ACTUAL_MODE")
+	if mode == "" {
+		return
+	}
+	switch mode {
+	case "hold", "conflict", "clean", "crash", "coexist":
+	default:
+		t.Fatal("unknown closed file-worker role")
+	}
+	wantUID, err := strconv.Atoi(os.Getenv("POLARIS_CLAIMS_ACTUAL_UID"))
+	if err != nil || (wantUID != 65531 && wantUID != 65530) || os.Geteuid() != wantUID {
+		t.Fatalf("actual UID=%d wanted=%d err=%v", os.Geteuid(), wantUID, err)
+	}
+	status, err := os.ReadFile("/proc/self/status")
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantCaps := uint64(1)<<unix.CAP_NET_ADMIN | uint64(1)<<unix.CAP_NET_RAW | uint64(1)<<unix.CAP_NET_BIND_SERVICE
+	var capAmbient uint64
+	for _, line := range strings.Split(string(status), "\n") {
+		if strings.HasPrefix(line, "CapAmb:") {
+			capAmbient, err = strconv.ParseUint(strings.TrimSpace(strings.TrimPrefix(line, "CapAmb:")), 16, 64)
+		}
+	}
+	if err != nil || capAmbient != wantCaps {
+		t.Fatalf("ambient capabilities=%x wanted=%x err=%v", capAmbient, wantCaps, err)
+	}
+	fd, err := unix.Open("/proc/self/ns/net", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fd)
+	var nsStat unix.Stat_t
+	if err = unix.Fstat(fd, &nsStat); err != nil {
+		t.Fatal(err)
+	}
+	namespace := networkNamespaceIdentity{uint64(nsStat.Dev), nsStat.Ino}
+	owner, err := newRedirectOwnership()
+	if err != nil {
+		t.Fatal(err)
+	}
+	key := "65001"
+	if mode == "coexist" {
+		key = "65002"
+	}
+	claims, err := acquireRedirectClaims(os.Getenv("POLARIS_CLAIMS_ACTUAL_DIR"), namespace, owner.birth, []redirectConflictKey{{"queue", key}})
+	if mode == "conflict" {
+		if claims != nil || !errors.Is(err, errRedirectClaimConflict) {
+			t.Fatalf("actual UID conflict: claims=%v err=%v", claims, err)
+		}
+		fmt.Printf("conflict uid=%d ns=%x:%x ambient=%x\n", os.Geteuid(), namespace.Device, namespace.Inode, capAmbient)
+		return
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Printf("claimed uid=%d ns=%x:%x ambient=%x\n", os.Geteuid(), namespace.Device, namespace.Inode, capAmbient)
+	if mode == "crash" {
+		os.Exit(0)
+	}
+	if mode == "hold" && !bufio.NewScanner(os.Stdin).Scan() {
+		t.Fatal("missing finite release instruction")
+	}
+	if err = claims.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	if err = claims.Release(); err != nil {
+		t.Fatal(err)
+	}
+}
