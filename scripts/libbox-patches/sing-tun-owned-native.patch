+		t.Fatal("late Start reopened Running", err)
+	}
+	if err = ownershipAwait(t, closed); err != nil {
+		t.Fatal("late actual Wait0 was not registered before drain", err)
+	}
+	if entries = ownershipEntries(owner); len(entries) != 4 {
+		t.Fatal("admitted generation disappeared before registration", entries)
+	}
+	for _, entry := range entries {
+		if entry.state != redirectReleased {
+			t.Fatal("late owned resource escaped exact cleanup", entry)
+		}
+	}
+	owner.access.Lock()
+	running := owner.running
+	owner.access.Unlock()
+	if running {
+		t.Fatal("successful late command reopened admission")
+	}
