+func TestCActualDockerExternalOwnDeleteAndSameCommentReplaceEnterLoop(t *testing.T) {
+	for _, replace := range []bool{false, true} {
+		t.Run(fmt.Sprint(replace), func(t *testing.T) {
+			r, e, op, w := cDockerLoopFixture(t, true)
+			cStartDockerFixture(t, r, e, op)
+			w.access.Lock()
+			own := w.snapshot.Rules[1]
+			changed := *own
+			eventType := nftables.MonitorEventType(unix.NFT_MSG_DELRULE)
+			if replace {
+				changed.Exprs = append([]expr.Any(nil), own.Exprs...)
+				changed.Exprs[3] = &expr.Verdict{Kind: expr.VerdictDrop}
+				w.snapshot.Rules[1] = &changed
+				eventType = nftables.MonitorEventType(unix.NFT_MSG_NEWRULE)
+			} else {
+				w.snapshot.Rules = append(w.snapshot.Rules[:1], w.snapshot.Rules[2:]...)
+			}
+			w.snapshot.Generation++
+			before := len(w.batches)
+			w.access.Unlock()
+			w.drainReads()
+			actualEvent := &nftables.MonitorEvent{Type: eventType, Header: netlink.Header{PID: 999}, Data: &changed}
+			w.events <- &nftables.MonitorEvents{GeneratedBy: actualEvent, Changes: []*nftables.MonitorEvent{actualEvent}}
+			ownershipAwait(t, w.reads)
+			if replace {
+				if err := r.Close(); !errors.Is(err, errRedirectAmbiguous) {
+					t.Fatal("same-comment wrong spec did not seal as ambiguity")
+				}
+				w.access.Lock()
+				after := len(w.batches)
+				w.access.Unlock()
+				if after != before {
+					t.Fatal("wrong spec authorized a mutation")
+				}
+			} else {
+				cDockerEffectBarrier(t, r)
+				w.assertLivePair(t, e, 11)
+				w.access.Lock()
+				after := len(w.batches)
+				self := w.snapshot.Rules[1]
+				w.access.Unlock()
+				if after != before+2 {
+					t.Fatal("external own DELETE did not retire remaining rule and acquire full pair")
+				}
+				for range 3 {
+					w.drainReads()
+					event := &nftables.MonitorEvent{Type: nftables.MonitorEventType(unix.NFT_MSG_NEWRULE), Header: netlink.Header{PID: 42}, Data: self}
+					w.events <- &nftables.MonitorEvents{GeneratedBy: event, Changes: []*nftables.MonitorEvent{event}}
+					ownershipAwait(t, w.reads)
+					cDockerEffectBarrier(t, r)
+				}
+				w.access.Lock()
+				final := len(w.batches)
+				w.access.Unlock()
+				if final != after {
+					t.Fatal("own INSERT notices caused a continuing mutation loop")
+				}
+				if err := r.Close(); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
