+
+// Capture the actual complete upstream expression serializer. This is a
+// transport capture only; it does not claim kernel ownership or acceptance.
+type nftBuilderCapture struct {
+	batches [][]netlink.Message
+	replies []netlink.Message
+	failure error
+}
+
+// The fork's transport tests establish these receipt states from real frozen
+// messages. This finite seam tests how the production N phase boundary consumes
+// them and publishes caches; it does not pretend to accept kernel operations.
+func TestActualNFTSnapshotBindingAndRetirementPhases(t *testing.T) {
+	before := nftables.TransactionReceipt{State: nftables.TransactionCommitted, Intent: nftables.TransactionIntent{Birth: "phase-birth", PortID: 42, Messages: []nftables.MessageIntent{{Header: netlink.Header{Sequence: 100}}}}}
+	for _, test := range []struct {
+		name      string
+		receipt   nftables.TransactionState
+		bindErr   error
+		retireErr error
+		want      RouteAddressSetUpdateState
+	}{
+		{"prebinding-not-sent", nftables.TransactionNotSent, unix.EMSGSIZE, nil, RouteAddressSetUnchanged},
+		{"prebinding-full-abort", nftables.TransactionAborted, unix.EEXIST, nil, RouteAddressSetUnchanged},
+		{"binding-lost-ack", nftables.TransactionUnknown, nftables.ErrUncertain, nil, RouteAddressSetUnknown},
+		{"committed-cleanup-unknown", nftables.TransactionCommitted, nil, nftables.ErrUncertain, RouteAddressSetCommitted},
+		{"committed-cleanup-error", nftables.TransactionCommitted, nil, unix.EBUSY, RouteAddressSetCommitted},
+		{"committed-success", nftables.TransactionCommitted, nil, nil, RouteAddressSetCommitted},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			r := newOwnershipTestRedirect(t)
+			a := []netip.Prefix{netip.MustParsePrefix("192.0.2.0/24")}
+			candidate := []netip.Prefix{netip.MustParsePrefix("198.51.100.0/24")}
+			old := &nftables.Set{Name: "include4_g1"}
+			next := map[string]*nftables.Set{"include4": {Name: "include4_g2"}}
+			b := &redirectNFTRuntime{sets: map[string]*nftables.Set{"include4": old}, bindingsConfirmed: true, includeAddresses: slices.Clone(a)}
+			receipt := nftables.TransactionReceipt{State: test.receipt, Intent: nftables.TransactionIntent{Birth: "phase-birth", PortID: 42, Generation: 0xfedcba98, Messages: []nftables.MessageIntent{{Header: netlink.Header{Sequence: 200}}}}}
+			state, err := nftAddressBindingState(before, receipt, 0xfedcba98, test.bindErr)
+			retireCalls := 0
+			state, err = b.finishAddressBinding(r, next, nil, candidate, nil, state, err, func() error {
+				retireCalls++
+				if !slices.Equal(b.includeAddresses, candidate) || b.sets["include4"] != next["include4"] {
+					t.Fatal("cleanup ran before confirmed binding publication")
+				}
+				return test.retireErr
+			})
+			if state != test.want || test.bindErr != nil && !errors.Is(err, test.bindErr) || test.retireErr != nil && !errors.Is(err, test.retireErr) {
+				t.Fatalf("phase/error: %v %v", state, err)
+			}
+			if test.want == RouteAddressSetCommitted {
+				if retireCalls != 1 || !slices.Equal(b.includeAddresses, candidate) {
+					t.Fatal("complete receipt did not publish candidate")
+				}
+				candidate[0] = a[0]
+				if b.includeAddresses[0] != netip.MustParsePrefix("198.51.100.0/24") {
+					t.Fatal("confirmed cache aliases caller candidate")
+				}
+			} else if retireCalls != 0 || !slices.Equal(b.includeAddresses, a) || b.sets["include4"] != old {
+				t.Fatal("an uncommitted/unknown binding published or retired the old graph")
+			}
+			if err = r.Close(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+	// A previous successful batch is not authority for a rejected next batch.
+	if state, err := nftAddressBindingState(before, before, 19, unix.EINVAL); state != RouteAddressSetUnchanged || !errors.Is(err, unix.EINVAL) {
+		t.Fatalf("stale receipt was treated as new commit: %v %v", state, err)
+	}
+	if state, err := nftAddressBindingState(before, before, 19, nil); state != RouteAddressSetUnknown || err == nil {
+		t.Fatal("stale successful receipt confirmed a new binding")
+	}
+}
+
+func TestActualNFTSnapshotNoOpRequiresConfirmedEquality(t *testing.T) {
+	r := newOwnershipTestRedirect(t)
+	confirmed := []netip.Prefix{netip.MustParsePrefix("192.0.2.0/24")}
+	b := &redirectNFTRuntime{bindingsConfirmed: true, includeAddresses: slices.Clone(confirmed)}
+	if state, err := b.updateSetsSnapshot(r, nil, slices.Clone(confirmed), nil); state != RouteAddressSetCommitted || err != nil {
+		t.Fatalf("confirmed equality did not certify no-op: %v %v", state, err)
+	}
+	b.unknown = true
+	if state, err := b.updateSetsSnapshot(r, nil, confirmed, nil); state != RouteAddressSetUnknown || !errors.Is(err, nftables.ErrUncertain) {
+		t.Fatal("uncertain live binding was guessed equal to old cache")
+	}
+	b.unknown = false
+	b.bindingsConfirmed = false
+	if state, err := b.updateSetsSnapshot(r, nil, confirmed, nil); state != RouteAddressSetUnknown || err == nil {
+		t.Fatal("unconfirmed cache equality was treated as committed")
+	}
+}
+
+type nftSnapshotPhaseFirewall struct {
+	*runtimeFirewallTransport
+	nft             *redirectNFTRuntime
+	entered, resume chan struct{}
+	cleanupErr      error
+}
+
+func (f *nftSnapshotPhaseFirewall) UpdateRouteAddressSetSnapshot(r *autoRedirect, _ *redirectOperation) (RouteAddressSetUpdateState, error) {
+	include, exclude, err := f.nft.routePrefixes(r)
+	if err != nil {
+		return RouteAddressSetUnchanged, err
+	}
+	close(f.entered)
+	<-f.resume
+	return f.nft.finishAddressBinding(r, map[string]*nftables.Set{"include4": {Name: "include4_g2"}}, f.nft.localAddresses, include, exclude, RouteAddressSetCommitted, nil, func() error { return f.cleanupErr })
+}
+
+func (f *nftSnapshotPhaseFirewall) UpdateNetwork(r *autoRedirect, op *redirectOperation) error {
+	return f.nft.UpdateNetwork(r, op)
+}
