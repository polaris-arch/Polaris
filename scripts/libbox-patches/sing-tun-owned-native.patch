+// The production Handle is private, lasting, and opened in the retained lease.
+// In particular, no method may fall back to netlink's package-global socket
+// after Handle.Close. The interface also injects the real API boundary in tests.
+type routeNetlink interface {
+	Close() error
+	LinkByName(string) (netlink.Link, error)
+	LinkByIndex(int) (netlink.Link, error)
+	LinkSetMTU(netlink.Link, int) error
+	LinkSetUp(netlink.Link) error
+	LinkSetDown(netlink.Link) error
+	AddrAdd(netlink.Link, *netlink.Addr) error
+	AddrDel(netlink.Link, *netlink.Addr) error
+	RouteAdd(*netlink.Route) error
+	RouteDel(*netlink.Route) error
+	RouteListFiltered(int, *netlink.Route, uint64) ([]netlink.Route, error)
+	RuleAdd(*netlink.Rule) error
+	RuleDel(*netlink.Rule) error
+	RuleList(int) ([]netlink.Rule, error)
+}
+
+func openRouteNetlink(lease *networkNamespaceLease) (routeNetlink, error) {
+	actual := &realRouteNetlink{}
+	err := lease.Run(func() error {
+		var err error
+		actual.Handle, err = netlink.NewHandle(unix.NETLINK_ROUTE)
+		if err != nil {
+			return err
+		}
+		if err = actual.Handle.SetSocketTimeout(netlink.GetSocketTimeout()); err != nil {
+			return err
+		}
+		actual.ruleSocket, err = rawnetlink.Dial(unix.NETLINK_ROUTE, nil)
+		return err
+	})
+	if actual.Handle == nil && actual.ruleSocket == nil {
+		return nil, err
+	}
+	return actual, err // preserve sockets opened before a later restore/construction error
+}
+
+// The pinned sagernet RuleList decoder discards action and mark-presence.
+// A second retained socket supplies the complete original wire selectors;
+// dumping through it never creates a release right. Both sockets are born in
+// the same lease and held by one actual constructor receipt.
+type realRouteNetlink struct {
+	*netlink.Handle
+	ruleSocket *rawnetlink.Conn
+}
+
+func (h *realRouteNetlink) Close() error {
+	var err error
+	if h.ruleSocket != nil {
+		err = h.ruleSocket.Close()
+	}
+	if h.Handle != nil {
+		h.Handle.Close()
+	}
+	return err
+}
+
+func (h *realRouteNetlink) RuleList(family int) ([]netlink.Rule, error) {
+	if h.ruleSocket == nil {
+		return nil, errors.New("rule observation socket was not acquired")
+	}
+	if err := h.ruleSocket.SetDeadline(time.Now().Add(netlink.GetSocketTimeout())); err != nil {
+		return nil, err
+	}
+	data := make([]byte, 12) // Linux fib_rule_hdr
+	data[0] = byte(family)
+	messages, err := h.ruleSocket.Execute(rawnetlink.Message{Header: rawnetlink.Header{Type: unix.RTM_GETRULE, Flags: rawnetlink.Request | rawnetlink.Dump}, Data: data})
+	if err != nil {
+		return nil, err
+	}
+	rules := make([]netlink.Rule, 0, len(messages))
+	for _, message := range messages {
+		if message.Header.Type != unix.RTM_NEWRULE {
+			return nil, errors.New("unexpected rule observation response")
+		}
+		rule, err := decodeOwnedRuleObservation(message.Data)
+		if err != nil {
+			return nil, err
+		}
+		rules = append(rules, *rule)
+	}
+	return rules, nil
+}
+
+func decodeOwnedRuleObservation(data []byte) (*netlink.Rule, error) {
+	if len(data) < 12 {
+		return nil, errors.New("short rule observation header")
+	}
+	rule := netlink.NewRule()
+	rule.Family, rule.Tos, rule.Type = int(data[0]), uint(data[3]), data[7]
+	if rule.Type == unix.FR_ACT_TO_TBL {
+		rule.Table = int(data[4])
+	}
+	flags := binary.NativeEndian.Uint32(data[8:12])
+	if flags & ^uint32(unix.FIB_RULE_INVERT|unix.FIB_RULE_PERMANENT|unix.FIB_RULE_UNRESOLVED|unix.FIB_RULE_IIF_DETACHED|unix.FIB_RULE_OIF_DETACHED) != 0 {
+		return nil, errors.New("rule observation has unsupported action flags")
+	}
+	rule.Invert = flags&netlink.FibRuleInvert != 0
+	attributes, err := rawnetlink.NewAttributeDecoder(data[12:])
+	if err != nil {
+		return nil, err
+	}
+	for attributes.Next() {
+		switch attributes.Type() {
+		case unix.FRA_TABLE:
+			value := int(attributes.Uint32())
+			if rule.Type == unix.FR_ACT_TO_TBL || value != 0 {
+				rule.Table = value
+			}
+		case unix.FRA_PRIORITY:
+			rule.Priority = int(attributes.Uint32())
+		case unix.FRA_SRC, unix.FRA_DST:
+			address, valid := netip.AddrFromSlice(attributes.Bytes())
+			if !valid {
+				return nil, errors.New("invalid rule observation address")
+			}
+			address = address.Unmap()
+			bits := int(data[2])
+			if attributes.Type() == unix.FRA_DST {
+				bits = int(data[1])
+			}
+			prefix := netip.PrefixFrom(address, bits)
+			if !prefix.IsValid() {
+				return nil, errors.New("invalid rule observation prefix")
+			}
+			if attributes.Type() == unix.FRA_SRC {
+				rule.Src = prefix
+			} else {
+				rule.Dst = prefix
+			}
+		case unix.FRA_FWMARK:
+			rule.Mark, rule.MarkSet = attributes.Uint32(), true
+		case unix.FRA_FWMASK:
+			rule.Mask = int(attributes.Uint32())
+		case unix.FRA_GOTO:
+			rule.Goto = int(attributes.Uint32())
+		case unix.FRA_FLOW:
+			rule.Flow = int(attributes.Uint32())
+		case unix.FRA_IIFNAME:
+			rule.IifName = attributes.String()
+		case unix.FRA_OIFNAME:
+			rule.OifName = attributes.String()
+		case unix.FRA_SUPPRESS_IFGROUP:
+			rule.SuppressIfgroup = int(int32(attributes.Uint32()))
+		case unix.FRA_SUPPRESS_PREFIXLEN:
+			rule.SuppressPrefixlen = int(int32(attributes.Uint32()))
+		case unix.FRA_DPORT_RANGE, unix.FRA_SPORT_RANGE:
+			value := attributes.Bytes()
+			if len(value) != 4 {
+				return nil, errors.New("invalid rule observation port range")
+			}
+			ports := netlink.NewRulePortRange(binary.NativeEndian.Uint16(value[:2]), binary.NativeEndian.Uint16(value[2:]))
+			if attributes.Type() == unix.FRA_DPORT_RANGE {
+				rule.Dport = ports
+			} else {
+				rule.Sport = ports
+			}
+		case unix.FRA_UID_RANGE:
+			value := attributes.Bytes()
+			if len(value) != 8 {
+				return nil, errors.New("invalid rule observation UID range")
+			}
+			rule.UIDRange = netlink.NewRuleUIDRange(binary.NativeEndian.Uint32(value[:4]), binary.NativeEndian.Uint32(value[4:]))
+		case unix.FRA_IP_PROTO:
+			rule.IPProto = int(attributes.Uint8())
+		case unix.FRA_TUN_ID:
+			value := attributes.Bytes()
+			if len(value) != 8 {
+				return nil, errors.New("invalid rule observation tunnel ID")
+			}
+			rule.TunID = uint(binary.BigEndian.Uint64(value))
+		case unix.FRA_PROTOCOL, unix.FRA_PAD:
+			// Origin annotation/padding does not alter a fib-rule selector.
+		default:
+			return nil, errors.New("rule observation has an unsupported selector")
+		}
+	}
+	if err := attributes.Err(); err != nil {
+		return nil, err
+	}
+	return rule, nil
+}
