+func TestRedirectOwnershipIPTablesCollisionAndResidualRelease(t *testing.T) {
+	scope := redirectIPTablesScope{redirectNamespaceIdentity{1, 333}, 6, iptablesTableMangle}
+	for _, mode := range []string{"collision", "reference-error", "reference-panic", "chain-error"} {
+		t.Run(mode, func(t *testing.T) {
+			world := newOwnershipIPTablesFakeWorld(scope)
+			r := newOwnershipTestRedirect(t)
+			ops := &ownershipIPTablesFakeOps{world: world, birth: r.ownership.birth, failAt: -1, collide: mode == "collision", releaseMode: mode}
+			r.ownershipBackend = ownershipIPTablesFixture(r, scope, ops)
+			err := r.Start()
+			if mode == "collision" {
+				if !errors.Is(err, syscall.EEXIST) {
+					t.Fatalf("Start=%v", err)
+				}
+				if err = r.Close(); err != nil {
+					t.Fatal(err)
+				}
+				if len(world.deletedChains) != 0 || len(world.deletedRules) != 0 || ownershipEntries(r.ownership)[0].state != redirectReleased {
+					t.Fatal("collision granted ownership")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			before := world.except(r.ownership.birth)
+			err = r.Close()
+			if !errors.Is(err, errRedirectAmbiguous) {
+				t.Fatalf("Close=%v", err)
+			}
+			entries := ownershipEntries(r.ownership)
+			if mode != "chain-error" && entries[0].state != redirectOwned {
+				t.Fatal("unreleased reference lost its chain")
+			}
+			if mode == "chain-error" && entries[0].state != redirectAmbiguous {
+				t.Fatal("chain error lost ambiguity")
+			}
+			world.assertPreserved(t, r.ownership.birth, before)
+			deleted := len(world.deletedChains) + len(world.deletedRules)
+			if r.Close() != err || len(world.deletedChains)+len(world.deletedRules) != deleted {
+				t.Fatal("Close retried unknown delete")
+			}
+		})
+	}
+}
