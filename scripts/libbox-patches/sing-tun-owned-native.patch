+	defer w.access.Unlock()
+	g := e.docker[nftables.TableFamilyIPv4]
+	if g == nil || g.parent.Handle != tableHandle || len(g.rules) != 2 {
+		t.Fatal("production reconcile did not bind full current pair")
+	}
+	unchanged, err := g.matchesObservation(w.snapshot)
+	if err != nil || !unchanged {
+		t.Fatalf("full actual C observation disagrees: %v", err)
+	}
+	if len(w.snapshot.Rules) != 3 || w.snapshot.Rules[0].Handle != 99 || string(bytes.TrimRight(w.snapshot.Rules[0].Exprs[1].(*expr.Cmp).Data, "\x00")) != "foreign-tun" {
+		t.Fatal("foreign parent/rule altered")
+	}
+}
