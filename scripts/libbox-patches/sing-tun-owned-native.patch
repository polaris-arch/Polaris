+func TestRedirectOwnershipNFTFiniteReleaseFailureAndForeignIdentity(t *testing.T) {
+	for _, mode := range []string{"rule-error", "element-error", "set-error", "foreign-element", "foreign-rule", "reused-rule-handle", "set-replacement", "changed-program"} {
+		t.Run(mode, func(t *testing.T) {
+			scope := redirectNFTScope{redirectNamespaceIdentity{3, 915}, redirectNFTINet}
+			r := newOwnershipTestRedirect(t)
+			ops := newOwnershipNFTContentOps(r.ownership, scope)
+			r.ownershipBackend = ownershipFakeBackend{start: func(_ *autoRedirect, op *redirectOperation) error {
+				members, err := ownershipNFTContentPlan(op, scope, []netip.Addr{netip.MustParseAddr("2001:db8::1")})
+				if err != nil {
+					return err
+				}
+				_, err = op.acquireNFTBatch(members, ops)
+				return err
+			}}
+			if err := r.Start(); err != nil {
+				t.Fatal(err)
+			}
+			switch mode {
+			case "rule-error":
+				ops.failRelease = redirectNFTRule
+			case "element-error":
+				ops.failRelease = redirectNFTElement
+			case "set-error":
+				ops.failRelease = redirectNFTSet
+			default:
+				for address, identity := range ops.world {
+					if identity.object.stamp.birth != r.ownership.birth {
+						continue
+					}
+					switch {
+					case mode == "foreign-element" && address.kind == redirectNFTElement:
+						identity.object.address.element = netip.MustParseAddr("2001:db8::2")
+						identity.object.stamp.birth = redirectBirth{}
+						ops.world[ownershipNFTContentAddress(identity.object)] = identity
+					case mode == "foreign-rule" && address.kind == redirectNFTRule:
+						identity.object.handle++
+						identity.object.stamp.birth = redirectBirth{}
+						ops.world[ownershipNFTContentAddress(identity.object)] = identity
+					case mode == "reused-rule-handle" && address.kind == redirectNFTRule:
+						identity.object.incarnation++
+						identity.object.stamp.birth = redirectBirth{}
+						ops.world[address] = identity
+					case mode == "set-replacement" && address.kind == redirectNFTSet:
+						identity.object.incarnation++
+						ops.world[address] = identity
+					case mode == "changed-program" && address.kind == redirectNFTRule:
+						identity.object.spec.content.verdict = redirectNFTDrop
+						ops.world[address] = identity
+					}
+				}
+			}
+			before := ops.foreignSnapshot(r.ownership.birth)
+			first := r.Close()
+			attempts := len(ops.releases)
+			if !errors.Is(first, errRedirectAmbiguous) || r.Close() != first || len(ops.releases) != attempts {
+				t.Fatal("unknown finite deletion retried or treated as released")
+			}
+			if !reflect.DeepEqual(before, ops.foreignSnapshot(r.ownership.birth)) {
+				t.Fatal("foreign finite object deleted")
+			}
+			for _, entry := range ownershipEntries(r.ownership) {
+				if entry.id.domain == redirectNFTables && entry.id == ops.batches[0].members[0].id && entry.state != redirectOwned {
+					t.Fatal("necessary table lost after finite residual")
+				}
+			}
+		})
+	}
+}
