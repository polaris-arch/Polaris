+type networkNamespaceIdentity struct{ Device, Inode uint64 }
+
+// The fd, rather than the path or inode, keeps this exact namespace alive.
+type networkNamespaceLease struct {
+	access   sync.RWMutex
+	fd       int
+	identity networkNamespaceIdentity
+	closed   bool
+}
+
+func newNetworkNamespaceLease(nameOrPath string) (*networkNamespaceLease, error) {
+	path := nameOrPath
+	if path == "" {
+		path = "/proc/thread-self/ns/net"
+	} else if !strings.HasPrefix(path, "/") {
+		path = "/run/netns/" + path
+	}
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, E.Cause(err, "open network namespace")
+	}
+	namespaceType, err := unix.IoctlRetInt(fd, unix.NS_GET_NSTYPE)
+	if err != nil || namespaceType != unix.CLONE_NEWNET {
+		_ = unix.Close(fd)
+		return nil, errors.Join(errors.New("file is not a network namespace"), err)
+	}
+	var stat unix.Stat_t
+	if err = unix.Fstat(fd, &stat); err != nil {
+		_ = unix.Close(fd)
+		return nil, err
+	}
+	return &networkNamespaceLease{fd: fd, identity: networkNamespaceIdentity{uint64(stat.Dev), stat.Ino}}, nil
+}
+
+func (l *networkNamespaceLease) Identity() networkNamespaceIdentity { return l.identity }
+
+// WithFD lends the pinned fd only for this call; the callee must not close it.
+func (l *networkNamespaceLease) WithFD(block func(int) error) error {
+	l.access.RLock()
+	defer l.access.RUnlock()
+	if l.closed {
+		return errors.New("network namespace lease is closed")
+	}
+	return block(l.fd)
+}
+
+func (l *networkNamespaceLease) Run(block func() error) error {
+	return l.WithFD(func(fd int) error {
+		result := make(chan error, 1)
+		go func() {
+			runtime.LockOSThread()
+			// Restore before returning the thread to the runtime. A failed restore
+			// leaves it locked, so the runtime discards it when this goroutine exits.
+			original, err := unix.Open("/proc/thread-self/ns/net", unix.O_RDONLY|unix.O_CLOEXEC, 0)
+			if err != nil {
+				runtime.UnlockOSThread()
+				result <- err
+				return
+			}
+			defer unix.Close(original)
+			var stat unix.Stat_t
+			if err = unix.Fstat(original, &stat); err != nil {
+				runtime.UnlockOSThread()
+				result <- err
+				return
+			}
+			same := uint64(stat.Dev) == l.identity.Device && stat.Ino == l.identity.Inode
+			if !same {
+				if err = unix.Setns(fd, unix.CLONE_NEWNET); err != nil {
+					runtime.UnlockOSThread()
+					result <- E.Cause(err, "enter pinned network namespace")
+					return
+				}
+			}
+			defer func() {
+				if value := recover(); value != nil {
+					err = fmt.Errorf("%w: %v", errRedirectEffectPanic, value)
+				}
+				if !same {
+					if restoreErr := unix.Setns(original, unix.CLONE_NEWNET); restoreErr != nil {
+						result <- errors.Join(err, E.Cause(restoreErr, "restore network namespace"))
+						return
+					}
+				}
+				runtime.UnlockOSThread()
+				result <- err
+			}()
+			err = block()
+		}()
+		return <-result
+	})
+}
+
+func (l *networkNamespaceLease) Close() error {
+	l.access.Lock()
+	defer l.access.Unlock()
+	if l.closed {
+		return nil
+	}
+	l.closed = true
+	return unix.Close(l.fd)
+}
