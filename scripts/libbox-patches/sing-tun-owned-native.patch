+	raw, err := json.Marshal(f.journal)
+	if err != nil {
+		return err
+	}
+	raw = append(raw, '\n')
+	if err = fw4Write(f.journalFD, raw); err != nil {
+		return err
+	}
+	f.journalBytes = raw
