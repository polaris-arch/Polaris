+	}
+}
+func (f *redirectFW4Runtime) validateDeployment() error {
+	for _, check := range []struct {
+		fd       int
+		path     string
+		identity fw4FileIdentity
+	}{{f.dirFD, f.dirPath, f.dirIdentity}, {f.nativeDirFD, f.nativeDirPath, f.nativeDirIdentity}} {
+		held, err := fw4Identity(check.fd)
+		if err != nil || held != check.identity {
+			return errFW4Unresolved
+		}
+		var linked unix.Stat_t
+		if err = unix.Stat(check.path, &linked); err != nil || fw4StatIdentity(linked) != check.identity {
+			return errFW4Unresolved
