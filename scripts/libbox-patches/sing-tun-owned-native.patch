+func fw4Write(fd int, raw []byte) error {
+	if err := unix.Ftruncate(fd, 0); err != nil {
+		return err
+	}
+	for offset := 0; offset < len(raw); {
+		n, err := unix.Pwrite(fd, raw[offset:], int64(offset))
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+		offset += n
+	}
