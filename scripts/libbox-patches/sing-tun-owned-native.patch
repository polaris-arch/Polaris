+	r := newOwnershipTestRedirect(t)
+	var anchor, child, hook redirectResourceID
+	var childReleases atomic.Int32
+	owned := func(release func() error) redirectResourceOps {
+		return redirectResourceFuncs{
+			acquire: func(redirectResourceID) redirectAcquireResult {
+				return redirectAcquireResult{status: redirectAcquireCreated}
+			},
+			release: func(redirectResourceID) error { return release() },
+		}
