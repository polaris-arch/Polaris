+			}
+			if _, err := r.ownership.beginOperation(false, true); !errors.Is(err, errRedirectClosing) {
+				t.Fatal("fatal error did not synchronously seal owner admission")
+			}
+			if queue.closeCount.Load() != 0 || queue.receiverExits.Load() != 0 || r.nfqueueHandler.ctx.Err() != nil {
+				t.Fatal("receiver exit/cancel/unbind preceded hook withdrawal")
+			}
+			select {
+			case ret := <-queue.errorReturns:
+				t.Fatalf("error callback returned before permission: %d", ret)
+			default:
+			}
+			close(resume)
+			if mode != "external-close" {
+				go func() { closed <- r.Close() }()
+			}
+			closeErr := ownershipAwait(t, closed)
+			if !errors.Is(closeErr, fatal) || !errors.Is(r.Close(), fatal) {
+				t.Fatal("shared Close lost original receiver cause")
+			}
+			if mode == "unknown" {
+				if !errors.Is(closeErr, ownershipTestFailure) || queue.closeCount.Load() != 0 || queue.receiverExits.Load() != 0 || r.nfqueueHandler.ctx.Err() != nil {
+					t.Fatal("Unknown hook withdrawal retired receiver responsibility")
+				}
+				select {
+				case ret := <-queue.errorReturns:
+					t.Fatalf("Unknown hook allowed receiver exit: %d", ret)
+				default:
+				}
+				if err := r.conflictClaims.Validate(); err != nil {
+					t.Fatal(err)
+				}
+				// Test transports have no kernel hook. Retire private test resources
+				// only after asserting the ledger's Unknown outcome and no early exit.
+				_ = r.nfqueueHandler.Close()
+				_ = r.conflictClaims.Release()
+				_ = r.namespaceLease.Close()
+			} else if queue.closeCount.Load() != 1 || queue.receiverExits.Load() != 1 {
+				t.Fatal("authorized retirement failed to join actual receiver once")
+			}
+			if ret := ownershipAwait(t, queue.errorReturns); ret != 1 {
+				t.Fatalf("terminal callback did not exit after permission: %d", ret)
+			}
+		})
+	}
+}
