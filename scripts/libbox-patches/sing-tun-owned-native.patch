+type fw4Output struct {
+	access sync.Mutex
+	bytes  []byte
+	total  int
+}
+
+func (o *fw4Output) Write(raw []byte) (int, error) {
+	o.access.Lock()
+	defer o.access.Unlock()
+	o.total += len(raw)
+	if len(o.bytes) < 65536 {
+		o.bytes = append(o.bytes, raw[:min(len(raw), 65536-len(o.bytes))]...)
+	}
+	return len(raw), nil
+}
+
+// This hashes the retained prefix; OutputTruncated makes the bound explicit.
+func (o *fw4Output) receipt() (string, int, bool, []byte) {
+	o.access.Lock()
+	defer o.access.Unlock()
+	return fw4Hash(o.bytes), o.total, o.total > len(o.bytes), bytes.Clone(o.bytes)
+}
